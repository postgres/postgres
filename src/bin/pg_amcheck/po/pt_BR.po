#: pg_amcheck.c:1186
#, c-format
msgid "Usage:\n"
msgstr "Uso:\n"

#: pg_amcheck.c:1187
#, c-format
msgid "  %s [OPTION]... [DBNAME]\n"
msgstr "  %s [OPÇÃO]... [NOMEBD]\n"

#: pg_amcheck.c:1188
#, c-format
msgid ""
"\n"
"Target options:\n"
msgstr ""
"\n"
"Opções de destino:\n"

#: pg_amcheck.c:1189
#, c-format
msgid "  -a, --all                       check all databases\n"
msgstr "  -a, --all                       verificar todos os bancos de dados\n"

#: pg_amcheck.c:1190
#, c-format
msgid "  -d, --database=PATTERN          check matching database(s)\n"
msgstr "  -d, --database=PATTERN verificar banco(s) de dados que correspondem ao padrão\n"

#: pg_amcheck.c:1191
#, c-format
msgid "  -D, --exclude-database=PATTERN  do NOT check matching database(s)\n"
msgstr "  -D, --exclude-database=PATTERN  NÃO verificar banco(s) de dados que correspondem ao padrão\n"

#: pg_amcheck.c:1192
#, c-format
msgid "  -i, --index=PATTERN             check matching index(es)\n"
msgstr "  -i, --index=PATTERN             verificar índice(s) que correspondem ao padrão\n"

#: pg_amcheck.c:1193
#, c-format
msgid "  -I, --exclude-index=PATTERN     do NOT check matching index(es)\n"
msgstr "  -I, --exclude-index=PATTERN     NÃO verificar índice(s) que correspondem ao padrão\n"

#: pg_amcheck.c:1194
#, c-format
msgid "  -r, --relation=PATTERN          check matching relation(s)\n"
msgstr "  -r, --relation=PATTERN          verificar relação(ões) que correspondem ao padrão\n"

#: pg_amcheck.c:1195
#, c-format
msgid "  -R, --exclude-relation=PATTERN  do NOT check matching relation(s)\n"
msgstr "  -R, --exclude-relation=PATTERN  NÃO verificar relação(ões) que correspondem ao padrão\n"

#: pg_amcheck.c:1196
#, c-format
msgid "  -s, --schema=PATTERN            check matching schema(s)\n"
msgstr "  -s, --schema=PATTERN            verificar esquema(s) que correspondem ao padrão\n"

#: pg_amcheck.c:1197
#, c-format
msgid "  -S, --exclude-schema=PATTERN    do NOT check matching schema(s)\n"
msgstr "  -S, --exclude-schema=PATTERN    NÃO verificar esquema(s) que correspondem ao padrão\n"

#: pg_amcheck.c:1198
#, c-format
msgid "  -t, --table=PATTERN             check matching table(s)\n"
msgstr "  -t, --table=PATTERN             verificar tabela(s) que correspondem ao padrão\n"

#: pg_amcheck.c:1199
#, c-format
msgid "  -T, --exclude-table=PATTERN     do NOT check matching table(s)\n"
msgstr "  -T, --exclude-table=PATTERN     NÃO verificar tabela(s) que correspondem ao padrão\n"

#: pg_amcheck.c:1200
#, c-format
msgid "      --no-dependent-indexes      do NOT expand list of relations to include indexes\n"
msgstr "      --no-dependent-indexes      NÃO expandir a lista de relações para incluir índices\n"

#: pg_amcheck.c:1201
#, c-format
msgid "      --no-dependent-toast        do NOT expand list of relations to include TOAST tables\n"
msgstr "      --no-dependent-toast        NÃO expandir a lista de relações para incluir tabelas TOAST\n"

#: pg_amcheck.c:1202
#, c-format
msgid "      --no-strict-names           do NOT require patterns to match objects\n"
msgstr "      --no-strict-names           Não exigir que os padrões correspondam aos objetos\n"

#: pg_amcheck.c:1203
#, c-format
msgid ""
"\n"
"Table checking options:\n"
msgstr ""
"\n"
"Opções de verificação de tabela:\n"

#: pg_amcheck.c:1204
#, c-format
msgid "      --exclude-toast-pointers    do NOT follow relation TOAST pointers\n"
msgstr "      --exclude-toast-pointers    Não seguir os ponteiros de relação TOAST\n"

#: pg_amcheck.c:1205
#, c-format
msgid "      --on-error-stop             stop checking at end of first corrupt page\n"
msgstr "      --on-error-stop             parar a verificação no final da primeira página corrompida\n"

#: pg_amcheck.c:1206
#, c-format
msgid "      --skip=OPTION               do NOT check \"all-frozen\" or \"all-visible\" blocks\n"
msgstr "      --skip=OPTION               NÃO verificar blocos \"all-frozen\" ou \"all-visible\"\n"

#: pg_amcheck.c:1207
#, c-format
msgid "      --startblock=BLOCK          begin checking table(s) at the given block number\n"
msgstr "      --startblock=BLOCK          iniciar a verificação da(s) tabela(s) no número de bloco especificado\n"

#: pg_amcheck.c:1208
#, c-format
msgid "      --endblock=BLOCK            check table(s) only up to the given block number\n"
msgstr "      --endblock=BLOCK            verificar a(s) tabela(s) somente até o número de bloco especificado\n"

#: pg_amcheck.c:1209
#, c-format
msgid ""
"\n"
"B-tree index checking options:\n"
msgstr ""
"\n"
"Opções de verificação de índice B-tree:\n"

#: pg_amcheck.c:1210
#, c-format
msgid "      --checkunique               check unique constraint if index is unique\n"
msgstr "      --checkunique verifica a restrição exclusiva se o índice for exclusivo\n"

#: pg_amcheck.c:1211
#, c-format
msgid "      --heapallindexed            check that all heap tuples are found within indexes\n"
msgstr "      -heapallindexed            verificar se todas as tuplas da heap são encontradas dentro dos índices\n"

#: pg_amcheck.c:1212
#, c-format
msgid "      --parent-check              check index parent/child relationships\n"
msgstr "      --parent-check              verificar as relações pai/filho do índice\n"

#: pg_amcheck.c:1213
#, c-format
msgid "      --rootdescend               search from root page to refind tuples\n"
msgstr "      --rootdescend               buscar da página raiz para reencontrar tuplas\n"

