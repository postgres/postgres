#, c-format
msgid ""
"\n"
"General options:\n"
msgstr ""
"\n"
"Opzioni generali:\n"

#: pg_dump.c:1298
#, c-format
msgid "  -f, --file=FILENAME          output file or directory name\n"
msgstr "  -f, --file=NOMEFILE          nome del file o della directory di output\n"

