#, c-format
msgid "out of memory\n"
msgstr "memoria esaurita\n"

#: ../../common/fe_memutils.c:98 ../../common/fe_memutils.c:159
#, c-format
msgid "cannot duplicate null pointer (internal error)\n"
msgstr "impossibile duplicare il puntatore nullo (errore interno)\n"

#: ../../common/fe_memutils.c:209
#, c-format
msgid "invalid memory allocation request size %zu + %zu\n"
msgstr ""
"dimensione della richiesta di allocazione di memoria non valida %zu + "
"%zu\n"

#: ../../common/fe_memutils.c:228
#, c-format
msgid "invalid memory allocation request size %zu * %zu\n"
msgstr ""
"dimensione della richiesta di allocazione di memoria non valida %zu + "
"%zu\n"

#: pg_test_timing.c:79
#, c-format
msgid "Usage: %s [-c CUTOFF] [-d DURATION]\n"
msgstr "Utilizzo: %s [-c SOGLIA] [-d DURATA]\n"

#: pg_test_timing.c:100 pg_test_timing.c:121
#, c-format
msgid "%s: invalid argument for option %s\n"
msgstr "%s: argomento non valido per l'opzione %s\n"

#: pg_test_timing.c:102 pg_test_timing.c:123 pg_test_timing.c:137
#: pg_test_timing.c:149
#, c-format
msgid "Try \"%s --help\" for more information.\n"
msgstr "Prova \"%s --help\" per maggiori informazioni.\n"

#: pg_test_timing.c:108 pg_test_timing.c:130
#, c-format
msgid "%s: %s must be in range %u..%u\n"
msgstr "%s: %s deve essere compreso nell'intervallo %u..%u\n"

#: pg_test_timing.c:147
#, c-format
msgid "%s: too many command-line arguments (first is \"%s\")\n"
msgstr "%s: troppi argomenti nella riga di comando (il primo è \"%s\")\n"

#: pg_test_timing.c:154
#, c-format
msgid ""
"Testing timing overhead for %u second.\n"
"\n"
msgid_plural ""
"Testing timing overhead for %u seconds.\n"
"\n"
msgstr[0] "Testare l'overhead di temporizzazione per %u secondo.\n"
msgstr[1] "Testare l'overhead di temporizzazione per %u secondi.\n"

#: pg_test_timing.c:209
#, c-format
msgid "TSC frequency source: %s\n"
msgstr "Sorgente di frequenza TSC: %s\n"

#: pg_test_timing.c:210
#, c-format
msgid "TSC frequency in use: %d kHz\n"
msgstr "Frequenza TSC in uso: %d kHz\n"

#: pg_test_timing.c:216
#, c-format
msgid "TSC frequency from calibration: %d kHz\n"
msgstr "Frequenza TSC da calibrazione: %d kHz\n"

#: pg_test_timing.c:223
#, c-format
msgid ""
"WARNING: Calibrated TSC frequency differs by %.1f%% from the TSC "
"frequency in use\n"
msgstr ""
"AVVERTENZA: La frequenza TSC calibrata differisce del %.1f%% dalla "
"frequenza TSC in uso.\n"

#: pg_test_timing.c:225
#, c-format
msgid ""
"HINT: Consider setting timing_clock_source to 'system'. Report bugs to "
"<%s>.\n"
msgstr ""
"SUGGERIMENTO: Valuta di impostare timing_clock_source su 'system'. "
"Segnala i bug a <%s>.\n"

#: pg_test_timing.c:230
#, c-format
msgid "TSC calibration did not converge\n"
msgstr "La calibrazione TSC non è andata a convergenza.\n"

#: pg_test_timing.c:240
#, c-format
msgid ""
"\n"
"TSC clock source will be used by default, unless timing_clock_source is "
"set to 'system'.\n"
msgstr ""
"\n"
"La sorgente di clock TSC verrà utilizzata per impostazione predefinita, a "
"meno che `timing_clock_source` non sia impostata su 'system'.\n"

#: pg_test_timing.c:242
#, c-format
msgid ""
"\n"
"TSC clock source will not be used by default, unless timing_clock_source "
"is set to 'tsc'.\n"
msgstr ""
"\n"
"La sorgente di clock TSC non verrà utilizzata per impostazione "
"predefinita, a meno che `timing_clock_source` non sia impostata su "
"'tsc'.\n"

#: pg_test_timing.c:245
#, c-format
msgid ""
"\n"
"TSC clock source is not usable. Likely unable to determine TSC frequency. "
"Are you running in an unsupported virtualized environment?\n"
msgstr ""
"\n"
"La sorgente di clock TSC non è utilizzabile. Probabilmente non è stato "
"possibile determinare la frequenza TSC. Si sta eseguendo il sistema in un "
"ambiente virtualizzato non supportato?\n"

#: pg_test_timing.c:270
#, c-format
msgid "Fast clock source: %s\n"
msgstr "Sorgente di clock veloce: %s\n"

#: pg_test_timing.c:272
#, c-format
msgid "System clock source: %s\n"
msgstr "Sorgente del clock di sistema: %s\n"

#: pg_test_timing.c:274
#, c-format
msgid "Clock source: %s\n"
msgstr "Sorgente di clock: %s\n"

#: pg_test_timing.c:312
#, c-format
msgid "Detected clock going backwards in time.\n"
msgstr "Rilevato orologio che va indietro nel tempo.\n"

#: pg_test_timing.c:313
#, c-format
msgid "Time warp: %<PRId64> ns\n"
msgstr "Salto temporale: %<PRId64> ns\n"

#: pg_test_timing.c:351
#, c-format
msgid "Average loop time including overhead: %0.2f ns\n"
msgstr "Tempo medio  per ciclo incluso sovraccarico: %0.2f ns\n"

#: pg_test_timing.c:361
msgid "<= ns"
msgstr "<= ns"

#: pg_test_timing.c:362
msgid "ns"
msgstr "ns"

#: pg_test_timing.c:363
#, no-c-format
msgid "% of total"
msgstr "% del totale"

#: pg_test_timing.c:364
#, no-c-format
msgid "running %"
msgstr "in esecuzione  %"

#: pg_test_timing.c:365
msgid "count"
msgstr "conteggio"

#: pg_test_timing.c:375
#, c-format
msgid ""
"WARNING: No timing measurements collected. Report this as a bug to <%s>.\n"
msgstr ""
"ATTENZIONE: Nessuna misurazione dei tempi rilevata. Segnala il problema "
"come bug a <%s>.\n"

#: pg_test_timing.c:389
#, c-format
msgid "Histogram of timing durations:\n"
msgstr "Istogramma delle durate temporali:\n"

#: pg_test_timing.c:409
#, c-format
msgid ""
"\n"
"Observed timing durations up to %.4f%%:\n"
msgstr ""
"\n"
"Durate di temporizzazione osservate fino a %.4f%%:\n"

#~ msgid "< us"
#~ msgstr "< noi"
