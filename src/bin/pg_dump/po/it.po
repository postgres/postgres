#, c-format
msgid ""
"  -Z, --compress=METHOD[:DETAIL]\n"
"                               compress as specified\n"
msgstr ""
"  -Z, --compress=METODO[:DETTAGLIO]\n"
"                               comprimi come specificato\n"

