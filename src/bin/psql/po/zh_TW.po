msgstr ""
"  PSQL_PAGER, PAGER\n"
"    外部分頁程式的名稱\n"

#: help.c:559
msgid ""
"  PSQL_WATCH_PAGER\n"
"    name of external pager program used for \\watch\n"
msgstr ""
"  PSQL_WATCH_PAGER\n"
"    用於 \\watch 的外部分頁程式的名稱\n"

#: help.c:562
msgid ""
"  PSQLRC\n"
"    alternative location for the user's .psqlrc file\n"
msgstr ""
"  PSQLRC\n"
"    使用者 .psqlrc 檔案的替代位置\n"

#: help.c:564
msgid ""
"  SHELL\n"
"    shell used by the \\! command\n"
msgstr ""
"  SHELL\n"
"    \\! 命令使用的 shell\n"

#: help.c:566
