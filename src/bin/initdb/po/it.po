msgstr "segnale intercettato\n"

#: initdb.c:2142
#, c-format
msgid "could not write to child process: %s\n"
msgstr "scrittura verso il processo figlio non riuscita: %s\n"

#: initdb.c:2150
#, c-format
msgid "ok\n"
msgstr "ok\n"

#: initdb.c:2232 initdb.c:2278
#, c-format
msgid "locale name \"%s\" contains non-ASCII characters"
msgstr "il nome di localizzazione \"%s\" contiene caratteri non ASCII"

#: initdb.c:2258
#, c-format
msgid "invalid locale name \"%s\""
msgstr "nome di localizzazione \"%s\" non valido"

#: initdb.c:2259
#, c-format
msgid "If the locale name is specific to ICU, use --icu-locale."
msgstr "Se il nome di localizzazione è specifico di ICU, usa --icu-locale."

#: initdb.c:2272
#, c-format
msgid "invalid locale settings; check LANG and LC_* environment variables"
msgstr ""
"impostazioni di localizzazione non valide; controllare le variabili d'ambiente "
"LANG e LC_*"

#: initdb.c:2303 initdb.c:2327
#, c-format
msgid "encoding mismatch"
msgstr "mancata corrispondenza della codifica"

#: initdb.c:2304
#, c-format
msgid ""
"The encoding you selected (%s) and the encoding that the selected locale uses "
"(%s) do not match. This would lead to misbehavior in various character string "
"processing functions."
msgstr ""
"La codifica selezionata (%s) e la codifica usata dalla localizzazione "
"selezionata (%s) non corrispondono. Questo causerebbe malfunzionamenti in varie "
"funzioni di elaborazione delle stringhe di caratteri."

#: initdb.c:2309 initdb.c:2330
#, c-format
msgid ""
"Rerun %s and either do not specify an encoding explicitly, or choose a matching "
"combination."
msgstr ""
"Rieseguire %s senza specificare esplicitamente una codifica, oppure scegliere "
"una combinazione compatibile."

#: initdb.c:2328
#, c-format
msgid "The encoding you selected (%s) is not supported with the ICU provider."
msgstr "La codifica selezionata (%s) non è supportata con il provider ICU."

#: initdb.c:2379
#, c-format
msgid "could not convert locale name \"%s\" to language tag: %s"
msgstr ""
"conversione del nome di localizzazione \"%s\" in tag di lingua non riuscita: %s"

#: initdb.c:2385 initdb.c:2437 initdb.c:2531
#, c-format
msgid "ICU is not supported in this build"
msgstr "ICU non è supportato in questa build"

#: initdb.c:2408
#, c-format
msgid "could not get language from locale \"%s\": %s"
msgstr "recupero della lingua dalla localizzazione \"%s\" non riuscito: %s"

#: initdb.c:2434
#, c-format
msgid "locale \"%s\" has unknown language \"%s\""
msgstr "la localizzazione \"%s\" ha una lingua sconosciuta \"%s\""

#: initdb.c:2495
#, c-format
msgid "locale must be specified if provider is %s"
msgstr "la localizzazione deve essere specificata se il provider è %s"

#: initdb.c:2508
#, c-format
msgid "invalid locale name \"%s\" for builtin provider"
msgstr "nome di localizzazione \"%s\" non valido per il provider builtin"

#: initdb.c:2519
#, c-format
msgid "Using language tag \"%s\" for ICU locale \"%s\".\n"
msgstr "Uso del tag di lingua \"%s\" per la localizzazione ICU \"%s\".\n"

#: initdb.c:2542
#, c-format
msgid ""
"%s initializes a PostgreSQL database cluster.\n"
"\n"
msgstr ""
"%s inizializza un cluster di database PostgreSQL.\n"
"\n"

#: initdb.c:2543
#, c-format
msgid "Usage:\n"
msgstr "Uso:\n"

#: initdb.c:2544
#, c-format
msgid "  %s [OPTION]... [DATADIR]\n"
msgstr "  %s [OPZIONE]... [DATADIR]\n"

#: initdb.c:2545
#, c-format
msgid ""
"\n"
"Options:\n"
msgstr ""
"\n"
"Opzioni:\n"

#: initdb.c:2546
#, c-format
msgid ""
"  -A, --auth=METHOD         default authentication method for local "
"connections\n"
msgstr ""
"  -A, --auth=METODO         metodo di autenticazione predefinito per le "
"connessioni locali\n"

#: initdb.c:2547
#, c-format
msgid ""
"      --auth-host=METHOD    default authentication method for local TCP/IP "
"connections\n"
msgstr ""
"      --auth-host=METODO    metodo di autenticazione predefinito per le "
"connessioni TCP/IP locali\n"

#: initdb.c:2548
#, c-format
msgid ""
"      --auth-local=METHOD   default authentication method for local-socket "
"connections\n"
msgstr ""
"      --auth-local=METODO   metodo di autenticazione predefinito per le "
"connessioni tramite socket locale\n"

#: initdb.c:2549
#, c-format
msgid " [-D, --pgdata=]DATADIR     location for this database cluster\n"
msgstr " [-D, --pgdata=]DATADIR     posizione di questo cluster di database\n"

#: initdb.c:2550
#, c-format
msgid "  -E, --encoding=ENCODING   set default encoding for new databases\n"
msgstr ""
"  -E, --encoding=CODIFICA   imposta la codifica predefinita per i nuovi "
"database\n"

#: initdb.c:2551
#, c-format
msgid "  -g, --allow-group-access  allow group read/execute on data directory\n"
msgstr ""
"  -g, --allow-group-access  consente al gruppo lettura/esecuzione sulla "
"directory dei dati\n"

#: initdb.c:2552
#, c-format
msgid "      --icu-locale=LOCALE   set ICU locale ID for new databases\n"
msgstr ""
"      --icu-locale=LOCALE   imposta l'ID di localizzazione ICU per i nuovi "
"database\n"

#: initdb.c:2553
#, c-format
msgid ""
"      --icu-rules=RULES     set additional ICU collation rules for new "
"databases\n"
msgstr ""
"      --icu-rules=REGOLE    imposta regole di ordinamento ICU aggiuntive per i "
"nuovi database\n"

#: initdb.c:2554
#, c-format
msgid "  -k, --data-checksums      use data page checksums\n"
msgstr "  -k, --data-checksums      usa i checksum delle pagine dati\n"

#: initdb.c:2555
#, c-format
msgid "      --locale=LOCALE       set default locale for new databases\n"
msgstr ""
"      --locale=LOCALE       imposta la localizzazione predefinita per i nuovi "
"database\n"

#: initdb.c:2556
#, c-format
msgid ""
"      --lc-collate=, --lc-ctype=, --lc-messages=LOCALE\n"
"      --lc-monetary=, --lc-numeric=, --lc-time=LOCALE\n"
"                            set default locale in the respective category for\n"
"                            new databases (default taken from environment)\n"
msgstr ""
"      --lc-collate=, --lc-ctype=, --lc-messages=LOCALE\n"
"      --lc-monetary=, --lc-numeric=, --lc-time=LOCALE\n"
"                            imposta la localizzazione predefinita nella "
"rispettiva\n"
"                            categoria per i nuovi database (il valore "
"predefinito\n"
"                            viene preso dall'ambiente)\n"

#: initdb.c:2560
#, c-format
msgid "      --no-locale           equivalent to --locale=C\n"
msgstr "      --no-locale           equivalente a --locale=C\n"

#: initdb.c:2561
#, c-format
msgid ""
"      --builtin-locale=LOCALE\n"
"                            set builtin locale name for new databases\n"
msgstr ""
"      --builtin-locale=LOCALE\n"
"                            imposta il nome della localizzazione builtin per i "
"nuovi database\n"

#: initdb.c:2563
