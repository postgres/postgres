#, c-format
msgid "cannot override ORDER BY clause of window \"%s\""
msgstr "不能覆盖窗口 \"%s\" 的 ORDER BY 子句"

#: parser/parse_clause.c:2897 parser/parse_clause.c:2903
#, c-format
