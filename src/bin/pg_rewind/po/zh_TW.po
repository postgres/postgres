msgstr "WAL 片段 %3$s 中的時間軸 ID %1$u 順序錯誤(前一個為 %2$u), LSN %4$X/%5$08X, 位移 %6$u"

#: xlogreader.c:1790
#, c-format
msgid "out-of-order block_id %u at %X/%08X"
msgstr "位於 %2$X/%3$08X 的 block_id %1$u 順序錯誤"

#: xlogreader.c:1814
#, c-format
msgid "BKPBLOCK_HAS_DATA set, but no data included at %X/%08X"
msgstr "%X/%08X 處已設定 BKPBLOCK_HAS_DATA，但未包含資料"

#: xlogreader.c:1821
#, c-format
msgid "BKPBLOCK_HAS_DATA not set, but data length is %d at %X/%08X"
msgstr "未設定 BKPBLOCK_HAS_DATA，但 %2$X/%3$08X 處的資料長度為 %1$d"

#: xlogreader.c:1857
#, c-format
msgid "BKPIMAGE_HAS_HOLE set, but hole offset %d length %d block image length %d at %X/%08X"
msgstr "已設定 BKPIMAGE_HAS_HOLE，但 %4$X/%5$08X 處的空洞位移為 %1$d，長度為 %2$d，區塊映像長度為 %3$d"

#: xlogreader.c:1873
#, c-format
msgid "BKPIMAGE_HAS_HOLE not set, but hole offset %d length %d at %X/%08X"
msgstr "未設定 BKPIMAGE_HAS_HOLE，但 %3$X/%4$08X 處的空洞位移為 %1$d，長度為 %2$d"

#: xlogreader.c:1887
#, c-format
msgid "BKPIMAGE_COMPRESSED set, but block image length %d at %X/%08X"
msgstr "已設定 BKPIMAGE_COMPRESSED，但 %2$X/%3$08X 處的區塊映像長度為 %1$d"

#: xlogreader.c:1902
#, c-format
msgid "neither BKPIMAGE_HAS_HOLE nor BKPIMAGE_COMPRESSED set, but block image length is %d at %X/%08X"
msgstr "既未設定 BKPIMAGE_HAS_HOLE，也未設定 BKPIMAGE_COMPRESSED，但 %2$X/%3$08X 處的區塊映像長度為 %1$d"

#: xlogreader.c:1918
#, c-format
msgid "BKPBLOCK_SAME_REL set but no previous rel at %X/%08X"
msgstr "%X/%08X 處已設定 BKPBLOCK_SAME_REL，但沒有先前的關聯"

#: xlogreader.c:1930
#, c-format
msgid "invalid block_id %u at %X/%08X"
msgstr "%2$X/%3$08X 處的 block_id %1$u 無效"

#: xlogreader.c:1997
#, c-format
msgid "record with invalid length at %X/%08X"
msgstr "位於 %X/%08X 的記錄長度無效"

#: xlogreader.c:2023
#, c-format
msgid "could not locate backup block with ID %d in WAL record"
msgstr "在 WAL 記錄中找不到具有 ID %d 的備份區塊"

#: xlogreader.c:2107
#, c-format
msgid "could not restore image at %X/%08X with invalid block %d specified"
msgstr "無法還原 %X/%08X 處的映像，因為指定的區塊 %d 無效"

#: xlogreader.c:2114
#, c-format
msgid "could not restore image at %X/%08X with invalid state, block %d"
msgstr "無法還原 %X/%08X 處的映像，狀態無效, 區塊 %d"

#: xlogreader.c:2141 xlogreader.c:2158
#, c-format
msgid "could not restore image at %X/%08X compressed with %s not supported by build, block %d"
msgstr "無法還原 %X/%08X 處使用 %s 壓縮的映像，此建置版本不支援該壓縮方式, 區塊 %d"

#: xlogreader.c:2167
#, c-format
msgid "could not restore image at %X/%08X compressed with unknown method, block %d"
msgstr "無法還原 %X/%08X 處使用未知方法壓縮的映像, 區塊 %d"

#: xlogreader.c:2175
#, c-format
msgid "could not decompress image at %X/%08X, block %d"
msgstr "無法解壓縮 %X/%08X 處的映像, 區塊 %d"

