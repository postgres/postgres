# help.c:83
#: help.c:60
msgid ""
"psql is the PostgreSQL interactive terminal.\n"
"\n"
msgstr "psql 是 PostgreSQL 互動式終端機。\n\n"

#: help.c:61 help.c:384 help.c:471 help.c:524
msgid "Usage:\n"
msgstr "用法:\n"

# help.c:86
#: help.c:62
msgid ""
"  psql [OPTION]... [DBNAME [USERNAME]]\n"
"\n"
msgstr "  psql [選項]... [資料庫名 [使用者名稱]]\n\n"

#: help.c:64
msgid "General options:\n"
msgstr "一般選項:\n"

# help.c:94
#: help.c:65
msgid "  -c, --command=COMMAND    run only single command (SQL or internal) and exit\n"
msgstr "  -c, --command=COMMAND    執行單一命令(SQL 或內部命令)後結束\n"

#: help.c:66
msgid "  -d, --dbname=DBNAME      database name to connect to\n"
msgstr "  -d, --dbname=DBNAME      要連線的資料庫名稱\n"

# help.c:95
#: help.c:67
msgid "  -f, --file=FILENAME      execute commands from file, then exit\n"
msgstr "  -f, --file=FILENAME      執行來自檔案的指令然後結束\n"

# help.c:96
#: help.c:68
msgid "  -l, --list               list available databases, then exit\n"
msgstr "  -l, --list               列出可用的資料庫然後結束\n"

# help.c:97
#: help.c:69
msgid ""
"  -v, --set=, --variable=NAME=VALUE\n"
"                           set psql variable NAME to VALUE\n"
"                           (e.g., -v ON_ERROR_STOP=1)\n"
msgstr "  -v, --set=, --variable=NAME=VALUE\n                           設定 psql 變數 NAME 為 VALUE\n                           (例如 -v ON_ERROR_STOP=1)\n"

#: help.c:72
msgid "  -V, --version            output version information, then exit\n"
msgstr "  -V, --version            顯示版本，然後結束\n"

# help.c:98
#: help.c:73
msgid "  -X, --no-psqlrc          do not read startup file (~/.psqlrc)\n"
msgstr "  -X, --no-psqlrc          不要讀取啟動檔(~/.psqlrc)\n"

#: help.c:74
msgid ""
"  -1 (\"one\"), --single-transaction\n"
"                           execute as a single transaction (if non-interactive)\n"
msgstr ""
"  -1 (\"one\"), --single-transaction\n"
"                           以單一交易執行(若為非互動模式)\n"

#: help.c:76
msgid "  -?, --help[=options]     show this help, then exit\n"
msgstr "  -?, --help[=options]     顯示說明，然後結束\n"

#: help.c:77
msgid "      --help=commands      list backslash commands, then exit\n"
msgstr "      --help=commands      列出反斜線命令然後結束\n"

# help.c:96
#: help.c:78
msgid "      --help=variables     list special variables, then exit\n"
msgstr "      --help=variables     列出特殊變數然後結束\n"

# help.c:102
#: help.c:80
msgid ""
"\n"
"Input and output options:\n"
msgstr ""
"\n"
"輸入和輸出選項:\n"

# help.c:103
#: help.c:81
msgid "  -a, --echo-all           echo all input from script\n"
msgstr "  -a, --echo-all           顯示來自腳本的所有輸入\n"

# help.c:104
#: help.c:82
msgid "  -b, --echo-errors        echo failed commands\n"
msgstr "  -b, --echo-errors        顯示失敗的命令\n"

# help.c:104
#: help.c:83
msgid "  -e, --echo-queries       echo commands sent to server\n"
msgstr "  -e, --echo-queries       顯示傳送至伺服器的命令\n"

# help.c:105
#: help.c:84
msgid "  -E, --echo-hidden        display queries that internal commands generate\n"
msgstr "  -E, --echo-hidden        顯示內部命令產生的查詢\n"

# help.c:107
#: help.c:85
msgid "  -L, --log-file=FILENAME  send session log to file\n"
msgstr "  -L, --log-file=FILENAME  將工作階段記錄存檔\n"

# help.c:108
#: help.c:86
msgid "  -n, --no-readline        disable enhanced command line editing (readline)\n"
msgstr "  -n, --no-readline        停用增強的命令列編輯(readline)\n"

# help.c:107
#: help.c:87
msgid "  -o, --output=FILENAME    send query results to file (or |pipe)\n"
msgstr "  -o, --output=FILENAME    將查詢結果傳送至檔案(或 | 管道)\n"

# help.c:106
#: help.c:88
msgid "  -q, --quiet              run quietly (no messages, only query output)\n"
msgstr "  -q, --quiet              靜默執行(無訊息，僅查詢輸出)\n"

# help.c:109
#: help.c:89
msgid "  -s, --single-step        single-step mode (confirm each query)\n"
msgstr "  -s, --single-step        單步模式(確認每個查詢)\n"

# help.c:110
#: help.c:90
msgid "  -S, --single-line        single-line mode (end of line terminates SQL command)\n"
msgstr "  -S, --single-line        單行模式(行尾結束 SQL 命令)\n"

# help.c:112
#: help.c:92
msgid ""
"\n"
"Output format options:\n"
msgstr ""
"\n"
"輸出格式選項:\n"

# help.c:113
#: help.c:93
msgid "  -A, --no-align           unaligned table output mode\n"
msgstr "  -A, --no-align           使用非對齊表格輸出模式\n"

# help.c:234
#: help.c:94
msgid "      --csv                CSV (Comma-Separated Values) table output mode\n"
msgstr "      --csv                CSV(逗號分隔值)表格輸出模式\n"

# help.c:119
#: help.c:95
#, c-format
msgid ""
"  -F, --field-separator=STRING\n"
"                           field separator for unaligned output (default: \"%s\")\n"
msgstr "  -F, --field-separator=STRING\n                           非對齊輸出的欄位分隔符號(預設: \"%s\")\n"

# help.c:114
#: help.c:98
msgid "  -H, --html               HTML table output mode\n"
msgstr "  -H, --html               HTML 表格輸出模式\n"

# help.c:118
#: help.c:99
msgid "  -P, --pset=VAR[=ARG]     set printing option VAR to ARG (see \\pset command)\n"
msgstr "  -P, --pset=VAR[=ARG]     將顯示選項 VAR 設為 ARG (參閱 \\pset 命令)\n"

# help.c:121
#: help.c:100
msgid ""
"  -R, --record-separator=STRING\n"
"                           record separator for unaligned output (default: newline)\n"
msgstr ""
"  -R, --record-separator=STRING\n"
"                           非對齊輸出的記錄分隔符號(預設: 換行字元)\n"

# help.c:115
#: help.c:102
msgid "  -t, --tuples-only        print rows only\n"
msgstr "  -t, --tuples-only        只顯示資料\n"

# help.c:116
#: help.c:103
msgid "  -T, --table-attr=TEXT    set HTML table tag attributes (e.g., width, border)\n"
msgstr "  -T, --table-attr=TEXT    設定 HTML 表格標籤屬性 (例如: width, border)\n"

# help.c:117
#: help.c:104
msgid "  -x, --expanded           turn on expanded table output\n"
msgstr "  -x, --expanded           開啟展開表格輸出模式\n"

# help.c:119
#: help.c:105
msgid ""
"  -z, --field-separator-zero\n"
"                           set field separator for unaligned output to zero byte\n"
msgstr "  -z, --field-separator-zero\n                           將非對齊輸出的欄位分隔符設定成值為零的位元組\n"

# help.c:121
#: help.c:107
msgid ""
"  -0, --record-separator-zero\n"
"                           set record separator for unaligned output to zero byte\n"
msgstr "  -0, --record-separator-zero\n                           將非對齊輸出的記錄分隔符設定成值為零的位元組\n"

#: help.c:110
msgid ""
"\n"
"Connection options:\n"
msgstr ""
"\n"
"連線選項:\n"

#: help.c:111
msgid "  -h, --host=HOSTNAME      database server host or socket directory\n"
msgstr "  -h, --host=HOSTNAME      資料庫伺服器主機或 socket 目錄\n"

#: help.c:112
msgid "  -p, --port=PORT          database server port\n"
msgstr "  -p, --port=PORT          資料庫伺服器連接埠\n"

#: help.c:113
msgid "  -U, --username=USERNAME  database user name\n"
msgstr "  -U, --username=USERNAME  資料庫使用者名稱\n"

#: help.c:114
msgid "  -w, --no-password        never prompt for password\n"
msgstr "  -w, --no-password        不詢問密碼\n"

#: help.c:115
msgid "  -W, --password           force password prompt (should happen automatically)\n"
msgstr "  -W, --password           強制提示輸入密碼(應自動提示)\n"

# help.c:140
#: help.c:117
msgid ""
"\n"
"For more information, type \"\\?\" (for internal commands) or \"\\help\" (for SQL\n"
"commands) from within psql, or consult the psql section in the PostgreSQL\n"
"documentation.\n"
"\n"
msgstr ""
"\n"
"若需更多資訊，請在 psql 輸入 \"\\?\"(內部命令)或 \"\\help\"(SQL 命令)\n"
"或查閱 PostgreSQL 文件中的 psql 章節。\n"
"\n"

#: help.c:120
#, c-format
msgid "Report bugs to <%s>.\n"
msgstr "回報錯誤至 <%s>。\n"

#: help.c:121
#, c-format
msgid "%s home page: <%s>\n"
msgstr "%s 首頁: <%s>\n"

# help.c:174
#: help.c:163
msgid "General\n"
msgstr "一般\n"

# help.c:179
#: help.c:164
msgid "  \\copyright             show PostgreSQL usage and distribution terms\n"
msgstr "  \\copyright             顯示 PostgreSQL 的使用和發佈條款\n"

#: help.c:165
msgid "  \\crosstabview [COLUMNS] execute query and display result in crosstab\n"
msgstr "  \\crosstabview [COLUMNS] 執行查詢並以樞紐分析表顯示結果\n"

#: help.c:166
msgid "  \\errverbose            show most recent error message at maximum verbosity\n"
msgstr "  \\errverbose            以最大詳細程度顯示最近的錯誤訊息\n"

#: help.c:167
msgid ""
"  \\g [(OPTIONS)] [FILE]  execute query (and send result to file or |pipe);\n"
"                         \\g with no arguments is equivalent to a semicolon\n"
msgstr ""
"  \\g [(OPTIONS)] [FILE]  執行查詢(並將結果發送到檔案或 | 管道)；\n"
"                         \\g 若無參數等同於分號\n"

#: help.c:169
msgid "  \\gdesc                 describe result of query, without executing it\n"
msgstr "  \\gdesc                 描述查詢的結果，但不執行該查詢\n"

#: help.c:170
msgid "  \\gexec                 execute query, then execute each value in its result\n"
msgstr "  \\gexec                 執行查詢，然後執行結果中的每個值\n"

# help.c:194
#: help.c:171
msgid "  \\gset [PREFIX]         execute query and store result in psql variables\n"
msgstr "  \\gset [PREFIX]         執行查詢並將結果儲存在 psql 變數中\n"

#: help.c:172
msgid "  \\gx [(OPTIONS)] [FILE] as \\g, but forces expanded output mode\n"
msgstr "  \\gx [(OPTIONS)] [FILE] 與 \\g 相同，但強制使用展開輸出模式\n"

# help.c:183
#: help.c:173
msgid "  \\q                     quit psql\n"
msgstr "  \\q                     結束 psql\n"

#: help.c:174
msgid ""
"  \\restrict RESTRICT_KEY\n"
"                         enter restricted mode with provided key\n"
msgstr "  \\restrict RESTRICT_KEY\n                         使用提供的金鑰進入限制模式\n"

#: help.c:176
msgid ""
"  \\unrestrict RESTRICT_KEY\n"
"                         exit restricted mode if key matches\n"
msgstr "  \\unrestrict RESTRICT_KEY\n                         金鑰相符時結束限制模式\n"

#: help.c:178
msgid ""
"  \\watch [[i=]SEC] [c=N] [m=MIN]\n"
"                         execute query every SEC seconds, up to N times,\n"
"                         stop if less than MIN rows are returned\n"
msgstr "  \\watch [[i=]SEC] [c=N] [m=MIN]\n                         每 SEC 秒執行一次查詢，最多執行 N 次，\n                         傳回資料列少於 MIN 時停止\n"

#: help.c:181 help.c:189 help.c:201 help.c:211 help.c:218 help.c:276 help.c:284
#: help.c:299 help.c:312 help.c:321 help.c:327
msgid "\n"
msgstr "\n"

#: help.c:183
msgid "Help\n"
msgstr "說明\n"

#: help.c:185
msgid "  \\? [commands]          show help on backslash commands\n"
msgstr "  \\? [commands]          顯示反斜線命令的說明\n"

#: help.c:186
msgid "  \\? options             show help on psql command-line options\n"
msgstr "  \\? options             顯示 psql 命令列選項的說明\n"

#: help.c:187
msgid "  \\? variables           show help on special variables\n"
msgstr "  \\? variables           顯示特殊變數的說明\n"

# help.c:182
#: help.c:188
msgid "  \\h [NAME]              help on syntax of SQL commands, * for all commands\n"
msgstr "  \\h [NAME]              顯示 SQL 命令語法的說明，用 * 代表所有命令\n"

# help.c:192
#: help.c:191
msgid "Query Buffer\n"
msgstr "查詢緩衝區\n"

# help.c:193
#: help.c:192
msgid "  \\e [FILE] [LINE]       edit the query buffer (or file) with external editor\n"
msgstr "  \\e [FILE] [LINE]       使用外部編輯器編輯查詢緩衝區(或檔案)\n"

# help.c:193
#: help.c:193
msgid "  \\ef [FUNCNAME [LINE]]  edit function definition with external editor\n"
msgstr "  \\ef [FUNCNAME [LINE]]  使用外部編輯器編輯函式定義\n"

# help.c:193
#: help.c:194
msgid "  \\ev [VIEWNAME [LINE]]  edit view definition with external editor\n"
msgstr "  \\ev [VIEWNAME [LINE]]  使用外部編輯器編輯檢視表定義\n"

# help.c:195
#: help.c:195
msgid "  \\p                     show the contents of the query buffer\n"
msgstr "  \\p                     顯示查詢緩衝區的內容\n"

# help.c:196
#: help.c:196
msgid "  \\r                     reset (clear) the query buffer\n"
msgstr "  \\r                     重設(清空)查詢緩衝區\n"

# help.c:198
#: help.c:198
msgid "  \\s [FILE]              display history or save it to file\n"
msgstr "  \\s [FILE]              顯示歷史記錄或存入檔案\n"

# help.c:200
#: help.c:200
msgid "  \\w FILE                write query buffer to file\n"
msgstr "  \\w FILE                將查詢緩衝區寫入檔案\n"

# help.c:203
#: help.c:203
msgid "Input/Output\n"
msgstr "輸入/輸出\n"

# help.c:251
#: help.c:204
msgid "  \\copy ...              perform SQL COPY with data stream to the client host\n"
msgstr "  \\copy ...              用 SQL 的 COPY 並將資料流傳送至客戶端主機\n"

# help.c:204
#: help.c:205
msgid "  \\echo [-n] [STRING]    write string to standard output (-n for no newline)\n"
