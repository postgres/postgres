#: ../../../src/common/logging.c:276
#, c-format
msgid "error: "
msgstr "错误: "

#: ../../../src/common/logging.c:283
#, c-format
msgid "warning: "
msgstr "警告: "

#: ../../../src/common/logging.c:294
#, c-format
msgid "detail: "
msgstr "详情: "

#: ../../../src/common/logging.c:301
#, c-format
msgid "hint: "
msgstr "提示: "

#: pg_waldump.c:160
#, c-format
msgid "could not open file \"%s\": %m"
msgstr "无法打开文件 \"%s\": %m"

#: pg_waldump.c:216
#, c-format
msgid ""
"WAL segment size must be a power of two between 1 MB and 1 GB, but the WAL "
"file \"%s\" header specifies %d byte"
msgid_plural ""
"WAL segment size must be a power of two between 1 MB and 1 GB, but the WAL "
"file \"%s\" header specifies %d bytes"
msgstr[0] ""
"WAL 段大小必须是 1 MB 到 1 GB 之间的二的幂，但 WAL 文件 \"%s\" 的头部指定了 "
"%d 字节"

#: pg_waldump.c:222
#, c-format
msgid "could not read file \"%s\": %m"
msgstr "无法读取文件 \"%s\": %m"

#: pg_waldump.c:225
#, c-format
msgid "could not read file \"%s\": read %d of %d"
msgstr "无法读取文件 \"%1$s\": 应读取 %3$d，实际读取 %2$d"

#: pg_waldump.c:286
#, c-format
msgid "could not locate WAL file \"%s\""
msgstr "无法找到 WAL 文件 \"%s\""

#: pg_waldump.c:288
#, c-format
msgid "could not find any WAL file"
msgstr "无法找到任何 WAL 文件"

#: pg_waldump.c:329
#, c-format
msgid "could not find file \"%s\": %m"
msgstr "无法找到文件 \"%s\": %m"

#: pg_waldump.c:378
#, c-format
msgid "could not read from file %s, offset %d: %m"
msgstr "无法从文件 %s 的偏移量 %d 处读取: %m"

#: pg_waldump.c:382
#, c-format
msgid "could not read from file %s, offset %d: read %d of %d"
msgstr "无法读取文件 %1$s 的偏移量 %2$d 处的数据: 应读取 %4$d，实际读取 %3$d"

#: pg_waldump.c:658
#, c-format
msgid ""
"%s decodes and displays PostgreSQL write-ahead logs for debugging.\n"
"\n"
msgstr ""
"%s 解码并显示 PostgreSQL 预写日志，用于调试。\n"
"\n"

#: pg_waldump.c:660
#, c-format
msgid "Usage:\n"
msgstr "用法:\n"

#: pg_waldump.c:661
#, c-format
msgid "  %s [OPTION]... [STARTSEG [ENDSEG]]\n"
msgstr "  %s [选项]... [起始段 [结束段]]\n"

#: pg_waldump.c:662
#, c-format
msgid ""
"\n"
"Options:\n"
msgstr ""
"\n"
"选项:\n"

#: pg_waldump.c:663
#, c-format
msgid ""
"  -b, --bkp-details      output detailed information about backup blocks\n"
msgstr "  -b, --bkp-details      输出有关备份块的详情\n"

#: pg_waldump.c:664
#, c-format
msgid ""
"  -B, --block=N          with --relation, only show records that modify "
"block N\n"
msgstr "  -B, --block=N          配合 --relation，仅显示修改块 N 的记录\n"

#: pg_waldump.c:665
#, c-format
msgid "  -e, --end=RECPTR       stop reading at WAL location RECPTR\n"
msgstr "  -e, --end=RECPTR       在 WAL 位置 RECPTR 停止读取\n"

#: pg_waldump.c:666
#, c-format
msgid "  -f, --follow           keep retrying after reaching end of WAL\n"
msgstr "  -f, --follow           在到达可用 WAL 的末尾之后，继续重试\n"

#: pg_waldump.c:667
#, c-format
msgid ""
"  -F, --fork=FORK        only show records that modify blocks in fork FORK;\n"
"                         valid names are main, fsm, vm, init\n"
msgstr ""
"  -F, --fork=FORK        仅显示修改文件分支 FORK 中块的记录；\n"
"                         有效名称为 main, fsm, vm, init\n"

#: pg_waldump.c:669
#, c-format
msgid "  -n, --limit=N          number of records to display\n"
msgstr "  -n, --limit=N          要显示的记录数\n"

#: pg_waldump.c:670
#, c-format
msgid ""
"  -p, --path=PATH        directory in which to find log segment files or a\n"
"                         directory with a ./pg_wal that contains such files\n"
"                         (default: current directory, ./pg_wal, $PGDATA/"
"pg_wal)\n"
msgstr ""
"  -p, --path=PATH        用于查找日志段文件的目录，或者\n"
"                         包含 ./pg_wal 子目录且该子目录含有这些文件的目录\n"
"                         （默认: 当前目录, ./pg_wal, $PGDATA/pg_wal）\n"

#: pg_waldump.c:673
#, c-format
msgid "  -q, --quiet            do not print any output, except for errors\n"
msgstr "  -q, --quiet            不打印任何输出，错误除外\n"

#: pg_waldump.c:674
#, c-format
msgid ""
"  -r, --rmgr=RMGR        only show records generated by resource manager "
"RMGR;\n"
"                         use --rmgr=list to list valid resource manager "
"names\n"
msgstr ""
"  -r, --rmgr=RMGR        仅显示由 RMGR 资源管理器生成的记录；\n"
"                         使用 --rmgr=list 列出有效的资源管理器名称\n"

#: pg_waldump.c:676
#, c-format
msgid ""
"  -R, --relation=T/D/R   only show records that modify blocks in relation T/"
"D/R\n"
msgstr "  -R, --relation=T/D/R   仅显示修改关系 T/D/R 中块的记录\n"

#: pg_waldump.c:677
#, c-format
msgid "  -s, --start=RECPTR     start reading at WAL location RECPTR\n"
msgstr "  -s, --start=RECPTR     从 WAL 位置 RECPTR 开始读取\n"

#: pg_waldump.c:678
#, c-format
msgid ""
"  -t, --timeline=TLI     timeline from which to read log records\n"
"                         (default: 1 or the value used in STARTSEG)\n"
msgstr ""
"  -t, --timeline=TLI     要读取日志记录的时间线\n"
"                         （默认: 1 或 STARTSEG 中使用的值）\n"

#: pg_waldump.c:680
#, c-format
msgid "  -V, --version          output version information, then exit\n"
msgstr "  -V, --version          输出版本信息，然后退出\n"

#: pg_waldump.c:681
#, c-format
msgid "  -w, --fullpage         only show records with a full page write\n"
msgstr "  -w, --fullpage         仅显示包含整页写入的记录\n"

#: pg_waldump.c:682
#, c-format
msgid "  -x, --xid=XID          only show records with transaction ID XID\n"
msgstr "  -x, --xid=XID          仅显示事务 ID 为 XID 的记录\n"

#: pg_waldump.c:683
#, c-format
msgid ""
"  -z, --stats[=record]   show statistics instead of records\n"
"                         (optionally, show per-record statistics)\n"
msgstr ""
"  -z, --stats[=record]   显示统计信息而不是记录\n"
"                         （可选: 按记录类型显示统计信息）\n"

#: pg_waldump.c:685
#, c-format
msgid "  -?, --help             show this help, then exit\n"
msgstr "  -?, --help             显示此帮助，然后退出\n"

#: pg_waldump.c:686
#, c-format
msgid ""
"\n"
"Report bugs to <%s>.\n"
msgstr ""
"\n"
"请向 <%s> 报告缺陷。\n"

#: pg_waldump.c:687
#, c-format
msgid "%s home page: <%s>\n"
msgstr "%s 主页: <%s>\n"

#: pg_waldump.c:781
#, c-format
msgid "no arguments specified"
msgstr "未指定参数"

#: pg_waldump.c:797
#, c-format
msgid "invalid block number: \"%s\""
msgstr "无效的块号: \"%s\""

#: pg_waldump.c:806 pg_waldump.c:904
#, c-format
msgid "invalid WAL location: \"%s\""
msgstr "无效的 WAL 位置: \"%s\""

#: pg_waldump.c:819
#, c-format
msgid "invalid fork name: \"%s\""
msgstr "无效的文件分支名称: \"%s\""

#: pg_waldump.c:827
#, c-format
msgid "invalid value \"%s\" for option %s"
msgstr "选项 %2$s 的值 \"%1$s\" 无效"

#: pg_waldump.c:858
#, c-format
msgid "custom resource manager \"%s\" does not exist"
msgstr "自定义资源管理器 \"%s\" 不存在"

#: pg_waldump.c:879
#, c-format
msgid "resource manager \"%s\" does not exist"
msgstr "资源管理器 \"%s\" 不存在"

#: pg_waldump.c:894
#, c-format
msgid "invalid relation specification: \"%s\""
msgstr "无效的关系标识: \"%s\""

#: pg_waldump.c:895
#, c-format
msgid "Expecting \"tablespace OID/database OID/relation filenode\"."
msgstr "预期为 \"表空间 OID/数据库 OID/关系文件节点\"。"

#: pg_waldump.c:914
#, c-format
msgid "invalid timeline specification: \"%s\""
msgstr "无效的时间线指定: \"%s\""

#: pg_waldump.c:924
#, c-format
msgid "invalid transaction ID specification: \"%s\""
msgstr "无效的事务 ID: \"%s\""

#: pg_waldump.c:939
#, c-format
msgid "unrecognized value for option %s: %s"
msgstr "选项 %s 的值无法识别: %s"

#: pg_waldump.c:953
#, c-format
msgid "option %s requires option %s to be specified"
msgstr "选项 %s 需要同时指定选项 %s"

#: pg_waldump.c:960
#, c-format
msgid "too many command-line arguments (first is \"%s\")"
msgstr "命令行参数过多（第一个多余参数是 \"%s\"）"

#: pg_waldump.c:970 pg_waldump.c:990
#, c-format
msgid "could not open directory \"%s\": %m"
msgstr "无法打开目录 \"%s\": %m"

#: pg_waldump.c:996 pg_waldump.c:1026
#, c-format
msgid "could not open file \"%s\""
msgstr "无法打开文件 \"%s\""

#: pg_waldump.c:1006
#, c-format
msgid "start WAL location %X/%X is not inside file \"%s\""
msgstr "WAL 起始位置 %X/%X 不在文件 \"%s\" 中"

#: pg_waldump.c:1033
#, c-format
msgid "ENDSEG %s is before STARTSEG %s"
msgstr "ENDSEG %s 在 STARTSEG %s 之前"

#: pg_waldump.c:1048
#, c-format
msgid "end WAL location %X/%X is not inside file \"%s\""
msgstr "WAL 结束位置 %X/%X 不在文件 \"%s\" 中"

#: pg_waldump.c:1060
#, c-format
msgid "no start WAL location given"
msgstr "未给出 WAL 起始位置"

#: pg_waldump.c:1074
#, c-format
msgid "out of memory while allocating a WAL reading processor"
msgstr "分配 WAL 读取器时内存不足"

#: pg_waldump.c:1080
#, c-format
msgid "could not find a valid record after %X/%X"
msgstr "无法在 %X/%X 之后找到有效记录"

#: pg_waldump.c:1090
#, c-format
msgid "first record is after %X/%X, at %X/%X, skipping over %u byte\n"
msgid_plural "first record is after %X/%X, at %X/%X, skipping over %u bytes\n"
msgstr[0] "第一条记录在 %X/%X 之后，位于 %X/%X，正在跳过 %u 字节\n"

#: pg_waldump.c:1171
#, c-format
msgid "error in WAL record at %X/%X: %s"
msgstr "%X/%X 处的 WAL 记录存在错误: %s"

#: pg_waldump.c:1180
#, c-format
msgid "Try \"%s --help\" for more information."
msgstr "运行 \"%s --help\" 获取更多信息。"

#: xlogreader.c:620
#, c-format
msgid "invalid record offset at %X/%X"
msgstr "%X/%X 处的记录偏移量无效"

#: xlogreader.c:628
#, c-format
msgid "contrecord is requested by %X/%X"
msgstr "请求的 %X/%X 处是续接记录"

#: xlogreader.c:669 xlogreader.c:1144
#, c-format
msgid "invalid record length at %X/%X: wanted %u, got %u"
msgstr "%X/%X 处的记录长度无效: 应为 %u，实际为 %u"

#: xlogreader.c:759
#, c-format
msgid "there is no contrecord flag at %X/%X"
msgstr "%X/%X 处没有续接记录标志"

#: xlogreader.c:772
#, c-format
msgid "invalid contrecord length %u (expected %lld) at %X/%X"
msgstr "%3$X/%4$X 处的续接记录长度 %1$u 无效（预期为 %2$lld）"

#: xlogreader.c:1152
#, c-format
msgid "invalid resource manager ID %u at %X/%X"
msgstr "%2$X/%3$X 处的资源管理器 ID %1$u 无效"

#: xlogreader.c:1165 xlogreader.c:1181
#, c-format
msgid "record with incorrect prev-link %X/%X at %X/%X"
msgstr "%3$X/%4$X 处的记录具有不正确的前一记录链接 %1$X/%2$X"

#: xlogreader.c:1219
#, c-format
msgid "incorrect resource manager data checksum in record at %X/%X"
msgstr "%X/%X 处记录的资源管理器数据校验和不正确"

#: xlogreader.c:1256
#, c-format
msgid "invalid magic number %04X in log segment %s, offset %u"
msgstr "日志段 %2$s 中的魔数 %1$04X 无效, 偏移量 %3$u"

#: xlogreader.c:1270 xlogreader.c:1311
#, c-format
msgid "invalid info bits %04X in log segment %s, offset %u"
msgstr "日志段 %2$s 中的信息位 %1$04X 无效, 偏移量 %3$u"

#: xlogreader.c:1285
#, c-format
msgid ""
"WAL file is from different database system: WAL file database system "
"identifier is %llu, pg_control database system identifier is %llu"
msgstr ""
"WAL 文件来自不同的数据库系统: WAL 文件中的数据库系统标识符为 %llu，"
"pg_control 中的数据库系统标识符为 %llu"

#: xlogreader.c:1293
#, c-format
msgid ""
"WAL file is from different database system: incorrect segment size in page "
"header"
msgstr "WAL 文件来自不同的数据库系统: 页头部中有不正确的段大小"

#: xlogreader.c:1299
#, c-format
msgid ""
"WAL file is from different database system: incorrect XLOG_BLCKSZ in page "
"header"
msgstr "WAL 文件来自不同的数据库系统: 页头部中有不正确的 XLOG_BLCKSZ"

#: xlogreader.c:1330
#, c-format
msgid "unexpected pageaddr %X/%X in log segment %s, offset %u"
msgstr "日志段 %3$s 中出现意外的 pageaddr %1$X/%2$X, 偏移量 %4$u"

#: xlogreader.c:1355
#, c-format
msgid "out-of-sequence timeline ID %u (after %u) in log segment %s, offset %u"
msgstr "日志段 %3$s 中的时间线 ID %1$u 顺序错误（前一个为 %2$u）, 偏移量 %4$u"

#: xlogreader.c:1760
#, c-format
msgid "out-of-order block_id %u at %X/%X"
msgstr "%2$X/%3$X 处的 block_id %1$u 顺序错误"

#: xlogreader.c:1784
#, c-format
msgid "BKPBLOCK_HAS_DATA set, but no data included at %X/%X"
msgstr "%X/%X 处已设置 BKPBLOCK_HAS_DATA，但未包含数据"

#: xlogreader.c:1791
#, c-format
msgid "BKPBLOCK_HAS_DATA not set, but data length is %u at %X/%X"
msgstr "未设置 BKPBLOCK_HAS_DATA，但 %2$X/%3$X 处的数据长度为 %1$u"

#: xlogreader.c:1827
#, c-format
msgid ""
"BKPIMAGE_HAS_HOLE set, but hole offset %u length %u block image length %u at "
"%X/%X"
msgstr ""
"已设置 BKPIMAGE_HAS_HOLE，但 %4$X/%5$X 处的空洞偏移量为 %1$u，长度为 %2$u，块"
"镜像长度为 %3$u"

#: xlogreader.c:1843
#, c-format
msgid "BKPIMAGE_HAS_HOLE not set, but hole offset %u length %u at %X/%X"
msgstr ""
"未设置 BKPIMAGE_HAS_HOLE，但 %3$X/%4$X 处的空洞偏移量为 %1$u，长度为 %2$u"

#: xlogreader.c:1857
#, c-format
msgid "BKPIMAGE_COMPRESSED set, but block image length %u at %X/%X"
msgstr "已设置 BKPIMAGE_COMPRESSED，但 %2$X/%3$X 处的块镜像长度为 %1$u"

#: xlogreader.c:1872
#, c-format
msgid ""
"neither BKPIMAGE_HAS_HOLE nor BKPIMAGE_COMPRESSED set, but block image "
"length is %u at %X/%X"
msgstr ""
"既未设置 BKPIMAGE_HAS_HOLE，也未设置 BKPIMAGE_COMPRESSED，但 %2$X/%3$X 处的块"
"镜像长度为 %1$u"

#: xlogreader.c:1888
#, c-format
msgid "BKPBLOCK_SAME_REL set but no previous rel at %X/%X"
msgstr "%X/%X 处已设置 BKPBLOCK_SAME_REL，但没有先前的关系"

#: xlogreader.c:1900
#, c-format
msgid "invalid block_id %u at %X/%X"
msgstr "%2$X/%3$X 处的 block_id %1$u 无效"

#: xlogreader.c:1967
#, c-format
msgid "record with invalid length at %X/%X"
msgstr "%X/%X 处的记录长度无效"

#: xlogreader.c:1992
#, c-format
msgid "could not locate backup block with ID %d in WAL record"
msgstr "无法在 WAL 记录中找到 ID 为 %d 的备份块"

#: xlogreader.c:2076
#, c-format
msgid "could not restore image at %X/%X with invalid block %d specified"
msgstr "无法恢复 %X/%X 处的镜像，因为指定的块 %d 无效"

#: xlogreader.c:2083
#, c-format
msgid "could not restore image at %X/%X with invalid state, block %d"
msgstr "无法恢复 %X/%X 处的镜像，状态无效, 块 %d"

#: xlogreader.c:2110 xlogreader.c:2127
#, c-format
msgid ""
"could not restore image at %X/%X compressed with %s not supported by build, "
"block %d"
msgstr "无法恢复 %X/%X 处使用 %s 压缩的镜像，此构建版本不支持该压缩方式, 块 %d"

#: xlogreader.c:2136
#, c-format
msgid ""
"could not restore image at %X/%X compressed with unknown method, block %d"
msgstr "无法恢复 %X/%X 处使用未知方法压缩的镜像, 块 %d"

#: xlogreader.c:2144
#, c-format
msgid "could not decompress image at %X/%X, block %d"
msgstr "无法解压缩 %X/%X 处的镜像, 块 %d"

#, c-format
#~ msgid "Try \"%s --help\" for more information.\n"
#~ msgstr "请用 \"%s --help\" 获取更多的信息.\n"

#, c-format
#~ msgid "could not parse \"%s\" as a transaction ID"
#~ msgstr "无法将\"%s\"解析为事务ID"

#, c-format
#~ msgid "could not parse end WAL location \"%s\""
#~ msgstr "无法解析WAL结束位置\"%s\""

#, c-format
#~ msgid "could not parse limit \"%s\""
#~ msgstr "无法解析限制\"%s\""

#, c-format
#~ msgid "could not parse start WAL location \"%s\""
#~ msgstr "无法解析WAL起始位置\"%s\""

#, c-format
#~ msgid "could not parse timeline \"%s\""
#~ msgstr "无法解析时间线\"%s\""

#, c-format
#~ msgid "could not read file \"%s\": read %d of %zu"
#~ msgstr "无法读取文件\"%1$s\"：读取了%3$zu中的%2$d"

#, c-format
#~ msgid "fatal: "
#~ msgstr "致命的: "

#, c-format
#~ msgid "out of memory"
#~ msgstr "内存不足"

#, c-format
#~ msgid "unrecognized argument to --stats: %s"
#~ msgstr "无法识别的参数--stats: %s"
