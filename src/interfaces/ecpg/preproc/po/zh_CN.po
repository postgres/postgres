#, c-format
msgid "pointer to pointer is not supported for this data type"
msgstr "此数据类型不支持指向指针的指针"

#: variable.c:646
#, c-format
msgid "multidimensional arrays for structures are not supported"
msgstr "不支持结构体的多维数组"

