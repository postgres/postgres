#: check.c:2787
#, c-format
msgid "oldestMultiXid (%u) in control file is newer than the datminmxid (%u) of database \"%s\""
msgstr "控制檔案中的 oldestMultiXid (%1$u) 晚於資料庫 \"%3$s\" 的 datminmxid (%2$u)"

