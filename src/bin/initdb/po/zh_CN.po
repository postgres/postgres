#: initdb.c:815
#, c-format
msgid "cannot be run as root"
msgstr "不能以 root 身份运行"

#: initdb.c:816
#, c-format
msgid ""
"Please log in (using, e.g., \"su\") as the (unprivileged) user that will own "
"the server process."
msgstr "请以将拥有服务器进程的非特权用户身份登录（例如使用 \"su\"）。"

#: initdb.c:848
#, c-format
msgid "\"%s\" is not a valid server encoding name"
msgstr "\"%s\" 不是有效的服务器编码名称"

#: initdb.c:992
#, c-format
msgid "file \"%s\" does not exist"
msgstr "文件 \"%s\" 不存在"

#: initdb.c:993 initdb.c:998 initdb.c:1005
#, c-format
msgid ""
"This might mean you have a corrupted installation or identified the wrong "
"directory with the invocation option -L."
msgstr "这可能表示安装已损坏，或调用时通过 -L 选项指定了错误的目录。"

