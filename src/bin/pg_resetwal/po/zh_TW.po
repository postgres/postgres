#: pg_resetwal.c:1220
#, c-format
msgid ""
"%s resets the PostgreSQL write-ahead log.\n"
"\n"
msgstr "%s 重設 PostgreSQL 的預寫式日誌。\n\n"

#: pg_resetwal.c:1221
#, c-format
msgid "Usage:\n"
msgstr "用法:\n"

#: pg_resetwal.c:1222
#, c-format
msgid "  %s [OPTION]... DATADIR\n"
msgstr "  %s [選項]... 資料目錄\n"

#: pg_resetwal.c:1224
#, c-format
msgid ""
"\n"
"Options:\n"
msgstr ""
"\n"
"選項:\n"

# postmaster/postmaster.c:1024 tcop/postgres.c:2122
#: pg_resetwal.c:1225
#, c-format
msgid " [-D, --pgdata=]DATADIR  data directory\n"
msgstr " [-D, --pgdata=]DATADIR  資料目錄\n"

#: pg_resetwal.c:1226
#, c-format
msgid ""
"  -f, --force            force update to be done even after unclean shutdown or\n"
"                         if pg_control values had to be guessed\n"
msgstr "  -f, --force            即使上次未正常停止，或必須推測 pg_control 中的值，\n                         也強制執行更新\n"

#: pg_resetwal.c:1228
#, c-format
msgid "  -n, --dry-run          no update, just show what would be done\n"
msgstr "  -n, --dry-run          不更新，只顯示將執行的操作\n"

#: pg_resetwal.c:1229
#, c-format
msgid "  -V, --version          output version information, then exit\n"
msgstr "  -V, --version          顯示版本，然後結束\n"

#: pg_resetwal.c:1230
#, c-format
msgid "  -?, --help             show this help, then exit\n"
msgstr "  -?, --help             顯示說明，然後結束\n"

#: pg_resetwal.c:1232
#, c-format
msgid ""
"\n"
"Options to override control file values:\n"
msgstr "\n覆寫控制檔中各值的選項:\n"

#: pg_resetwal.c:1233
#, c-format
msgid ""
"  -c, --commit-timestamp-ids=XID,XID\n"
"                                   set oldest and newest transactions bearing\n"
"                                   commit timestamp (zero means no change)\n"
msgstr "  -c, --commit-timestamp-ids=XID,XID\n                                   設定具有提交時間戳記的最舊和最新交易\n                                   (零表示不修改)\n"

#: pg_resetwal.c:1236
#, c-format
msgid "  -e, --epoch=XIDEPOCH             set next transaction ID epoch\n"
msgstr "  -e, --epoch=XIDEPOCH             設定下一個交易 ID 的紀元\n"

#: pg_resetwal.c:1237
#, c-format
msgid "  -l, --next-wal-file=WALFILE      set minimum starting location for new WAL\n"
msgstr "  -l, --next-wal-file=WALFILE      設定新 WAL 的最小起始位置\n"

#: pg_resetwal.c:1238
#, c-format
msgid "  -m, --multixact-ids=MXID,MXID    set next and oldest multitransaction ID\n"
msgstr "  -m, --multixact-ids=MXID,MXID    設定下一個和最舊的多重交易 ID\n"

#: pg_resetwal.c:1239
#, c-format
msgid "  -o, --next-oid=OID               set next OID\n"
msgstr "  -o, --next-oid=OID               設定下一個 OID\n"

#: pg_resetwal.c:1240
#, c-format
msgid "  -O, --multixact-offset=OFFSET    set next multitransaction offset\n"
msgstr "  -O, --multixact-offset=OFFSET    設定下一個多重交易位移\n"

#: pg_resetwal.c:1241
#, c-format
msgid "  -u, --oldest-transaction-id=XID  set oldest transaction ID\n"
msgstr "  -u, --oldest-transaction-id=XID  設定最舊的交易 ID\n"

#: pg_resetwal.c:1242
#, c-format
msgid "  -x, --next-transaction-id=XID    set next transaction ID\n"
msgstr "  -x, --next-transaction-id=XID    設定下一個交易 ID\n"

#: pg_resetwal.c:1243
#, c-format
msgid "      --char-signedness=OPTION     set char signedness to \"signed\" or \"unsigned\"\n"
msgstr "      --char-signedness=OPTION     將 char 的符號屬性設為 \"signed\" 或 \"unsigned\"\n"

#: pg_resetwal.c:1244
#, c-format
msgid "      --wal-segsize=SIZE           size of WAL segments, in megabytes\n"
msgstr "      --wal-segsize=SIZE           WAL 片段的大小，單位是 MB\n"

#: pg_resetwal.c:1246
#, c-format
msgid ""
"\n"
"Report bugs to <%s>.\n"
msgstr ""
"\n"
"回報錯誤至 <%s>。\n"

