msgstr "пропущено \"%s\" в кінці оператора SQL"

#: pl_gram.y:2843
msgid "missing expression"
msgstr "пропущено вираз"

#: pl_gram.y:2845
msgid "missing SQL statement"
msgstr "пропущений оператор SQL"

