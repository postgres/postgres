#: ../../common/fe_memutils.c:41 ../../common/fe_memutils.c:81
#: ../../common/fe_memutils.c:104 ../../common/fe_memutils.c:167
#, c-format
msgid "out of memory\n"
msgstr "недостатньо пам'яті\n"

#: ../../common/fe_memutils.c:98 ../../common/fe_memutils.c:159
#, c-format
msgid "cannot duplicate null pointer (internal error)\n"
msgstr "неможливо дублювати нульовий покажчик (внутрішня помилка)\n"

#: ../../common/fe_memutils.c:209
#, c-format
msgid "invalid memory allocation request size %zu + %zu\n"
msgstr "неправильний розмір запиту на виділення пам'яті %zu + %zu\n"

#: ../../common/fe_memutils.c:228
#, c-format
msgid "invalid memory allocation request size %zu * %zu\n"
msgstr "неправильний розмір запиту на виділення пам'яті %zu * %zu\n"

#: pg_test_timing.c:79
#, c-format
msgid "Usage: %s [-c CUTOFF] [-d DURATION]\n"
msgstr "Використання: %s [-c ПОРІГ] [-d ТРИВАЛІСТЬ]\n"

#: pg_test_timing.c:100 pg_test_timing.c:121
#, c-format
msgid "%s: invalid argument for option %s\n"
msgstr "%s: неприпустимий аргумент для параметру %s\n"

#: pg_test_timing.c:102 pg_test_timing.c:123 pg_test_timing.c:137
#: pg_test_timing.c:149
#, c-format
msgid "Try \"%s --help\" for more information.\n"
msgstr "Спробуйте \"%s --help\" для додаткової інформації.\n"

#: pg_test_timing.c:108 pg_test_timing.c:130
#, c-format
msgid "%s: %s must be in range %u..%u\n"
msgstr "%s: %s має бути в діапазоні %u..%u\n"

#: pg_test_timing.c:147
#, c-format
msgid "%s: too many command-line arguments (first is \"%s\")\n"
msgstr "%s: забагато аргументів у командному рядку (перший \"%s\")\n"

#: pg_test_timing.c:154
#, c-format
msgid "Testing timing overhead for %u second.\n\n"
msgid_plural "Testing timing overhead for %u seconds.\n\n"
msgstr[0] "Тестування накладних витрат часу на %u секунду.\n\n"
msgstr[1] "Тестування накладних витрат часу на %u секунди.\n\n"
msgstr[2] "Тестування накладних витрат часу на %u секунд.\n\n"
msgstr[3] "Тестування накладних витрат часу на %u секунд.\n\n"

#: pg_test_timing.c:209
#, c-format
msgid "TSC frequency source: %s\n"
msgstr "Джерело частоти TSC: %s\n"

#: pg_test_timing.c:210
#, c-format
msgid "TSC frequency in use: %d kHz\n"
msgstr "Використовувана частота TSC: %d кГц\n"

#: pg_test_timing.c:216
#, c-format
msgid "TSC frequency from calibration: %d kHz\n"
msgstr "Частота TSC за калібруванням: %d кГц\n"

#: pg_test_timing.c:223
#, c-format
msgid "WARNING: Calibrated TSC frequency differs by %.1f%% from the TSC frequency in use\n"
msgstr "ПОПЕРЕДЖЕННЯ: Відкалібрована частота TSC відрізняється на %.1f%% від використовуваної частоти TSC\n"

#: pg_test_timing.c:225
#, c-format
msgid "HINT: Consider setting timing_clock_source to 'system'. Report bugs to <%s>.\n"
msgstr "ПІДКАЗКА: Спробуйте встановити timing_clock_source у 'system'. Повідомляти про помилки на <%s>.\n"

#: pg_test_timing.c:230
#, c-format
msgid "TSC calibration did not converge\n"
msgstr "Калібрування TSC не збіглося\n"

#: pg_test_timing.c:240
#, c-format
msgid "\n"
"TSC clock source will be used by default, unless timing_clock_source is set to 'system'.\n"
msgstr "\n"
"Джерело часу TSC буде використовуватися за замовчуванням, якщо timing_clock_source не встановлено у 'system'.\n"

#: pg_test_timing.c:242
#, c-format
msgid "\n"
"TSC clock source will not be used by default, unless timing_clock_source is set to 'tsc'.\n"
msgstr "\n"
"Джерело часу TSC не буде використовуватися за замовчуванням, якщо timing_clock_source не встановлено у 'tsc'.\n"

#: pg_test_timing.c:245
#, c-format
msgid "\n"
"TSC clock source is not usable. Likely unable to determine TSC frequency. Are you running in an unsupported virtualized environment?\n"
msgstr "\n"
"Джерело часу TSC непридатне. Ймовірно, не вдалося визначити частоту TSC. Можливо, ви працюєте в непідтримуваному віртуалізованому середовищі?\n"

#: pg_test_timing.c:270
#, c-format
msgid "Fast clock source: %s\n"
msgstr "Швидке джерело часу: %s\n"

#: pg_test_timing.c:272
#, c-format
msgid "System clock source: %s\n"
msgstr "Системне джерело часу: %s\n"

#: pg_test_timing.c:274
#, c-format
msgid "Clock source: %s\n"
msgstr "Джерело часу: %s\n"

#: pg_test_timing.c:312
#, c-format
msgid "Detected clock going backwards in time.\n"
msgstr "Годинник іде в зворотньому напряму у минуле.\n"

#: pg_test_timing.c:313
#, c-format
msgid "Time warp: %<PRId64> ns\n"
msgstr "Зсув часу: %<PRId64> нс\n"

#: pg_test_timing.c:351
#, c-format
msgid "Average loop time including overhead: %0.2f ns\n"
msgstr "Середній час циклу, у тому числі накладні витрати: %0.2f нс\n"

#: pg_test_timing.c:361
msgid "<= ns"
msgstr "<= нс"

#: pg_test_timing.c:362
msgid "ns"
msgstr "нс"

#: pg_test_timing.c:363
#, no-c-format
msgid "% of total"
msgstr "% від загалу"

#: pg_test_timing.c:364
#, no-c-format
msgid "running %"
msgstr "сукупний %"

#: pg_test_timing.c:365
msgid "count"
msgstr "кількість"

#: pg_test_timing.c:375
#, c-format
msgid "WARNING: No timing measurements collected. Report this as a bug to <%s>.\n"
msgstr "ПОПЕРЕДЖЕННЯ: Не зібрано жодних замірів часу. Повідомте про це як про помилку на <%s>.\n"

#: pg_test_timing.c:389
#, c-format
msgid "Histogram of timing durations:\n"
msgstr "Гістограмма тривалості замірів часу:\n"

#: pg_test_timing.c:409
#, c-format
msgid "\n"
"Observed timing durations up to %.4f%%:\n"
msgstr "\n"
"Спостережувані тривалості замірів часу до %.4f%%:\n"

