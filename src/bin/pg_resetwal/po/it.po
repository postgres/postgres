"  -f, --force            forza l'aggiornamento anche dopo un arresto non pulito "
"oppure\n"
"                         se i valori di pg_control hanno dovuto essere stimati\n"

#: pg_resetwal.c:1228
#, c-format
msgid "  -n, --dry-run          no update, just show what would be done\n"
msgstr ""
"  -n, --dry-run          nessun aggiornamento, mostra solo cosa verrebbe fatto\n"

#: pg_resetwal.c:1229
#, c-format
msgid "  -V, --version          output version information, then exit\n"
msgstr "  -V, --version          mostra le informazioni sulla versione, poi esci\n"

#: pg_resetwal.c:1230
#, c-format
msgid "  -?, --help             show this help, then exit\n"
msgstr "  -?, --help             mostra questo aiuto, poi esci\n"

#: pg_resetwal.c:1232
#, c-format
msgid ""
"\n"
"Options to override control file values:\n"
msgstr ""
"\n"
"Opzioni per sovrascrivere i valori del file di controllo:\n"

#: pg_resetwal.c:1233
#, c-format
msgid ""
"  -c, --commit-timestamp-ids=XID,XID\n"
"                                   set oldest and newest transactions bearing\n"
"                                   commit timestamp (zero means no change)\n"
msgstr ""
"  -c, --commit-timestamp-ids=XID,XID\n"
"                                   imposta la transazione più vecchia e più "
"recente\n"
"                                   che riportano un timestamp di commit (zero "
"significa\n"
"                                   nessuna modifica)\n"

#: pg_resetwal.c:1236
#, c-format
msgid "  -e, --epoch=XIDEPOCH             set next transaction ID epoch\n"
msgstr ""
"  -e, --epoch=XIDEPOCH             imposta l'epoca del prossimo ID di "
"transazione\n"

#: pg_resetwal.c:1237
#, c-format
msgid ""
"  -l, --next-wal-file=WALFILE      set minimum starting location for new WAL\n"
msgstr ""
"  -l, --next-wal-file=FILEWAL      imposta la posizione minima di partenza per il "
"nuovo WAL\n"

#: pg_resetwal.c:1238
#, c-format
msgid "  -m, --multixact-ids=MXID,MXID    set next and oldest multitransaction ID\n"
msgstr ""
"  -m, --multixact-ids=MXID,MXID    imposta l'ID di multitransazione successivo e "
"più vecchio\n"

#: pg_resetwal.c:1239
#, c-format
msgid "  -o, --next-oid=OID               set next OID\n"
msgstr "  -o, --next-oid=OID               imposta il prossimo OID\n"

#: pg_resetwal.c:1240
#, c-format
msgid "  -O, --multixact-offset=OFFSET    set next multitransaction offset\n"
msgstr ""
"  -O, --multixact-offset=OFFSET    imposta l'offset di multitransazione "
"successivo\n"

#: pg_resetwal.c:1241
#, c-format
msgid "  -u, --oldest-transaction-id=XID  set oldest transaction ID\n"
msgstr ""
"  -u, --oldest-transaction-id=XID  imposta l'ID di transazione più vecchia\n"

#: pg_resetwal.c:1242
#, c-format
msgid "  -x, --next-transaction-id=XID    set next transaction ID\n"
msgstr "  -x, --next-transaction-id=XID    imposta il prossimo ID di transazione\n"

#: pg_resetwal.c:1243
#, c-format
msgid ""
"      --char-signedness=OPTION     set char signedness to \"signed\" or "
"\"unsigned\"\n"
msgstr ""
"      --char-signedness=OPZIONE     imposta il segno dei char a \"signed\" oppure "
"\"unsigned\"\n"

#: pg_resetwal.c:1244
#, c-format
msgid "      --wal-segsize=SIZE           size of WAL segments, in megabytes\n"
msgstr ""
"      --wal-segsize=DIMENSIONE      dimensione dei segmenti WAL, in megabyte\n"

#: pg_resetwal.c:1246
#, c-format
msgid ""
"\n"
"Report bugs to <%s>.\n"
msgstr ""
"\n"
"Segnala i bug a <%s>.\n"

