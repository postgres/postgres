#, c-format
msgid "could not generate nonce"
msgstr "non è stato possibile generare il nonce"

#: fe-auth-scram.c:381
#, c-format
msgid "could not encode nonce"
msgstr "non è stato possibile codificare il nonce"

#: fe-auth-scram.c:569
#, c-format
msgid "could not calculate client proof: %s"
msgstr "non è stato possibile calcolare la prova del client: %s"

#: fe-auth-scram.c:584
#, c-format
msgid "could not encode client proof"
msgstr "non è stato possibile codificare la prova del client"

#: fe-auth-scram.c:636
#, c-format
msgid "invalid SCRAM response (nonce mismatch)"
msgstr "risposta SCRAM non valida (mancata corrispondenza del nonce)"

#: fe-auth-scram.c:666
#, c-format
msgid "malformed SCRAM message (invalid salt)"
msgstr "messaggio SCRAM malformato (salt non valido)"

#: fe-auth-scram.c:679
#, c-format
msgid "malformed SCRAM message (invalid iteration count)"
msgstr "messaggio SCRAM malformato (contatore di iterazioni non valido)"

#: fe-auth-scram.c:684
#, c-format
msgid "malformed SCRAM message (garbage at end of server-first-message)"
msgstr "messaggio SCRAM malformato (spazzatura alla fine del server-first-message)"

#: fe-auth-scram.c:718
#, c-format
msgid "error received from server in SCRAM exchange: %s"
msgstr "errore ricevuto dal server nello scambio SCRAM: %s"

#: fe-auth-scram.c:733
#, c-format
msgid "malformed SCRAM message (garbage at end of server-final-message)"
msgstr "messaggio SCRAM malformato (spazzatura alla fine del server-final-message)"

#: fe-auth-scram.c:750
#, c-format
msgid "malformed SCRAM message (invalid server signature)"
msgstr "messaggio SCRAM malformato (firma del server non valida)"

#: fe-auth-scram.c:940
msgid "could not generate random salt"
msgstr "non è stato possibile generare un salt casuale"

#: fe-auth.c:80
#, c-format
msgid "out of memory allocating GSSAPI buffer (%d)"
msgstr "memoria esaurita nell'allocazione del buffer GSSAPI (%d)"

# DV: non ne sono convinto
#: fe-auth.c:146
msgid "GSSAPI continuation error"
msgstr "errore di continuazione GSSAPI"

#: fe-auth.c:176 fe-auth.c:410 fe-gssapi-common.c:97 fe-secure-common.c:99
#: fe-secure-common.c:173
#, c-format
msgid "host name must be specified"
msgstr "il nome dell'host deve essere specificato"

#: fe-auth.c:182
#, c-format
msgid "duplicate GSS authentication request"
msgstr "richiesta di autenticazione GSS duplicata"

#: fe-auth.c:246
#, c-format
msgid "out of memory allocating SSPI buffer (%d)"
msgstr "memoria esaurita nell'allocazione del buffer SSPI (%d)"

#: fe-auth.c:297
msgid "SSPI continuation error"
msgstr "errore di continuazione SSPI"

#: fe-auth.c:372
#, c-format
msgid "duplicate SSPI authentication request"
msgstr "richiesta di autenticazione SSPI duplicata"

#: fe-auth.c:397
msgid "could not acquire SSPI credentials"
msgstr "non è stato possibile acquisire le credenziali SSPI"

#: fe-auth.c:449
#, c-format
msgid "channel binding required, but SSL not in use"
msgstr "channel binding richiesto, ma SSL non in uso"

#: fe-auth.c:455
#, c-format
msgid "duplicate SASL authentication request"
msgstr "richiesta di autenticazione SASL duplicata"

#: fe-auth.c:513
#, c-format
msgid "channel binding is required, but client does not support it"
msgstr "il channel binding è richiesto, ma il client non lo supporta"

#: fe-auth.c:529
#, c-format
msgid "server offered SCRAM-SHA-256-PLUS authentication over a non-SSL connection"
msgstr "il server ha offerto l'autenticazione SCRAM-SHA-256-PLUS su una connessione non SSL"

#: fe-auth.c:551
#, c-format
msgid "none of the server's SASL authentication mechanisms are supported"
msgstr "nessuno dei meccanismi di autenticazione SASL del server è supportato"

#: fe-auth.c:571
#, c-format
msgid "authentication method requirement \"%s\" failed: server requested %s authentication"
msgstr "requisito del metodo di autenticazione \"%s\" fallito: il server ha richiesto l'autenticazione %s"

#: fe-auth.c:580
#, c-format
msgid "channel binding is required, but server did not offer an authentication method that supports channel binding"
msgstr "il channel binding è richiesto, ma il server non ha offerto un metodo di autenticazione che lo supporti"

#: fe-auth.c:716
#, c-format
msgid "out of memory allocating SASL buffer (%d)"
msgstr "memoria esaurita nell'allocazione del buffer SASL (%d)"

#: fe-auth.c:758
#, c-format
msgid "AuthenticationSASLFinal received from server, but SASL authentication was not completed"
msgstr "Ricevuto AuthenticationSASLFinal dal server, ma l'autenticazione SASL non è stata completata"

#: fe-auth.c:768
#, c-format
msgid "no client response found after SASL exchange success"
msgstr "nessuna risposta del client trovata dopo il successo dello scambio SASL"

#: fe-auth.c:836 fe-auth.c:843 fe-auth.c:1476 fe-auth.c:1487
#, c-format
msgid "could not encrypt password: %s"
msgstr "non è stato possibile cifrare la password: %s"

#: fe-auth.c:873
msgid "server requested a cleartext password"
msgstr "il server ha richiesto una password in chiaro"

#: fe-auth.c:875
msgid "server requested a hashed password"
msgstr "il server ha richiesto una password con hash"

#: fe-auth.c:878
