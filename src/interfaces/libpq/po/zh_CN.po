#, c-format
msgid "invalid LDAP URL \"%s\": no filter\n"
msgstr "LDAP URL \"%s\" 无效: 没有过滤器\n"

#: fe-connect.c:4914
#, c-format
msgid "invalid LDAP URL \"%s\": invalid port number\n"
msgstr "LDAP URL \"%s\" 无效: 端口号无效\n"

#: fe-connect.c:4952
msgid "could not create LDAP structure\n"
msgstr "无法创建 LDAP 结构\n"

