#: pg_checksums.c:70
#, c-format
msgid ""
"%s enables, disables, or verifies data checksums in a PostgreSQL database "
"cluster.\n"
"\n"
msgstr ""
"%s 启用、禁用或验证 PostgreSQL 数据库集簇的数据校验和。\n"
"\n"

#: pg_checksums.c:71
#, c-format
msgid "Usage:\n"
msgstr "用法:\n"

#: pg_checksums.c:72
#, c-format
msgid "  %s [OPTION]... [DATADIR]\n"
msgstr "  %s [选项]... [数据目录]\n"

#: pg_checksums.c:73
#, c-format
msgid ""
"\n"
"Options:\n"
msgstr ""
"\n"
"选项:\n"

#: pg_checksums.c:74
#, c-format
msgid " [-D, --pgdata=]DATADIR    data directory\n"
msgstr " [-D, --pgdata=]DATADIR    数据目录\n"

#: pg_checksums.c:75
#, c-format
msgid "  -c, --check              check data checksums (default)\n"
msgstr "  -c, --check              检查数据校验和（默认）\n"

#: pg_checksums.c:76
#, c-format
msgid "  -d, --disable            disable data checksums\n"
msgstr "  -d, --disable            禁用数据校验和\n"

#: pg_checksums.c:77
#, c-format
msgid "  -e, --enable             enable data checksums\n"
msgstr "  -e, --enable             启用数据校验和\n"

#: pg_checksums.c:78
#, c-format
msgid ""
"  -f, --filenode=FILENODE  check only relation with specified filenode\n"
msgstr "  -f, --filenode=FILENODE  仅检查具有指定 filenode 的关系\n"

#: pg_checksums.c:79
#, c-format
msgid ""
"  -N, --no-sync            do not wait for changes to be written safely to "
"disk\n"
msgstr "  -N, --no-sync            不等待变更安全写入磁盘\n"

#: pg_checksums.c:80
#, c-format
msgid "  -P, --progress           show progress information\n"
msgstr "  -P, --progress           显示进度信息\n"

#: pg_checksums.c:81
#, c-format
msgid "      --sync-method=METHOD set method for syncing files to disk\n"
msgstr "      --sync-method=METHOD 设置将文件同步到磁盘的方法\n"

#: pg_checksums.c:82
#, c-format
msgid "  -v, --verbose            output verbose messages\n"
msgstr "  -v, --verbose            输出详细的消息\n"

#: pg_checksums.c:83
#, c-format
msgid "  -V, --version            output version information, then exit\n"
msgstr "  -V, --version            输出版本信息，然后退出\n"

#: pg_checksums.c:84
#, c-format
msgid "  -?, --help               show this help, then exit\n"
msgstr "  -?, --help               显示此帮助，然后退出\n"

#: pg_checksums.c:85
#, c-format
msgid ""
"\n"
"If no data directory (DATADIR) is specified, the environment variable "
"PGDATA\n"
"is used.\n"
"\n"
msgstr ""
"\n"
"如果没有指定数据目录（DATADIR），将使用环境变量 PGDATA。\n"
"\n"

#: pg_checksums.c:87
#, c-format
msgid "Report bugs to <%s>.\n"
msgstr "请向 <%s> 报告缺陷。\n"

#: pg_checksums.c:88
#, c-format
msgid "%s home page: <%s>\n"
msgstr "%s 主页: <%s>\n"

#: pg_checksums.c:145
#, c-format
msgid "%lld/%lld MB (%d%%) computed"
msgstr "已计算 %lld/%lld MB（%d%%）"

#: pg_checksums.c:206
#, c-format
msgid "could not read block %u in file \"%s\": %m"
msgstr "无法读取文件 \"%2$s\" 中的块 %1$u: %m"

#: pg_checksums.c:209
#, c-format
msgid "could not read block %u in file \"%s\": read %d of %d"
msgstr "无法读取文件 \"%2$s\" 中的块 %1$u: 应读取 %4$d，实际读取 %3$d"

#: pg_checksums.c:232
#, c-format
msgid ""
"checksum verification failed in file \"%s\", block %u: calculated checksum "
"%X but block contains %X"
msgstr "文件 \"%s\" 中块 %u 的校验和验证失败: 计算值为 %X，但块中存储的值为 %X"

#: pg_checksums.c:255
#, c-format
msgid "seek failed for block %u in file \"%s\": %m"
msgstr "无法在文件 \"%2$s\" 中定位块 %1$u: %m"

#: pg_checksums.c:262
#, c-format
msgid "could not write block %u in file \"%s\": %m"
msgstr "无法写入文件 \"%2$s\" 中的块 %1$u: %m"

#: pg_checksums.c:265
#, c-format
msgid "could not write block %u in file \"%s\": wrote %d of %d"
msgstr "无法写入文件 \"%2$s\" 中的块 %1$u: 应写入 %4$d，实际写入 %3$d"

#: pg_checksums.c:277
#, c-format
msgid "checksums verified in file \"%s\""
msgstr "已验证文件 \"%s\" 的校验和"

#: pg_checksums.c:279
#, c-format
msgid "checksums enabled in file \"%s\""
msgstr "已为文件 \"%s\" 启用校验和"

#: pg_checksums.c:362
#, c-format
msgid "invalid segment number %d in file name \"%s\""
msgstr "文件名 \"%2$s\" 中的段号 %1$d 无效"

#: pg_checksums.c:509 pg_checksums.c:525 pg_checksums.c:535 pg_checksums.c:543
#, c-format
msgid "Try \"%s --help\" for more information."
msgstr "运行 \"%s --help\" 获取更多信息。"

#: pg_checksums.c:524
#, c-format
msgid "no data directory specified"
msgstr "未指定数据目录"

#: pg_checksums.c:533
#, c-format
msgid "too many command-line arguments (first is \"%s\")"
msgstr "命令行参数过多（第一个多余参数是 \"%s\"）"

#: pg_checksums.c:542
#, c-format
msgid "option -f/--filenode can only be used with --check"
msgstr "选项 -f/--filenode 只能与 --check 一起使用"

#: pg_checksums.c:550
#, c-format
msgid "pg_control CRC value is incorrect"
msgstr "pg_control 的 CRC 值不正确"

#: pg_checksums.c:553
#, c-format
msgid "cluster is not compatible with this version of pg_checksums"
msgstr "集簇与此版本的 pg_checksums 不兼容"

#: pg_checksums.c:557
#, c-format
msgid "database cluster is not compatible"
msgstr "数据库集簇不兼容"

#: pg_checksums.c:558
#, c-format
msgid ""
"The database cluster was initialized with block size %u, but pg_checksums "
"was compiled with block size %u."
msgstr "数据库集簇初始化时的块大小为 %u，但 pg_checksums 编译时的块大小为 %u。"

#: pg_checksums.c:570
#, c-format
msgid "cluster must be shut down"
msgstr "集簇必须处于关闭状态"

#: pg_checksums.c:574
#, c-format
msgid "data checksums are not enabled in cluster"
msgstr "集簇中未启用数据校验和"

#: pg_checksums.c:578
#, c-format
msgid "data checksums are already disabled in cluster"
msgstr "集簇中已禁用数据校验和"

#: pg_checksums.c:582
#, c-format
msgid "data checksums are already enabled in cluster"
msgstr "集簇中已启用数据校验和"

#: pg_checksums.c:606
#, c-format
msgid "Checksum operation completed\n"
msgstr "校验和操作已完成\n"

#: pg_checksums.c:607
#, c-format
msgid "Files scanned:   %lld\n"
msgstr "已扫描文件:      %lld\n"

#: pg_checksums.c:608
#, c-format
msgid "Blocks scanned:  %lld\n"
msgstr "已扫描块:        %lld\n"

#: pg_checksums.c:611
#, c-format
msgid "Bad checksums:  %lld\n"
msgstr "错误校验和:      %lld\n"

#: pg_checksums.c:612 pg_checksums.c:644
#, c-format
msgid "Data checksum version: %u\n"
msgstr "数据校验和版本:  %u\n"

#: pg_checksums.c:619
#, c-format
msgid "Files written:  %lld\n"
msgstr "已写入文件:      %lld\n"

#: pg_checksums.c:620
#, c-format
msgid "Blocks written: %lld\n"
msgstr "已写入块:        %lld\n"

#: pg_checksums.c:636
#, c-format
msgid "syncing data directory"
msgstr "正在同步数据目录"

#: pg_checksums.c:640
#, c-format
msgid "updating control file"
msgstr "正在更新控制文件"

#: pg_checksums.c:646
#, c-format
msgid "Checksums enabled in cluster\n"
msgstr "已在集簇中启用校验和\n"

#: pg_checksums.c:648
#, c-format
msgid "Checksums disabled in cluster\n"
msgstr "已在集簇中禁用校验和\n"

