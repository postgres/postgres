#: ../../common/fe_memutils.c:41 ../../common/fe_memutils.c:81
#: ../../common/fe_memutils.c:104 ../../common/fe_memutils.c:167
#, c-format
msgid "out of memory\n"
msgstr "memoria agotada\n"

#: ../../common/fe_memutils.c:98 ../../common/fe_memutils.c:159
#, c-format
msgid "cannot duplicate null pointer (internal error)\n"
msgstr "no se puede duplicar un puntero nulo (error interno)\n"

#: ../../common/fe_memutils.c:209
#, c-format
msgid "invalid memory allocation request size %zu + %zu\n"
msgstr "tamaño de petición de memoria no válido %zu + %zu\n"

#: ../../common/fe_memutils.c:228
#, c-format
msgid "invalid memory allocation request size %zu * %zu\n"
msgstr "tamaño de petición de memoria no válido %zu * %zu\n"

#: pg_test_timing.c:79
#, c-format
msgid "Usage: %s [-c CUTOFF] [-d DURATION]\n"
msgstr "Empleo: %s [-c CORTE] [-d DURACIÓN]\n"

#: pg_test_timing.c:100 pg_test_timing.c:121
#, c-format
msgid "%s: invalid argument for option %s\n"
msgstr "%s: argumento no válido para la opción %s\n"

#: pg_test_timing.c:102 pg_test_timing.c:123 pg_test_timing.c:137
#: pg_test_timing.c:149
#, c-format
msgid "Try \"%s --help\" for more information.\n"
msgstr "Pruebe «%s --help» para mayor información.\n"

#: pg_test_timing.c:108 pg_test_timing.c:130
#, c-format
msgid "%s: %s must be in range %u..%u\n"
msgstr "%s: %s debe estar en el rango %u..%u\n"

#: pg_test_timing.c:147
#, c-format
msgid "%s: too many command-line arguments (first is \"%s\")\n"
msgstr "%s: demasiados argumentos de línea de órdenes (el primero es «%s»)\n"

#: pg_test_timing.c:154
#, c-format
msgid ""
"Testing timing overhead for %u second.\n"
"\n"
msgid_plural ""
"Testing timing overhead for %u seconds.\n"
"\n"
msgstr[0] "Midiendo sobrecosto de lectura de reloj durante %u segundo.\n"
msgstr[1] "Midiendo sobrecosto de lectura de reloj durante %u segundos.\n"

#: pg_test_timing.c:209
#, c-format
msgid "TSC frequency source: %s\n"
msgstr "Fuente de frecuencia TSC: %s\n"

#: pg_test_timing.c:210
#, c-format
msgid "TSC frequency in use: %d kHz\n"
msgstr "Frecuencia TSC en uso: %d kHz\n"

#: pg_test_timing.c:216
#, c-format
msgid "TSC frequency from calibration: %d kHz\n"
msgstr "Frecuencia TSC de calibración: %d kHz\n"

#: pg_test_timing.c:223
#, c-format
msgid "WARNING: Calibrated TSC frequency differs by %.1f%% from the TSC frequency in use\n"
msgstr "PRECAUCIÓN: la frecuencia de TSC calibrada difiere en %.1f%% de la frecuencia TSC en uso\n"

#: pg_test_timing.c:225
#, c-format
msgid "HINT: Consider setting timing_clock_source to 'system'. Report bugs to <%s>.\n"
msgstr "CONSEJO: Considere definir timing_clock_source a 'system'. Reporte errores a <%s>.\n"

#: pg_test_timing.c:230
#, c-format
msgid "TSC calibration did not converge\n"
msgstr "La calibración TSC no convergió\n"

#: pg_test_timing.c:240
#, c-format
msgid ""
"\n"
"TSC clock source will be used by default, unless timing_clock_source is set to 'system'.\n"
msgstr ""
"\n"
"La fuente de reloj TSC se usará por omisión, a menos que timing_clock_source se defina a 'system'.\n"

#: pg_test_timing.c:242
#, c-format
msgid ""
"\n"
"TSC clock source will not be used by default, unless timing_clock_source is set to 'tsc'.\n"
msgstr ""
"\n"
"La fuente de reloj TSC no se usará por omisión, a menos que timing_clock_source se defina a 'tsc'.\n"

#: pg_test_timing.c:245
#, c-format
msgid ""
"\n"
"TSC clock source is not usable. Likely unable to determine TSC frequency. Are you running in an unsupported virtualized environment?\n"
msgstr ""
"\n"
"La fuente de reloj TSC no es utilizable. Probablemente no se puede determinar la frecuencia TSC. ¿Está ejecutando en un ambiente virtualizado no soportado?\n"

#: pg_test_timing.c:270
#, c-format
msgid "Fast clock source: %s\n"
msgstr "Fuente de reloj rápida: %s\n"

#: pg_test_timing.c:272
#, c-format
msgid "System clock source: %s\n"
msgstr "Fuente de reloj de sistema: %s\n"

#: pg_test_timing.c:274
#, c-format
msgid "Clock source: %s\n"
msgstr "Fuente de reloj: %s\n"

#: pg_test_timing.c:312
#, c-format
msgid "Detected clock going backwards in time.\n"
msgstr "Se detectó que el reloj retrocede en el tiempo.\n"

#: pg_test_timing.c:313
#, c-format
msgid "Time warp: %<PRId64> ns\n"
msgstr "Desfase de tiempo: %<PRId64> ns\n"

#: pg_test_timing.c:351
#, c-format
msgid "Average loop time including overhead: %0.2f ns\n"
msgstr "Tiempo promedio del bucle incluyendo sobrecosto: %0.2f ns\n"

#: pg_test_timing.c:361
msgid "<= ns"
msgstr "<= ns"

#: pg_test_timing.c:362
msgid "ns"
msgstr "ns"

#: pg_test_timing.c:363
#, no-c-format
msgid "% of total"
msgstr "% del total"

#: pg_test_timing.c:364
#, no-c-format
msgid "running %"
msgstr "ejecutando %"

#: pg_test_timing.c:365
msgid "count"
msgstr "cantidad"

#: pg_test_timing.c:375
#, c-format
msgid "WARNING: No timing measurements collected. Report this as a bug to <%s>.\n"
msgstr "PRECAUCIÓN: No se recolectaron mediciones de tiempo. Reporte esto como un bug a <%s>.\n"

#: pg_test_timing.c:389
#, c-format
msgid "Histogram of timing durations:\n"
msgstr "Histograma de duraciones de lectura de reloj:\n"

#: pg_test_timing.c:409
#, c-format
msgid ""
"\n"
"Observed timing durations up to %.4f%%:\n"
msgstr ""
"\n"
"Mediciones de tiempo observadas hasta %.4f%%:\n"
