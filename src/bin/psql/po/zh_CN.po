#: help.c:60
msgid ""
"psql is the PostgreSQL interactive terminal.\n"
"\n"
msgstr ""
"psql 是 PostgreSQL 的交互式终端。\n"
"\n"

#: help.c:61 help.c:384 help.c:471 help.c:524
msgid "Usage:\n"
msgstr "用法:\n"

#: help.c:62
msgid ""
"  psql [OPTION]... [DBNAME [USERNAME]]\n"
"\n"
msgstr ""
"  psql [选项]... [数据库名 [用户名]]\n"
"\n"

#: help.c:64
msgid "General options:\n"
msgstr "一般选项:\n"

#: help.c:65
msgid ""
"  -c, --command=COMMAND    run only single command (SQL or internal) and "
"exit\n"
msgstr "  -c, --command=COMMAND    仅执行一条命令（SQL 或内部命令）并退出\n"

#: help.c:66
msgid "  -d, --dbname=DBNAME      database name to connect to\n"
msgstr "  -d, --dbname=DBNAME      要连接的数据库名\n"

#: help.c:67
msgid "  -f, --file=FILENAME      execute commands from file, then exit\n"
msgstr "  -f, --file=FILENAME      从文件中执行命令然后退出\n"

#: help.c:68
msgid "  -l, --list               list available databases, then exit\n"
msgstr "  -l, --list               列出所有可用的数据库，然后退出\n"

#: help.c:69
msgid ""
"  -v, --set=, --variable=NAME=VALUE\n"
"                           set psql variable NAME to VALUE\n"
"                           (e.g., -v ON_ERROR_STOP=1)\n"
msgstr ""
"  -v, --set=, --variable=NAME=VALUE\n"
"                           设置 psql 变量 NAME 为 VALUE\n"
"                           （例如，-v ON_ERROR_STOP=1）\n"

#: help.c:72
msgid "  -V, --version            output version information, then exit\n"
msgstr "  -V, --version            输出版本信息，然后退出\n"

#: help.c:73
msgid "  -X, --no-psqlrc          do not read startup file (~/.psqlrc)\n"
msgstr "  -X, --no-psqlrc          不读取启动文件（~/.psqlrc）\n"

#: help.c:74
msgid ""
"  -1 (\"one\"), --single-transaction\n"
"                           execute as a single transaction (if non-"
"interactive)\n"
msgstr ""
"  -1 (\"one\"), --single-transaction\n"
"                           作为一个事务执行（非交互模式下）\n"

#: help.c:76
msgid "  -?, --help[=options]     show this help, then exit\n"
msgstr "  -?, --help[=options]     显示此帮助，然后退出\n"

#: help.c:77
msgid "      --help=commands      list backslash commands, then exit\n"
msgstr "      --help=commands      列出反斜杠命令，然后退出\n"

#: help.c:78
msgid "      --help=variables     list special variables, then exit\n"
msgstr "      --help=variables     列出特殊变量，然后退出\n"

#: help.c:80
msgid ""
"\n"
"Input and output options:\n"
msgstr ""
"\n"
"输入和输出选项:\n"

#: help.c:81
msgid "  -a, --echo-all           echo all input from script\n"
msgstr "  -a, --echo-all           回显来自脚本的所有输入\n"

#: help.c:82
msgid "  -b, --echo-errors        echo failed commands\n"
msgstr "  -b, --echo-errors        回显失败的命令\n"

#: help.c:83
msgid "  -e, --echo-queries       echo commands sent to server\n"
msgstr "  -e, --echo-queries       回显发送给服务器的命令\n"

#: help.c:84
msgid ""
"  -E, --echo-hidden        display queries that internal commands generate\n"
msgstr "  -E, --echo-hidden        显示内部命令产生的查询\n"

#: help.c:85
msgid "  -L, --log-file=FILENAME  send session log to file\n"
msgstr "  -L, --log-file=FILENAME  将会话日志写入文件\n"

#: help.c:86
msgid ""
"  -n, --no-readline        disable enhanced command line editing (readline)\n"
msgstr "  -n, --no-readline        禁用增强命令行编辑功能（readline）\n"

#: help.c:87
msgid "  -o, --output=FILENAME    send query results to file (or |pipe)\n"
msgstr "  -o, --output=FILENAME    将查询结果写入文件（或 |pipe）\n"

#: help.c:88
msgid ""
"  -q, --quiet              run quietly (no messages, only query output)\n"
msgstr "  -q, --quiet              静默运行（不显示消息，只有查询结果）\n"

#: help.c:89
msgid "  -s, --single-step        single-step mode (confirm each query)\n"
msgstr "  -s, --single-step        单步模式（确认每个查询）\n"

#: help.c:90
msgid ""
"  -S, --single-line        single-line mode (end of line terminates SQL "
"command)\n"
msgstr "  -S, --single-line        单行模式（行末终止 SQL 命令）\n"

#: help.c:92
msgid ""
"\n"
"Output format options:\n"
msgstr ""
"\n"
"输出格式选项:\n"

#: help.c:93
msgid "  -A, --no-align           unaligned table output mode\n"
msgstr "  -A, --no-align           使用非对齐表格输出模式\n"

#: help.c:94
msgid ""
"      --csv                CSV (Comma-Separated Values) table output mode\n"
msgstr "      --csv                CSV（逗号分隔值）表格输出模式\n"

#: help.c:95
#, c-format
msgid ""
"  -F, --field-separator=STRING\n"
"                           field separator for unaligned output (default: "
"\"%s\")\n"
msgstr ""
"  -F, --field-separator=STRING\n"
"                           非对齐输出的字段分隔符（默认为 \"%s\"）\n"

#: help.c:98
msgid "  -H, --html               HTML table output mode\n"
msgstr "  -H, --html               HTML 表格输出模式\n"

#: help.c:99
msgid ""
"  -P, --pset=VAR[=ARG]     set printing option VAR to ARG (see \\pset "
"command)\n"
msgstr ""
"  -P, --pset=VAR[=ARG]     将打印选项 VAR 设为 ARG（参见 \\pset 命令）\n"

#: help.c:100
msgid ""
"  -R, --record-separator=STRING\n"
"                           record separator for unaligned output (default: "
"newline)\n"
msgstr ""
"  -R, --record-separator=STRING\n"
"                           非对齐输出的记录分隔符（默认为换行符）\n"

#: help.c:102
msgid "  -t, --tuples-only        print rows only\n"
msgstr "  -t, --tuples-only        只打印行\n"

#: help.c:103
msgid ""
"  -T, --table-attr=TEXT    set HTML table tag attributes (e.g., width, "
"border)\n"
msgstr ""
"  -T, --table-attr=TEXT    设置 HTML 表格标签属性（如 width, border）\n"

#: help.c:104
msgid "  -x, --expanded           turn on expanded table output\n"
msgstr "  -x, --expanded           开启扩展表格输出\n"

#: help.c:105
msgid ""
"  -z, --field-separator-zero\n"
"                           set field separator for unaligned output to zero "
"byte\n"
msgstr ""
"  -z, --field-separator-zero\n"
"                           将非对齐输出的字段分隔符设为空字节\n"

#: help.c:107
msgid ""
"  -0, --record-separator-zero\n"
"                           set record separator for unaligned output to zero "
"byte\n"
msgstr ""
"  -0, --record-separator-zero\n"
"                           将非对齐输出的记录分隔符设为空字节\n"

#: help.c:110
msgid ""
"\n"
"Connection options:\n"
msgstr ""
"\n"
"连接选项:\n"

#: help.c:111
msgid "  -h, --host=HOSTNAME      database server host or socket directory\n"
msgstr "  -h, --host=HOSTNAME      数据库服务器主机或套接字目录\n"

#: help.c:112
msgid "  -p, --port=PORT          database server port\n"
msgstr "  -p, --port=PORT          数据库服务器端口\n"

#: help.c:113
msgid "  -U, --username=USERNAME  database user name\n"
msgstr "  -U, --username=USERNAME  数据库用户名\n"

#: help.c:114
msgid "  -w, --no-password        never prompt for password\n"
msgstr "  -w, --no-password        永远不提示输入密码\n"

#: help.c:115
msgid ""
"  -W, --password           force password prompt (should happen "
"automatically)\n"
msgstr "  -W, --password           强制提示输入密码（应当自动提示）\n"

#: help.c:117
msgid ""
"\n"
"For more information, type \"\\?\" (for internal commands) or \"\\help\" "
"(for SQL\n"
"commands) from within psql, or consult the psql section in the PostgreSQL\n"
"documentation.\n"
"\n"
msgstr ""
"\n"
"更多信息，在 psql 中输入 \"\\?\"（内部命令）或 \"\\help\"（SQL 命令），\n"
"或参阅 PostgreSQL 文档中的 psql 章节。\n"
"\n"

#: help.c:120
#, c-format
msgid "Report bugs to <%s>.\n"
msgstr "请向 <%s> 报告缺陷。\n"

#: help.c:121
#, c-format
msgid "%s home page: <%s>\n"
msgstr "%s 主页: <%s>\n"

#: help.c:163
msgid "General\n"
msgstr "一般\n"

#: help.c:164
msgid ""
"  \\copyright             show PostgreSQL usage and distribution terms\n"
msgstr "  \\copyright             显示 PostgreSQL 的使用和发行许可条款\n"

#: help.c:165
msgid ""
"  \\crosstabview [COLUMNS] execute query and display result in crosstab\n"
msgstr "  \\crosstabview [COLUMNS] 执行查询并以交叉表显示结果\n"

#: help.c:166
msgid ""
"  \\errverbose            show most recent error message at maximum "
"verbosity\n"
msgstr "  \\errverbose            以最高详细级别显示最近的错误消息\n"

#: help.c:167
msgid ""
"  \\g [(OPTIONS)] [FILE]  execute query (and send result to file or |pipe);\n"
"                         \\g with no arguments is equivalent to a semicolon\n"
msgstr ""
