msgstr "l'opzione AT non è permessa nell'istruzione WHENEVER"

#: preproc.y:1421 preproc.y:1549 preproc.y:2325 preproc.y:2651 preproc.y:3084
#: preproc.y:3171 preproc.y:6341
#, c-format
msgid "unsupported feature will be passed to server"
msgstr "al server è stata richiesta una funzionalità non supportata"

#: preproc.y:1661
#, c-format
msgid "SHOW ALL is not implemented"
msgstr "SHOW ALL non è implementato"

#: preproc.y:1959
#, c-format
msgid "COPY FROM STDIN is not implemented"
msgstr "COPY FROM STDIN non è implementato"

#: preproc.y:5375 preproc.y:8660
#, c-format
msgid "\"database\" cannot be used as cursor name in INFORMIX mode"
msgstr "\"database\" non può essere utilizzato come nome del cursore in modalità INFORMIX"

#: preproc.y:5382 preproc.y:8670
#, c-format
msgid "using variable \"%s\" in different declare statements is not supported"
msgstr "usare la variabile \"%s\" in una diversa istruzione declare non è supportato"

#: preproc.y:5384 preproc.y:8672
#, c-format
msgid "cursor \"%s\" is already defined"
msgstr "il cursore \"%s\" è già definito"

#: preproc.y:5631
#, c-format
