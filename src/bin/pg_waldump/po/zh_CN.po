#: archive_waldump.c:143 pg_waldump.c:1300 pg_waldump.c:1330
#, c-format
msgid "could not open file \"%s\""
msgstr "无法打开文件 \"%s\""

#: archive_waldump.c:188
#, c-format
msgid "could not find WAL in archive \"%s\""
msgstr "无法在归档 \"%s\" 中找到 WAL"

#: archive_waldump.c:205
#, c-format
msgid "invalid WAL segment size in WAL file from archive \"%s\" (%u byte)"
msgid_plural ""
"invalid WAL segment size in WAL file from archive \"%s\" (%u bytes)"
msgstr[0] "归档 \"%s\" 中 WAL 文件的 WAL 段大小无效（%u 字节）"

#: archive_waldump.c:209 pg_waldump.c:252
#, c-format
msgid "The WAL segment size must be a power of two between 1 MB and 1 GB."
msgstr "WAL 段大小必须是 1 MB 到 1 GB 之间的二的幂。"

#: archive_waldump.c:291 pg_waldump.c:654
#, c-format
msgid "could not close file \"%s\": %m"
msgstr "无法关闭文件 \"%s\": %m"

#: archive_waldump.c:367
#, c-format
msgid ""
"WAL segment \"%s\" in archive \"%s\" is too short: read %zu of %zu bytes"
msgstr ""
"归档 \"%2$s\" 中的 WAL 段 \"%1$s\" 过短: 应读取 %4$zu 字节，实际读取 %3$zu 字"
"节"

#: archive_waldump.c:371
#, c-format
msgid ""
"unexpected end of archive \"%s\" while reading \"%s\": read %zu of %zu bytes"
msgstr ""
"读取 \"%2$s\" 时意外遇到归档 \"%1$s\" 末尾: 应读取 %4$zu 字节，实际读取 "
"%3$zu 字节"

#: archive_waldump.c:503
#, c-format
msgid "could not close file \"%s/%s\": %m"
msgstr "无法关闭文件 \"%s/%s\": %m"

#: archive_waldump.c:516
#, c-format
msgid "could not find WAL \"%s\" in archive \"%s\""
msgstr "无法在归档 \"%2$s\" 中找到 WAL \"%1$s\""

#: archive_waldump.c:548 pg_waldump.c:259
#, c-format
msgid "could not read file \"%s\": %m"
msgstr "无法读取文件 \"%s\": %m"

#: archive_waldump.c:595 pg_waldump.c:131
#, c-format
msgid "could not create directory \"%s\": %m"
msgstr "无法创建目录 \"%s\": %m"

#: archive_waldump.c:622
#, c-format
msgid "could not create file \"%s\": %m"
msgstr "无法创建文件 \"%s\": %m"

#: archive_waldump.c:626
#, c-format
msgid "could not set permissions on file \"%s\": %m"
msgstr "无法设置文件 \"%s\" 的权限: %m"

#: archive_waldump.c:651
#, c-format
msgid "could not write to file \"%s/%s\": %m"
msgstr "无法写入文件 \"%s/%s\": %m"

#: archive_waldump.c:743
#, c-format
msgid "ignoring duplicate WAL \"%s\" found in archive \"%s\""
msgstr "正在忽略归档 \"%2$s\" 中发现的重复 WAL \"%1$s\""

#: archive_waldump.c:779
#, c-format
msgid "unexpected state while parsing tar file"
msgstr "解析 tar 文件时出现意外状态"

#: pg_waldump.c:140
#, c-format
msgid "directory \"%s\" exists but is not empty"
msgstr "目录 \"%s\" 已存在，但不为空"

#: pg_waldump.c:144
#, c-format
msgid "could not access directory \"%s\": %m"
msgstr "无法访问目录 \"%s\": %m"

#: pg_waldump.c:248
#, c-format
msgid "invalid WAL segment size in WAL file \"%s\" (%u byte)"
msgid_plural "invalid WAL segment size in WAL file \"%s\" (%u bytes)"
msgstr[0] "WAL 文件 \"%s\" 中的 WAL 段大小无效（%u 字节）"

#: pg_waldump.c:262
#, c-format
msgid "could not read file \"%s\": read %d of %d"
msgstr "无法读取文件 \"%1$s\": 应读取 %3$d，实际读取 %2$d"

#: pg_waldump.c:324
#, c-format
msgid "could not locate WAL file \"%s\""
msgstr "无法找到 WAL 文件 \"%s\""

#: pg_waldump.c:326
#, c-format
msgid "could not find any WAL file"
msgstr "无法找到任何 WAL 文件"

#: pg_waldump.c:393
#, c-format
msgid "could not find file \"%s\": %m"
msgstr "无法找到文件 \"%s\": %m"

#: pg_waldump.c:433
#, c-format
msgid "could not read from file \"%s\", offset %d: %m"
msgstr "无法从文件 \"%s\" 的偏移量 %d 处读取: %m"

#: pg_waldump.c:437
#, c-format
msgid "could not read from file \"%s\", offset %d: read %d of %d"
msgstr ""
"无法读取文件 \"%1$s\" 的偏移量 %2$d 处的数据: 应读取 %4$d，实际读取 %3$d"

#: pg_waldump.c:631
#, c-format
msgid "%s"
msgstr "%s"

#: pg_waldump.c:639
#, c-format
msgid "invalid fork number: %u"
msgstr "无效的文件分支编号: %u"

#: pg_waldump.c:651
#, c-format
msgid "could not write file \"%s\": %m"
msgstr "无法写入文件 \"%s\": %m"

#: pg_waldump.c:895
#, c-format
msgid ""
"%s decodes and displays PostgreSQL write-ahead logs for debugging.\n"
"\n"
msgstr ""
"%s 解码并显示 PostgreSQL 预写日志，用于调试。\n"
"\n"

#: pg_waldump.c:897
#, c-format
msgid "Usage:\n"
msgstr "用法:\n"

#: pg_waldump.c:898
#, c-format
msgid "  %s [OPTION]... [STARTSEG [ENDSEG]]\n"
msgstr "  %s [选项]... [起始段 [结束段]]\n"

#: pg_waldump.c:899
#, c-format
msgid ""
"\n"
"Options:\n"
msgstr ""
"\n"
"选项:\n"

#: pg_waldump.c:900
#, c-format
msgid ""
"  -b, --bkp-details      output detailed information about backup blocks\n"
msgstr "  -b, --bkp-details      输出有关备份块的详情\n"

#: pg_waldump.c:901
#, c-format
msgid ""
"  -B, --block=N          with --relation, only show records that modify "
"block N\n"
msgstr "  -B, --block=N          配合 --relation，仅显示修改块 N 的记录\n"

#: pg_waldump.c:902
#, c-format
msgid "  -e, --end=RECPTR       stop reading at WAL location RECPTR\n"
msgstr "  -e, --end=RECPTR       在 WAL 位置 RECPTR 停止读取\n"

#: pg_waldump.c:903
#, c-format
msgid "  -f, --follow           keep retrying after reaching end of WAL\n"
msgstr "  -f, --follow           在到达可用 WAL 的末尾之后，继续重试\n"

#: pg_waldump.c:904
#, c-format
msgid ""
"  -F, --fork=FORK        only show records that modify blocks in fork FORK;\n"
"                         valid names are main, fsm, vm, init\n"
msgstr ""
"  -F, --fork=FORK        仅显示修改文件分支 FORK 中块的记录；\n"
"                         有效名称为 main, fsm, vm, init\n"

#: pg_waldump.c:906
#, c-format
msgid "  -n, --limit=N          number of records to display\n"
msgstr "  -n, --limit=N          要显示的记录数\n"

#: pg_waldump.c:907
#, c-format
msgid ""
"  -p, --path=PATH        a tar archive or a directory in which to find WAL "
"segment files or\n"
"                         a directory with a pg_wal subdirectory containing "
"such files\n"
"                         (default: current directory, ./pg_wal, $PGDATA/"
"pg_wal)\n"
msgstr ""
"  -p, --path=PATH        用于查找 WAL 段文件的 tar 归档或目录，或者\n"
"                         包含 pg_wal 子目录且该子目录含有这些文件的目录\n"
"                         （默认: 当前目录, ./pg_wal, $PGDATA/pg_wal）\n"

#: pg_waldump.c:910
#, c-format
msgid "  -q, --quiet            do not print any output, except for errors\n"
msgstr "  -q, --quiet            不打印任何输出，错误除外\n"

#: pg_waldump.c:911
#, c-format
msgid ""
"  -r, --rmgr=RMGR        only show records generated by resource manager "
"RMGR;\n"
"                         use --rmgr=list to list valid resource manager "
"names\n"
msgstr ""
"  -r, --rmgr=RMGR        仅显示由 RMGR 资源管理器生成的记录；\n"
"                         使用 --rmgr=list 列出有效的资源管理器名称\n"

#: pg_waldump.c:913
#, c-format
msgid ""
"  -R, --relation=T/D/R   only show records that modify blocks in relation T/"
"D/R\n"
msgstr "  -R, --relation=T/D/R   仅显示修改关系 T/D/R 中块的记录\n"

#: pg_waldump.c:914
#, c-format
msgid "  -s, --start=RECPTR     start reading at WAL location RECPTR\n"
msgstr "  -s, --start=RECPTR     从 WAL 位置 RECPTR 开始读取\n"

#: pg_waldump.c:915
#, c-format
msgid ""
"  -t, --timeline=TLI     timeline from which to read WAL records\n"
"                         (default: 1 or the value used in STARTSEG)\n"
msgstr ""
"  -t, --timeline=TLI     要读取 WAL 记录的时间线\n"
"                         （默认: 1 或 STARTSEG 中使用的值）\n"

#: pg_waldump.c:917
#, c-format
msgid "  -V, --version          output version information, then exit\n"
msgstr "  -V, --version          输出版本信息，然后退出\n"

#: pg_waldump.c:918
#, c-format
msgid "  -w, --fullpage         only show records with a full page write\n"
msgstr "  -w, --fullpage         仅显示包含整页写入的记录\n"

#: pg_waldump.c:919
#, c-format
msgid "  -x, --xid=XID          only show records with transaction ID XID\n"
msgstr "  -x, --xid=XID          仅显示事务 ID 为 XID 的记录\n"

#: pg_waldump.c:920
#, c-format
msgid ""
"  -z, --stats[=record]   show statistics instead of records\n"
"                         (optionally, show per-record statistics)\n"
msgstr ""
"  -z, --stats[=record]   显示统计信息而不是记录\n"
"                         （可选: 按记录类型显示统计信息）\n"

#: pg_waldump.c:922
#, c-format
msgid "  --save-fullpage=DIR    save full page images to DIR\n"
msgstr "  --save-fullpage=DIR    将整页镜像保存到 DIR\n"

#: pg_waldump.c:923
#, c-format
msgid "  -?, --help             show this help, then exit\n"
msgstr "  -?, --help             显示此帮助，然后退出\n"

#: pg_waldump.c:924
#, c-format
msgid ""
"\n"
"Report bugs to <%s>.\n"
msgstr ""
"\n"
"请向 <%s> 报告缺陷。\n"

#: pg_waldump.c:925
#, c-format
msgid "%s home page: <%s>\n"
msgstr "%s 主页: <%s>\n"

#: pg_waldump.c:1027
#, c-format
msgid "no arguments specified"
msgstr "未指定参数"

#: pg_waldump.c:1043
#, c-format
msgid "invalid block number: \"%s\""
msgstr "无效的块号: \"%s\""

#: pg_waldump.c:1052 pg_waldump.c:1150
#, c-format
msgid "invalid WAL location: \"%s\""
msgstr "无效的 WAL 位置: \"%s\""

#: pg_waldump.c:1065
#, c-format
msgid "invalid fork name: \"%s\""
msgstr "无效的文件分支名称: \"%s\""

#: pg_waldump.c:1073 pg_waldump.c:1176
#, c-format
msgid "invalid value \"%s\" for option %s"
msgstr "选项 %2$s 的值 \"%1$s\" 无效"

#: pg_waldump.c:1104
#, c-format
msgid "custom resource manager \"%s\" does not exist"
msgstr "自定义资源管理器 \"%s\" 不存在"

#: pg_waldump.c:1125
#, c-format
msgid "resource manager \"%s\" does not exist"
msgstr "资源管理器 \"%s\" 不存在"

#: pg_waldump.c:1140
#, c-format
msgid "invalid relation specification: \"%s\""
msgstr "无效的关系标识: \"%s\""

#: pg_waldump.c:1141
#, c-format
msgid "Expecting \"tablespace OID/database OID/relation filenode\"."
msgstr "预期为 \"表空间 OID/数据库 OID/关系文件节点\"。"

#: pg_waldump.c:1183
#, c-format
msgid "%s must be in range %u..%u"
msgstr "%s 必须位于 %u..%u 的范围内"

#: pg_waldump.c:1198
#, c-format
msgid "invalid transaction ID specification: \"%s\""
msgstr "无效的事务 ID: \"%s\""

#: pg_waldump.c:1213
#, c-format
msgid "unrecognized value for option %s: %s"
msgstr "选项 %s 的值无法识别: %s"

#: pg_waldump.c:1230
#, c-format
msgid "option %s requires option %s to be specified"
msgstr "选项 %s 需要同时指定选项 %s"

#: pg_waldump.c:1237
#, c-format
msgid "too many command-line arguments (first is \"%s\")"
msgstr "命令行参数过多（第一个多余参数是 \"%s\"）"

#: pg_waldump.c:1274
#, c-format
msgid ""
"unnecessary command-line arguments specified with tar archive (first is "
"\"%s\")"
msgstr "使用 tar 归档时指定了多余的命令行参数（第一个多余参数是 \"%s\"）"

#: pg_waldump.c:1310
#, c-format
msgid "start WAL location %X/%08X is not inside file \"%s\""
msgstr "WAL 起始位置 %X/%08X 不在文件 \"%s\" 中"

#: pg_waldump.c:1337
#, c-format
msgid "ENDSEG %s is before STARTSEG %s"
msgstr "ENDSEG %s 在 STARTSEG %s 之前"

#: pg_waldump.c:1351
#, c-format
msgid "end WAL location %X/%08X is not inside file \"%s\""
msgstr "WAL 结束位置 %X/%08X 不在文件 \"%s\" 中"

#: pg_waldump.c:1364
#, c-format
msgid "no start WAL location given"
msgstr "未给出 WAL 起始位置"

#: pg_waldump.c:1371
#, c-format
msgid "--follow is not supported when reading from a tar archive"
msgstr "从 tar 归档读取时不支持 --follow"

#: pg_waldump.c:1409
#, c-format
msgid "out of memory while allocating a WAL reading processor"
msgstr "分配 WAL 读取器时内存不足"

#: pg_waldump.c:1425
#, c-format
msgid "could not find a valid record after %X/%08X: %s"
msgstr "无法在 %X/%08X 之后找到有效记录: %s"

#: pg_waldump.c:1428
#, c-format
msgid "could not find a valid record after %X/%08X"
msgstr "无法在 %X/%08X 之后找到有效记录"

#: pg_waldump.c:1439
#, c-format
msgid "first record is after %X/%08X, at %X/%08X, skipping over %u byte"
msgid_plural ""
"first record is after %X/%08X, at %X/%08X, skipping over %u bytes"
msgstr[0] "第一条记录在 %X/%08X 之后，位于 %X/%08X，正在跳过 %u 字节"

#: pg_waldump.c:1527
#, c-format
msgid "error in WAL record at %X/%08X: %s"
msgstr "%X/%08X 处的 WAL 记录存在错误: %s"

#: pg_waldump.c:1545
#, c-format
msgid "Try \"%s --help\" for more information."
msgstr "运行 \"%s --help\" 获取更多信息。"

#: xlogreader.c:621
#, c-format
msgid "invalid record offset at %X/%08X: expected at least %u, got %u"
msgstr "%X/%08X 处的记录偏移量无效: 至少应为 %u，实际为 %u"

#: xlogreader.c:630
#, c-format
msgid "contrecord is requested by %X/%08X"
msgstr "请求的 %X/%08X 处是续接记录"

#: xlogreader.c:671 xlogreader.c:1146
#, c-format
msgid "invalid record length at %X/%08X: expected at least %u, got %u"
msgstr "%X/%08X 处的记录长度无效: 至少应为 %u，实际为 %u"

#: xlogreader.c:761
#, c-format
msgid "there is no contrecord flag at %X/%08X"
msgstr "%X/%08X 处没有续接记录标志"

#: xlogreader.c:774
#, c-format
msgid "invalid contrecord length %u (expected %lld) at %X/%08X"
msgstr "%3$X/%4$08X 处的续接记录长度 %1$u 无效（预期为 %2$lld）"

#: xlogreader.c:1154
#, c-format
msgid "invalid resource manager ID %u at %X/%08X"
msgstr "%2$X/%3$08X 处的资源管理器 ID %1$u 无效"

#: xlogreader.c:1167 xlogreader.c:1183
#, c-format
msgid "record with incorrect prev-link %X/%08X at %X/%08X"
msgstr "%3$X/%4$08X 处的记录具有不正确的前一记录链接 %1$X/%2$08X"

#: xlogreader.c:1221
#, c-format
msgid "incorrect resource manager data checksum in record at %X/%08X"
msgstr "%X/%08X 处记录的资源管理器数据校验和不正确"

#: xlogreader.c:1255
#, c-format
msgid "invalid magic number %04X in WAL segment %s, LSN %X/%08X, offset %u"
msgstr "WAL 段 %2$s 中的魔数 %1$04X 无效, LSN %3$X/%4$08X, 偏移量 %5$u"

#: xlogreader.c:1270 xlogreader.c:1312
#, c-format
msgid "invalid info bits %04X in WAL segment %s, LSN %X/%08X, offset %u"
msgstr "WAL 段 %2$s 中的信息位 %1$04X 无效, LSN %3$X/%4$08X, 偏移量 %5$u"

#: xlogreader.c:1286
#, c-format
msgid ""
"WAL file is from different database system: WAL file database system "
"identifier is %<PRIu64>, pg_control database system identifier is %<PRIu64>"
msgstr ""
"WAL 文件来自不同的数据库系统: WAL 文件中的数据库系统标识符为 %<PRIu64>，"
"pg_control 中的数据库系统标识符为 %<PRIu64>"

#: xlogreader.c:1294
#, c-format
msgid ""
"WAL file is from different database system: incorrect segment size in page "
"header"
msgstr "WAL 文件来自不同的数据库系统: 页头部中有不正确的段大小"

#: xlogreader.c:1300
#, c-format
msgid ""
"WAL file is from different database system: incorrect XLOG_BLCKSZ in page "
"header"
msgstr "WAL 文件来自不同的数据库系统: 页头部中有不正确的 XLOG_BLCKSZ"

#: xlogreader.c:1332
#, c-format
msgid "unexpected pageaddr %X/%08X in WAL segment %s, LSN %X/%08X, offset %u"
msgstr ""
"WAL 段 %3$s 中出现意外的 pageaddr %1$X/%2$08X, LSN %4$X/%5$08X, 偏移量 %6$u"

#: xlogreader.c:1358
#, c-format
msgid ""
"out-of-sequence timeline ID %u (after %u) in WAL segment %s, LSN %X/%08X, "
"offset %u"
msgstr ""
