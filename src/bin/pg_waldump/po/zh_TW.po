# access/transam/xlog.c:2443
#: xlogreader.c:331
#, c-format
msgid "contrecord is requested by %X/%X"
msgstr "請求的 %X/%X 處是續接記錄"

#: xlogreader.c:372 xlogreader.c:728
#, c-format
msgid "invalid record length at %X/%X: wanted %u, got %u"
msgstr "%X/%X 處的記錄長度無效: 預期為 %u，實際為 %u"

#: xlogreader.c:443
#, c-format
msgid "there is no contrecord flag at %X/%X"
msgstr "位於 %X/%X 沒有續接記錄旗標"

#: xlogreader.c:456
#, c-format
msgid "invalid contrecord length %u (expected %lld) at %X/%X"
msgstr "位於 %3$X/%4$X 的 contrecord 長度 %1$u 無效(預期為 %2$lld)"

# access/transam/xlog.c:2465
#: xlogreader.c:736
#, c-format
msgid "invalid resource manager ID %u at %X/%X"
msgstr "位於 %2$X/%3$X 的無效資源管理員 ID %1$u"

# access/transam/xlog.c:2458
#: xlogreader.c:749 xlogreader.c:765
#, c-format
msgid "record with incorrect prev-link %X/%X at %X/%X"
msgstr "位於 %3$X/%4$X 的記錄有不正確的 prev-link %1$X/%2$X"

# access/transam/xlog.c:2269
#: xlogreader.c:803
#, c-format
msgid "incorrect resource manager data checksum in record at %X/%X"
msgstr "位於 %X/%X 的記錄中資源管理員資料檢查碼不正確"

#: xlogreader.c:840
#, c-format
msgid "invalid magic number %04X in log segment %s, offset %u"
msgstr "日誌片段 %2$s 中的魔數 %1$04X 無效，位移 %3$u"

#: xlogreader.c:854 xlogreader.c:895
#, c-format
msgid "invalid info bits %04X in log segment %s, offset %u"
msgstr "日誌片段 %2$s 中的資訊位元 %1$04X 無效，位移 %3$u"

#: xlogreader.c:869
#, c-format
msgid "WAL file is from different database system: WAL file database system identifier is %llu, pg_control database system identifier is %llu"
msgstr "WAL 檔案來自不同的資料庫系統：WAL 檔案的資料庫系統識別碼為 %llu，而 pg_control 的資料庫系統識別碼為 %llu"

#: xlogreader.c:877
#, c-format
msgid "WAL file is from different database system: incorrect segment size in page header"
msgstr "WAL 檔案來自不同的資料庫系統: 資料頁標頭中的片段大小不正確"

#: xlogreader.c:883
#, c-format
msgid "WAL file is from different database system: incorrect XLOG_BLCKSZ in page header"
msgstr "WAL 檔案來自不同的資料庫系統: 資料頁標頭中的 XLOG_BLCKSZ 不正確"

#: xlogreader.c:914
#, c-format
msgid "unexpected pageaddr %X/%X in log segment %s, offset %u"
msgstr "日誌片段 %3$s 中出現非預期的 pageaddr %1$X/%2$X，位移 %4$u"

#: xlogreader.c:939
#, c-format
msgid "out-of-sequence timeline ID %u (after %u) in log segment %s, offset %u"
msgstr "日誌片段 %3$s 中的時間軸 ID %1$u 順序錯誤（前一個為 %2$u），位移 %4$u"

#: xlogreader.c:1284
#, c-format
msgid "out-of-order block_id %u at %X/%X"
msgstr "%2$X/%3$X 處的 block_id %1$u 順序錯誤"

#: xlogreader.c:1306
#, c-format
msgid "BKPBLOCK_HAS_DATA set, but no data included at %X/%X"
msgstr "%X/%X 處已設定 BKPBLOCK_HAS_DATA，但未包含資料"

#: xlogreader.c:1313
#, c-format
msgid "BKPBLOCK_HAS_DATA not set, but data length is %u at %X/%X"
msgstr "未設定 BKPBLOCK_HAS_DATA，但在 %2$X/%3$X 的資料長度為 %1$u"

#: xlogreader.c:1349
#, c-format
msgid "BKPIMAGE_HAS_HOLE set, but hole offset %u length %u block image length %u at %X/%X"
msgstr "已設定 BKPIMAGE_HAS_HOLE，但 %4$X/%5$X 處的空洞位移為 %1$u，長度為 %2$u，區塊映像長度為 %3$u"

#: xlogreader.c:1365
#, c-format
msgid "BKPIMAGE_HAS_HOLE not set, but hole offset %u length %u at %X/%X"
msgstr "未設定 BKPIMAGE_HAS_HOLE，但 %3$X/%4$X 處的空洞位移為 %1$u，長度為 %2$u"

#: xlogreader.c:1380
#, c-format
msgid "BKPIMAGE_IS_COMPRESSED set, but block image length %u at %X/%X"
msgstr "已設定 BKPIMAGE_IS_COMPRESSED，但 %2$X/%3$X 處的區塊映像長度為 %1$u"

#: xlogreader.c:1395
#, c-format
msgid "neither BKPIMAGE_HAS_HOLE nor BKPIMAGE_IS_COMPRESSED set, but block image length is %u at %X/%X"
msgstr "既未設定 BKPIMAGE_HAS_HOLE，也未設定 BKPIMAGE_IS_COMPRESSED，但 %2$X/%3$X 處的區塊映像長度為 %1$u"

#: xlogreader.c:1411
#, c-format
msgid "BKPBLOCK_SAME_REL set but no previous rel at %X/%X"
msgstr "%X/%X 處已設定 BKPBLOCK_SAME_REL，但沒有先前的關聯"

#: xlogreader.c:1423
#, c-format
msgid "invalid block_id %u at %X/%X"
msgstr "位於 %2$X/%3$X 的無效 block_id %1$u"

#: xlogreader.c:1510
#, c-format
msgid "record with invalid length at %X/%X"
msgstr "位於 %X/%X 的記錄長度無效"

#: xlogreader.c:1599
#, c-format
msgid "invalid compressed image at %X/%X, block %d"
msgstr "%X/%X 處的壓縮映像無效，區塊 %d"

