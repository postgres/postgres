#, c-format
msgid "no data was returned by command \"%s\""
msgstr "Il comando \"%s\" non ha restituito alcun dato."

#: ../../common/exec.c:406
#, c-format
msgid "%s() failed: %m"
msgstr "%s() non riuscito: %m"

