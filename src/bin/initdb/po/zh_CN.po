msgstr "无法向子进程写入数据: %s\n"

#: initdb.c:2100
#, c-format
msgid "ok\n"
msgstr "成功\n"

#: initdb.c:2182 initdb.c:2228
#, c-format
msgid "locale name \"%s\" contains non-ASCII characters"
msgstr "区域设置名称 \"%s\" 包含非 ASCII 字符"

#: initdb.c:2208
#, c-format
msgid "invalid locale name \"%s\""
msgstr "无效的区域设置名称 \"%s\""

#: initdb.c:2209
#, c-format
msgid "If the locale name is specific to ICU, use --icu-locale."
msgstr "如果区域设置名称专用于 ICU，使用 --icu-locale。"

#: initdb.c:2222
#, c-format
msgid "invalid locale settings; check LANG and LC_* environment variables"
msgstr "无效的区域设置；检查环境变量 LANG 和 LC_* 的值"

#: initdb.c:2253 initdb.c:2277
#, c-format
msgid "encoding mismatch"
msgstr "编码不匹配"

#: initdb.c:2254
#, c-format
msgid ""
"The encoding you selected (%s) and the encoding that the selected locale "
"uses (%s) do not match. This would lead to misbehavior in various character "
"string processing functions."
msgstr ""
"所选编码（%s）与所选区域设置使用的编码（%s）不匹配。这会导致多种字符串处理函"
"数行为异常。"

#: initdb.c:2259 initdb.c:2280
#, c-format
msgid ""
"Rerun %s and either do not specify an encoding explicitly, or choose a "
"matching combination."
msgstr "重新运行 %s，不显式指定编码，或选择相互匹配的组合。"

#: initdb.c:2278
#, c-format
msgid "The encoding you selected (%s) is not supported with the ICU provider."
msgstr "ICU 提供者不支持所选编码（%s）。"

#: initdb.c:2329
#, c-format
msgid "could not convert locale name \"%s\" to language tag: %s"
msgstr "无法将区域设置名称 \"%s\" 转换为语言标签: %s"

#: initdb.c:2335 initdb.c:2387 initdb.c:2466
#, c-format
msgid "ICU is not supported in this build"
msgstr "此构建版本不支持 ICU"

#: initdb.c:2358
#, c-format
msgid "could not get language from locale \"%s\": %s"
msgstr "无法从区域设置 \"%s\" 获取语言: %s"

#: initdb.c:2384
#, c-format
msgid "locale \"%s\" has unknown language \"%s\""
msgstr "区域设置 \"%s\" 的语言 \"%s\" 未知"

#: initdb.c:2450
#, c-format
msgid "ICU locale must be specified"
msgstr "必须指定 ICU 区域设置"

#: initdb.c:2454
#, c-format
msgid "Using language tag \"%s\" for ICU locale \"%s\".\n"
msgstr "正在为 ICU 区域设置 \"%2$s\" 使用语言标签 \"%1$s\"。\n"

#: initdb.c:2477
#, c-format
msgid ""
"%s initializes a PostgreSQL database cluster.\n"
"\n"
msgstr ""
"%s 初始化 PostgreSQL 数据库集簇。\n"
"\n"

#: initdb.c:2478
#, c-format
msgid "Usage:\n"
msgstr "用法:\n"

#: initdb.c:2479
#, c-format
msgid "  %s [OPTION]... [DATADIR]\n"
msgstr "  %s [选项]... [数据目录]\n"

#: initdb.c:2480
#, c-format
msgid ""
"\n"
"Options:\n"
msgstr ""
"\n"
"选项:\n"

#: initdb.c:2481
#, c-format
msgid ""
"  -A, --auth=METHOD         default authentication method for local "
"connections\n"
msgstr "  -A, --auth=METHOD         本地连接的默认认证方法\n"

#: initdb.c:2482
#, c-format
msgid ""
"      --auth-host=METHOD    default authentication method for local TCP/IP "
"connections\n"
msgstr "      --auth-host=METHOD    本地 TCP/IP 连接的默认认证方法\n"

#: initdb.c:2483
#, c-format
msgid ""
"      --auth-local=METHOD   default authentication method for local-socket "
"connections\n"
msgstr "      --auth-local=METHOD   本地套接字连接的默认认证方法\n"

#: initdb.c:2484
#, c-format
msgid " [-D, --pgdata=]DATADIR     location for this database cluster\n"
msgstr " [-D, --pgdata=]DATADIR     该数据库集簇的位置\n"

#: initdb.c:2485
#, c-format
msgid "  -E, --encoding=ENCODING   set default encoding for new databases\n"
msgstr "  -E, --encoding=ENCODING   为新数据库设置默认编码\n"

#: initdb.c:2486
#, c-format
msgid ""
"  -g, --allow-group-access  allow group read/execute on data directory\n"
msgstr "  -g, --allow-group-access  允许组对数据目录进行读/执行\n"

#: initdb.c:2487
#, c-format
msgid "      --icu-locale=LOCALE   set ICU locale ID for new databases\n"
msgstr "      --icu-locale=LOCALE   为新数据库设置 ICU 区域设置 ID\n"

#: initdb.c:2488
#, c-format
msgid ""
"      --icu-rules=RULES     set additional ICU collation rules for new "
"databases\n"
msgstr "      --icu-rules=RULES     为新数据库设置额外的 ICU 排序规则\n"

#: initdb.c:2489
#, c-format
msgid "  -k, --data-checksums      use data page checksums\n"
msgstr "  -k, --data-checksums      使用数据页校验和\n"

#: initdb.c:2490
#, c-format
msgid "      --locale=LOCALE       set default locale for new databases\n"
msgstr "      --locale=LOCALE       为新数据库设置默认区域设置\n"

#: initdb.c:2491
#, c-format
msgid ""
"      --lc-collate=, --lc-ctype=, --lc-messages=LOCALE\n"
"      --lc-monetary=, --lc-numeric=, --lc-time=LOCALE\n"
"                            set default locale in the respective category "
"for\n"
"                            new databases (default taken from environment)\n"
msgstr ""
"      --lc-collate=, --lc-ctype=, --lc-messages=LOCALE\n"
"      --lc-monetary=, --lc-numeric=, --lc-time=LOCALE\n"
"                            为新数据库设置各类别的默认区域设置\n"
"                            （默认取自环境）\n"

#: initdb.c:2495
#, c-format
msgid "      --no-locale           equivalent to --locale=C\n"
msgstr "      --no-locale           等同于 --locale=C\n"

#: initdb.c:2496
#, c-format
msgid ""
"      --locale-provider={libc|icu}\n"
"                            set default locale provider for new databases\n"
msgstr ""
"      --locale-provider={libc|icu}\n"
"                            为新数据库设置默认的区域设置提供者\n"

#: initdb.c:2498
#, c-format
msgid ""
"      --pwfile=FILE         read password for the new superuser from file\n"
msgstr "      --pwfile=FILE         为新的超级用户从文件读取密码\n"

#: initdb.c:2499
#, c-format
msgid ""
"  -T, --text-search-config=CFG\n"
"                            default text search configuration\n"
msgstr ""
"  -T, --text-search-config=CFG\n"
"                            默认文本搜索配置\n"

#: initdb.c:2501
#, c-format
msgid "  -U, --username=NAME       database superuser name\n"
msgstr "  -U, --username=NAME       数据库超级用户名\n"

#: initdb.c:2502
#, c-format
msgid ""
"  -W, --pwprompt            prompt for a password for the new superuser\n"
msgstr "  -W, --pwprompt            提示输入新超级用户的密码\n"

#: initdb.c:2503
#, c-format
msgid ""
"  -X, --waldir=WALDIR       location for the write-ahead log directory\n"
msgstr "  -X, --waldir=WALDIR       预写日志目录的位置\n"

#: initdb.c:2504
#, c-format
msgid "      --wal-segsize=SIZE    size of WAL segments, in megabytes\n"
msgstr "      --wal-segsize=SIZE    WAL 段的大小（兆字节）\n"

#: initdb.c:2505
#, c-format
msgid ""
"\n"
"Less commonly used options:\n"
msgstr ""
"\n"
"不常用选项:\n"

#: initdb.c:2506
#, c-format
msgid ""
"  -c, --set NAME=VALUE      override default setting for server parameter\n"
msgstr "  -c, --set NAME=VALUE      覆盖默认的服务器参数设置\n"

#: initdb.c:2507
#, c-format
msgid "  -d, --debug               generate lots of debugging output\n"
msgstr "  -d, --debug               产生大量的调试信息\n"

#: initdb.c:2508
#, c-format
msgid "      --discard-caches      set debug_discard_caches=1\n"
msgstr "      --discard-caches      设置 debug_discard_caches=1\n"

#: initdb.c:2509
#, c-format
msgid "  -L DIRECTORY              where to find the input files\n"
msgstr "  -L DIRECTORY              输入文件的位置\n"

#: initdb.c:2510
#, c-format
msgid "  -n, --no-clean            do not clean up after errors\n"
msgstr "  -n, --no-clean            出错后不清理\n"

#: initdb.c:2511
#, c-format
msgid ""
"  -N, --no-sync             do not wait for changes to be written safely to "
"disk\n"
msgstr "  -N, --no-sync             不等待变更安全写入磁盘\n"

#: initdb.c:2512
#, c-format
msgid "      --no-instructions     do not print instructions for next steps\n"
msgstr "      --no-instructions     不打印后续步骤的说明\n"

#: initdb.c:2513
#, c-format
msgid "  -s, --show                show internal settings\n"
msgstr "  -s, --show                显示内部设置\n"

#: initdb.c:2514
#, c-format
msgid ""
"  -S, --sync-only           only sync database files to disk, then exit\n"
