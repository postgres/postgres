#, c-format
msgid "  -j, --jobs=NUM               use this many parallel jobs to dump\n"
msgstr "  -j, --jobs=NUM               usa questo numero di job paralleli per il dump\n"

#: pg_dump.c:1302 pg_dumpall.c:710
#, c-format
msgid "  -v, --verbose                verbose mode\n"
msgstr "  -v, --verbose                modalità dettagliata\n"

