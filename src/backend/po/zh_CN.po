msgstr "ON CONFLICT DO %s 需要指定唯一索引推断条件或约束名称"

#: parser/parse_clause.c:3321
#, c-format
msgid "For example, ON CONFLICT (column_name)."
msgstr "例如: ON CONFLICT (column_name)。"

#: parser/parse_clause.c:3332
#, c-format
msgid "ON CONFLICT is not supported with system catalog tables"
msgstr "系统目录表不支持 ON CONFLICT"

#: parser/parse_clause.c:3340
#, c-format
msgid "ON CONFLICT is not supported on table \"%s\" used as a catalog table"
msgstr "在用作目录表的表 \"%s\" 上不支持 ON CONFLICT"

#: parser/parse_clause.c:3471
#, c-format
msgid "operator %s is not a valid ordering operator"
msgstr "操作符 %s 不是有效的排序操作符"

#: parser/parse_clause.c:3473
#, c-format
msgid ""
"Ordering operators must be \"<\" or \">\" members of btree operator families."
msgstr "排序操作符必须是 btree 操作符族中的 \"<\" 或 \">\" 成员。"

#: parser/parse_clause.c:3787
#, c-format
msgid ""
"RANGE with offset PRECEDING/FOLLOWING is not supported for column type %s"
msgstr "列类型 %s 不支持带有 PRECEDING/FOLLOWING 偏移量的 RANGE"

#: parser/parse_clause.c:3793
#, c-format
msgid ""
"RANGE with offset PRECEDING/FOLLOWING is not supported for column type %s "
"and offset type %s"
msgstr ""
"列类型 %s 与偏移量类型 %s 的组合不支持带有 PRECEDING/FOLLOWING 偏移量的 RANGE"

#: parser/parse_clause.c:3796
#, c-format
msgid "Cast the offset value to an appropriate type."
msgstr "将偏移量值强制转换为适当的类型。"

#: parser/parse_clause.c:3801
#, c-format
msgid ""
"RANGE with offset PRECEDING/FOLLOWING has multiple interpretations for "
"column type %s and offset type %s"
msgstr ""
"对于列类型 %s 和偏移量类型 %s，带有 PRECEDING/FOLLOWING 偏移量的 RANGE 存在多"
"种解释"

#: parser/parse_clause.c:3804
#, c-format
msgid "Cast the offset value to the exact intended type."
msgstr "将偏移量值强制转换为准确的预期类型。"

