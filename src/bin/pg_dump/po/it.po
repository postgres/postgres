msgstr "  -C, --create                  includi nel dump i comandi per creare il database\n"

#: pg_dump.c:1319
#, c-format
msgid "  -e, --extension=PATTERN      dump the specified extension(s) only\n"
msgstr "  -e, --extension=PATTERN       esporta solo le estensioni specificate\n"

#: pg_dump.c:1320 pg_dumpall.c:717
#, c-format
