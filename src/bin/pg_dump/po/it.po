#, c-format
msgid ""
"  -F, --format=c|d|t|p         output file format (custom, directory, tar,\n"
"                               plain text (default))\n"
msgstr ""
"  -F, --format=c|d|t|p         formato del file di output (custom, directory, tar,\n"
"                               testo semplice (predefinito))\n"

