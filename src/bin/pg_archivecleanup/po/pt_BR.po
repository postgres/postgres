msgstr "argumento de nome de arquivo é inválido"

#: pg_archivecleanup.c:247 pg_archivecleanup.c:335 pg_archivecleanup.c:355
#: pg_archivecleanup.c:367 pg_archivecleanup.c:374
#, c-format
msgid "Try \"%s --help\" for more information."
msgstr "Tente \"%s --help\" para obter informações adicionais."

#: pg_archivecleanup.c:260
#, c-format
msgid ""
"%s removes older WAL files from PostgreSQL archives.\n"
"\n"
msgstr ""
"%s remove arquivos mais antigos do WAL da cópia de segurança do PostgreSQL.\n"
"\n"

#: pg_archivecleanup.c:261
#, c-format
msgid "Usage:\n"
msgstr "Uso:\n"

#: pg_archivecleanup.c:262
#, c-format
msgid "  %s [OPTION]... ARCHIVELOCATION OLDESTKEPTWALFILE\n"
msgstr "  %s [OPÇÃO]... LOCALARCHIVE ARQUIVOWALMAISANTIGO\n"

#: pg_archivecleanup.c:263
#, c-format
msgid ""
"\n"
"Options:\n"
msgstr ""
"\n"
"Opções:\n"

#: pg_archivecleanup.c:264
#, c-format
msgid "  -b, --clean-backup-history  clean up files including backup history files\n"
msgstr "  -b, --clean-backup-history limpa os arquivos, inclusive os arquivos de histórico de backup\n"

#: pg_archivecleanup.c:265
#, c-format
msgid "  -d, --debug                 generate debug output (verbose mode)\n"
msgstr "  -d, --debug                 geram saída de depuração (modo detalhado)\n"

#: pg_archivecleanup.c:266
#, c-format
msgid ""
"  -n, --dry-run               dry run, show the names of the files that would be\n"
"                              removed\n"
msgstr ""
"  -n, --dry-run dry run, mostra os nomes dos arquivos que seriam\n"
"                              removidos\n"

#: pg_archivecleanup.c:268
#, c-format
msgid "  -V, --version               output version information, then exit\n"
msgstr "  -V, --versão               exibir informações da versão e sair\n"

#: pg_archivecleanup.c:269
#, c-format
msgid ""
"  -x, --strip-extension=EXT   strip this extension before identifying files for\n"
"                              clean up\n"
msgstr ""
"  -x, --strip-extension=EXT retira essa extensão antes de identificar arquivos para\n"
"                              limpeza\n"

#: pg_archivecleanup.c:271
#, c-format
msgid "  -?, --help                  show this help, then exit\n"
msgstr "  -?, --ajuda                  exibir esta ajuda e sair\n"

#: pg_archivecleanup.c:272
#, c-format
msgid ""
"\n"
"For use as \"archive_cleanup_command\" in postgresql.conf:\n"
"  archive_cleanup_command = 'pg_archivecleanup [OPTION]... ARCHIVELOCATION %%r'\n"
"e.g.\n"
"  archive_cleanup_command = 'pg_archivecleanup /mnt/server/archiverdir %%r'\n"
msgstr ""
"\n"
"Para usar como \"archive\\_cleanup\\_command\" no postgresql.conf:\n"
"  archive\\_cleanup\\_command = 'pg\\_archivecleanup \\[OPÇÃO]... ARQUIVODIRETÓRIO %%r'\n"
"exemplo:\n"
"  archive\\_cleanup\\_command = 'pg\\_archivecleanup /mnt/servidor/diretorioarquivador %%r'\n"

#: pg_archivecleanup.c:277
#, c-format
msgid ""
"\n"
"Or for use as a standalone archive cleaner:\n"
"e.g.\n"
"  pg_archivecleanup /mnt/server/archiverdir 000000010000000000000010.00000020.backup\n"
msgstr ""
"\n"
"Ou para usar como um limpador autônomo da cópia de segurança:\n"
"e.g.\n"
"  pg_archivecleanup /mnt/server/archiverdir 000000010000000000000010.00000020.backup\n"

#: pg_archivecleanup.c:281
#, c-format
msgid ""
"\n"
"Report bugs to <%s>.\n"
msgstr ""
"\n"
"Relate erros a <%s>.\n"

#: pg_archivecleanup.c:282
#, c-format
msgid "%s home page: <%s>\n"
msgstr "Página web do %s: <%s>\n"

#: pg_archivecleanup.c:354
#, c-format
msgid "must specify archive location"
msgstr "deve especificar local da cópia de segurança"

#: pg_archivecleanup.c:366
#, c-format
msgid "must specify oldest kept WAL file"
msgstr "deve especificar o arquvo do WAL mais antigo a ser mantido"

#: pg_archivecleanup.c:373
#, c-format
msgid "too many command-line arguments"
msgstr "muitos argumentos de linha de comando"

#: pg_archivecleanup.c:380
#, fuzzy, c-format
#| msgid "Running in debug mode.\n"
msgid "executing in dry-run mode"
msgstr "Executando no modo de depuração.\n"

#: pg_archivecleanup.c:381
#, fuzzy, c-format
#| msgid "Role \"%s\" will be permanently removed.\n"
msgid "No files will be removed."
msgstr "Role \"%s\" será permanentemente removida.\n"

#, c-format
#~ msgid "  -?, --help     show this help, then exit\n"
#~ msgstr "  -?, --help     mostra essa ajuda e termina\n"

#, c-format
#~ msgid "  -V, --version  output version information, then exit\n"
#~ msgstr "  -V, --version  mostra informação sobre a versão e termina\n"

#, c-format
#~ msgid "  -x EXT         clean up files if they have this extension\n"
#~ msgstr "  -x EXT         limpa arquivos se eles têm esta extensão\n"
