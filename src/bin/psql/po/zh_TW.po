msgid "  \\prompt [TEXT] NAME    prompt user to set internal variable\n"
msgstr "  \\prompt [TEXT] NAME    提示使用者設定內部變數\n"

# help.c:184
#: help.c:324
#, c-format
msgid "  \\set [NAME [VALUE]]    set internal variable, or list all if no parameters\n"
msgstr "  \\set [NAME [VALUE]]    設定內部變數，如果沒有參數則列出所有內部變數\n"

# help.c:188
#: help.c:325
#, c-format
msgid "  \\unset NAME            unset (delete) internal variable\n"
msgstr "  \\unset NAME            取消(刪除)內部變數\n"

# large_obj.c:264
#: help.c:328
#, c-format
msgid "Large Objects\n"
msgstr "大物件\n"

# help.c:252
#: help.c:329
#, c-format
msgid ""
"  \\lo_export LOBOID FILE\n"
"  \\lo_import FILE [COMMENT]\n"
"  \\lo_list\n"
"  \\lo_unlink LOBOID      large object operations\n"
msgstr "  \\lo_export LOBOID FILE\n  \\lo_import FILE [COMMENT]\n  \\lo_list\n  \\lo_unlink LOBOID      大物件操作\n"

#: help.c:356
#, c-format
msgid ""
"List of specially treated variables\n"
"\n"
msgstr "特別變數清單\n\n"

#: help.c:358
#, c-format
msgid "psql variables:\n"
msgstr "psql 變數:\n"

#: help.c:360
#, c-format
msgid ""
"  psql --set=NAME=VALUE\n"
"  or \\set NAME VALUE inside psql\n"
"\n"
msgstr "  psql --set=名稱=值\n  或在 psql 中 \\set 名稱 值\n\n"

#: help.c:362
#, c-format
msgid ""
"  AUTOCOMMIT\n"
"    if set, successful SQL commands are automatically committed\n"
msgstr "  AUTOCOMMIT\n    如果設定，成功的 SQL 命令將自動提交\n"

#: help.c:364
#, c-format
msgid ""
"  COMP_KEYWORD_CASE\n"
"    determines the case used to complete SQL key words\n"
"    [lower, upper, preserve-lower, preserve-upper]\n"
msgstr "  COMP_KEYWORD_CASE\n    決定完成 SQL 關鍵字時使用的大小寫\n    [lower, upper, preserve-lower, preserve-upper]\n"

#: help.c:367
#, c-format
msgid ""
"  DBNAME\n"
"    the currently connected database name\n"
msgstr "  DBNAME\n    目前連線的資料庫名稱\n"

#: help.c:369
#, c-format
msgid ""
"  ECHO\n"
"    controls what input is written to standard output\n"
"    [all, errors, none, queries]\n"
msgstr "  ECHO\n    控制寫入標準輸出的輸入內容\n    [all, errors, none, queries]\n"

#: help.c:372
#, c-format
msgid ""
"  ECHO_HIDDEN\n"
"    if set, display internal queries executed by backslash commands;\n"
"    if set to \"noexec\", just show them without execution\n"
msgstr "  ECHO_HIDDEN\n    若設定，顯示由反斜線指令執行的內部查詢；\n    若設定為 \"noexec\"，僅顯示而不執行\n"

# utils/misc/guc.c:1432
#: help.c:375
#, c-format
msgid ""
"  ENCODING\n"
"    current client character set encoding\n"
msgstr "  ENCODING\n    目前客戶端字元集編碼\n"

#: help.c:377
#, c-format
msgid ""
"  ERROR\n"
"    true if last query failed, else false\n"
msgstr "  ERROR\n    上次查詢失敗時為 true，否則為 false\n"

#: help.c:379
#, c-format
msgid ""
"  FETCH_COUNT\n"
"    the number of result rows to fetch and display at a time (0 = unlimited)\n"
msgstr "  FETCH_COUNT\n    每次擷取和顯示的結果列數(0 = 無限制)\n"

#: help.c:381
#, c-format
msgid ""
"  HIDE_TABLEAM\n"
"    if set, table access methods are not displayed\n"
msgstr "  HIDE_TABLEAM\n    若設定，則不顯示資料表存取方法\n"

#: help.c:383
#, c-format
msgid ""
"  HIDE_TOAST_COMPRESSION\n"
"    if set, compression methods are not displayed\n"
msgstr "  HIDE_TOAST_COMPRESSION\n    若設定，則不顯示壓縮方法\n"

#: help.c:385
#, c-format
msgid ""
"  HISTCONTROL\n"
"    controls command history [ignorespace, ignoredups, ignoreboth]\n"
msgstr "  HISTCONTROL\n    控制指令歷史記錄 [ignorespace, ignoredups, ignoreboth]\n"

#: help.c:387
#, c-format
msgid ""
"  HISTFILE\n"
"    file name used to store the command history\n"
msgstr "  HISTFILE\n    用於儲存指令歷史記錄的檔案名稱\n"

#: help.c:389
#, c-format
msgid ""
"  HISTSIZE\n"
"    maximum number of commands to store in the command history\n"
msgstr "  HISTSIZE\n    儲存在指令歷史記錄中的最大指令數量\n"

# common.c:636
# common.c:871
#: help.c:391
#, c-format
msgid ""
"  HOST\n"
"    the currently connected database server host\n"
msgstr "  HOST\n    目前連線的資料庫伺服器主機\n"

#: help.c:393
#, c-format
msgid ""
"  IGNOREEOF\n"
"    number of EOFs needed to terminate an interactive session\n"
msgstr "  IGNOREEOF\n    結束互動式工作階段所需的 EOF 次數\n"

#: help.c:395
#, c-format
msgid ""
"  LASTOID\n"
"    value of the last affected OID\n"
msgstr "  LASTOID\n    上一個受影響的 OID\n"

#: help.c:397
#, c-format
msgid ""
"  LAST_ERROR_MESSAGE\n"
"  LAST_ERROR_SQLSTATE\n"
"    message and SQLSTATE of last error, or empty string and \"00000\" if none\n"
msgstr "  LAST_ERROR_MESSAGE\n  LAST_ERROR_SQLSTATE\n    上一個錯誤的訊息和 SQLSTATE，若無則為空字串和 \"00000\"\n"

#: help.c:400
#, c-format
msgid ""
"  ON_ERROR_ROLLBACK\n"
"    if set, an error doesn't stop a transaction (uses implicit savepoints)\n"
msgstr "  ON_ERROR_ROLLBACK\n    若設定，錯誤不會停止交易(使用隱式儲存點)\n"

#: help.c:402
#, c-format
msgid ""
"  ON_ERROR_STOP\n"
"    stop batch execution after error\n"
msgstr "  ON_ERROR_STOP\n    發生錯誤後停止批次執行\n"

#: help.c:404
#, c-format
msgid ""
"  PORT\n"
"    server port of the current connection\n"
msgstr "  PORT\n    目前連線的伺服器連接埠\n"

#: help.c:406
#, c-format
msgid ""
"  PROMPT1\n"
"    specifies the standard psql prompt\n"
msgstr "  PROMPT1\n    指定標準的 psql 提示符號\n"

#: help.c:408
#, c-format
msgid ""
"  PROMPT2\n"
"    specifies the prompt used when a statement continues from a previous line\n"
msgstr "  PROMPT2\n    指定當陳述式從前一行繼續時所使用的提示符號\n"

#: help.c:410
#, c-format
msgid ""
"  PROMPT3\n"
"    specifies the prompt used during COPY ... FROM STDIN\n"
msgstr "  PROMPT3\n    指定在執行 COPY ... FROM STDIN 時使用的提示符號\n"

#: help.c:412
#, c-format
msgid ""
"  QUIET\n"
"    run quietly (same as -q option)\n"
msgstr "  QUIET\n    靜默執行(同 -q 選項)\n"

#: help.c:414
#, c-format
msgid ""
"  ROW_COUNT\n"
"    number of rows returned or affected by last query, or 0\n"
msgstr "  ROW_COUNT\n    上一次查詢所傳回或受影響的列數，或為 0\n"

#: help.c:416
#, c-format
msgid ""
"  SERVER_VERSION_NAME\n"
"  SERVER_VERSION_NUM\n"
"    server's version (in short string or numeric format)\n"
msgstr "  SERVER_VERSION_NAME\n  SERVER_VERSION_NUM\n    伺服器版本(以簡短字串或數字格式表示)\n"

#: help.c:419
#, c-format
msgid ""
"  SHOW_CONTEXT\n"
"    controls display of message context fields [never, errors, always]\n"
msgstr "  SHOW_CONTEXT\n    控制訊息上下文欄位的顯示 [never, errors, always]\n"

#: help.c:421
#, c-format
msgid ""
"  SINGLELINE\n"
"    if set, end of line terminates SQL commands (same as -S option)\n"
msgstr "  SINGLELINE\n    若設定，SQL 命令在行尾結束(同 -S 選項)\n"

#: help.c:423
#, c-format
msgid ""
"  SINGLESTEP\n"
"    single-step mode (same as -s option)\n"
msgstr "  SINGLESTEP\n    單步執行模式(同 -s 選項)\n"

#: help.c:425
#, c-format
msgid ""
"  SQLSTATE\n"
"    SQLSTATE of last query, or \"00000\" if no error\n"
msgstr "  SQLSTATE\n    上一個查詢的 SQLSTATE，若無錯誤則為 \"00000\"\n"

# common.c:636
# common.c:871
#: help.c:427
#, c-format
msgid ""
"  USER\n"
"    the currently connected database user\n"
msgstr "  USER\n    目前連線的資料庫使用者\n"

#: help.c:429
#, c-format
msgid ""
"  VERBOSITY\n"
"    controls verbosity of error reports [default, verbose, terse, sqlstate]\n"
msgstr "  VERBOSITY\n    控制錯誤報告的詳細程度 [default, verbose, terse, sqlstate]\n"

#: help.c:431
#, c-format
msgid ""
"  VERSION\n"
"  VERSION_NAME\n"
"  VERSION_NUM\n"
"    psql's version (in verbose string, short string, or numeric format)\n"
msgstr "  VERSION\n  VERSION_NAME\n  VERSION_NUM\n    psql 的版本(以詳細字串、簡短字串或數字格式表示)\n"

# describe.c:1549
#: help.c:436
#, c-format
msgid ""
"\n"
"Display settings:\n"
msgstr "\n顯示設定:\n"

#: help.c:438
#, c-format
msgid ""
"  psql --pset=NAME[=VALUE]\n"
"  or \\pset NAME [VALUE] inside psql\n"
"\n"
msgstr "  psql --pset=名稱[=值]\n  或在 psql 中 \\pset 名稱 [值]\n\n"

#: help.c:440
#, c-format
msgid ""
"  border\n"
"    border style (number)\n"
msgstr "  border\n    邊框樣式(數字)\n"

#: help.c:442
#, c-format
msgid ""
"  columns\n"
"    target width for the wrapped format\n"
msgstr "  columns\n    wrapped 格式的目標寬度\n"

#: help.c:444
#, c-format
msgid ""
"  csv_fieldsep\n"
"    field separator for CSV output format (default \"%c\")\n"
msgstr "  csv_fieldsep\n    CSV 輸出格式的欄位分隔符號 (預設 \"%c\")\n"

#: help.c:447
#, c-format
msgid ""
"  expanded (or x)\n"
"    expanded output [on, off, auto]\n"
msgstr "  expanded (或 x)\n    展開輸出 [on, off, auto]\n"

#: help.c:449
#, c-format
msgid ""
"  fieldsep\n"
"    field separator for unaligned output (default \"%s\")\n"
msgstr "  fieldsep\n    用於非對齊輸出的欄位分隔符(預設值 \"%s\")\n"

# help.c:236
#: help.c:452
#, c-format
msgid ""
"  fieldsep_zero\n"
"    set field separator for unaligned output to a zero byte\n"
msgstr "  fieldsep_zero\n    將非對齊輸出的欄位分隔符設定成值為零的位元組\n"

#: help.c:454
#, c-format
msgid ""
"  footer\n"
"    enable or disable display of the table footer [on, off]\n"
msgstr "  footer\n    啟動或停用顯示表格頁腳 [on, off]\n"

# command.c:1340
#: help.c:456
#, c-format
msgid ""
"  format\n"
"    set output format [unaligned, aligned, wrapped, html, asciidoc, ...]\n"
msgstr "  format\n    設定輸出格式 [unaligned, aligned, wrapped, html, asciidoc, ...]\n"

#: help.c:458
#, c-format
msgid ""
"  linestyle\n"
"    set the border line drawing style [ascii, old-ascii, unicode]\n"
msgstr "  linestyle\n    設定邊框線條繪製樣式 [ascii, old-ascii, unicode]\n"

#: help.c:460
#, c-format
msgid ""
"  null\n"
"    set the string to be printed in place of a null value\n"
msgstr "  null\n    設定要在空值位置上顯示的字串\n"

#: help.c:462
#, c-format
msgid ""
"  numericlocale\n"
"    enable display of a locale-specific character to separate groups of digits\n"
msgstr "  numericlocale\n    啟動顯示區域特定的字元來分隔數字群組\n"

#: help.c:464
#, c-format
msgid ""
"  pager\n"
"    control when an external pager is used [yes, no, always]\n"
msgstr "  pager\n    控制何時使用外部分頁程式 [yes, no, always]\n"

# help.c:236
#: help.c:466
#, c-format
msgid ""
"  recordsep\n"
"    record (line) separator for unaligned output\n"
msgstr "  recordsep\n    用於非對齊輸出的記錄(行)分隔符號\n"

#: help.c:468
#, c-format
msgid ""
"  recordsep_zero\n"
"    set record separator for unaligned output to a zero byte\n"
msgstr "  recordsep_zero\n    將非對齊輸出的記錄分隔符設定成值為零的位元組\n"

#: help.c:470
#, c-format
msgid ""
"  tableattr (or T)\n"
"    specify attributes for table tag in html format, or proportional\n"
"    column widths for left-aligned data types in latex-longtable format\n"
msgstr "  tableattr (或 T)\n    指定 html 格式中表格標籤的屬性，或是 latex-longtable\n    格式中左對齊資料型別的比例欄寬\n"

#: help.c:473
#, c-format
msgid ""
"  title\n"
"    set the table title for subsequently printed tables\n"
msgstr "  title\n    設定後續顯示表格的表格標題\n"

#: help.c:475
#, c-format
msgid ""
"  tuples_only\n"
"    if set, only actual table data is shown\n"
msgstr "  tuples_only\n    若設定則只顯示資料\n"

#: help.c:477
#, c-format
msgid ""
"  unicode_border_linestyle\n"
"  unicode_column_linestyle\n"
"  unicode_header_linestyle\n"
"    set the style of Unicode line drawing [single, double]\n"
msgstr "  unicode_border_linestyle\n  unicode_column_linestyle\n  unicode_header_linestyle\n    設定 Unicode 線條繪製樣式 [single, double]\n"

#: help.c:482
#, c-format
msgid ""
"\n"
"Environment variables:\n"
msgstr "\n環境變數:\n"

#: help.c:486
#, c-format
msgid ""
"  NAME=VALUE [NAME=VALUE] psql ...\n"
"  or \\setenv NAME [VALUE] inside psql\n"
"\n"
msgstr "  名稱=值 [名稱=值] psql ...\n  或在 psql 中 \\setenv 名稱 [值]\n\n"

#: help.c:488
#, c-format
msgid ""
"  set NAME=VALUE\n"
"  psql ...\n"
"  or \\setenv NAME [VALUE] inside psql\n"
"\n"
msgstr "  set 名稱=值\n  psql ...\n  或在 psql 中 \\setenv 名稱 [值]\n\n"

#: help.c:491
#, c-format
msgid ""
"  COLUMNS\n"
"    number of columns for wrapped format\n"
msgstr "  COLUMNS\n    用於 wrapped 格式的顯示欄數\n"

#: help.c:493
#, c-format
msgid ""
"  PGAPPNAME\n"
"    same as the application_name connection parameter\n"
msgstr "  PGAPPNAME\n    與連線參數中的 application_name 相同\n"

#: help.c:495
#, c-format
msgid ""
"  PGDATABASE\n"
"    same as the dbname connection parameter\n"
msgstr "  PGDATABASE\n    與連線參數中的 dbname 相同\n"

#: help.c:497
#, c-format
msgid ""
"  PGHOST\n"
"    same as the host connection parameter\n"
msgstr "  PGHOST\n    與連線參數中的 host 相同\n"

#: help.c:499
#, c-format
msgid ""
"  PGPASSFILE\n"
"    password file name\n"
msgstr "  PGPASSFILE\n    密碼檔案名稱\n"

#: help.c:501
#, c-format
msgid ""
"  PGPASSWORD\n"
"    connection password (not recommended)\n"
msgstr "  PGPASSWORD\n    連線密碼(不建議使用)\n"

#: help.c:503
#, c-format
msgid ""
"  PGPORT\n"
"    same as the port connection parameter\n"
msgstr "  PGPORT\n    與連線參數中的 port 相同\n"

#: help.c:505
#, c-format
msgid ""
"  PGUSER\n"
"    same as the user connection parameter\n"
msgstr "  PGUSER\n    與連線參數中的 user 相同\n"

#: help.c:507
#, c-format
msgid ""
"  PSQL_EDITOR, EDITOR, VISUAL\n"
"    editor used by the \\e, \\ef, and \\ev commands\n"
msgstr "  PSQL_EDITOR, EDITOR, VISUAL\n    \\e, \\ef 和 \\ev 命令使用的編輯器\n"

#: help.c:509
#, c-format
msgid ""
"  PSQL_EDITOR_LINENUMBER_ARG\n"
"    how to specify a line number when invoking the editor\n"
msgstr "  PSQL_EDITOR_LINENUMBER_ARG\n    在呼叫編輯器時如何指定行號\n"

#: help.c:511
#, c-format
msgid ""
"  PSQL_HISTORY\n"
"    alternative location for the command history file\n"
msgstr "  PSQL_HISTORY\n    命令歷史檔案的替代位置\n"

#: help.c:513
#, c-format
msgid ""
"  PSQL_PAGER, PAGER\n"
"    name of external pager program\n"
msgstr "  PSQL_PAGER, PAGER\n    外部分頁程式的名稱\n"

#: help.c:515
#, c-format
msgid ""
"  PSQLRC\n"
"    alternative location for the user's .psqlrc file\n"
msgstr "  PSQLRC\n    使用者 .psqlrc 檔案的替代位置\n"

#: help.c:517
#, c-format
msgid ""
"  SHELL\n"
"    shell used by the \\! command\n"
msgstr "  SHELL\n    \\! 命令使用的 shell\n"

#: help.c:519
#, c-format
msgid ""
"  TMPDIR\n"
"    directory for temporary files\n"
msgstr "  TMPDIR\n    暫存檔案的目錄\n"

