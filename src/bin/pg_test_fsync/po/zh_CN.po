#: pg_test_fsync.c:293
#, c-format
msgid ""
"\n"
"Compare file sync methods using one %dkB write:\n"
msgstr ""
"\n"
"通过一次 %d kB 的写入比较文件同步方法:\n"

#: pg_test_fsync.c:295
#, c-format
msgid ""
"\n"
"Compare file sync methods using two %dkB writes:\n"
msgstr ""
"\n"
"通过两次 %d kB 的写入比较文件同步方法:\n"

#: pg_test_fsync.c:296
#, c-format
msgid ""
"(in \"wal_sync_method\" preference order, except fdatasync is Linux's "
"default)\n"
msgstr ""
"（按 \"wal_sync_method\" 的优先顺序排列，但 Linux 默认使用 fdatasync）\n"

#: pg_test_fsync.c:307 pg_test_fsync.c:410 pg_test_fsync.c:477
msgid "n/a*"
msgstr "n/a*"

#: pg_test_fsync.c:326 pg_test_fsync.c:398 pg_test_fsync.c:436
#: pg_test_fsync.c:495
msgid "n/a"
msgstr "n/a"

#: pg_test_fsync.c:441
#, c-format
msgid ""
"* This file system and its mount options do not support direct\n"
"  I/O, e.g. ext4 in journaled mode.\n"
msgstr ""
"* 此文件系统及其挂载选项不支持直接 I/O，例如，使用 journaled 模式的 ext4。\n"

#: pg_test_fsync.c:449
#, c-format
msgid ""
"\n"
"Compare open_sync with different write sizes:\n"
msgstr ""
"\n"
"比较不同写入大小情况下的 open_sync:\n"

#: pg_test_fsync.c:450
#, c-format
msgid ""
"(This is designed to compare the cost of writing 16kB in different write\n"
"open_sync sizes.)\n"
msgstr ""
"（此测试用于比较采用不同单次写入大小时，以 open_sync 写入 16 kB 数据的开"
"销。）\n"

#: pg_test_fsync.c:453
msgid " 1 * 16kB open_sync write"
msgstr " 1 * 16kB open_sync 写入"

#: pg_test_fsync.c:454
msgid " 2 *  8kB open_sync writes"
msgstr " 2 *  8kB open_sync 写入"

#: pg_test_fsync.c:455
msgid " 4 *  4kB open_sync writes"
msgstr " 4 *  4kB open_sync 写入"

#: pg_test_fsync.c:456
msgid " 8 *  2kB open_sync writes"
msgstr " 8 *  2kB open_sync 写入"

#: pg_test_fsync.c:457
msgid "16 *  1kB open_sync writes"
msgstr "16 *  1kB open_sync 写入"

#: pg_test_fsync.c:511
#, c-format
msgid ""
"\n"
"Test if fsync on non-write file descriptor is honored:\n"
msgstr ""
"\n"
"测试未用于写入的文件描述符上的 fsync 是否生效:\n"

#: pg_test_fsync.c:512
#, c-format
msgid ""
"(If the times are similar, fsync() can sync data written on a different\n"
"descriptor.)\n"
msgstr ""
"（如果耗时相近，说明 fsync() 可以同步通过其他文件描述符写入的数据。）\n"

