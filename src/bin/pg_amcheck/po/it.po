#: pg_amcheck.c:1221
#, c-format
msgid ""
"\n"
"Other options:\n"
msgstr ""
"\n"
"Altre opzioni:\n"

#: pg_amcheck.c:1222
#, c-format
msgid "  -e, --echo                      show the commands being sent to the server\n"
msgstr "  -e, --echo                      mostra i comandi inviati al server\n"

#: pg_amcheck.c:1223
#, c-format
msgid ""
"  -j, --jobs=NUM                  use this many concurrent connections to the "
