#: help.c:484
msgid ""
"  display_true\n"
"    set the string to be printed in place of a Boolean \"true\"\n"
msgstr ""
"  display_true\n"
"    configure la chaîne à afficher à la place d'un booléen « true »\n"

#: help.c:486
msgid ""
"  expanded (or x)\n"
"    expanded output [on, off, auto]\n"
msgstr ""
"  expanded (ou x)\n"
