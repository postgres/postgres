msgstr "\"%s\" 已是视图"

#: rewrite/rewriteDefine.c:397
#, c-format
msgid "view rule for \"%s\" must be named \"%s\""
msgstr "\"%s\" 的视图规则必须命名为 \"%s\""

#: rewrite/rewriteDefine.c:422
#, c-format
msgid "cannot have multiple RETURNING lists in a rule"
msgstr "规则中不能包含多个 RETURNING 列表"

#: rewrite/rewriteDefine.c:427
#, c-format
msgid "RETURNING lists are not supported in conditional rules"
msgstr "在条件规则中不支持 RETURNING 列表"

#: rewrite/rewriteDefine.c:431
#, c-format
msgid "RETURNING lists are not supported in non-INSTEAD rules"
msgstr "在非 INSTEAD 规则中不支持 RETURNING 列表"

#: rewrite/rewriteDefine.c:445 rewrite/rewriteDefine.c:840
#, c-format
msgid "non-view rule for \"%s\" must not be named \"%s\""
msgstr "\"%s\" 的非视图规则不得命名为 \"%s\""

#: rewrite/rewriteDefine.c:519
#, c-format
msgid "SELECT rule's target list has too many entries"
msgstr "SELECT 规则的目标列表条目过多"

#: rewrite/rewriteDefine.c:520
#, c-format
msgid "RETURNING list has too many entries"
msgstr "RETURNING 列表条目过多"

#: rewrite/rewriteDefine.c:547
#, c-format
msgid "cannot convert relation containing dropped columns to view"
msgstr "不能将包含已删除列的关系转换为视图"

#: rewrite/rewriteDefine.c:548
#, c-format
msgid ""
"cannot create a RETURNING list for a relation containing dropped columns"
msgstr "不能为包含已删除列的关系创建 RETURNING 列表"

#: rewrite/rewriteDefine.c:554
#, c-format
msgid ""
"SELECT rule's target entry %d has different column name from column \"%s\""
msgstr "SELECT 规则的第 %d 个目标条目的列名与列 \"%s\" 不同"

#: rewrite/rewriteDefine.c:556
#, c-format
msgid "SELECT target entry is named \"%s\"."
msgstr "SELECT 目标条目命名为 \"%s\"。"

#: rewrite/rewriteDefine.c:565
#, c-format
msgid "SELECT rule's target entry %d has different type from column \"%s\""
msgstr "SELECT 规则的第 %d 个目标条目的类型与列 \"%s\" 不同"

#: rewrite/rewriteDefine.c:567
#, c-format
msgid "RETURNING list's entry %d has different type from column \"%s\""
msgstr "RETURNING 列表中的第 %d 项的类型与列 \"%s\" 不同"

#: rewrite/rewriteDefine.c:570 rewrite/rewriteDefine.c:594
#, c-format
msgid "SELECT target entry has type %s, but column has type %s."
msgstr "SELECT 目标条目类型为 %s，但关系中对应列的类型为 %s。"

#: rewrite/rewriteDefine.c:573 rewrite/rewriteDefine.c:598
#, c-format
msgid "RETURNING list entry has type %s, but column has type %s."
msgstr "RETURNING 列表条目类型为 %s，但关系中对应列的类型为 %s。"

#: rewrite/rewriteDefine.c:589
#, c-format
msgid "SELECT rule's target entry %d has different size from column \"%s\""
msgstr "SELECT 规则的第 %d 个目标条目的大小与列 \"%s\" 不同"

#: rewrite/rewriteDefine.c:591
#, c-format
msgid "RETURNING list's entry %d has different size from column \"%s\""
msgstr "RETURNING 列表中的第 %d 项的大小与列 \"%s\" 不同"

#: rewrite/rewriteDefine.c:608
#, c-format
msgid "SELECT rule's target list has too few entries"
msgstr "SELECT 规则的目标列表条目过少"

#: rewrite/rewriteDefine.c:609
#, c-format
msgid "RETURNING list has too few entries"
msgstr "RETURNING 列表条目过少"

#: rewrite/rewriteDefine.c:698 rewrite/rewriteDefine.c:812
#: rewrite/rewriteSupport.c:108
#, c-format
msgid "rule \"%s\" for relation \"%s\" does not exist"
msgstr "关系 \"%2$s\" 的规则 \"%1$s\" 不存在"

#: rewrite/rewriteDefine.c:831
#, c-format
msgid "renaming an ON SELECT rule is not allowed"
msgstr "不允许重命名 ON SELECT 规则"

#: rewrite/rewriteHandler.c:589
#, c-format
msgid ""
"WITH query name \"%s\" appears in both a rule action and the query being "
"rewritten"
msgstr "WITH 查询名称 \"%s\" 同时出现在规则动作和正在重写的查询中"

#: rewrite/rewriteHandler.c:619
#, c-format
msgid ""
"INSERT ... SELECT rule actions are not supported for queries having data-"
"modifying statements in WITH"
msgstr "对于 WITH 中包含数据修改语句的查询，不支持 INSERT ... SELECT 规则动作"

#: rewrite/rewriteHandler.c:705
#, c-format
msgid ""
"A rule action is INSERT ... ON CONFLICT DO SELECT, which requires a "
"RETURNING clause."
msgstr ""
"规则动作为 INSERT ... ON CONFLICT DO SELECT，该动作需要 RETURNING 子句。"

#: rewrite/rewriteHandler.c:720
#, c-format
msgid "cannot have RETURNING lists in multiple rules"
msgstr "不能在多个规则中同时指定 RETURNING 列表"

#: rewrite/rewriteHandler.c:957 rewrite/rewriteHandler.c:997
#, c-format
msgid "cannot insert a non-DEFAULT value into column \"%s\""
msgstr "不能向列 \"%s\" 插入非 DEFAULT 值"

#: rewrite/rewriteHandler.c:959 rewrite/rewriteHandler.c:1026
#, c-format
msgid "Column \"%s\" is an identity column defined as GENERATED ALWAYS."
msgstr "列 \"%s\" 是定义为 GENERATED ALWAYS 的标识列。"

#: rewrite/rewriteHandler.c:961
#, c-format
msgid "Use OVERRIDING SYSTEM VALUE to override."
msgstr "使用 OVERRIDING SYSTEM VALUE 覆盖。"

#: rewrite/rewriteHandler.c:1024 rewrite/rewriteHandler.c:1032
#, c-format
msgid "column \"%s\" can only be updated to DEFAULT"
msgstr "列 \"%s\" 只能更新为 DEFAULT"

#: rewrite/rewriteHandler.c:1168 rewrite/rewriteHandler.c:1186
#, c-format
msgid "multiple assignments to same column \"%s\""
msgstr "对同一列 \"%s\" 进行多次赋值"

#: rewrite/rewriteHandler.c:1741
#, c-format
msgid "MERGE is not supported for relations with rules."
msgstr "具有规则的关系不支持 MERGE。"

#: rewrite/rewriteHandler.c:1781 rewrite/rewriteHandler.c:3353
#, c-format
msgid "access to non-system view \"%s\" is restricted"
msgstr "对非系统视图 \"%s\" 的访问受限"

#: rewrite/rewriteHandler.c:2180 rewrite/rewriteHandler.c:4364
#, c-format
msgid "infinite recursion detected in rules for relation \"%s\""
msgstr "在关系 \"%s\" 的规则中检测到无限递归"

#: rewrite/rewriteHandler.c:2285
#, c-format
msgid "infinite recursion detected in policy for relation \"%s\""
msgstr "在关系 \"%s\" 的策略中检测到无限递归"

#: rewrite/rewriteHandler.c:2680
msgid "Junk view columns are not updatable."
msgstr "视图的辅助列不能更新。"

#: rewrite/rewriteHandler.c:2685
msgid ""
"View columns that are not columns of their base relation are not updatable."
msgstr "不对应基础关系列的视图列不能更新。"

#: rewrite/rewriteHandler.c:2688
msgid "View columns that refer to system columns are not updatable."
msgstr "引用系统列的视图列不能更新。"

#: rewrite/rewriteHandler.c:2691
msgid "View columns that return whole-row references are not updatable."
msgstr "返回整行引用的视图列不能更新。"

#: rewrite/rewriteHandler.c:2752
msgid "Views containing DISTINCT are not automatically updatable."
msgstr "包含 DISTINCT 的视图不能自动更新。"

#: rewrite/rewriteHandler.c:2755
msgid "Views containing GROUP BY are not automatically updatable."
msgstr "包含 GROUP BY 的视图不能自动更新。"

#: rewrite/rewriteHandler.c:2758
msgid "Views containing HAVING are not automatically updatable."
msgstr "包含 HAVING 的视图不能自动更新。"

#: rewrite/rewriteHandler.c:2761
msgid ""
"Views containing UNION, INTERSECT, or EXCEPT are not automatically updatable."
msgstr "包含 UNION, INTERSECT 或 EXCEPT 的视图不能自动更新。"

#: rewrite/rewriteHandler.c:2764
msgid "Views containing WITH are not automatically updatable."
msgstr "包含 WITH 的视图不能自动更新。"

#: rewrite/rewriteHandler.c:2767
msgid "Views containing LIMIT or OFFSET are not automatically updatable."
msgstr "包含 LIMIT 或 OFFSET 的视图不能自动更新。"

#: rewrite/rewriteHandler.c:2779
msgid "Views that return aggregate functions are not automatically updatable."
msgstr "视图输出聚合函数的结果时，不能自动更新。"

#: rewrite/rewriteHandler.c:2782
msgid "Views that return window functions are not automatically updatable."
msgstr "视图输出窗口函数的结果时，不能自动更新。"

#: rewrite/rewriteHandler.c:2785
msgid ""
"Views that return set-returning functions are not automatically updatable."
msgstr "视图输出返回集合的函数的结果时，不能自动更新。"

#: rewrite/rewriteHandler.c:2792 rewrite/rewriteHandler.c:2796
#: rewrite/rewriteHandler.c:2804
msgid ""
"Views that do not select from a single table or view are not automatically "
"updatable."
msgstr "不来自单表或单视图的视图不能自动更新。"

#: rewrite/rewriteHandler.c:2807
msgid "Views containing TABLESAMPLE are not automatically updatable."
msgstr "包含 TABLESAMPLE 的视图不能自动更新。"

#: rewrite/rewriteHandler.c:2831
msgid "Views that have no updatable columns are not automatically updatable."
msgstr "没有可更新列的视图不能自动更新。"

#: rewrite/rewriteHandler.c:3212 rewrite/rewriteHandler.c:3247
#, c-format
msgid "cannot insert into view \"%s\""
msgstr "不能向视图 \"%s\" 插入数据"

#: rewrite/rewriteHandler.c:3215
#, c-format
msgid ""
"To enable inserting into the view, provide an INSTEAD OF INSERT trigger or "
"an unconditional ON INSERT DO INSTEAD rule."
msgstr ""
"要启用视图的插入操作，提供 INSTEAD OF INSERT 触发器或无条件的 ON INSERT DO "
"INSTEAD 规则。"

#: rewrite/rewriteHandler.c:3220 rewrite/rewriteHandler.c:3256
#, c-format
msgid "cannot update view \"%s\""
msgstr "不能更新视图 \"%s\""

#: rewrite/rewriteHandler.c:3223
#, c-format
msgid ""
"To enable updating the view, provide an INSTEAD OF UPDATE trigger or an "
"unconditional ON UPDATE DO INSTEAD rule."
msgstr ""
"要启用视图的更新操作，提供 INSTEAD OF UPDATE 触发器或无条件的 ON UPDATE DO "
"INSTEAD 规则。"

#: rewrite/rewriteHandler.c:3228 rewrite/rewriteHandler.c:3265
#, c-format
msgid "cannot delete from view \"%s\""
msgstr "不能从视图 \"%s\" 中删除数据"

#: rewrite/rewriteHandler.c:3231
#, c-format
msgid ""
"To enable deleting from the view, provide an INSTEAD OF DELETE trigger or an "
"unconditional ON DELETE DO INSTEAD rule."
msgstr ""
"要启用视图的删除操作，提供 INSTEAD OF DELETE 触发器或无条件的 ON DELETE DO "
"INSTEAD 规则。"

#: rewrite/rewriteHandler.c:3250
#, c-format
msgid ""
"To enable inserting into the view using MERGE, provide an INSTEAD OF INSERT "
"trigger."
msgstr "要启用 MERGE 对视图的插入操作，提供 INSTEAD OF INSERT 触发器。"

#: rewrite/rewriteHandler.c:3259
#, c-format
msgid ""
"To enable updating the view using MERGE, provide an INSTEAD OF UPDATE "
"trigger."
msgstr "要启用 MERGE 对视图的更新操作，提供 INSTEAD OF UPDATE 触发器。"

#: rewrite/rewriteHandler.c:3268
#, c-format
msgid ""
"To enable deleting from the view using MERGE, provide an INSTEAD OF DELETE "
"trigger."
msgstr "要启用 MERGE 对视图的删除操作，提供 INSTEAD OF DELETE 触发器。"

#: rewrite/rewriteHandler.c:3443
#, c-format
msgid "cannot insert into column \"%s\" of view \"%s\""
msgstr "不能向视图 \"%2$s\" 的列 \"%1$s\" 插入数据"

#: rewrite/rewriteHandler.c:3451
#, c-format
msgid "cannot update column \"%s\" of view \"%s\""
msgstr "不能更新视图 \"%2$s\" 的列 \"%1$s\""

#: rewrite/rewriteHandler.c:3459
#, c-format
msgid "cannot merge into column \"%s\" of view \"%s\""
msgstr "不能向视图 \"%2$s\" 的列 \"%1$s\" 合并数据"

#: rewrite/rewriteHandler.c:3487
#, c-format
msgid "cannot merge into view \"%s\""
msgstr "不能向视图 \"%s\" 合并数据"

#: rewrite/rewriteHandler.c:3489
#, c-format
msgid ""
"MERGE is not supported for views with INSTEAD OF triggers for some actions "
"but not all."
msgstr ""
"如果视图仅为部分动作定义 INSTEAD OF 触发器，而未涵盖所有动作，则不支持 "
"MERGE。"

#: rewrite/rewriteHandler.c:3490
#, c-format
msgid ""
"To enable merging into the view, either provide a full set of INSTEAD OF "
"triggers or drop the existing INSTEAD OF triggers."
msgstr ""
"要启用视图的合并操作，提供全套 INSTEAD OF 触发器，或删除已有的 INSTEAD OF 触"
"发器。"

#: rewrite/rewriteHandler.c:4021
#, c-format
msgid ""
"DO INSTEAD NOTIFY rules are not supported for data-modifying statements in "
"WITH"
msgstr "WITH 中的数据修改语句不支持 DO INSTEAD NOTIFY 规则"

#: rewrite/rewriteHandler.c:4032
#, c-format
msgid ""
"DO INSTEAD NOTHING rules are not supported for data-modifying statements in "
"WITH"
msgstr "WITH 中的数据修改语句不支持 DO INSTEAD NOTHING 规则"

#: rewrite/rewriteHandler.c:4046
#, c-format
msgid ""
"conditional DO INSTEAD rules are not supported for data-modifying statements "
"in WITH"
msgstr "WITH 中的数据修改语句不支持带条件的 DO INSTEAD 规则"

#: rewrite/rewriteHandler.c:4050
#, c-format
msgid "DO ALSO rules are not supported for data-modifying statements in WITH"
msgstr "WITH 中的数据修改语句不支持 DO ALSO 规则"

#: rewrite/rewriteHandler.c:4055
#, c-format
msgid ""
"multi-statement DO INSTEAD rules are not supported for data-modifying "
"statements in WITH"
msgstr "WITH 中的数据修改语句不支持多语句 DO INSTEAD 规则"

#: rewrite/rewriteHandler.c:4316
msgid ""
"Views with conditional DO INSTEAD rules are not automatically updatable."
msgstr "具有带条件的 DO INSTEAD 规则的视图不能自动更新。"

#: rewrite/rewriteHandler.c:4414
#, c-format
msgid "cannot perform INSERT RETURNING on relation \"%s\""
msgstr "不能在关系 \"%s\" 上执行 INSERT RETURNING"

#: rewrite/rewriteHandler.c:4416
#, c-format
msgid ""
"You need an unconditional ON INSERT DO INSTEAD rule with a RETURNING clause."
msgstr "您需要带有 RETURNING 子句的无条件 ON INSERT DO INSTEAD 规则。"

#: rewrite/rewriteHandler.c:4421
#, c-format
msgid "cannot perform UPDATE RETURNING on relation \"%s\""
msgstr "不能在关系 \"%s\" 上执行 UPDATE RETURNING"

#: rewrite/rewriteHandler.c:4423
#, c-format
msgid ""
"You need an unconditional ON UPDATE DO INSTEAD rule with a RETURNING clause."
msgstr "您需要带有 RETURNING 子句的无条件 ON UPDATE DO INSTEAD 规则。"

#: rewrite/rewriteHandler.c:4428
#, c-format
msgid "cannot perform DELETE RETURNING on relation \"%s\""
msgstr "不能在关系 \"%s\" 上执行 DELETE RETURNING"

#: rewrite/rewriteHandler.c:4430
#, c-format
msgid ""
"You need an unconditional ON DELETE DO INSTEAD rule with a RETURNING clause."
msgstr "您需要带有 RETURNING 子句的无条件 ON DELETE DO INSTEAD 规则。"

#: rewrite/rewriteHandler.c:4448
#, c-format
msgid ""
"INSERT with ON CONFLICT clause cannot be used with table that has INSERT or "
"UPDATE rules"
msgstr ""
"不能对具有 INSERT 或者 UPDATE 规则的表使用带有 ON CONFLICT 子句的 INSERT"

#: rewrite/rewriteHandler.c:4505
#, c-format
msgid ""
"WITH cannot be used in a query that is rewritten by rules into multiple "
"queries"
msgstr "WITH 不能用于被规则重写为多个查询的查询中"

#: rewrite/rewriteManip.c:1193
#, c-format
msgid "conditional utility statements are not implemented"
msgstr "条件工具语句未实现"

#: rewrite/rewriteManip.c:1925
#, c-format
msgid ""
"NEW variables in ON UPDATE rules cannot reference columns that are part of a "
"multiple assignment in the subject UPDATE command"
msgstr "ON UPDATE 规则中的 NEW 变量不能引用主 UPDATE 命令中参与多重赋值的列"

#: rewrite/rewriteSearchCycle.c:410
#, c-format
msgid ""
"with a SEARCH or CYCLE clause, the recursive reference to WITH query \"%s\" "
"must be at the top level of its right-hand SELECT"
msgstr ""
"带有 SEARCH 或 CYCLE 子句时，对 WITH 查询 \"%s\" 的递归引用必须位于其右侧 "
"SELECT 的顶层"

