"                                 per recuperare i file WAL dagli archivi\n"

#: pg_rewind.c:99
#, c-format
msgid "  -D, --target-pgdata=DIRECTORY  existing data directory to modify\n"
msgstr ""
"  -D, --target-pgdata=DIRECTORY  directory dei dati esistente da modificare\n"

#: pg_rewind.c:100
#, c-format
