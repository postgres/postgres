"\n"

#: pg_basebackup.c:395 pg_createsubscriber.c:287 pg_receivewal.c:79 pg_recvlogical.c:86
#, c-format
msgid "Usage:\n"
msgstr "Uso:\n"

#: pg_basebackup.c:396 pg_createsubscriber.c:288 pg_receivewal.c:80 pg_recvlogical.c:87
#, c-format
msgid "  %s [OPTION]...\n"
msgstr "  %s [OPZIONE]...\n"

#: pg_basebackup.c:397
#, c-format
msgid ""
"\n"
"Options controlling the output:\n"
msgstr ""
"\n"
"Opzioni per il controllo dell'output:\n"

#: pg_basebackup.c:398
#, c-format
msgid "  -D, --pgdata=DIRECTORY receive base backup into directory\n"
msgstr "  -D, --pgdata=DIRECTORY riceve il base backup in questa directory\n"

#: pg_basebackup.c:399
#, c-format
msgid "  -F, --format=p|t       output format (plain (default), tar)\n"
msgstr "  -F, --format=p|t       formato di output (plain (predefinito), tar)\n"

#: pg_basebackup.c:400
#, c-format
msgid ""
"  -i, --incremental=OLDMANIFEST\n"
"                         take incremental backup\n"
msgstr ""
"  -i, --incremental=VECCHIOMANIFEST\n"
"                         esegui un backup incrementale\n"

#: pg_basebackup.c:402
#, c-format
msgid ""
"  -r, --max-rate=RATE    maximum transfer rate to transfer data directory\n"
"                         (in kB/s, or use suffix \"k\" or \"M\")\n"
msgstr ""
"  -r, --max-rate=VELOCITA velocità massima di trasferimento della directory dei dati\n"
"                         (in kB/s, oppure usa il suffisso \"k\" o \"M\")\n"

#: pg_basebackup.c:404
#, c-format
msgid ""
"  -R, --write-recovery-conf\n"
"                         write configuration for replication\n"
msgstr ""
"  -R, --write-recovery-conf\n"
"                         scrivi la configurazione per la replica\n"

#: pg_basebackup.c:406
#, c-format
msgid ""
"  -t, --target=TARGET[:DETAIL]\n"
"                         backup target (if other than client)\n"
msgstr ""
"  -t, --target=TARGET[:DETTAGLIO]\n"
"                         destinazione del backup (se diversa dal client)\n"

#: pg_basebackup.c:408
#, c-format
msgid ""
"  -T, --tablespace-mapping=OLDDIR=NEWDIR\n"
"                         relocate tablespace in OLDDIR to NEWDIR\n"
msgstr ""
"  -T, --tablespace-mapping=VECCHIADIR=NUOVADIR\n"
"                         sposta il tablespace da VECCHIADIR a NUOVADIR\n"

#: pg_basebackup.c:410
#, c-format
msgid "      --waldir=WALDIR    location for the write-ahead log directory\n"
msgstr "      --waldir=WALDIR    posizione della directory del write-ahead log\n"

#: pg_basebackup.c:411
#, c-format
msgid ""
"  -X, --wal-method=none|fetch|stream\n"
"                         include required WAL files with specified method\n"
msgstr ""
