#: help.c:279
msgid "Large Objects\n"
msgstr "大对象\n"

#: help.c:280
msgid "  \\lo_export LOBOID FILE write large object to file\n"
msgstr "  \\lo_export LOBOID FILE 将大对象写入文件\n"

#: help.c:281
msgid ""
"  \\lo_import FILE [COMMENT]\n"
"                         read large object from file\n"
msgstr ""
"  \\lo_import FILE [COMMENT]\n"
"                         从文件读取大对象\n"

#: help.c:283
msgid "  \\lo_list[x+]           list large objects\n"
msgstr "  \\lo_list[x+]           列出大对象\n"

#: help.c:284
msgid "  \\lo_unlink LOBOID      delete a large object\n"
msgstr "  \\lo_unlink LOBOID      删除大对象\n"

#: help.c:287
msgid "Formatting\n"
msgstr "格式化\n"

#: help.c:288
msgid ""
"  \\a                     toggle between unaligned and aligned output mode\n"
msgstr "  \\a                     在非对齐模式和对齐模式之间切换\n"

#: help.c:289
msgid "  \\C [STRING]            set table title, or unset if none\n"
msgstr "  \\C [STRING]            设置表格标题，不带参数时清除标题\n"

#: help.c:290
msgid ""
"  \\f [STRING]            show or set field separator for unaligned query "
"output\n"
msgstr "  \\f [STRING]            显示或设置非对齐模式查询输出的字段分隔符\n"

#: help.c:291
#, c-format
msgid "  \\H                     toggle HTML output mode (currently %s)\n"
msgstr "  \\H                     切换 HTML 输出模式（当前为 %s）\n"

#: help.c:293
msgid ""
"  \\pset [NAME [VALUE]]   set table output option\n"
"                         (border|columns|csv_fieldsep|expanded|fieldsep|\n"
"                         fieldsep_zero|footer|format|linestyle|null|\n"
"                         numericlocale|pager|pager_min_lines|recordsep|\n"
"                         recordsep_zero|tableattr|title|tuples_only|\n"
"                         unicode_border_linestyle|unicode_column_linestyle|\n"
"                         unicode_header_linestyle|xheader_width)\n"
msgstr ""
"  \\pset [NAME [VALUE]]   设置表格输出选项\n"
"                         (border|columns|csv_fieldsep|expanded|fieldsep|\n"
"                         fieldsep_zero|footer|format|linestyle|null|\n"
"                         numericlocale|pager|pager_min_lines|recordsep|\n"
"                         recordsep_zero|tableattr|title|tuples_only|\n"
"                         unicode_border_linestyle|unicode_column_linestyle|\n"
"                         unicode_header_linestyle|xheader_width)\n"

#: help.c:300
#, c-format
msgid "  \\t [on|off]            show only rows (currently %s)\n"
msgstr "  \\t [on|off]            只显示行（当前为 %s）\n"

#: help.c:302
msgid ""
"  \\T [STRING]            set HTML <table> tag attributes, or unset if none\n"
msgstr ""
"  \\T [STRING]            设置 HTML <table> 标签属性，不带参数时清除设置\n"

#: help.c:303
#, c-format
msgid "  \\x [on|off|auto]       toggle expanded output (currently %s)\n"
msgstr "  \\x [on|off|auto]       切换扩展输出模式（当前为 %s）\n"

#: help.c:304
msgid "auto"
msgstr "自动"

#: help.c:307
msgid "Connection\n"
msgstr "连接\n"

#: help.c:309
#, c-format
msgid ""
"  \\c[onnect] {[DBNAME|- USER|- HOST|- PORT|-] | conninfo}\n"
"                         connect to new database (currently \"%s\")\n"
msgstr ""
"  \\c[onnect] {[DBNAME|- USER|- HOST|- PORT|-] | conninfo}\n"
"                         连接到新数据库（当前为 \"%s\"）\n"

#: help.c:313
msgid ""
"  \\c[onnect] {[DBNAME|- USER|- HOST|- PORT|-] | conninfo}\n"
"                         connect to new database (currently no connection)\n"
msgstr ""
"  \\c[onnect] {[DBNAME|- USER|- HOST|- PORT|-] | conninfo}\n"
"                         连接到新数据库（当前无连接）\n"

#: help.c:315
msgid ""
"  \\conninfo              display information about current connection\n"
msgstr "  \\conninfo              显示当前连接的相关信息\n"

#: help.c:316
msgid "  \\encoding [ENCODING]   show or set client encoding\n"
msgstr "  \\encoding [ENCODING]   显示或设置客户端编码\n"

#: help.c:317
msgid "  \\password [USERNAME]   securely change the password for a user\n"
msgstr "  \\password [USERNAME]   安全地为用户更改密码\n"

#: help.c:320
msgid "Operating System\n"
msgstr "操作系统\n"

#: help.c:321
msgid "  \\cd [DIR]              change the current working directory\n"
msgstr "  \\cd [DIR]              更改目前的工作目录\n"

#: help.c:322
msgid "  \\getenv PSQLVAR ENVVAR fetch environment variable\n"
msgstr "  \\getenv PSQLVAR ENVVAR 获取环境变量\n"

#: help.c:323
msgid "  \\setenv NAME [VALUE]   set or unset environment variable\n"
msgstr "  \\setenv NAME [VALUE]   设置或取消设置环境变量\n"

#: help.c:324
#, c-format
msgid "  \\timing [on|off]       toggle timing of commands (currently %s)\n"
msgstr "  \\timing [on|off]       切换命令计时（当前为 %s）\n"

#: help.c:326
msgid ""
"  \\! [COMMAND]           execute command in shell or start interactive "
"shell\n"
msgstr "  \\! [COMMAND]           在 shell 中执行命令或启动交互式 shell\n"

#: help.c:329
msgid "Variables\n"
msgstr "变量\n"

#: help.c:330
msgid "  \\prompt [TEXT] NAME    prompt user to set internal variable\n"
msgstr "  \\prompt [TEXT] NAME    提示用户设置内部变量\n"

#: help.c:331
msgid ""
"  \\set [NAME [VALUE]]    set internal variable, or list all if no "
"parameters\n"
msgstr "  \\set [NAME [VALUE]]    设置内部变量，若无参数则列出全部变量\n"

#: help.c:332
msgid "  \\unset NAME            unset (delete) internal variable\n"
msgstr "  \\unset NAME            取消设置（删除）内部变量\n"

#: help.c:335
msgid "Extended Query Protocol\n"
msgstr "扩展查询协议\n"

#: help.c:336
msgid "  \\bind [PARAM]...       set query parameters\n"
msgstr "  \\bind [PARAM]...       设置查询参数\n"

#: help.c:337
msgid ""
"  \\bind_named STMT_NAME [PARAM]...\n"
"                         set query parameters for an existing prepared "
"statement\n"
msgstr ""
"  \\bind_named STMT_NAME [PARAM]...\n"
"                         设置已有预备语句的查询参数\n"

#: help.c:339
msgid ""
"  \\close_prepared STMT_NAME\n"
"                         close an existing prepared statement\n"
msgstr ""
"  \\close_prepared STMT_NAME\n"
"                         关闭已有预备语句\n"

#: help.c:341
msgid "  \\endpipeline           exit pipeline mode\n"
msgstr "  \\endpipeline           退出流水线模式\n"

#: help.c:342
msgid "  \\flush                 flush output data to the server\n"
msgstr "  \\flush                 将输出数据刷新到服务器\n"

#: help.c:343
msgid ""
"  \\flushrequest          send request to the server to flush its output "
"buffer\n"
msgstr "  \\flushrequest          请求服务器刷新其输出缓冲区\n"

#: help.c:344
msgid ""
"  \\getresults [NUM_RES]  read NUM_RES pending results, or all if no "
"argument\n"
msgstr ""
"  \\getresults [NUM_RES]  读取 NUM_RES 个待处理结果，不带参数时读取全部\n"

#: help.c:345
msgid "  \\parse STMT_NAME       create a prepared statement\n"
msgstr "  \\parse STMT_NAME       创建预备语句\n"

#: help.c:346
msgid ""
"  \\sendpipeline          send an extended query to an ongoing pipeline\n"
msgstr "  \\sendpipeline          向正在进行的流水线发送扩展查询\n"

#: help.c:347
msgid "  \\startpipeline         enter pipeline mode\n"
msgstr "  \\startpipeline         进入流水线模式\n"

#: help.c:348
msgid ""
"  \\syncpipeline          add a synchronisation point to an ongoing "
"pipeline\n"
msgstr "  \\syncpipeline          向正在进行的流水线添加同步点\n"

#: help.c:387
msgid ""
"List of specially treated variables\n"
"\n"
msgstr ""
"特殊处理变量列表\n"
"\n"

#: help.c:389
msgid "psql variables:\n"
msgstr "psql 变量:\n"

#: help.c:391
msgid ""
"  psql --set=NAME=VALUE\n"
"  or \\set NAME VALUE inside psql\n"
"\n"
msgstr ""
"  psql --set=NAME=VALUE\n"
"  或在 psql 中执行 \\set NAME VALUE\n"
"\n"

#: help.c:393
msgid ""
"  AUTOCOMMIT\n"
"    if set, successful SQL commands are automatically committed\n"
msgstr ""
"  AUTOCOMMIT\n"
"    设置后，成功的 SQL 命令会自动提交\n"

#: help.c:395
msgid ""
"  COMP_KEYWORD_CASE\n"
"    determines the case used to complete SQL key words\n"
"    [lower, upper, preserve-lower, preserve-upper]\n"
msgstr ""
"  COMP_KEYWORD_CASE\n"
"    决定 SQL 关键字补全所用的大小写\n"
"    [lower, upper, preserve-lower, preserve-upper]\n"

#: help.c:398
msgid ""
"  DBNAME\n"
"    the currently connected database name\n"
msgstr ""
"  DBNAME\n"
"    当前已连接的数据库名\n"

#: help.c:400
msgid ""
"  ECHO\n"
"    controls what input is written to standard output\n"
"    [all, errors, none, queries]\n"
msgstr ""
"  ECHO\n"
"    控制将哪些输入写入标准输出\n"
"    [all, errors, none, queries]\n"

#: help.c:403
msgid ""
"  ECHO_HIDDEN\n"
"    if set, display internal queries executed by backslash commands;\n"
"    if set to \"noexec\", just show them without execution\n"
msgstr ""
"  ECHO_HIDDEN\n"
"    设置后显示反斜杠命令执行的内部查询；\n"
"    设为 \"noexec\" 时只显示而不执行\n"

#: help.c:406
msgid ""
"  ENCODING\n"
"    current client character set encoding\n"
msgstr ""
"  ENCODING\n"
"    当前的客户端字符集编码\n"

#: help.c:408
msgid ""
"  ERROR\n"
"    \"true\" if last query failed, else \"false\"\n"
msgstr ""
"  ERROR\n"
"    上次查询失败时为 \"true\"，否则为 \"false\"\n"

#: help.c:410
msgid ""
"  FETCH_COUNT\n"
"    the number of result rows to fetch and display at a time (0 = "
"unlimited)\n"
msgstr ""
"  FETCH_COUNT\n"
"    每次获取并显示的结果行数（0 = 无限制）\n"

#: help.c:412
msgid ""
"  HIDE_TABLEAM\n"
"    if set, table access methods are not displayed\n"
msgstr ""
"  HIDE_TABLEAM\n"
"    如果设置，则不显示表访问方法\n"

#: help.c:414
msgid ""
"  HIDE_TOAST_COMPRESSION\n"
"    if set, compression methods are not displayed\n"
msgstr ""
"  HIDE_TOAST_COMPRESSION\n"
"    如果设置，则不显示压缩方法\n"

#: help.c:416
msgid ""
"  HISTCONTROL\n"
"    controls command history [ignorespace, ignoredups, ignoreboth]\n"
msgstr ""
"  HISTCONTROL\n"
"    控制命令历史记录 [ignorespace, ignoredups, ignoreboth]\n"

#: help.c:418
msgid ""
"  HISTFILE\n"
"    file name used to store the command history\n"
msgstr ""
"  HISTFILE\n"
"    用来存储命令历史记录的文件名\n"

#: help.c:420
msgid ""
"  HISTSIZE\n"
"    maximum number of commands to store in the command history\n"
msgstr ""
"  HISTSIZE\n"
"    保存在命令历史记录中的最大命令数\n"

#: help.c:422
msgid ""
"  HOST\n"
"    the currently connected database server host\n"
msgstr ""
"  HOST\n"
"    当前已连接的数据库服务器主机\n"

#: help.c:424
msgid ""
"  IGNOREEOF\n"
"    number of EOFs needed to terminate an interactive session\n"
msgstr ""
"  IGNOREEOF\n"
"    终止交互式会话所需的 EOF 数\n"

#: help.c:426
msgid ""
"  LASTOID\n"
"    value of the last affected OID\n"
msgstr ""
"  LASTOID\n"
"    最后一个受影响的 OID 的值\n"

#: help.c:428
msgid ""
"  LAST_ERROR_MESSAGE\n"
"  LAST_ERROR_SQLSTATE\n"
"    message and SQLSTATE of last error, or empty string and \"00000\" if "
"none\n"
msgstr ""
"  LAST_ERROR_MESSAGE\n"
"  LAST_ERROR_SQLSTATE\n"
"    最近错误的消息和 SQLSTATE，无错误时分别为空字符串和 \"00000\"\n"

#: help.c:431
msgid ""
"  ON_ERROR_ROLLBACK\n"
"    if set, an error doesn't stop a transaction (uses implicit savepoints)\n"
msgstr ""
"  ON_ERROR_ROLLBACK\n"
"    设置后，错误不会停止事务（使用隐式保存点）\n"

#: help.c:433
msgid ""
"  ON_ERROR_STOP\n"
"    stop batch execution after error\n"
msgstr ""
"  ON_ERROR_STOP\n"
"    发生错误后停止批量执行\n"

#: help.c:435
msgid ""
"  PORT\n"
"    server port of the current connection\n"
msgstr ""
"  PORT\n"
"    当前连接的服务器端口\n"

#: help.c:437
msgid ""
"  PROMPT1\n"
"    specifies the standard psql prompt\n"
msgstr ""
"  PROMPT1\n"
"    指定标准的 psql 提示符\n"

#: help.c:439
msgid ""
"  PROMPT2\n"
"    specifies the prompt used when a statement continues from a previous "
"line\n"
msgstr ""
"  PROMPT2\n"
"    指定在语句跨行时使用的提示符\n"

#: help.c:441
msgid ""
"  PROMPT3\n"
"    specifies the prompt used during COPY ... FROM STDIN\n"
msgstr ""
"  PROMPT3\n"
"    指定 COPY ... FROM STDIN 期间使用的提示符\n"

#: help.c:443
msgid ""
"  QUIET\n"
"    run quietly (same as -q option)\n"
msgstr ""
"  QUIET\n"
"    静默运行（和 -q 选项相同）\n"

#: help.c:445
msgid ""
"  ROW_COUNT\n"
"    number of rows returned or affected by last query, or 0\n"
msgstr ""
"  ROW_COUNT\n"
"    上一个查询返回或影响的行数，或 0\n"

#: help.c:447
msgid ""
"  SERVER_VERSION_NAME\n"
"  SERVER_VERSION_NUM\n"
"    server's version (in short string or numeric format)\n"
msgstr ""
"  SERVER_VERSION_NAME\n"
"  SERVER_VERSION_NUM\n"
"    服务器版本（短字符串或数值格式）\n"

#: help.c:450
msgid ""
"  SHELL_ERROR\n"
"    \"true\" if the last shell command failed, \"false\" if it succeeded\n"
msgstr ""
"  SHELL_ERROR\n"
"    上次 shell 命令失败时为 \"true\"，成功时为 \"false\"\n"

#: help.c:452
msgid ""
"  SHELL_EXIT_CODE\n"
"    exit status of the last shell command\n"
msgstr ""
"  SHELL_EXIT_CODE\n"
"    上次 shell 命令的退出状态\n"

#: help.c:454
msgid ""
"  SHOW_ALL_RESULTS\n"
"    show all results of a combined query (\\;) instead of only the last\n"
msgstr ""
"  SHOW_ALL_RESULTS\n"
"    显示组合查询（\\;）的全部结果，而不仅是最后一个\n"

#: help.c:456
msgid ""
"  SHOW_CONTEXT\n"
"    controls display of message context fields [never, errors, always]\n"
msgstr ""
"  SHOW_CONTEXT\n"
"    控制消息上下文字段的显示 [never, errors, always]\n"

#: help.c:458
msgid ""
"  SINGLELINE\n"
"    if set, end of line terminates SQL commands (same as -S option)\n"
msgstr ""
"  SINGLELINE\n"
"    设置后，行末终止 SQL 命令（与 -S 选项相同）\n"

#: help.c:460
msgid ""
"  SINGLESTEP\n"
"    single-step mode (same as -s option)\n"
msgstr ""
"  SINGLESTEP\n"
"    单步模式（与 -s 选项相同）\n"

#: help.c:462
msgid ""
"  SQLSTATE\n"
"    SQLSTATE of last query, or \"00000\" if no error\n"
msgstr ""
"  SQLSTATE\n"
"    最近查询的 SQLSTATE，无错误时为 \"00000\"\n"

#: help.c:464
msgid ""
"  USER\n"
"    the currently connected database user\n"
msgstr ""
"  USER\n"
"    当前已连接的数据库用户\n"

#: help.c:466
msgid ""
"  VERBOSITY\n"
"    controls verbosity of error reports [default, verbose, terse, sqlstate]\n"
msgstr ""
"  VERBOSITY\n"
"    控制错误报告的详细程度 [default, verbose, terse, sqlstate]\n"

#: help.c:468
msgid ""
"  VERSION\n"
"  VERSION_NAME\n"
"  VERSION_NUM\n"
"    psql's version (in verbose string, short string, or numeric format)\n"
msgstr ""
"  VERSION\n"
"  VERSION_NAME\n"
"  VERSION_NUM\n"
"    psql 版本（详细字符串、短字符串或数值格式）\n"

#: help.c:472
#, c-format
msgid ""
"  WATCH_INTERVAL\n"
"    number of seconds \\watch waits between executions (default %s)\n"
msgstr ""
"  WATCH_INTERVAL\n"
"    \\watch 两次执行之间等待的秒数（默认为 %s）\n"

#: help.c:476
msgid ""
"\n"
"Display settings:\n"
msgstr ""
"\n"
"显示设置:\n"

#: help.c:478
msgid ""
"  psql --pset=NAME[=VALUE]\n"
"  or \\pset NAME [VALUE] inside psql\n"
"\n"
msgstr ""
"  psql --pset=NAME[=VALUE]\n"
"  或在 psql 中执行 \\pset NAME [VALUE]\n"
"\n"

#: help.c:480
msgid ""
"  border\n"
"    border style (number)\n"
msgstr ""
"  border\n"
"    边框样式（数字）\n"

#: help.c:482
msgid ""
"  columns\n"
"    target width for the wrapped format\n"
msgstr ""
"  columns\n"
"    wrapped 格式的目标宽度\n"

#: help.c:484
#, c-format
msgid ""
"  csv_fieldsep\n"
"    field separator for CSV output format (default \"%c\")\n"
msgstr ""
"  csv_fieldsep\n"
"    CSV 输出格式的字段分隔符（默认为 \"%c\"）\n"

#: help.c:487
msgid ""
"  expanded (or x)\n"
"    expanded output [on, off, auto]\n"
msgstr ""
"  expanded（或 x）\n"
"    扩展输出 [on, off, auto]\n"

#: help.c:489
#, c-format
msgid ""
"  fieldsep\n"
"    field separator for unaligned output (default \"%s\")\n"
msgstr ""
"  fieldsep\n"
"    非对齐输出的字段分隔符（默认为 \"%s\"）\n"

#: help.c:492
msgid ""
"  fieldsep_zero\n"
"    set field separator for unaligned output to a zero byte\n"
msgstr ""
"  fieldsep_zero\n"
"    将非对齐输出的字段分隔符设为空字节\n"

#: help.c:494
msgid ""
"  footer\n"
"    enable or disable display of the table footer [on, off]\n"
msgstr ""
"  footer\n"
"    启用或禁用表格页脚的显示 [on, off]\n"

#: help.c:496
msgid ""
"  format\n"
"    set output format [unaligned, aligned, wrapped, html, asciidoc, ...]\n"
msgstr ""
"  format\n"
"    设置输出格式 [unaligned, aligned, wrapped, html, asciidoc, ...]\n"

#: help.c:498
msgid ""
"  linestyle\n"
"    set the border line drawing style [ascii, old-ascii, unicode]\n"
msgstr ""
"  linestyle\n"
"    设置边框线型 [ascii, old-ascii, unicode]\n"

#: help.c:500
msgid ""
"  null\n"
"    set the string to be printed in place of a null value\n"
msgstr ""
"  null\n"
"    设置用于替代 NULL 值的打印字符串\n"

#: help.c:502
msgid ""
"  numericlocale\n"
"    enable display of a locale-specific character to separate groups of "
"digits\n"
msgstr ""
"  numericlocale\n"
"    启用数字分组分隔符显示，分隔符由区域设置决定\n"

#: help.c:504
msgid ""
"  pager\n"
"    control when an external pager is used [yes, no, always]\n"
msgstr ""
"  pager\n"
"    控制何时使用外部分页器 [yes, no, always]\n"

#: help.c:506
msgid ""
"  recordsep\n"
"    record (line) separator for unaligned output\n"
msgstr ""
"  recordsep\n"
"    用于非对齐输出中的记录（行）分隔符\n"

#: help.c:508
msgid ""
"  recordsep_zero\n"
"    set record separator for unaligned output to a zero byte\n"
msgstr ""
"  recordsep_zero\n"
"    将非对齐输出的记录分隔符设为空字节\n"

#: help.c:510
msgid ""
"  tableattr (or T)\n"
"    specify attributes for table tag in html format, or proportional\n"
"    column widths for left-aligned data types in latex-longtable format\n"
msgstr ""
"  tableattr（或者 T）\n"
"    指定 html 格式中表格标签的属性\n"
"    或者 latex-longtable 格式中左对齐数据类型的比例列宽\n"

#: help.c:513
msgid ""
"  title\n"
"    set the table title for subsequently printed tables\n"
msgstr ""
"  title\n"
"    为后续打印的表格设置标题\n"

#: help.c:515
msgid ""
"  tuples_only\n"
"    if set, only actual table data is shown\n"
msgstr ""
"  tuples_only\n"
"    设置后，只显示实际的表格数据\n"

#: help.c:517
msgid ""
"  unicode_border_linestyle\n"
"  unicode_column_linestyle\n"
"  unicode_header_linestyle\n"
"    set the style of Unicode line drawing [single, double]\n"
msgstr ""
"  unicode_border_linestyle\n"
"  unicode_column_linestyle\n"
"  unicode_header_linestyle\n"
"    设置 Unicode 线型 [single, double]\n"

#: help.c:521
msgid ""
"  xheader_width\n"
"    set the maximum width of the header for expanded output\n"
"    [full, column, page, integer value]\n"
msgstr ""
"  xheader_width\n"
"    设置扩展输出标题的最大宽度\n"
"    [full, column, page, 整数值]\n"

#: help.c:525
msgid ""
"\n"
"Environment variables:\n"
msgstr ""
"\n"
"环境变量:\n"

#: help.c:529
msgid ""
"  NAME=VALUE [NAME=VALUE] psql ...\n"
"  or \\setenv NAME [VALUE] inside psql\n"
"\n"
msgstr ""
"  NAME=VALUE [NAME=VALUE] psql ...\n"
"  或在 psql 中执行 \\setenv NAME [VALUE]\n"
"\n"

#: help.c:531
msgid ""
"  set NAME=VALUE\n"
"  psql ...\n"
"  or \\setenv NAME [VALUE] inside psql\n"
"\n"
msgstr ""
"  set NAME=VALUE\n"
"  psql ...\n"
"  或在 psql 中执行 \\setenv NAME [VALUE]\n"
"\n"

#: help.c:534
msgid ""
"  COLUMNS\n"
"    number of columns for wrapped format\n"
msgstr ""
"  COLUMNS\n"
"    wrapped 格式的显示列数\n"

#: help.c:536
msgid ""
"  PGAPPNAME\n"
"    same as the application_name connection parameter\n"
msgstr ""
"  PGAPPNAME\n"
"    与 application_name 连接参数相同\n"

#: help.c:538
msgid ""
"  PGDATABASE\n"
"    same as the dbname connection parameter\n"
msgstr ""
"  PGDATABASE\n"
"    与 dbname 连接参数相同\n"

#: help.c:540
msgid ""
"  PGHOST\n"
"    same as the host connection parameter\n"
msgstr ""
"  PGHOST\n"
"    与 host 连接参数相同\n"

#: help.c:542
msgid ""
"  PGPASSFILE\n"
"    password file name\n"
msgstr ""
"  PGPASSFILE\n"
"    密码文件名\n"

#: help.c:544
msgid ""
"  PGPASSWORD\n"
"    connection password (not recommended)\n"
msgstr ""
"  PGPASSWORD\n"
"    连接密码（不推荐）\n"

#: help.c:546
msgid ""
"  PGPORT\n"
"    same as the port connection parameter\n"
msgstr ""
"  PGPORT\n"
"    与 port 连接参数相同\n"

#: help.c:548
msgid ""
"  PGUSER\n"
"    same as the user connection parameter\n"
msgstr ""
"  PGUSER\n"
"    与 user 连接参数相同\n"

#: help.c:550
msgid ""
"  PSQL_EDITOR, EDITOR, VISUAL\n"
"    editor used by the \\e, \\ef, and \\ev commands\n"
msgstr ""
"  PSQL_EDITOR, EDITOR, VISUAL\n"
"    \\e, \\ef 和 \\ev 命令使用的编辑器\n"

#: help.c:552
msgid ""
"  PSQL_EDITOR_LINENUMBER_ARG\n"
"    how to specify a line number when invoking the editor\n"
msgstr ""
"  PSQL_EDITOR_LINENUMBER_ARG\n"
"    调用编辑器时如何指定行号\n"

#: help.c:554
msgid ""
"  PSQL_HISTORY\n"
"    alternative location for the command history file\n"
msgstr ""
"  PSQL_HISTORY\n"
"    命令历史记录文件的替代位置\n"

#: help.c:556
msgid ""
"  PSQL_PAGER, PAGER\n"
"    name of external pager program\n"
msgstr ""
"  PSQL_PAGER, PAGER\n"
"    外部分页器程序的名称\n"

#: help.c:559
msgid ""
"  PSQL_WATCH_PAGER\n"
"    name of external pager program used for \\watch\n"
msgstr ""
"  PSQL_WATCH_PAGER\n"
"    用于 \\watch 的外部分页器程序名称\n"

#: help.c:562
msgid ""
"  PSQLRC\n"
"    alternative location for the user's .psqlrc file\n"
msgstr ""
"  PSQLRC\n"
"    用户的 .psqlrc 文件的替代位置\n"

#: help.c:564
msgid ""
"  SHELL\n"
"    shell used by the \\! command\n"
msgstr ""
"  SHELL\n"
"    \\! 命令使用的 shell\n"

#: help.c:566
msgid ""
"  TMPDIR\n"
"    directory for temporary files\n"
msgstr ""
"  TMPDIR\n"
"    临时文件的目录\n"

#: help.c:626
msgid "Available help:\n"
msgstr "可用的帮助:\n"

