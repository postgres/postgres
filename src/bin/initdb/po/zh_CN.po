msgstr "数据库集簇将以区域设置 \"%s\" 进行初始化。\n"

#: initdb.c:2432
#, c-format
msgid ""
"The database cluster will be initialized with locales\n"
"  COLLATE:  %s\n"
"  CTYPE:    %s\n"
"  MESSAGES: %s\n"
"  MONETARY: %s\n"
"  NUMERIC:  %s\n"
"  TIME:     %s\n"
msgstr ""
"数据库集簇将以以下区域设置进行初始化\n"
"  COLLATE:  %s\n"
"  CTYPE:    %s\n"
"  MESSAGES: %s\n"
"  MONETARY: %s\n"
"  NUMERIC:  %s\n"
"  TIME:     %s\n"

