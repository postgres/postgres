#, c-format
msgid "cannot duplicate null pointer (internal error)\n"
msgstr "不能複製空指標(內部錯誤)\n"

#: ../../common/fe_memutils.c:209
#, c-format
msgid "invalid memory allocation request size %zu + %zu\n"
