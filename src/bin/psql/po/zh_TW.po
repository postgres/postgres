msgstr "  \\lo_export LOBOID FILE 將大物件寫入檔案\n"

# help.c:205
#: help.c:281
msgid ""
"  \\lo_import FILE [COMMENT]\n"
"                         read large object from file\n"
msgstr ""
"  \\lo_import FILE [COMMENT]\n"
"                         從檔案讀取大物件\n"

#: help.c:283
msgid "  \\lo_list[x+]           list large objects\n"
msgstr "  \\lo_list[x+]           列出大型物件\n"

#: help.c:284
msgid "  \\lo_unlink LOBOID      delete a large object\n"
msgstr "  \\lo_unlink LOBOID      刪除大物件\n"

# help.c:233
#: help.c:287
msgid "Formatting\n"
msgstr "格式化\n"

# help.c:234
#: help.c:288
msgid "  \\a                     toggle between unaligned and aligned output mode\n"
msgstr "  \\a                     切換對齊和非對齊的輸出模式\n"

# help.c:235
#: help.c:289
msgid "  \\C [STRING]            set table title, or unset if none\n"
msgstr "  \\C [STRING]            設定表格標題，若無參數則取消設定\n"

# help.c:236
#: help.c:290
msgid "  \\f [STRING]            show or set field separator for unaligned query output\n"
msgstr "  \\f [STRING]            顯示或設定非對齊查詢輸出的欄位分隔符號\n"

# help.c:237
#: help.c:291
#, c-format
msgid "  \\H                     toggle HTML output mode (currently %s)\n"
msgstr "  \\H                     切換 HTML 輸出模式(目前是 %s)\n"

#: help.c:293
msgid ""
"  \\pset [NAME [VALUE]]   set table output option\n"
"                         (border|columns|csv_fieldsep|expanded|fieldsep|\n"
"                         fieldsep_zero|footer|format|linestyle|null|\n"
"                         numericlocale|pager|pager_min_lines|recordsep|\n"
"                         recordsep_zero|tableattr|title|tuples_only|\n"
"                         unicode_border_linestyle|unicode_column_linestyle|\n"
"                         unicode_header_linestyle|xheader_width)\n"
msgstr "  \\pset [NAME [VALUE]]   設定表格輸出選項\n                         (border|columns|csv_fieldsep|expanded|fieldsep|\n                         fieldsep_zero|footer|format|linestyle|null|\n                         numericlocale|pager|pager_min_lines|recordsep|\n                         recordsep_zero|tableattr|title|tuples_only|\n                         unicode_border_linestyle|unicode_column_linestyle|\n                         unicode_header_linestyle|xheader_width)\n"

# help.c:243
#: help.c:300
#, c-format
msgid "  \\t [on|off]            show only rows (currently %s)\n"
msgstr "  \\t [on|off]            只顯示資料(目前是 %s)\n"

# help.c:245
#: help.c:302
msgid "  \\T [STRING]            set HTML <table> tag attributes, or unset if none\n"
msgstr "  \\T [STRING]            設定 HTML <table> 標籤屬性，若無參數則取消設定\n"

# help.c:246
#: help.c:303
#, c-format
msgid "  \\x [on|off|auto]       toggle expanded output (currently %s)\n"
msgstr "  \\x [on|off|auto]       切換展開輸出模式(目前是 %s)\n"

#: help.c:304
msgid "auto"
msgstr "auto"

# help.c:123
#: help.c:307
msgid "Connection\n"
msgstr "連線\n"

# help.c:175
#: help.c:309
#, c-format
msgid ""
"  \\c[onnect] {[DBNAME|- USER|- HOST|- PORT|-] | conninfo}\n"
"                         connect to new database (currently \"%s\")\n"
msgstr ""
"  \\c[onnect] {[DBNAME|- USER|- HOST|- PORT|-] | conninfo}\n"
"                         連線至新的資料庫(目前是 \"%s\")\n"

# help.c:175
#: help.c:313
msgid ""
"  \\c[onnect] {[DBNAME|- USER|- HOST|- PORT|-] | conninfo}\n"
"                         connect to new database (currently no connection)\n"
msgstr ""
"  \\c[onnect] {[DBNAME|- USER|- HOST|- PORT|-] | conninfo}\n"
"                         連線至新的資料庫(目前沒有連線)\n"

#: help.c:315
msgid "  \\conninfo              display information about current connection\n"
msgstr "  \\conninfo              顯示目前連線資訊\n"

# help.c:180
#: help.c:316
msgid "  \\encoding [ENCODING]   show or set client encoding\n"
msgstr "  \\encoding [ENCODING]   顯示或設定客戶端編碼\n"

#: help.c:317
msgid "  \\password [USERNAME]   securely change the password for a user\n"
msgstr "  \\password [USERNAME]   安全地變更使用者密碼\n"

# utils/error/elog.c:1873
#: help.c:320
msgid "Operating System\n"
msgstr "作業系統\n"

# help.c:178
#: help.c:321
msgid "  \\cd [DIR]              change the current working directory\n"
msgstr "  \\cd [DIR]              變更目前的工作目錄\n"

#: help.c:322
msgid "  \\getenv PSQLVAR ENVVAR fetch environment variable\n"
msgstr "  \\getenv PSQLVAR ENVVAR 取得環境變數\n"

# help.c:188
#: help.c:323
msgid "  \\setenv NAME [VALUE]   set or unset environment variable\n"
msgstr "  \\setenv NAME [VALUE]   設定或取消環境變數\n"

# help.c:186
#: help.c:324
#, c-format
msgid "  \\timing [on|off]       toggle timing of commands (currently %s)\n"
msgstr "  \\timing [on|off]       切換指令計時功能(目前是 %s)\n"

# help.c:189
#: help.c:326
msgid "  \\! [COMMAND]           execute command in shell or start interactive shell\n"
msgstr "  \\! [COMMAND]           用 shell 執行命令或啟動互動式 shell\n"

#: help.c:329
msgid "Variables\n"
msgstr "變數\n"

# help.c:188
#: help.c:330
msgid "  \\prompt [TEXT] NAME    prompt user to set internal variable\n"
msgstr "  \\prompt [TEXT] NAME    提示使用者設定內部變數\n"

# help.c:184
#: help.c:331
msgid "  \\set [NAME [VALUE]]    set internal variable, or list all if no parameters\n"
msgstr "  \\set [NAME [VALUE]]    設定內部變數，如果沒有參數則列出所有內部變數\n"

# help.c:188
#: help.c:332
msgid "  \\unset NAME            unset (delete) internal variable\n"
msgstr "  \\unset NAME            取消(刪除)內部變數\n"

#: help.c:335
msgid "Extended Query Protocol\n"
msgstr "延伸查詢協定\n"

# help.c:228
#: help.c:336
msgid "  \\bind [PARAM]...       set query parameters\n"
msgstr "  \\bind [PARAM]...       設定查詢參數\n"

#: help.c:337
msgid ""
"  \\bind_named STMT_NAME [PARAM]...\n"
"                         set query parameters for an existing prepared statement\n"
msgstr "  \\bind_named STMT_NAME [PARAM]...\n                         設定現有預備敘述的查詢參數\n"

#: help.c:339
msgid ""
"  \\close_prepared STMT_NAME\n"
"                         close an existing prepared statement\n"
msgstr "  \\close_prepared STMT_NAME\n                         關閉現有的預備敘述\n"

#: help.c:341
msgid "  \\endpipeline           exit pipeline mode\n"
msgstr "  \\endpipeline           結束管道模式\n"

#: help.c:342
msgid "  \\flush                 flush output data to the server\n"
msgstr "  \\flush                 將輸出資料排清至伺服器\n"

#: help.c:343
msgid "  \\flushrequest          send request to the server to flush its output buffer\n"
msgstr "  \\flushrequest          請求伺服器排清其輸出緩衝區\n"

#: help.c:344
msgid "  \\getresults [NUM_RES]  read NUM_RES pending results, or all if no argument\n"
msgstr "  \\getresults [NUM_RES]  讀取 NUM_RES 個待處理結果，無參數時讀取全部\n"

# sql_help.h:217
#: help.c:345
msgid "  \\parse STMT_NAME       create a prepared statement\n"
msgstr "  \\parse STMT_NAME       建立預備敘述\n"

#: help.c:346
msgid "  \\sendpipeline          send an extended query to an ongoing pipeline\n"
msgstr "  \\sendpipeline          向進行中的管道傳送延伸查詢\n"

#: help.c:347
msgid "  \\startpipeline         enter pipeline mode\n"
msgstr "  \\startpipeline         進入管道模式\n"

#: help.c:348
msgid "  \\syncpipeline          add a synchronisation point to an ongoing pipeline\n"
msgstr "  \\syncpipeline          在進行中的管道加入同步點\n"

#: help.c:387
msgid ""
"List of specially treated variables\n"
"\n"
msgstr ""
"特別變數清單\n"
"\n"

#: help.c:389
msgid "psql variables:\n"
msgstr "psql 變數:\n"

#: help.c:391
msgid ""
"  psql --set=NAME=VALUE\n"
"  or \\set NAME VALUE inside psql\n"
"\n"
msgstr "  psql --set=名稱=值\n  或在 psql 中 \\set 名稱 值\n\n"

#: help.c:393
msgid ""
"  AUTOCOMMIT\n"
"    if set, successful SQL commands are automatically committed\n"
msgstr ""
"  AUTOCOMMIT\n"
"    如果設定，成功的 SQL 命令將自動提交\n"

#: help.c:395
msgid ""
"  COMP_KEYWORD_CASE\n"
"    determines the case used to complete SQL key words\n"
"    [lower, upper, preserve-lower, preserve-upper]\n"
msgstr "  COMP_KEYWORD_CASE\n    決定完成 SQL 關鍵字時使用的大小寫\n    [lower, upper, preserve-lower, preserve-upper]\n"

#: help.c:398
msgid ""
"  DBNAME\n"
"    the currently connected database name\n"
msgstr ""
"  DBNAME\n"
"    目前連線的資料庫名稱\n"

#: help.c:400
msgid ""
"  ECHO\n"
"    controls what input is written to standard output\n"
"    [all, errors, none, queries]\n"
msgstr ""
"  ECHO\n"
"    控制寫入標準輸出的輸入內容\n"
"    [all, errors, none, queries]\n"

#: help.c:403
msgid ""
"  ECHO_HIDDEN\n"
"    if set, display internal queries executed by backslash commands;\n"
"    if set to \"noexec\", just show them without execution\n"
msgstr ""
"  ECHO_HIDDEN\n"
"    若設定，顯示由反斜線指令執行的內部查詢；\n"
"    若設定為 \"noexec\"，僅顯示而不執行\n"

# utils/misc/guc.c:1432
#: help.c:406
msgid ""
"  ENCODING\n"
"    current client character set encoding\n"
msgstr ""
"  ENCODING\n"
"    目前客戶端字元集編碼\n"

#: help.c:408
msgid ""
"  ERROR\n"
"    \"true\" if last query failed, else \"false\"\n"
msgstr ""
"  ERROR\n"
"    若上一次查詢失敗，則為 \"true\"，否則為 \"false\"\n"

#: help.c:410
msgid ""
"  FETCH_COUNT\n"
"    the number of result rows to fetch and display at a time (0 = unlimited)\n"
msgstr ""
"  FETCH_COUNT\n"
"    每次擷取和顯示的結果列數(0 = 無限制)\n"

#: help.c:412
msgid ""
"  HIDE_TABLEAM\n"
"    if set, table access methods are not displayed\n"
msgstr "  HIDE_TABLEAM\n    若設定，則不顯示資料表存取方法\n"

#: help.c:414
msgid ""
"  HIDE_TOAST_COMPRESSION\n"
"    if set, compression methods are not displayed\n"
msgstr ""
"  HIDE_TOAST_COMPRESSION\n"
"    若設定，則不顯示壓縮方法\n"

#: help.c:416
msgid ""
"  HISTCONTROL\n"
"    controls command history [ignorespace, ignoredups, ignoreboth]\n"
msgstr "  HISTCONTROL\n    控制指令歷史記錄 [ignorespace, ignoredups, ignoreboth]\n"

#: help.c:418
msgid ""
"  HISTFILE\n"
"    file name used to store the command history\n"
msgstr "  HISTFILE\n    用於儲存指令歷史記錄的檔案名稱\n"

#: help.c:420
msgid ""
"  HISTSIZE\n"
"    maximum number of commands to store in the command history\n"
msgstr "  HISTSIZE\n    儲存在指令歷史記錄中的最大指令數量\n"

# common.c:636
# common.c:871
#: help.c:422
msgid ""
"  HOST\n"
"    the currently connected database server host\n"
msgstr ""
"  HOST\n"
"    目前連線的資料庫伺服器主機\n"

#: help.c:424
msgid ""
"  IGNOREEOF\n"
"    number of EOFs needed to terminate an interactive session\n"
msgstr "  IGNOREEOF\n    結束互動式工作階段所需的 EOF 次數\n"

#: help.c:426
msgid ""
"  LASTOID\n"
"    value of the last affected OID\n"
msgstr "  LASTOID\n    上一個受影響的 OID\n"

#: help.c:428
msgid ""
"  LAST_ERROR_MESSAGE\n"
"  LAST_ERROR_SQLSTATE\n"
"    message and SQLSTATE of last error, or empty string and \"00000\" if none\n"
msgstr ""
"  LAST_ERROR_MESSAGE\n"
"  LAST_ERROR_SQLSTATE\n"
"    上一個錯誤的訊息和 SQLSTATE，若無則為空字串和 \"00000\"\n"

#: help.c:431
msgid ""
"  ON_ERROR_ROLLBACK\n"
"    if set, an error doesn't stop a transaction (uses implicit savepoints)\n"
msgstr "  ON_ERROR_ROLLBACK\n    若設定，錯誤不會停止交易(使用隱式儲存點)\n"

#: help.c:433
msgid ""
"  ON_ERROR_STOP\n"
"    stop batch execution after error\n"
msgstr "  ON_ERROR_STOP\n    發生錯誤後停止批次執行\n"

#: help.c:435
msgid ""
"  PORT\n"
"    server port of the current connection\n"
msgstr ""
"  PORT\n"
"    目前連線的伺服器連接埠\n"

#: help.c:437
msgid ""
"  PROMPT1\n"
"    specifies the standard psql prompt\n"
msgstr "  PROMPT1\n    指定標準的 psql 提示符號\n"

#: help.c:439
msgid ""
"  PROMPT2\n"
"    specifies the prompt used when a statement continues from a previous line\n"
msgstr "  PROMPT2\n    指定當陳述式從前一行繼續時所使用的提示符號\n"

#: help.c:441
msgid ""
"  PROMPT3\n"
"    specifies the prompt used during COPY ... FROM STDIN\n"
msgstr ""
"  PROMPT3\n"
"    指定在執行 COPY ... FROM STDIN 時使用的提示符號\n"

#: help.c:443
msgid ""
"  QUIET\n"
"    run quietly (same as -q option)\n"
msgstr ""
"  QUIET\n"
"    靜默執行(同 -q 選項)\n"

#: help.c:445
msgid ""
"  ROW_COUNT\n"
"    number of rows returned or affected by last query, or 0\n"
msgstr "  ROW_COUNT\n    上一次查詢所傳回或受影響的列數，或為 0\n"

#: help.c:447
msgid ""
"  SERVER_VERSION_NAME\n"
"  SERVER_VERSION_NUM\n"
"    server's version (in short string or numeric format)\n"
msgstr ""
"  SERVER_VERSION_NAME\n"
"  SERVER_VERSION_NUM\n"
"    伺服器版本(以簡短字串或數字格式表示)\n"

#: help.c:450
msgid ""
"  SHELL_ERROR\n"
"    \"true\" if the last shell command failed, \"false\" if it succeeded\n"
msgstr ""
"  SHELL_ERROR\n"
"    若上一個 shell 指令失敗，為 \"true\"，若成功則為 \"false\"\n"

#: help.c:452
msgid ""
"  SHELL_EXIT_CODE\n"
"    exit status of the last shell command\n"
msgstr ""
"  SHELL_EXIT_CODE\n"
"    上一個 shell 命令的結束碼\n"

#: help.c:454
msgid ""
"  SHOW_ALL_RESULTS\n"
"    show all results of a combined query (\\;) instead of only the last\n"
msgstr ""
"  SHOW_ALL_RESULTS\n"
"    顯示合併查詢(\\;)的所有結果，而不僅僅是最後一個結果\n"

#: help.c:456
msgid ""
"  SHOW_CONTEXT\n"
"    controls display of message context fields [never, errors, always]\n"
msgstr "  SHOW_CONTEXT\n    控制訊息上下文欄位的顯示 [never, errors, always]\n"

#: help.c:458
msgid ""
"  SINGLELINE\n"
"    if set, end of line terminates SQL commands (same as -S option)\n"
msgstr "  SINGLELINE\n    若設定，SQL 命令在行尾結束(同 -S 選項)\n"

#: help.c:460
msgid ""
"  SINGLESTEP\n"
"    single-step mode (same as -s option)\n"
msgstr ""
"  SINGLESTEP\n"
"    單步執行模式(同 -s 選項)\n"

#: help.c:462
msgid ""
"  SQLSTATE\n"
"    SQLSTATE of last query, or \"00000\" if no error\n"
msgstr ""
"  SQLSTATE\n"
"    上一個查詢的 SQLSTATE，若無錯誤則為 \"00000\"\n"

# common.c:636
# common.c:871
#: help.c:464
msgid ""
"  USER\n"
"    the currently connected database user\n"
msgstr ""
"  USER\n"
"    目前連線的資料庫使用者\n"

#: help.c:466
msgid ""
"  VERBOSITY\n"
"    controls verbosity of error reports [default, verbose, terse, sqlstate]\n"
msgstr ""
"  VERBOSITY\n"
"    控制錯誤報告的詳細程度 [default, verbose, terse, sqlstate]\n"

#: help.c:468
msgid ""
"  VERSION\n"
"  VERSION_NAME\n"
"  VERSION_NUM\n"
"    psql's version (in verbose string, short string, or numeric format)\n"
msgstr "  VERSION\n  VERSION_NAME\n  VERSION_NUM\n    psql 的版本(以詳細字串、簡短字串或數字格式表示)\n"

#: help.c:472
#, c-format
msgid ""
"  WATCH_INTERVAL\n"
"    number of seconds \\watch waits between executions (default %s)\n"
msgstr "  WATCH_INTERVAL\n    \\watch 兩次執行之間等待的秒數 (預設 %s)\n"

# describe.c:1549
#: help.c:476
msgid ""
"\n"
"Display settings:\n"
msgstr ""
"\n"
"顯示設定:\n"

#: help.c:478
msgid ""
"  psql --pset=NAME[=VALUE]\n"
"  or \\pset NAME [VALUE] inside psql\n"
"\n"
msgstr "  psql --pset=名稱[=值]\n  或在 psql 中 \\pset 名稱 [值]\n\n"

#: help.c:480
msgid ""
"  border\n"
"    border style (number)\n"
msgstr ""
"  border\n"
"    邊框樣式(數字)\n"

#: help.c:482
msgid ""
"  columns\n"
"    target width for the wrapped format\n"
msgstr "  columns\n    wrapped 格式的目標寬度\n"

#: help.c:484
#, c-format
msgid ""
"  csv_fieldsep\n"
"    field separator for CSV output format (default \"%c\")\n"
msgstr "  csv_fieldsep\n    CSV 輸出格式的欄位分隔符號 (預設 \"%c\")\n"

#: help.c:487
msgid ""
"  expanded (or x)\n"
"    expanded output [on, off, auto]\n"
msgstr "  expanded (或 x)\n    展開輸出 [on, off, auto]\n"

#: help.c:489
#, c-format
msgid ""
"  fieldsep\n"
"    field separator for unaligned output (default \"%s\")\n"
msgstr ""
"  fieldsep\n"
"    用於非對齊輸出的欄位分隔符(預設值 \"%s\")\n"

# help.c:236
#: help.c:492
msgid ""
"  fieldsep_zero\n"
"    set field separator for unaligned output to a zero byte\n"
msgstr "  fieldsep_zero\n    將非對齊輸出的欄位分隔符設定成值為零的位元組\n"

#: help.c:494
msgid ""
"  footer\n"
"    enable or disable display of the table footer [on, off]\n"
msgstr ""
"  footer\n"
"    啟動或停用顯示表格頁腳 [on, off]\n"

# command.c:1340
#: help.c:496
msgid ""
"  format\n"
"    set output format [unaligned, aligned, wrapped, html, asciidoc, ...]\n"
msgstr ""
"  format\n"
"    設定輸出格式 [unaligned, aligned, wrapped, html, asciidoc, ...]\n"

#: help.c:498
msgid ""
"  linestyle\n"
"    set the border line drawing style [ascii, old-ascii, unicode]\n"
msgstr ""
"  linestyle\n"
"    設定邊框線條繪製樣式 [ascii, old-ascii, unicode]\n"

#: help.c:500
msgid ""
"  null\n"
"    set the string to be printed in place of a null value\n"
msgstr ""
"  null\n"
"    設定要在空值位置上顯示的字串\n"

#: help.c:502
msgid ""
"  numericlocale\n"
"    enable display of a locale-specific character to separate groups of digits\n"
msgstr "  numericlocale\n    啟動顯示區域特定的字元來分隔數字群組\n"

#: help.c:504
msgid ""
"  pager\n"
"    control when an external pager is used [yes, no, always]\n"
msgstr ""
"  pager\n"
"    控制何時使用外部分頁程式 [yes, no, always]\n"

# help.c:236
#: help.c:506
msgid ""
"  recordsep\n"
"    record (line) separator for unaligned output\n"
msgstr ""
"  recordsep\n"
"    用於非對齊輸出的記錄(行)分隔符號\n"

#: help.c:508
msgid ""
"  recordsep_zero\n"
"    set record separator for unaligned output to a zero byte\n"
msgstr "  recordsep_zero\n    將非對齊輸出的記錄分隔符設定成值為零的位元組\n"

#: help.c:510
msgid ""
"  tableattr (or T)\n"
"    specify attributes for table tag in html format, or proportional\n"
"    column widths for left-aligned data types in latex-longtable format\n"
msgstr "  tableattr (或 T)\n    指定 html 格式中表格標籤的屬性，或是 latex-longtable\n    格式中左對齊資料型別的比例欄寬\n"

#: help.c:513
msgid ""
"  title\n"
"    set the table title for subsequently printed tables\n"
msgstr ""
"  title\n"
"    設定後續顯示表格的表格標題\n"

#: help.c:515
msgid ""
"  tuples_only\n"
"    if set, only actual table data is shown\n"
msgstr ""
"  tuples_only\n"
"    若設定則只顯示資料\n"

#: help.c:517
msgid ""
"  unicode_border_linestyle\n"
"  unicode_column_linestyle\n"
"  unicode_header_linestyle\n"
"    set the style of Unicode line drawing [single, double]\n"
msgstr ""
"  unicode_border_linestyle\n"
"  unicode_column_linestyle\n"
"  unicode_header_linestyle\n"
"    設定 Unicode 線條繪製樣式 [single, double]\n"

#: help.c:521
msgid ""
"  xheader_width\n"
"    set the maximum width of the header for expanded output\n"
"    [full, column, page, integer value]\n"
msgstr "  xheader_width\n    設定展開輸出標頭的最大寬度\n    [full, column, page, 整數值]\n"

#: help.c:525
msgid ""
"\n"
"Environment variables:\n"
msgstr ""
"\n"
"環境變數:\n"

#: help.c:529
msgid ""
"  NAME=VALUE [NAME=VALUE] psql ...\n"
"  or \\setenv NAME [VALUE] inside psql\n"
"\n"
msgstr "  名稱=值 [名稱=值] psql ...\n  或在 psql 中 \\setenv 名稱 [值]\n\n"

