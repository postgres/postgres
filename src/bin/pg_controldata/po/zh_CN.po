#: ../../common/controldata_utils.c:165
msgid "byte ordering mismatch"
msgstr "字节序不匹配"

#: ../../common/controldata_utils.c:167
#, c-format
msgid ""
"possible byte ordering mismatch\n"
"The byte ordering used to store the pg_control file might not match the one\n"
"used by this program.  In that case the results below would be incorrect, "
"and\n"
"the PostgreSQL installation would be incompatible with this data directory."
msgstr ""
"可能存在字节序不匹配\n"
"存储 pg_control 文件时使用的字节序可能与本程序使用的\n"
"字节序不一致。若确实如此，下列结果将不正确，且\n"
"安装的 PostgreSQL 将与此数据目录不兼容。"

#: ../../common/controldata_utils.c:233
#, c-format
msgid "could not open file \"%s\": %m"
msgstr "无法打开文件 \"%s\": %m"

#: ../../common/controldata_utils.c:254
#, c-format
msgid "could not write file \"%s\": %m"
msgstr "无法写入文件 \"%s\": %m"

#: ../../common/controldata_utils.c:275
#, c-format
msgid "could not fsync file \"%s\": %m"
msgstr "无法对文件 \"%s\" 执行 fsync: %m"

#: pg_controldata.c:35
#, c-format
msgid ""
"%s displays control information of a PostgreSQL database cluster.\n"
"\n"
msgstr ""
"%s 显示 PostgreSQL 数据库集簇的控制信息。\n"
"\n"

