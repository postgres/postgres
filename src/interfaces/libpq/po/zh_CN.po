msgid "malformed SCRAM message (garbage at end of server-final-message)\n"
msgstr "SCRAM 消息格式错误（server-final-message 末尾有多余内容）\n"

#: fe-auth-scram.c:758
msgid "malformed SCRAM message (invalid server signature)\n"
msgstr "SCRAM 消息格式错误（服务器签名无效）\n"

#: fe-auth.c:76
#, c-format
msgid "out of memory allocating GSSAPI buffer (%d)\n"
msgstr "分配 GSSAPI 缓冲区时内存不足（%d）\n"

#: fe-auth.c:131
msgid "GSSAPI continuation error"
msgstr "GSSAPI 继续认证时出错"

#: fe-auth.c:158 fe-auth.c:391 fe-gssapi-common.c:98 fe-secure-common.c:98
msgid "host name must be specified\n"
msgstr "必须指定主机名\n"

#: fe-auth.c:165
msgid "duplicate GSS authentication request\n"
msgstr "重复的 GSS 认证请求\n"

#: fe-auth.c:230
#, c-format
msgid "out of memory allocating SSPI buffer (%d)\n"
msgstr "分配 SSPI 缓冲区时内存不足（%d）\n"

#: fe-auth.c:278
msgid "SSPI continuation error"
msgstr "SSPI 继续认证时出错"

#: fe-auth.c:351
msgid "duplicate SSPI authentication request\n"
msgstr "重复的 SSPI 认证请求\n"

#: fe-auth.c:377
msgid "could not acquire SSPI credentials"
msgstr "无法获取 SSPI 凭据"

#: fe-auth.c:433
msgid "channel binding required, but SSL not in use\n"
msgstr "需要通道绑定，但未使用 SSL\n"

#: fe-auth.c:440
msgid "duplicate SASL authentication request\n"
msgstr "重复的 SASL 认证请求\n"

#: fe-auth.c:496
msgid "channel binding is required, but client does not support it\n"
msgstr "需要通道绑定，但客户端不支持\n"

#: fe-auth.c:513
msgid ""
"server offered SCRAM-SHA-256-PLUS authentication over a non-SSL connection\n"
msgstr "服务器在非 SSL 连接上已提供 SCRAM-SHA-256-PLUS 认证\n"

#: fe-auth.c:525
msgid "none of the server's SASL authentication mechanisms are supported\n"
msgstr "服务器提供的 SASL 认证机制均不受支持\n"

#: fe-auth.c:533
msgid ""
"channel binding is required, but server did not offer an authentication "
"method that supports channel binding\n"
msgstr "需要通道绑定，但服务器未提供支持通道绑定的认证方法\n"

#: fe-auth.c:639
#, c-format
msgid "out of memory allocating SASL buffer (%d)\n"
msgstr "分配 SASL 缓冲区时内存不足（%d）\n"

#: fe-auth.c:664
msgid ""
"AuthenticationSASLFinal received from server, but SASL authentication was "
"not completed\n"
msgstr "收到服务器的 AuthenticationSASLFinal，但 SASL 认证尚未完成\n"

#: fe-auth.c:741
msgid "SCM_CRED authentication method not supported\n"
msgstr "不支持 SCM_CRED 认证方法\n"

#: fe-auth.c:836
msgid ""
"channel binding required, but server authenticated client without channel "
"binding\n"
msgstr "需要通道绑定，但服务器在未进行通道绑定的情况下已完成客户端认证\n"

#: fe-auth.c:842
msgid ""
"channel binding required but not supported by server's authentication "
"request\n"
msgstr "需要通道绑定，但服务器的认证请求不支持\n"

#: fe-auth.c:877
msgid "Kerberos 4 authentication not supported\n"
msgstr "不支持 Kerberos 4 认证\n"

#: fe-auth.c:882
msgid "Kerberos 5 authentication not supported\n"
msgstr "不支持 Kerberos 5 认证\n"

#: fe-auth.c:953
msgid "GSSAPI authentication not supported\n"
msgstr "不支持 GSSAPI 认证\n"

#: fe-auth.c:985
msgid "SSPI authentication not supported\n"
msgstr "不支持 SSPI 认证\n"

#: fe-auth.c:993
msgid "Crypt authentication not supported\n"
msgstr "不支持 Crypt 认证\n"

#: fe-auth.c:1060
#, c-format
msgid "authentication method %u not supported\n"
msgstr "不支持认证方法 %u\n"

#: fe-auth.c:1107
#, c-format
msgid "user name lookup failure: error code %lu\n"
msgstr "用户名查找失败: 错误码 %lu\n"

#: fe-auth.c:1117 fe-connect.c:2858
#, c-format
msgid "could not look up local user ID %d: %s\n"
msgstr "无法查找本地用户 ID %d: %s\n"

#: fe-auth.c:1122 fe-connect.c:2863
#, c-format
msgid "local user with ID %d does not exist\n"
msgstr "ID 为 %d 的本地用户不存在\n"

#: fe-auth.c:1226
msgid "unexpected shape of result set returned for SHOW\n"
msgstr "SHOW 返回的结果集具有意外的结构\n"

#: fe-auth.c:1235
msgid "password_encryption value too long\n"
msgstr "password_encryption 的值过长\n"

#: fe-auth.c:1275
#, c-format
msgid "unrecognized password encryption algorithm \"%s\"\n"
msgstr "无法识别的密码加密算法 \"%s\"\n"

#: fe-connect.c:1097
#, c-format
msgid "could not match %d host names to %d hostaddr values\n"
msgstr "无法将 %d 个主机名与 %d 个 hostaddr 值对应\n"

#: fe-connect.c:1183
#, c-format
msgid "could not match %d port numbers to %d hosts\n"
msgstr "无法将 %d 个端口号与 %d 个主机对应\n"

#: fe-connect.c:1276 fe-connect.c:1302 fe-connect.c:1344 fe-connect.c:1353
#: fe-connect.c:1386 fe-connect.c:1430
#, c-format
msgid "invalid %s value: \"%s\"\n"
msgstr "无效的 %s 值: \"%s\"\n"

#: fe-connect.c:1323
#, c-format
msgid "sslmode value \"%s\" invalid when SSL support is not compiled in\n"
msgstr "编译时未包含 SSL 支持，sslmode 的值 \"%s\" 无效\n"

#: fe-connect.c:1371
msgid "invalid SSL protocol version range\n"
msgstr "SSL 协议版本范围无效\n"

#: fe-connect.c:1396
#, c-format
msgid ""
"gssencmode value \"%s\" invalid when GSSAPI support is not compiled in\n"
msgstr "编译时未包含 GSSAPI 支持，gssencmode 的值 \"%s\" 无效\n"

#: fe-connect.c:1656
#, c-format
msgid "could not set socket to TCP no delay mode: %s\n"
msgstr "无法将套接字设置为 TCP 无延迟模式: %s\n"

#: fe-connect.c:1718
#, c-format
msgid "connection to server on socket \"%s\" failed: "
msgstr "连接到套接字 \"%s\" 上的服务器失败: "

#: fe-connect.c:1745
#, c-format
msgid "connection to server at \"%s\" (%s), port %s failed: "
msgstr "连接到服务器 \"%s\"（%s）的端口 %s 失败: "

#: fe-connect.c:1750
#, c-format
msgid "connection to server at \"%s\", port %s failed: "
msgstr "连接到服务器 \"%s\" 的端口 %s 失败: "

#: fe-connect.c:1775
msgid ""
"\tIs the server running locally and accepting connections on that socket?\n"
msgstr "\t服务器是否在本地运行，并接受该套接字上的连接？\n"

#: fe-connect.c:1779
msgid ""
"\tIs the server running on that host and accepting TCP/IP connections?\n"
msgstr "\t服务器是否在该主机上运行，并接受 TCP/IP 连接？\n"

#: fe-connect.c:1843
#, c-format
msgid "invalid integer value \"%s\" for connection option \"%s\"\n"
msgstr "连接选项 \"%2$s\" 的整数值 \"%1$s\" 无效\n"

#: fe-connect.c:1873 fe-connect.c:1908 fe-connect.c:1944 fe-connect.c:2033
#: fe-connect.c:2646
#, c-format
msgid "%s(%s) failed: %s\n"
msgstr "%s(%s) 失败: %s\n"

#: fe-connect.c:1998
#, c-format
msgid "%s(%s) failed: error code %d\n"
msgstr "%s(%s) 失败: 错误码 %d\n"

#: fe-connect.c:2313
msgid "invalid connection state, probably indicative of memory corruption\n"
msgstr "连接状态无效，可能表明内存已损坏\n"

#: fe-connect.c:2392
#, c-format
msgid "invalid port number: \"%s\"\n"
msgstr "无效的端口号: \"%s\"\n"

