#: pg_waldump.c:222
#, c-format
msgid "could not read file \"%s\": %m"
msgstr "無法讀取檔案 \"%s\": %m"

#: pg_waldump.c:225
#, c-format
msgid "could not read file \"%s\": read %d of %d"
msgstr "無法讀取檔案 \"%1$s\": 應讀取 %3$d，實際讀取 %2$d"

#: pg_waldump.c:286
#, c-format
msgid "could not locate WAL file \"%s\""
msgstr "找不到 WAL 檔 \"%s\""

#: pg_waldump.c:288
#, c-format
msgid "could not find any WAL file"
msgstr "找不到任何 WAL 檔"

#: pg_waldump.c:329
#, c-format
msgid "could not find file \"%s\": %m"
msgstr "找不到檔案 \"%s\": %m"

#: pg_waldump.c:378
#, c-format
msgid "could not read from file %s, offset %d: %m"
msgstr "無法從檔案 %s 的位移 %d 處讀取: %m"

#: pg_waldump.c:382
#, c-format
msgid "could not read from file %s, offset %d: read %d of %d"
msgstr "無法讀取檔案 %1$s 的位移 %2$d 處的資料: 應讀取 %4$d，實際讀取 %3$d"

#: pg_waldump.c:658
#, c-format
msgid ""
"%s decodes and displays PostgreSQL write-ahead logs for debugging.\n"
"\n"
msgstr "%s 解碼並顯示 PostgreSQL 的預寫式日誌以進行除錯。\n\n"

#: pg_waldump.c:660
#, c-format
msgid "Usage:\n"
msgstr "用法:\n"

#: pg_waldump.c:661
#, c-format
msgid "  %s [OPTION]... [STARTSEG [ENDSEG]]\n"
msgstr "  %s [選項]... [起始片段 [結束片段]]\n"

#: pg_waldump.c:662
#, c-format
msgid ""
"\n"
"Options:\n"
msgstr ""
"\n"
"選項:\n"

#: pg_waldump.c:663
#, c-format
msgid "  -b, --bkp-details      output detailed information about backup blocks\n"
msgstr "  -b, --bkp-details      輸出關於備份區塊的詳細資訊\n"

#: pg_waldump.c:664
#, c-format
msgid "  -B, --block=N          with --relation, only show records that modify block N\n"
msgstr "  -B, --block=N          與 --relation 一起使用，只顯示修改區塊 N 的記錄\n"

#: pg_waldump.c:665
#, c-format
msgid "  -e, --end=RECPTR       stop reading at WAL location RECPTR\n"
msgstr "  -e, --end=RECPTR       在 WAL 位置 RECPTR 停止讀取\n"

#: pg_waldump.c:666
#, c-format
msgid "  -f, --follow           keep retrying after reaching end of WAL\n"
msgstr "  -f, --follow           到達 WAL 結尾後繼續嘗試\n"

#: pg_waldump.c:667
#, c-format
msgid ""
"  -F, --fork=FORK        only show records that modify blocks in fork FORK;\n"
"                         valid names are main, fsm, vm, init\n"
msgstr "  -F, --fork=FORK        只顯示修改關聯分支 FORK 中區塊的記錄；\n                         有效的名稱有 main, fsm, vm, init\n"

#: pg_waldump.c:669
#, c-format
msgid "  -n, --limit=N          number of records to display\n"
msgstr "  -n, --limit=N          要顯示的記錄數量\n"

#: pg_waldump.c:670
#, c-format
msgid ""
"  -p, --path=PATH        directory in which to find log segment files or a\n"
"                         directory with a ./pg_wal that contains such files\n"
"                         (default: current directory, ./pg_wal, $PGDATA/pg_wal)\n"
msgstr "  -p, --path=PATH        用於查詢日誌片段檔案的目錄，或者\n                         包含 ./pg_wal 子目錄且該子目錄含有這些檔案的目錄\n                         （預設: 目前目錄, ./pg_wal, $PGDATA/pg_wal）\n"

#: pg_waldump.c:673
#, c-format
msgid "  -q, --quiet            do not print any output, except for errors\n"
msgstr "  -q, --quiet            不顯示任何輸出，除了錯誤訊息\n"

#: pg_waldump.c:674
#, c-format
msgid ""
"  -r, --rmgr=RMGR        only show records generated by resource manager RMGR;\n"
"                         use --rmgr=list to list valid resource manager names\n"
msgstr "  -r, --rmgr=RMGR        只顯示由資源管理員 RMGR 產生的記錄；\n                         用 --rmgr=list 列出有效的資源管理員名稱\n"

#: pg_waldump.c:676
#, c-format
msgid "  -R, --relation=T/D/R   only show records that modify blocks in relation T/D/R\n"
msgstr "  -R, --relation=T/D/R   只顯示在 T/D/R 關聯中修改區塊的記錄\n"

#: pg_waldump.c:677
#, c-format
msgid "  -s, --start=RECPTR     start reading at WAL location RECPTR\n"
msgstr "  -s, --start=RECPTR     從 WAL 位置 RECPTR 開始讀取\n"

#: pg_waldump.c:678
#, c-format
msgid ""
"  -t, --timeline=TLI     timeline from which to read log records\n"
"                         (default: 1 or the value used in STARTSEG)\n"
msgstr "  -t, --timeline=TLI     要讀取日誌記錄的時間軸\n                         （預設: 1 或 STARTSEG 中使用的值）\n"

#: pg_waldump.c:680
#, c-format
msgid "  -V, --version          output version information, then exit\n"
msgstr "  -V, --version          顯示版本，然後結束\n"

#: pg_waldump.c:681
#, c-format
msgid "  -w, --fullpage         only show records with a full page write\n"
msgstr "  -w, --fullpage         只顯示有完整資料頁寫入的記錄\n"

#: pg_waldump.c:682
#, c-format
msgid "  -x, --xid=XID          only show records with transaction ID XID\n"
msgstr "  -x, --xid=XID          只顯示有交易 ID XID 的記錄\n"

#: pg_waldump.c:683
#, c-format
msgid ""
"  -z, --stats[=record]   show statistics instead of records\n"
"                         (optionally, show per-record statistics)\n"
msgstr "  -z, --stats[=record]   顯示統計資料而不是記錄\n                         (可選擇顯示各記錄類型的統計資料)\n"

#: pg_waldump.c:685
#, c-format
msgid "  -?, --help             show this help, then exit\n"
msgstr "  -?, --help             顯示說明，然後結束\n"

#: pg_waldump.c:686
#, c-format
msgid ""
"\n"
"Report bugs to <%s>.\n"
msgstr "\n回報錯誤至 <%s>。\n"

#: pg_waldump.c:687
#, c-format
msgid "%s home page: <%s>\n"
msgstr "%s 首頁: <%s>\n"

#: pg_waldump.c:781
#, c-format
msgid "no arguments specified"
msgstr "未指定任何參數"

#: pg_waldump.c:797
#, c-format
msgid "invalid block number: \"%s\""
msgstr "無效的區塊編號: \"%s\""

#: pg_waldump.c:806 pg_waldump.c:904
#, c-format
msgid "invalid WAL location: \"%s\""
msgstr "無效的 WAL 位置: \"%s\""

#: pg_waldump.c:819
#, c-format
msgid "invalid fork name: \"%s\""
msgstr "無效的關聯分支名稱: \"%s\""

#: pg_waldump.c:827
#, c-format
msgid "invalid value \"%s\" for option %s"
msgstr "選項 %2$s 的值 \"%1$s\" 無效"

#: pg_waldump.c:858
#, c-format
msgid "custom resource manager \"%s\" does not exist"
msgstr "自訂資源管理員 \"%s\" 不存在"

#: pg_waldump.c:879
#, c-format
msgid "resource manager \"%s\" does not exist"
msgstr "資源管理員 \"%s\" 不存在"

#: pg_waldump.c:894
#, c-format
msgid "invalid relation specification: \"%s\""
msgstr "無效的關聯識別資訊: \"%s\""

#: pg_waldump.c:895
#, c-format
msgid "Expecting \"tablespace OID/database OID/relation filenode\"."
msgstr "預期 \"表空間 OID/資料庫 OID/關聯檔案節點\"。"

#: pg_waldump.c:914
#, c-format
msgid "invalid timeline specification: \"%s\""
msgstr "無效的時間軸指定: \"%s\""

#: pg_waldump.c:924
#, c-format
msgid "invalid transaction ID specification: \"%s\""
msgstr "無效的交易 ID: \"%s\""

#: pg_waldump.c:939
#, c-format
msgid "unrecognized value for option %s: %s"
msgstr "無法辨識選項 %s 的值: %s"

#: pg_waldump.c:953
#, c-format
msgid "option %s requires option %s to be specified"
msgstr "選項 %s 需要指定選項 %s"

#: pg_waldump.c:960
#, c-format
msgid "too many command-line arguments (first is \"%s\")"
msgstr "命令列參數過多(第一個多餘參數是 \"%s\")"

# access/transam/slru.c:930 commands/tablespace.c:529
# commands/tablespace.c:694 utils/adt/misc.c:174
#: pg_waldump.c:970 pg_waldump.c:990
#, c-format
msgid "could not open directory \"%s\": %m"
msgstr "無法開啟目錄 \"%s\": %m"

#: pg_waldump.c:996 pg_waldump.c:1026
#, c-format
msgid "could not open file \"%s\""
msgstr "無法開啟檔案 \"%s\""

#: pg_waldump.c:1006
#, c-format
msgid "start WAL location %X/%X is not inside file \"%s\""
msgstr "WAL 開始位置 %X/%X 不在檔案 \"%s\" 內"

#: pg_waldump.c:1033
#, c-format
msgid "ENDSEG %s is before STARTSEG %s"
msgstr "ENDSEG %s 在 STARTSEG %s 之前"

#: pg_waldump.c:1048
#, c-format
msgid "end WAL location %X/%X is not inside file \"%s\""
msgstr "WAL 結束位置 %X/%X 不在檔案 \"%s\" 內"

#: pg_waldump.c:1060
#, c-format
msgid "no start WAL location given"
msgstr "未提供 WAL 開始位置"

#: pg_waldump.c:1074
#, c-format
msgid "out of memory while allocating a WAL reading processor"
msgstr "配置 WAL 讀取處理器時記憶體不足"

#: pg_waldump.c:1080
#, c-format
msgid "could not find a valid record after %X/%X"
msgstr "%X/%X 之後找不到有效的記錄"

#: pg_waldump.c:1090
#, c-format
msgid "first record is after %X/%X, at %X/%X, skipping over %u byte\n"
msgid_plural "first record is after %X/%X, at %X/%X, skipping over %u bytes\n"
msgstr[0] "第一筆記錄在 %X/%X 之後，位於 %X/%X，正在跳過 %u 個位元組\n"

#: pg_waldump.c:1171
#, c-format
msgid "error in WAL record at %X/%X: %s"
msgstr "WAL 記錄在 %X/%X 出現錯誤: %s"

# tcop/postgres.c:2636 tcop/postgres.c:2652
#: pg_waldump.c:1180
#, c-format
msgid "Try \"%s --help\" for more information."
msgstr "用 \"%s --help\" 取得更多資訊。"

# access/transam/xlog.c:2365 access/transam/xlog.c:2435
#: xlogreader.c:620
#, c-format
msgid "invalid record offset at %X/%X"
msgstr "%X/%X 處的記錄位移無效"

# access/transam/xlog.c:2443
#: xlogreader.c:628
#, c-format
msgid "contrecord is requested by %X/%X"
msgstr "請求的 %X/%X 處是續接記錄"

#: xlogreader.c:669 xlogreader.c:1144
#, c-format
msgid "invalid record length at %X/%X: wanted %u, got %u"
msgstr "%X/%X 處的記錄長度無效: 預期為 %u，實際為 %u"

#: xlogreader.c:759
#, c-format
msgid "there is no contrecord flag at %X/%X"
msgstr "位於 %X/%X 沒有續接記錄旗標"

#: xlogreader.c:772
#, c-format
msgid "invalid contrecord length %u (expected %lld) at %X/%X"
msgstr "位於 %3$X/%4$X 的 contrecord 長度 %1$u 無效(預期為 %2$lld)"

# access/transam/xlog.c:2465
#: xlogreader.c:1152
#, c-format
msgid "invalid resource manager ID %u at %X/%X"
msgstr "位於 %2$X/%3$X 的無效資源管理員 ID %1$u"

# access/transam/xlog.c:2458
#: xlogreader.c:1165 xlogreader.c:1181
#, c-format
msgid "record with incorrect prev-link %X/%X at %X/%X"
msgstr "位於 %3$X/%4$X 的記錄有不正確的 prev-link %1$X/%2$X"

# access/transam/xlog.c:2269
#: xlogreader.c:1219
#, c-format
msgid "incorrect resource manager data checksum in record at %X/%X"
msgstr "位於 %X/%X 的記錄中資源管理員資料檢查碼不正確"

#: xlogreader.c:1256
#, c-format
msgid "invalid magic number %04X in log segment %s, offset %u"
msgstr "日誌片段 %2$s 中的魔數 %1$04X 無效，位移 %3$u"

#: xlogreader.c:1270 xlogreader.c:1311
#, c-format
msgid "invalid info bits %04X in log segment %s, offset %u"
msgstr "日誌片段 %2$s 中的資訊位元 %1$04X 無效，位移 %3$u"

#: xlogreader.c:1285
#, c-format
msgid "WAL file is from different database system: WAL file database system identifier is %llu, pg_control database system identifier is %llu"
msgstr "WAL 檔案來自不同的資料庫系統：WAL 檔案的資料庫系統識別碼為 %llu，而 pg_control 的資料庫系統識別碼為 %llu"

#: xlogreader.c:1293
#, c-format
msgid "WAL file is from different database system: incorrect segment size in page header"
msgstr "WAL 檔案來自不同的資料庫系統: 資料頁標頭中的片段大小不正確"

#: xlogreader.c:1299
#, c-format
msgid "WAL file is from different database system: incorrect XLOG_BLCKSZ in page header"
msgstr "WAL 檔案來自不同的資料庫系統: 資料頁標頭中的 XLOG_BLCKSZ 不正確"

#: xlogreader.c:1330
#, c-format
msgid "unexpected pageaddr %X/%X in log segment %s, offset %u"
msgstr "日誌片段 %3$s 中出現非預期的 pageaddr %1$X/%2$X，位移 %4$u"

#: xlogreader.c:1355
#, c-format
msgid "out-of-sequence timeline ID %u (after %u) in log segment %s, offset %u"
msgstr "日誌片段 %3$s 中的時間軸 ID %1$u 順序錯誤（前一個為 %2$u），位移 %4$u"

#: xlogreader.c:1760
#, c-format
msgid "out-of-order block_id %u at %X/%X"
msgstr "%2$X/%3$X 處的 block_id %1$u 順序錯誤"

#: xlogreader.c:1784
#, c-format
msgid "BKPBLOCK_HAS_DATA set, but no data included at %X/%X"
msgstr "%X/%X 處已設定 BKPBLOCK_HAS_DATA，但未包含資料"

#: xlogreader.c:1791
#, c-format
msgid "BKPBLOCK_HAS_DATA not set, but data length is %u at %X/%X"
msgstr "未設定 BKPBLOCK_HAS_DATA，但在 %2$X/%3$X 的資料長度為 %1$u"

#: xlogreader.c:1827
#, c-format
msgid "BKPIMAGE_HAS_HOLE set, but hole offset %u length %u block image length %u at %X/%X"
msgstr "已設定 BKPIMAGE_HAS_HOLE，但 %4$X/%5$X 處的空洞位移為 %1$u，長度為 %2$u，區塊映像長度為 %3$u"

#: xlogreader.c:1843
#, c-format
msgid "BKPIMAGE_HAS_HOLE not set, but hole offset %u length %u at %X/%X"
msgstr "未設定 BKPIMAGE_HAS_HOLE，但 %3$X/%4$X 處的空洞位移為 %1$u，長度為 %2$u"

#: xlogreader.c:1857
#, c-format
msgid "BKPIMAGE_COMPRESSED set, but block image length %u at %X/%X"
msgstr "已設定 BKPIMAGE_COMPRESSED，但 %2$X/%3$X 處的區塊映像長度為 %1$u"

#: xlogreader.c:1872
#, c-format
msgid "neither BKPIMAGE_HAS_HOLE nor BKPIMAGE_COMPRESSED set, but block image length is %u at %X/%X"
msgstr "既未設定 BKPIMAGE_HAS_HOLE，也未設定 BKPIMAGE_COMPRESSED，但 %2$X/%3$X 處的區塊映像長度為 %1$u"

#: xlogreader.c:1888
#, c-format
msgid "BKPBLOCK_SAME_REL set but no previous rel at %X/%X"
msgstr "%X/%X 處已設定 BKPBLOCK_SAME_REL，但沒有先前的關聯"

#: xlogreader.c:1900
#, c-format
msgid "invalid block_id %u at %X/%X"
msgstr "位於 %2$X/%3$X 的無效 block_id %1$u"

#: xlogreader.c:1967
#, c-format
msgid "record with invalid length at %X/%X"
msgstr "位於 %X/%X 的記錄長度無效"

#: xlogreader.c:1992
#, c-format
msgid "could not locate backup block with ID %d in WAL record"
msgstr "在 WAL 記錄中找不到具有 ID %d 的備份區塊"

#: xlogreader.c:2076
#, c-format
msgid "could not restore image at %X/%X with invalid block %d specified"
msgstr "無法還原 %X/%X 處的映像，因為指定的區塊 %d 無效"

#: xlogreader.c:2083
#, c-format
msgid "could not restore image at %X/%X with invalid state, block %d"
msgstr "無法還原 %X/%X 處的映像，狀態無效, 區塊 %d"

#: xlogreader.c:2110 xlogreader.c:2127
#, c-format
msgid "could not restore image at %X/%X compressed with %s not supported by build, block %d"
msgstr "無法還原 %X/%X 處使用 %s 壓縮的映像，此建置版本不支援該壓縮方式, 區塊 %d"

#: xlogreader.c:2136
#, c-format
msgid "could not restore image at %X/%X compressed with unknown method, block %d"
msgstr "無法還原 %X/%X 處使用未知方法壓縮的映像, 區塊 %d"

#: xlogreader.c:2144
#, c-format
msgid "could not decompress image at %X/%X, block %d"
msgstr "無法解壓縮 %X/%X 處的映像, 區塊 %d"

