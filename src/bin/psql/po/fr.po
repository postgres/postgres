#: help.c:488
#, c-format
msgid ""
"  fieldsep\n"
"    field separator for unaligned output (default \"%s\")\n"
msgstr ""
"  fieldsep\n"
"    champ séparateur pour l'affichage non aligné (par défaut « %s »)\n"

