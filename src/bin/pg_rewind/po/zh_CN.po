"%s 使用 PostgreSQL 集簇的另一个副本重新同步该集簇。\n"
"\n"

#: pg_rewind.c:95
#, c-format
msgid ""
"Usage:\n"
"  %s [OPTION]...\n"
"\n"
msgstr ""
"用法:\n"
"  %s [选项]...\n"
"\n"

#: pg_rewind.c:96
#, c-format
msgid "Options:\n"
msgstr "选项:\n"

#: pg_rewind.c:97
#, c-format
msgid ""
"  -c, --restore-target-wal       use \"restore_command\" in target "
"configuration to\n"
"                                 retrieve WAL files from archives\n"
msgstr ""
"  -c, --restore-target-wal       使用目标配置中的 \"restore_command\"\n"
"                                 从归档中获取 WAL 文件\n"

#: pg_rewind.c:99
#, c-format
msgid "  -D, --target-pgdata=DIRECTORY  existing data directory to modify\n"
msgstr "  -D, --target-pgdata=DIRECTORY  待修改的现有数据目录\n"

#: pg_rewind.c:100
#, c-format
msgid ""
"      --source-pgdata=DIRECTORY  source data directory to synchronize with\n"
msgstr "      --source-pgdata=DIRECTORY  要与之同步的源数据目录\n"

#: pg_rewind.c:101
#, c-format
msgid "      --source-server=CONNSTR    source server to synchronize with\n"
msgstr "      --source-server=CONNSTR    要与之同步的源服务器\n"

#: pg_rewind.c:102
#, c-format
msgid "  -n, --dry-run                  stop before modifying anything\n"
msgstr "  -n, --dry-run                  在修改任何内容之前停止\n"

#: pg_rewind.c:103
#, c-format
msgid ""
"  -N, --no-sync                  do not wait for changes to be written\n"
"                                 safely to disk\n"
msgstr "  -N, --no-sync                  不等待变更安全写入磁盘\n"

#: pg_rewind.c:105
#, c-format
msgid "  -P, --progress                 write progress messages\n"
msgstr "  -P, --progress                 写出进度消息\n"

#: pg_rewind.c:106
#, c-format
msgid ""
"  -R, --write-recovery-conf      write configuration for replication\n"
"                                 (requires --source-server)\n"
msgstr ""
"  -R, --write-recovery-conf      写入复制配置\n"
