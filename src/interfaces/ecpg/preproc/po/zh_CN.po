msgstr "嵌套 EXEC SQL IFDEF 条件过多"

#: pgc.l:1357 pgc.l:1368 pgc.l:1384 pgc.l:1406
#, c-format
msgid "missing matching \"EXEC SQL IFDEF\" / \"EXEC SQL IFNDEF\""
msgstr "缺少匹配的 \"EXEC SQL IFDEF\" / \"EXEC SQL IFNDEF\""

#: pgc.l:1359 pgc.l:1370 pgc.l:1565
#, c-format
msgid "missing \"EXEC SQL ENDIF;\""
msgstr "缺少 \"EXEC SQL ENDIF;\""

#: pgc.l:1386 pgc.l:1408
#, c-format
msgid "more than one EXEC SQL ELSE"
msgstr "多个 EXEC SQL ELSE"

#: pgc.l:1431 pgc.l:1445
#, c-format
msgid "unmatched EXEC SQL ENDIF"
msgstr "EXEC SQL ENDIF 不匹配"

#: pgc.l:1507
#, c-format
msgid "missing identifier in EXEC SQL IFDEF command"
msgstr "EXEC SQL IFDEF 命令中缺少标识符"

#: pgc.l:1516
#, c-format
msgid "missing identifier in EXEC SQL DEFINE command"
msgstr "EXEC SQL DEFINE 命令中缺少标识符"

#: pgc.l:1554
#, c-format
msgid "syntax error in EXEC SQL INCLUDE command"
msgstr "在 EXEC SQL INCLUDE 命令中出现语法错误"

#: pgc.l:1609
#, c-format
msgid "internal error: unreachable state; please report this to <%s>"
msgstr "内部错误: 不可达状态；请向 <%s> 报告此问题"

#: pgc.l:1766
#, c-format
msgid "Error: include path \"%s/%s\" is too long on line %d, skipping\n"
msgstr "错误: 第 %3$d 行的包含路径 \"%1$s/%2$s\" 过长，跳过\n"

#: pgc.l:1793
#, c-format
msgid "could not open include file \"%s\" on line %d"
msgstr "第 %2$d 行: 无法打开包含文件 \"%1$s\""

#: preproc.y:28
msgid "syntax error"
msgstr "语法错误"

#: preproc.y:467
#, c-format
msgid "cursor \"%s\" does not exist"
msgstr "游标 \"%s\" 不存在"

#: preproc.y:503
#, c-format
msgid "initializer not allowed in type definition"
msgstr "类型定义中不允许使用初始化器"

#: preproc.y:505
#, c-format
msgid "type name \"string\" is reserved in Informix mode"
msgstr "类型名 \"string\" 在 Informix 模式中是保留名称"

#: preproc.y:512 preproc.y:8901
#, c-format
msgid "type \"%s\" is already defined"
msgstr "类型 \"%s\" 已定义"

#: preproc.y:539 preproc.y:9607 preproc.y:9954 variable.c:708
#, c-format
msgid "multidimensional arrays for simple data types are not supported"
msgstr "不支持针对简单数据类型的多维数组"

#: preproc.y:562
#, c-format
msgid "connection %s is overwritten with %s by DECLARE statement %s"
msgstr "连接 %1$s 被 DECLARE 语句 %3$s 覆盖为 %2$s"

#: preproc.y:932
#, c-format
msgid "AT option not allowed in CLOSE DATABASE statement"
msgstr "在 CLOSE DATABASE 语句中不允许使用 AT 选项"

#: preproc.y:1184
#, c-format
msgid "AT option not allowed in CONNECT statement"
msgstr "在 CONNECT 语句中不允许使用 AT 选项"

#: preproc.y:1221
#, c-format
msgid "AT option not allowed in DISCONNECT statement"
msgstr "在 DISCONNECT 语句中不允许使用 AT 选项"

#: preproc.y:1274
#, c-format
msgid "AT option not allowed in SET CONNECTION statement"
msgstr "在 SET CONNECTION 语句中不允许使用 AT 选项"

#: preproc.y:1292
#, c-format
msgid "AT option not allowed in TYPE statement"
msgstr "在 TYPE 语句中不允许使用 AT 选项"

#: preproc.y:1300
#, c-format
msgid "AT option not allowed in VAR statement"
msgstr "在 VAR 语句中不允许使用 AT 选项"

#: preproc.y:1307
#, c-format
msgid "AT option not allowed in WHENEVER statement"
msgstr "在 WHENEVER 语句中不允许使用 AT 选项"

#: preproc.y:1414 preproc.y:1539 preproc.y:2302 preproc.y:2628 preproc.y:3061
#: preproc.y:3148 preproc.y:6145
#, c-format
msgid "unsupported feature will be passed to server"
msgstr "不支持的功能将传递给服务器"

#: preproc.y:1651
#, c-format
msgid "SHOW ALL is not implemented"
msgstr "尚未实现 SHOW ALL"

#: preproc.y:1936
#, c-format
msgid "COPY FROM STDIN is not implemented"
msgstr "尚未实现 COPY FROM STDIN"

#: preproc.y:5197 preproc.y:8352
#, c-format
msgid "\"database\" cannot be used as cursor name in INFORMIX mode"
msgstr "在 INFORMIX 模式下，\"database\" 不能用作游标名称"

#: preproc.y:5204 preproc.y:8362
#, c-format
msgid "using variable \"%s\" in different declare statements is not supported"
msgstr "不支持在不同的声明语句中使用变量 \"%s\""

#: preproc.y:5206 preproc.y:8364
#, c-format
msgid "cursor \"%s\" is already defined"
msgstr "游标 \"%s\" 已定义"

#: preproc.y:5453
#, c-format
msgid "no longer supported LIMIT #,# syntax passed to server"
msgstr "向服务器传递不再支持的 LIMIT #,# 语法"

#: preproc.y:8000 preproc.y:8008
#, c-format
msgid "CREATE TABLE AS cannot specify INTO"
msgstr "在 CREATE TABLE AS 语句中不能指定 INTO 子句"

#: preproc.y:8053
#, c-format
msgid "expected \"@\", found \"%s\""
msgstr "预期为 \"@\"，实际为 \"%s\""

#: preproc.y:8065
#, c-format
msgid ""
"only protocols \"tcp\" and \"unix\" and database type \"postgresql\" are "
"supported"
msgstr "只支持协议 \"tcp\" 和 \"unix\" 以及数据库类型 \"postgresql\""

#: preproc.y:8068
#, c-format
msgid "expected \"://\", found \"%s\""
msgstr "预期为 \"://\"，实际为 \"%s\""

#: preproc.y:8073
#, c-format
msgid "Unix-domain sockets only work on \"localhost\" but not on \"%s\""
msgstr "Unix 域套接字只能用于 \"localhost\"，不能用于 \"%s\""

#: preproc.y:8100
#, c-format
msgid "expected \"postgresql\", found \"%s\""
msgstr "预期为 \"postgresql\"，实际为 \"%s\""

#: preproc.y:8103
#, c-format
msgid "invalid connection type: %s"
msgstr "无效的连接类型: %s"

#: preproc.y:8112
#, c-format
msgid "expected \"@\" or \"://\", found \"%s\""
msgstr "预期为 \"@\" 或 \"://\"，实际为 \"%s\""

#: preproc.y:8210 preproc.y:8228
#, c-format
msgid "invalid data type"
msgstr "无效的数据类型"

#: preproc.y:8239 preproc.y:8256
#, c-format
msgid "incomplete statement"
msgstr "不完整的语句"

#: preproc.y:8242 preproc.y:8259
#, c-format
msgid "unrecognized token \"%s\""
msgstr "无法识别的词元 \"%s\""

#: preproc.y:8314
#, c-format
msgid "name \"%s\" is already declared"
msgstr "名称 \"%s\" 已声明"

#: preproc.y:8617
#, c-format
msgid "only data types numeric and decimal have precision/scale argument"
msgstr "只有 numeric 和 decimal 数据类型具有精度/标度参数"

#: preproc.y:8716
#, c-format
msgid "interval specification not allowed here"
msgstr "此处不允许使用时间间隔字段的限定符"

#: preproc.y:8872 preproc.y:8930
#, c-format
msgid "too many levels in nested structure/union definition"
msgstr "嵌套的结构体/联合体定义层级过多"

#: preproc.y:9065
#, c-format
msgid "pointers to varchar are not implemented"
msgstr "未实现指向 varchar 类型值的指针"

#: preproc.y:9572
#, c-format
msgid "initializer not allowed in EXEC SQL VAR command"
msgstr "EXEC SQL VAR 命令中不允许使用初始化器"

#: preproc.y:9895
#, c-format
msgid "arrays of indicators are not allowed on input"
msgstr "输入中不允许使用指示符数组"

#: preproc.y:10131
#, c-format
msgid "operator not allowed in variable definition"
msgstr "变量定义中不允许使用操作符"

#. translator: %s is typically the translation of "syntax error"
#: preproc.y:10176
#, c-format
msgid "%s at or near \"%s\""
msgstr "%s，位置在 \"%s\" 或其附近"

#: type.c:191 type.c:664
#, c-format
