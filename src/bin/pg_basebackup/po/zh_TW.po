#: pg_basebackup.c:389
#, c-format
msgid ""
"%s takes a base backup of a running PostgreSQL server.\n"
"\n"
msgstr "%s 對執行中的 PostgreSQL 伺服器進行基本備份。\n\n"

#: pg_basebackup.c:391 pg_receivewal.c:79 pg_recvlogical.c:75
#, c-format
msgid "Usage:\n"
msgstr "用法:\n"

#: pg_basebackup.c:392 pg_receivewal.c:80 pg_recvlogical.c:76
#, c-format
msgid "  %s [OPTION]...\n"
msgstr "  %s [選項]...\n"

#: pg_basebackup.c:393
#, c-format
msgid ""
"\n"
"Options controlling the output:\n"
msgstr "\n控制輸出的選項:\n"

#: pg_basebackup.c:394
#, c-format
msgid "  -D, --pgdata=DIRECTORY receive base backup into directory\n"
msgstr "  -D, --pgdata=DIRECTORY 將基本備份接收到目錄中\n"

#: pg_basebackup.c:395
#, c-format
msgid "  -F, --format=p|t       output format (plain (default), tar)\n"
msgstr "  -F, --format=p|t       輸出格式(plain(預設), tar)\n"

#: pg_basebackup.c:396
#, c-format
msgid ""
"  -r, --max-rate=RATE    maximum transfer rate to transfer data directory\n"
"                         (in kB/s, or use suffix \"k\" or \"M\")\n"
msgstr "  -r, --max-rate=RATE    資料目錄最大傳輸速率\n                         (單位是 kB/s，或用後綴 \"k\" 或 \"M\")\n"

#: pg_basebackup.c:398
#, c-format
msgid ""
"  -R, --write-recovery-conf\n"
"                         write configuration for replication\n"
msgstr "  -R, --write-recovery-conf\n                         寫入複寫所需的組態\n"

#: pg_basebackup.c:400
#, c-format
msgid ""
"  -T, --tablespace-mapping=OLDDIR=NEWDIR\n"
"                         relocate tablespace in OLDDIR to NEWDIR\n"
msgstr "  -T, --tablespace-mapping=OLDDIR=NEWDIR\n                         將 OLDDIR 中的表空間搬到 NEWDIR\n"

#: pg_basebackup.c:402
#, c-format
msgid "      --waldir=WALDIR    location for the write-ahead log directory\n"
msgstr "      --waldir=WALDIR    預寫式日誌目錄的位置\n"

#: pg_basebackup.c:403
#, c-format
msgid ""
"  -X, --wal-method=none|fetch|stream\n"
"                         include required WAL files with specified method\n"
msgstr "  -X, --wal-method=none|fetch|stream\n                         用指定的方式包括必要的 WAL 檔\n"

#: pg_basebackup.c:405
#, c-format
msgid "  -z, --gzip             compress tar output\n"
msgstr "  -z, --gzip             壓縮 tar 輸出\n"

#: pg_basebackup.c:406
#, c-format
msgid "  -Z, --compress=0-9     compress tar output with given compression level\n"
msgstr "  -Z, --compress=0-9     按給定的壓縮層級壓縮 tar 輸出\n"

#: pg_basebackup.c:407
#, c-format
msgid ""
"\n"
"General options:\n"
msgstr ""
"\n"
"一般選項:\n"

#: pg_basebackup.c:408
#, c-format
msgid ""
"  -c, --checkpoint=fast|spread\n"
"                         set fast or spread checkpointing\n"
msgstr "  -c, --checkpoint=fast|spread\n                         設定 fast 或 spread 的檢查點方式\n"

#: pg_basebackup.c:410
#, c-format
msgid "  -C, --create-slot      create replication slot\n"
msgstr "  -C, --create-slot      建立複寫槽\n"

#: pg_basebackup.c:411
#, c-format
msgid "  -l, --label=LABEL      set backup label\n"
msgstr "  -l, --label=LABEL      設定備份標籤\n"

#: pg_basebackup.c:412
#, c-format
msgid "  -n, --no-clean         do not clean up after errors\n"
msgstr "  -n, --no-clean         發生錯誤後不清理\n"

#: pg_basebackup.c:413
#, c-format
msgid "  -N, --no-sync          do not wait for changes to be written safely to disk\n"
msgstr "  -N, --no-sync          不等待變更安全寫入磁碟\n"

#: pg_basebackup.c:414
#, c-format
msgid "  -P, --progress         show progress information\n"
msgstr "  -P, --progress         顯示進度資訊\n"

#: pg_basebackup.c:415 pg_receivewal.c:89
#, c-format
msgid "  -S, --slot=SLOTNAME    replication slot to use\n"
msgstr "  -S, --slot=SLOTNAME    複寫槽名稱\n"

#: pg_basebackup.c:416 pg_receivewal.c:91 pg_recvlogical.c:96
#, c-format
msgid "  -v, --verbose          output verbose messages\n"
msgstr "  -v, --verbose          顯示詳細訊息\n"

#: pg_basebackup.c:417 pg_receivewal.c:92 pg_recvlogical.c:97
#, c-format
msgid "  -V, --version          output version information, then exit\n"
msgstr "  -V, --version          顯示版本，然後結束\n"

#: pg_basebackup.c:418
#, c-format
msgid ""
"      --manifest-checksums=SHA{224,256,384,512}|CRC32C|NONE\n"
"                         use algorithm for manifest checksums\n"
msgstr "      --manifest-checksums=SHA{224,256,384,512}|CRC32C|NONE\n                         使用指定演算法計算清單檢查碼\n"

#: pg_basebackup.c:420
#, c-format
msgid ""
"      --manifest-force-encode\n"
"                         hex encode all file names in manifest\n"
msgstr "      --manifest-force-encode\n                         將清單中所有檔名進行十六進位編碼\n"

#: pg_basebackup.c:422
#, c-format
msgid "      --no-estimate-size do not estimate backup size in server side\n"
msgstr "      --no-estimate-size 不在伺服器端估算備份大小\n"

#: pg_basebackup.c:423
#, c-format
msgid "      --no-manifest      suppress generation of backup manifest\n"
msgstr "      --no-manifest      不產生備份清單\n"

#: pg_basebackup.c:424
#, c-format
msgid "      --no-slot          prevent creation of temporary replication slot\n"
msgstr "      --no-slot          阻止建立臨時複寫槽\n"

#: pg_basebackup.c:425
#, c-format
msgid ""
"      --no-verify-checksums\n"
"                         do not verify checksums\n"
msgstr "      --no-verify-checksums\n                         不驗證檢查碼\n"

#: pg_basebackup.c:427 pg_receivewal.c:94 pg_recvlogical.c:98
#, c-format
msgid "  -?, --help             show this help, then exit\n"
msgstr "  -?, --help             顯示說明，然後結束\n"

#: pg_basebackup.c:428 pg_receivewal.c:95 pg_recvlogical.c:99
#, c-format
msgid ""
"\n"
"Connection options:\n"
msgstr ""
"\n"
"連線選項:\n"

#: pg_basebackup.c:429 pg_receivewal.c:96
#, c-format
msgid "  -d, --dbname=CONNSTR   connection string\n"
msgstr "  -d, --dbname=CONNSTR   連接字串\n"

#: pg_basebackup.c:430 pg_receivewal.c:97 pg_recvlogical.c:101
#, c-format
msgid "  -h, --host=HOSTNAME    database server host or socket directory\n"
msgstr "  -h, --host=HOSTNAME    資料庫伺服器主機或 socket 目錄\n"

#: pg_basebackup.c:431 pg_receivewal.c:98 pg_recvlogical.c:102
#, c-format
msgid "  -p, --port=PORT        database server port number\n"
msgstr "  -p, --port=PORT        資料庫伺服器連接埠\n"

#: pg_basebackup.c:432
#, c-format
msgid ""
"  -s, --status-interval=INTERVAL\n"
"                         time between status packets sent to server (in seconds)\n"
msgstr "  -s, --status-interval=INTERVAL\n                         向伺服器發送狀態封包的時間間隔(以秒為單位)\n"

#: pg_basebackup.c:434 pg_receivewal.c:99 pg_recvlogical.c:103
#, c-format
msgid "  -U, --username=NAME    connect as specified database user\n"
msgstr "  -U, --username=NAME    以指定的資料庫使用者連線\n"

#: pg_basebackup.c:435 pg_receivewal.c:100 pg_recvlogical.c:104
#, c-format
msgid "  -w, --no-password      never prompt for password\n"
msgstr "  -w, --no-password      不詢問密碼\n"

#: pg_basebackup.c:436 pg_receivewal.c:101 pg_recvlogical.c:105
#, c-format
msgid "  -W, --password         force password prompt (should happen automatically)\n"
msgstr "  -W, --password         強制提示輸入密碼(應自動提示)\n"

#: pg_basebackup.c:437 pg_receivewal.c:105 pg_recvlogical.c:106
#, c-format
msgid ""
"\n"
"Report bugs to <%s>.\n"
msgstr "\n回報錯誤至 <%s>。\n"

#: pg_basebackup.c:438 pg_receivewal.c:106 pg_recvlogical.c:107
#, c-format
msgid "%s home page: <%s>\n"
msgstr "%s 首頁: <%s>\n"

