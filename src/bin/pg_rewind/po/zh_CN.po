msgid "need to copy %lu MB (total source directory size is %lu MB)"
msgstr "需要复制 %lu MB（整个源目录的大小是 %lu MB）"

#: pg_rewind.c:468
#, c-format
msgid "syncing target data directory"
msgstr "正在同步目标数据目录"

#: pg_rewind.c:484
#, c-format
msgid "Done!"
msgstr "完成！"

#: pg_rewind.c:567
#, c-format
msgid "no action decided for file \"%s\""
msgstr "尚未确定文件 \"%s\" 的处理操作"

