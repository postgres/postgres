msgid "  \\dAc[x+] [AMPTRN [TYPEPTRN]]  list operator classes\n"
msgstr "  \\dAc[x+] [AMPTRN [TYPEPTRN]]  列出運算子類別\n"

# help.c:224
#: help.c:228
msgid "  \\dAf[x+] [AMPTRN [TYPEPTRN]]  list operator families\n"
msgstr "  \\dAf[x+] [AMPTRN [TYPEPTRN]]  列出運算子家族\n"

# help.c:224
#: help.c:229
msgid "  \\dAo[x+] [AMPTRN [OPFPTRN]]   list operators of operator families\n"
msgstr "  \\dAo[x+] [AMPTRN [OPFPTRN]]   列出運算子家族中的運算子\n"

#: help.c:230
msgid "  \\dAp[x+] [AMPTRN [OPFPTRN]]   list support functions of operator families\n"
msgstr "  \\dAp[x+] [AMPTRN [OPFPTRN]]   列出運算子家族的支援函式\n"

# help.c:228
#: help.c:231
msgid "  \\db[x+]  [PATTERN]     list tablespaces\n"
msgstr "  \\db[x+]  [PATTERN]     列出表空間\n"

# help.c:217
#: help.c:232
msgid "  \\dc[Sx+] [PATTERN]     list conversions\n"
msgstr "  \\dc[Sx+] [PATTERN]     列出編碼轉換\n"

# help.c:221
#: help.c:233
msgid "  \\dconfig[x+] [PATTERN] list configuration parameters\n"
msgstr "  \\dconfig[x+] [PATTERN] 列出組態參數\n"

# help.c:218
#: help.c:234
