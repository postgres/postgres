#: pg_walsummary.c:267
#, c-format
msgid "Usage:\n"
msgstr "用法:\n"

#: pg_walsummary.c:268
#, c-format
msgid "  %s [OPTION]... FILE...\n"
msgstr "  %s [選項]... 檔案...\n"

#: pg_walsummary.c:269
#, c-format
msgid ""
"\n"
"Options:\n"
msgstr ""
"\n"
"選項:\n"

#: pg_walsummary.c:270
#, c-format
msgid "  -i, --individual          list block numbers individually, not as ranges\n"
msgstr "  -i, --individual          逐個列出區塊編號，而非顯示為範圍\n"

#: pg_walsummary.c:271
#, c-format
msgid "  -q, --quiet               don't print anything, just parse the files\n"
msgstr "  -q, --quiet               不輸出任何內容，只解析檔案\n"

#: pg_walsummary.c:272
#, c-format
msgid "  -V, --version             output version information, then exit\n"
msgstr "  -V, --version             顯示版本，然後結束\n"

#: pg_walsummary.c:273
#, c-format
msgid "  -?, --help                show this help, then exit\n"
msgstr "  -?, --help                顯示說明，然後結束\n"

#: pg_walsummary.c:275
#, c-format
msgid ""
"\n"
"Report bugs to <%s>.\n"
msgstr ""
"\n"
"回報錯誤至 <%s>。\n"

