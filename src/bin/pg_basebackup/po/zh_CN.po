msgstr "解析 tar 归档时出现意外状态"

#: bbstreamer_tar.c:297
#, c-format
msgid "tar member has empty name"
msgstr "tar 成员名称为空"

#: bbstreamer_tar.c:332
#, c-format
msgid "COPY stream ended before last file was finished"
msgstr "COPY 流在最后一个文件完成前结束"

#: bbstreamer_zstd.c:85
#, c-format
