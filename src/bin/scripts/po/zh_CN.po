#, c-format
msgid "  -U, --username=USERNAME   user name to connect as\n"
msgstr "  -U, --username=USERNAME   连接所用的用户名\n"

#: clusterdb.c:280 createuser.c:376 dropdb.c:184 dropuser.c:184 vacuumdb.c:1012
#, c-format
