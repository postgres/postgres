msgid "requirepeer parameter is not supported on this platform\n"
msgstr "此平台不支持 requirepeer 参数\n"

#: fe-connect.c:2847
#, c-format
msgid "could not get peer credentials: %s\n"
msgstr "无法获取对端凭据: %s\n"

#: fe-connect.c:2871
#, c-format
msgid "requirepeer specifies \"%s\", but actual peer user name is \"%s\"\n"
msgstr "requirepeer 指定的是 \"%s\"，但实际对端用户名为 \"%s\"\n"

#: fe-connect.c:2911
#, c-format
msgid "could not send GSSAPI negotiation packet: %s\n"
msgstr "无法发送 GSSAPI 协商包: %s\n"

#: fe-connect.c:2923
msgid ""
"GSSAPI encryption required but was impossible (possibly no credential cache, "
"no server support, or using a local socket)\n"
msgstr ""
"需要 GSSAPI 加密，但无法实现（可能没有凭据缓存、服务器不支持或使用了本地套接"
"字）\n"

#: fe-connect.c:2965
#, c-format
msgid "could not send SSL negotiation packet: %s\n"
msgstr "无法发送 SSL 协商包: %s\n"

#: fe-connect.c:2996
#, c-format
msgid "could not send startup packet: %s\n"
msgstr "无法发送启动包: %s\n"

#: fe-connect.c:3072
msgid "server does not support SSL, but SSL was required\n"
msgstr "服务器不支持 SSL，但连接需要使用 SSL\n"

#: fe-connect.c:3090
msgid "server sent an error response during SSL exchange\n"
msgstr "服务器在 SSL 交互期间已发送错误响应\n"

#: fe-connect.c:3096
#, c-format
msgid "received invalid response to SSL negotiation: %c\n"
msgstr "收到对 SSL 协商的无效响应: %c\n"

#: fe-connect.c:3117
msgid "received unencrypted data after SSL response\n"
msgstr "在 SSL 响应之后收到未加密的数据\n"

#: fe-connect.c:3198
msgid "server doesn't support GSSAPI encryption, but it was required\n"
msgstr "服务器不支持 GSSAPI 加密，但连接需要使用该加密\n"

#: fe-connect.c:3210
#, c-format
msgid "received invalid response to GSSAPI negotiation: %c\n"
msgstr "收到对 GSSAPI 协商的无效响应: %c\n"

#: fe-connect.c:3229
msgid "received unencrypted data after GSSAPI encryption response\n"
msgstr "在 GSSAPI 加密响应之后收到未加密的数据\n"

#: fe-connect.c:3294 fe-connect.c:3319
#, c-format
msgid "expected authentication request from server, but received %c\n"
msgstr "预期为服务器的认证请求，实际为 %c\n"

#: fe-connect.c:3526
msgid "unexpected message from server during startup\n"
msgstr "启动期间收到意外的服务器消息\n"

#: fe-connect.c:3618
msgid "session is read-only\n"
msgstr "会话为只读\n"

#: fe-connect.c:3621
msgid "session is not read-only\n"
msgstr "会话不是只读的\n"

#: fe-connect.c:3675
msgid "server is in hot standby mode\n"
msgstr "服务器处于热备模式\n"

#: fe-connect.c:3678
msgid "server is not in hot standby mode\n"
msgstr "服务器未处于热备模式\n"

#: fe-connect.c:3796 fe-connect.c:3848
#, c-format
msgid "\"%s\" failed\n"
msgstr "\"%s\" 失败\n"

#: fe-connect.c:3862
#, c-format
msgid "invalid connection state %d, probably indicative of memory corruption\n"
msgstr "连接状态 %d 无效，可能表明内存已损坏\n"

#: fe-connect.c:4308 fe-connect.c:4368
#, c-format
msgid "PGEventProc \"%s\" failed during PGEVT_CONNRESET event\n"
msgstr "PGEventProc \"%s\" 在 PGEVT_CONNRESET 事件期间失败\n"

#: fe-connect.c:4728
#, c-format
msgid "invalid LDAP URL \"%s\": scheme must be ldap://\n"
msgstr "LDAP URL \"%s\" 无效: 协议方案必须为 ldap://\n"

