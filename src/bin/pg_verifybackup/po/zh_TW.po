#: ../../common/jsonapi.c:1087
#, c-format
msgid "Escape sequence \"\\%s\" is invalid."
msgstr "逸出序列 \"\\%s\" 無效。"

#: ../../common/jsonapi.c:1090
#, c-format
msgid "Character with value 0x%02x must be escaped."
msgstr "必須對值為 0x%02x 的字元進行逸出處理。"

#: ../../common/jsonapi.c:1093
#, c-format
msgid "Expected end of input, but found \"%s\"."
msgstr "預期為輸入結束，實際為 \"%s\"。"

#: ../../common/jsonapi.c:1096
#, c-format
msgid "Expected array element or \"]\", but found \"%s\"."
msgstr "預期為陣列元素或 \"]\"，實際為 \"%s\"。"

#: ../../common/jsonapi.c:1099
#, c-format
msgid "Expected \",\" or \"]\", but found \"%s\"."
msgstr "預期為 \",\" 或 \"]\"，實際為 \"%s\"。"

#: ../../common/jsonapi.c:1102
#, c-format
msgid "Expected \":\", but found \"%s\"."
msgstr "預期為 \":\"，實際為 \"%s\"。"

#: ../../common/jsonapi.c:1105
#, c-format
msgid "Expected JSON value, but found \"%s\"."
msgstr "預期為 JSON 值，實際為 \"%s\"。"

#: ../../common/jsonapi.c:1108
msgid "The input string ended unexpectedly."
msgstr "輸入字串非預期地結束。"

#: ../../common/jsonapi.c:1110
#, c-format
msgid "Expected string or \"}\", but found \"%s\"."
msgstr "預期為字串或 \"}\"，實際為 \"%s\"。"

#: ../../common/jsonapi.c:1113
#, c-format
msgid "Expected \",\" or \"}\", but found \"%s\"."
msgstr "預期為 \",\" 或 \"}\"，實際為 \"%s\"。"

#: ../../common/jsonapi.c:1116
#, c-format
msgid "Expected string, but found \"%s\"."
msgstr "預期為字串，實際為 \"%s\"。"

#: ../../common/jsonapi.c:1119
#, c-format
msgid "Token \"%s\" is invalid."
msgstr "符記 \"%s\" 無效。"

#: ../../common/jsonapi.c:1122
msgid "\\u0000 cannot be converted to text."
msgstr "\\u0000 不能轉成文字。"

#: ../../common/jsonapi.c:1124
msgid "\"\\u\" must be followed by four hexadecimal digits."
msgstr "\"\\u\" 必須後接四個十六進位數字。"

#: ../../common/jsonapi.c:1127
msgid "Unicode escape values cannot be used for code point values above 007F when the encoding is not UTF8."
msgstr "當編碼不是 UTF8 時，不能使用 Unicode 逸出值來表示大於 007F 的編碼位置。"

#: ../../common/jsonapi.c:1129
msgid "Unicode high surrogate must not follow a high surrogate."
msgstr "Unicode 高位代理不能跟著高位代理。"

#: ../../common/jsonapi.c:1131
msgid "Unicode low surrogate must follow a high surrogate."
msgstr "Unicode 低位代理必須跟著高位代理。"

#: parse_manifest.c:152
msgid "manifest ended unexpectedly"
msgstr "清單非預期地結束"

#: parse_manifest.c:191
msgid "unexpected object start"
msgstr "非預期的物件開始"

#: parse_manifest.c:224
msgid "unexpected object end"
msgstr "非預期的物件結束"

#: parse_manifest.c:251
msgid "unexpected array start"
msgstr "非預期的陣列開始"

#: parse_manifest.c:274
msgid "unexpected array end"
msgstr "非預期的陣列結束"

#: parse_manifest.c:299
msgid "expected version indicator"
msgstr "預期為版本標示"

#: parse_manifest.c:328
msgid "unrecognized top-level field"
msgstr "無法識別的頂層欄位"

#: parse_manifest.c:347
msgid "unexpected file field"
msgstr "非預期的檔案欄位"

#: parse_manifest.c:361
msgid "unexpected WAL range field"
msgstr "非預期的 WAL 範圍欄位"

#: parse_manifest.c:367
msgid "unexpected object field"
msgstr "非預期的物件欄位"

#: parse_manifest.c:397
msgid "unexpected manifest version"
msgstr "非預期的清單版本"

#: parse_manifest.c:448
msgid "unexpected scalar"
msgstr "非預期的純量值"

#: parse_manifest.c:472
msgid "missing path name"
msgstr "缺少路徑名稱"

#: parse_manifest.c:475
msgid "both path name and encoded path name"
msgstr "同時存在路徑名稱和編碼路徑名稱"

#: parse_manifest.c:477
msgid "missing size"
msgstr "缺少大小"

#: parse_manifest.c:480
msgid "checksum without algorithm"
msgstr "檢查碼沒有演算法"

#: parse_manifest.c:494
msgid "could not decode file name"
msgstr "無法解碼檔案名稱"

#: parse_manifest.c:504
msgid "file size is not an integer"
msgstr "檔案大小不是整數"

#: parse_manifest.c:510
#, c-format
msgid "unrecognized checksum algorithm: \"%s\""
msgstr "無法識別的檢查碼演算法: \"%s\""

#: parse_manifest.c:529
#, c-format
msgid "invalid checksum for file \"%s\": \"%s\""
msgstr "檔案 \"%s\" 的檢查碼無效: \"%s\""

#: parse_manifest.c:572
msgid "missing timeline"
msgstr "缺少時間線"

#: parse_manifest.c:574
msgid "missing start LSN"
msgstr "缺少起始 LSN"

#: parse_manifest.c:576
msgid "missing end LSN"
msgstr "缺少結束 LSN"

#: parse_manifest.c:582
msgid "timeline is not an integer"
msgstr "時間線不是整數"

#: parse_manifest.c:585
msgid "could not parse start LSN"
msgstr "無法解析起始 LSN"

#: parse_manifest.c:588
msgid "could not parse end LSN"
msgstr "無法解析結束 LSN"

#: parse_manifest.c:649
msgid "expected at least 2 lines"
msgstr "預期至少有 2 行"

#: parse_manifest.c:652
msgid "last line not newline-terminated"
msgstr "最後一行未以換行字元結束"

