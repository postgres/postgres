#: pg_controldata.c:35
#, c-format
msgid ""
"%s displays control information of a PostgreSQL database cluster.\n"
"\n"
msgstr ""
"%s mostra le informazioni di controllo di un cluster di database PostgreSQL.\n"
"\n"

#: pg_controldata.c:36
#, c-format
msgid "Usage:\n"
msgstr "Uso:\n"

#: pg_controldata.c:37
#, c-format
msgid "  %s [OPTION] [DATADIR]\n"
msgstr "  %s [OPZIONE] [DATADIR]\n"

#: pg_controldata.c:38
#, c-format
msgid ""
"\n"
"Options:\n"
msgstr ""
"\n"
"Opzioni:\n"

#: pg_controldata.c:39
#, c-format
msgid " [-D, --pgdata=]DATADIR  data directory\n"
msgstr " [-D, --pgdata=]DATADIR  directory dei dati\n"

#: pg_controldata.c:40
#, c-format
msgid "  -V, --version          output version information, then exit\n"
msgstr "  -V, --version          mostra le informazioni sulla versione, poi esci\n"

#: pg_controldata.c:41
#, c-format
msgid "  -?, --help             show this help, then exit\n"
msgstr "  -?, --help             mostra questo aiuto, poi esci\n"

#: pg_controldata.c:42
#, c-format
msgid ""
"\n"
"If no data directory (DATADIR) is specified, the environment variable PGDATA\n"
"is used.\n"
"\n"
msgstr ""
"\n"
"Se la directory dei dati (DATADIR) non è specificata, viene usata la variabile\n"
"d'ambiente PGDATA.\n"
"\n"

