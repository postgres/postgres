msgid "invalid record length at %X/%08X: expected at least %u, got %u"
msgstr ""
"неверная длина записи в позиции %X/%08X: ожидалось минимум %u, получено %u"

#: xlogreader.c:764
#, c-format
msgid "there is no contrecord flag at %X/%08X"
msgstr "нет флага contrecord в позиции %X/%08X"

#: xlogreader.c:777
#, c-format
msgid "invalid contrecord length %u (expected %lld) at %X/%08X"
msgstr "неверная длина contrecord: %u (ожидалась %lld) в позиции %X/%08X"

#: xlogreader.c:1157
#, c-format
msgid "invalid resource manager ID %u at %X/%08X"
msgstr "неверный ID менеджера ресурсов %u в позиции %X/%08X"

#: xlogreader.c:1170 xlogreader.c:1186
#, c-format
msgid "record with incorrect prev-link %X/%08X at %X/%08X"
msgstr "запись с неверной ссылкой назад %X/%08X в позиции %X/%08X"

#: xlogreader.c:1224
#, c-format
msgid "incorrect resource manager data checksum in record at %X/%08X"
msgstr ""
"некорректная контрольная сумма данных менеджера ресурсов в записи в позиции "
"%X/%08X"

#: xlogreader.c:1258
#, c-format
msgid "invalid magic number %04X in WAL segment %s, LSN %X/%08X, offset %u"
msgstr ""
"неверное магическое число %04X в сегменте WAL %s, LSN %X/%08X, смещение %u"

#: xlogreader.c:1273 xlogreader.c:1315
#, c-format
msgid "invalid info bits %04X in WAL segment %s, LSN %X/%08X, offset %u"
msgstr ""
"неверные информационные биты %04X в сегменте WAL %s, LSN %X/%08X, смещение %u"

#: xlogreader.c:1289
#, c-format
msgid ""
"WAL file is from different database system: WAL file database system "
"identifier is %<PRIu64>, pg_control database system identifier is %<PRIu64>"
msgstr ""
"файл WAL принадлежит другой СУБД: в нём указан идентификатор системы БД "
"%<PRIu64>, а идентификатор системы pg_control: %<PRIu64>"

#: xlogreader.c:1297
#, c-format
msgid ""
"WAL file is from different database system: incorrect segment size in page "
"header"
msgstr ""
"файл WAL принадлежит другой СУБД: некорректный размер сегмента в заголовке "
"страницы"

#: xlogreader.c:1303
#, c-format
msgid ""
"WAL file is from different database system: incorrect XLOG_BLCKSZ in page "
"header"
msgstr ""
"файл WAL принадлежит другой СУБД: некорректный XLOG_BLCKSZ в заголовке "
"страницы"

#: xlogreader.c:1335
#, c-format
msgid "unexpected pageaddr %X/%08X in WAL segment %s, LSN %X/%08X, offset %u"
msgstr ""
"неожиданный pageaddr %X/%08X в сегменте WAL %s, LSN %X/%08X, смещение %u"

#: xlogreader.c:1361
#, c-format
msgid ""
"out-of-sequence timeline ID %u (after %u) in WAL segment %s, LSN %X/%08X, "
"offset %u"
msgstr ""
"нарушение последовательности ID линии времени %u (после %u) в сегменте WAL "
"%s, LSN %X/%08X, смещение %u"

#: xlogreader.c:1792
#, c-format
msgid "out-of-order block_id %u at %X/%08X"
msgstr "идентификатор блока %u идёт не по порядку в позиции %X/%08X"

#: xlogreader.c:1816
#, c-format
msgid "BKPBLOCK_HAS_DATA set, but no data included at %X/%08X"
msgstr "BKPBLOCK_HAS_DATA установлен, но данных в позиции %X/%08X нет"

#: xlogreader.c:1823
#, c-format
msgid "BKPBLOCK_HAS_DATA not set, but data length is %d at %X/%08X"
msgstr ""
"BKPBLOCK_HAS_DATA не установлен, но длина данных равна %d в позиции %X/%08X"

#: xlogreader.c:1859
#, c-format
msgid ""
"BKPIMAGE_HAS_HOLE set, but hole offset %d length %d block image length %d at "
"%X/%08X"
msgstr ""
"BKPIMAGE_HAS_HOLE установлен, но для пропуска заданы смещение %d и длина %d "
"при длине образа блока %d в позиции %X/%08X"

#: xlogreader.c:1875
#, c-format
msgid "BKPIMAGE_HAS_HOLE not set, but hole offset %d length %d at %X/%08X"
msgstr ""
"BKPIMAGE_HAS_HOLE не установлен, но для пропуска заданы смещение %d и длина "
"%d в позиции %X/%08X"

#: xlogreader.c:1889
#, c-format
msgid "BKPIMAGE_COMPRESSED set, but block image length %d at %X/%08X"
msgstr ""
"BKPIMAGE_COMPRESSED установлен, но длина образа блока равна %d в позиции %X/"
"%08X"

#: xlogreader.c:1904
#, c-format
msgid ""
"neither BKPIMAGE_HAS_HOLE nor BKPIMAGE_COMPRESSED set, but block image "
"length is %d at %X/%08X"
msgstr ""
"ни BKPIMAGE_HAS_HOLE, ни BKPIMAGE_COMPRESSED не установлены, но длина образа "
"блока равна %d в позиции %X/%08X"

#: xlogreader.c:1920
#, c-format
msgid "BKPBLOCK_SAME_REL set but no previous rel at %X/%08X"
msgstr ""
"BKPBLOCK_SAME_REL установлен, но предыдущее отношение не задано в позиции %X/"
"%08X"

#: xlogreader.c:1932
#, c-format
msgid "invalid block_id %u at %X/%08X"
msgstr "неверный идентификатор блока %u в позиции %X/%08X"

#: xlogreader.c:1999
#, c-format
msgid "record with invalid length at %X/%08X"
msgstr "запись с неверной длиной в позиции %X/%08X"

#: xlogreader.c:2025
#, c-format
msgid "could not locate backup block with ID %d in WAL record"
msgstr "не удалось найти копию блока с ID %d в записи журнала WAL"

#: xlogreader.c:2109
#, c-format
msgid "could not restore image at %X/%08X with invalid block %d specified"
msgstr ""
"не удалось восстановить образ в позиции %X/%08X с указанным неверным блоком "
"%d"

#: xlogreader.c:2116
#, c-format
msgid "could not restore image at %X/%08X with invalid state, block %d"
msgstr ""
"не удалось восстановить образ в позиции %X/%08X с неверным состоянием, блок "
"%d"

#: xlogreader.c:2143 xlogreader.c:2160
#, c-format
msgid ""
"could not restore image at %X/%08X compressed with %s not supported by "
"build, block %d"
msgstr ""
"не удалось восстановить образ в позиции %X/%08X, сжатый методом %s, который "
"не поддерживается этой сборкой, блок %d"

#: xlogreader.c:2169
#, c-format
msgid ""
"could not restore image at %X/%08X compressed with unknown method, block %d"
msgstr ""
"не удалось восстановить образ в позиции %X/%08X, сжатый неизвестным методом, "
"блок %d"

#: xlogreader.c:2177
#, c-format
msgid "could not decompress image at %X/%08X, block %d"
msgstr "не удалось распаковать образ в позиции %X/%08X, блок %d"

