msgstr "  \\dRp[x+] [PATTERN]     列出複寫發布\n"

# help.c:217
#: help.c:264
msgid "  \\dRs[x+] [PATTERN]     list replication subscriptions\n"
msgstr "  \\dRs[x+] [PATTERN]     列出複寫訂閱\n"

# help.c:228
#: help.c:265
msgid "  \\ds[Sx+] [PATTERN]     list sequences\n"
msgstr "  \\ds[Sx+] [PATTERN]     列出序列\n"

# help.c:228
#: help.c:266
msgid "  \\dt[Sx+] [PATTERN]     list tables\n"
msgstr "  \\dt[Sx+] [PATTERN]     列出資料表\n"

# help.c:220
#: help.c:267
msgid "  \\dT[Sx+] [PATTERN]     list data types\n"
msgstr "  \\dT[Sx+] [PATTERN]     列出資料型別\n"

# help.c:228
#: help.c:268
