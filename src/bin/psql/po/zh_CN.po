#: help.c:73
#, c-format
msgid ""
"psql is the PostgreSQL interactive terminal.\n"
"\n"
msgstr ""
"psql 是 PostgreSQL 的交互式终端。\n"
"\n"

#: help.c:74 help.c:359 help.c:437 help.c:483
#, c-format
msgid "Usage:\n"
msgstr "用法:\n"

#: help.c:75
#, c-format
msgid ""
"  psql [OPTION]... [DBNAME [USERNAME]]\n"
"\n"
msgstr ""
"  psql [选项]... [数据库名 [用户名]]\n"
"\n"

#: help.c:77
#, c-format
msgid "General options:\n"
msgstr "一般选项:\n"

#: help.c:82
#, c-format
msgid ""
"  -c, --command=COMMAND    run only single command (SQL or internal) and "
"exit\n"
msgstr "  -c, --command=COMMAND    仅执行一条命令（SQL 或内部命令）并退出\n"

#: help.c:83
#, c-format
msgid ""
"  -d, --dbname=DBNAME      database name to connect to (default: \"%s\")\n"
msgstr "  -d, --dbname=DBNAME      要连接的数据库名（默认: \"%s\"）\n"

#: help.c:84
#, c-format
msgid "  -f, --file=FILENAME      execute commands from file, then exit\n"
msgstr "  -f, --file=FILENAME      从文件中执行命令然后退出\n"

#: help.c:85
#, c-format
msgid "  -l, --list               list available databases, then exit\n"
msgstr "  -l, --list               列出所有可用的数据库，然后退出\n"

#: help.c:86
#, c-format
msgid ""
"  -v, --set=, --variable=NAME=VALUE\n"
"                           set psql variable NAME to VALUE\n"
"                           (e.g., -v ON_ERROR_STOP=1)\n"
msgstr ""
"  -v, --set=, --variable=NAME=VALUE\n"
"                           设置 psql 变量 NAME 为 VALUE\n"
"                           （例如，-v ON_ERROR_STOP=1）\n"

#: help.c:89
#, c-format
msgid "  -V, --version            output version information, then exit\n"
msgstr "  -V, --version            输出版本信息，然后退出\n"

#: help.c:90
#, c-format
msgid "  -X, --no-psqlrc          do not read startup file (~/.psqlrc)\n"
msgstr "  -X, --no-psqlrc          不读取启动文件（~/.psqlrc）\n"

#: help.c:91
#, c-format
msgid ""
"  -1 (\"one\"), --single-transaction\n"
"                           execute as a single transaction (if non-"
"interactive)\n"
msgstr ""
"  -1 (\"one\"), --single-transaction\n"
"                           作为一个事务执行（非交互模式下）\n"

#: help.c:93
#, c-format
msgid "  -?, --help[=options]     show this help, then exit\n"
msgstr "  -?, --help[=options]     显示此帮助，然后退出\n"

#: help.c:94
#, c-format
msgid "      --help=commands      list backslash commands, then exit\n"
msgstr "      --help=commands      列出反斜杠命令，然后退出\n"

#: help.c:95
#, c-format
msgid "      --help=variables     list special variables, then exit\n"
msgstr "      --help=variables     列出特殊变量，然后退出\n"

#: help.c:97
#, c-format
msgid ""
"\n"
"Input and output options:\n"
msgstr ""
"\n"
"输入和输出选项:\n"

#: help.c:98
#, c-format
msgid "  -a, --echo-all           echo all input from script\n"
msgstr "  -a, --echo-all           回显来自脚本的所有输入\n"

#: help.c:99
#, c-format
msgid "  -b, --echo-errors        echo failed commands\n"
msgstr "  -b, --echo-errors        回显失败的命令\n"

#: help.c:100
#, c-format
msgid "  -e, --echo-queries       echo commands sent to server\n"
msgstr "  -e, --echo-queries       回显发送给服务器的命令\n"

#: help.c:101
#, c-format
msgid ""
"  -E, --echo-hidden        display queries that internal commands generate\n"
msgstr "  -E, --echo-hidden        显示内部命令产生的查询\n"

#: help.c:102
#, c-format
msgid "  -L, --log-file=FILENAME  send session log to file\n"
msgstr "  -L, --log-file=FILENAME  将会话日志写入文件\n"

#: help.c:103
#, c-format
msgid ""
"  -n, --no-readline        disable enhanced command line editing (readline)\n"
msgstr "  -n, --no-readline        禁用增强命令行编辑功能（readline）\n"

#: help.c:104
#, c-format
msgid "  -o, --output=FILENAME    send query results to file (or |pipe)\n"
msgstr "  -o, --output=FILENAME    将查询结果写入文件（或 |pipe）\n"

#: help.c:105
#, c-format
msgid ""
"  -q, --quiet              run quietly (no messages, only query output)\n"
msgstr "  -q, --quiet              静默运行（不显示消息，只有查询结果）\n"

#: help.c:106
#, c-format
msgid "  -s, --single-step        single-step mode (confirm each query)\n"
msgstr "  -s, --single-step        单步模式（确认每个查询）\n"

#: help.c:107
#, c-format
msgid ""
"  -S, --single-line        single-line mode (end of line terminates SQL "
"command)\n"
msgstr "  -S, --single-line        单行模式（行末终止 SQL 命令）\n"

#: help.c:109
#, c-format
msgid ""
"\n"
"Output format options:\n"
msgstr ""
"\n"
"输出格式选项:\n"

#: help.c:110
#, c-format
msgid "  -A, --no-align           unaligned table output mode\n"
msgstr "  -A, --no-align           使用非对齐表格输出模式\n"

#: help.c:111
#, c-format
msgid ""
"      --csv                CSV (Comma-Separated Values) table output mode\n"
msgstr "      --csv                CSV（逗号分隔值）表格输出模式\n"

#: help.c:112
#, c-format
msgid ""
"  -F, --field-separator=STRING\n"
"                           field separator for unaligned output (default: "
"\"%s\")\n"
msgstr ""
"  -F, --field-separator=STRING\n"
"                           非对齐输出的字段分隔符（默认为 \"%s\"）\n"

#: help.c:115
#, c-format
msgid "  -H, --html               HTML table output mode\n"
msgstr "  -H, --html               HTML 表格输出模式\n"

#: help.c:116
#, c-format
msgid ""
"  -P, --pset=VAR[=ARG]     set printing option VAR to ARG (see \\pset "
"command)\n"
msgstr ""
"  -P, --pset=VAR[=ARG]     将打印选项 VAR 设为 ARG（参见 \\pset 命令）\n"

#: help.c:117
#, c-format
msgid ""
"  -R, --record-separator=STRING\n"
"                           record separator for unaligned output (default: "
"newline)\n"
msgstr ""
"  -R, --record-separator=STRING\n"
"                           非对齐输出的记录分隔符（默认为换行符）\n"

#: help.c:119
#, c-format
msgid "  -t, --tuples-only        print rows only\n"
msgstr "  -t, --tuples-only        只打印行\n"

#: help.c:120
#, c-format
msgid ""
"  -T, --table-attr=TEXT    set HTML table tag attributes (e.g., width, "
"border)\n"
msgstr ""
"  -T, --table-attr=TEXT    设置 HTML 表格标签属性（如 width, border）\n"

#: help.c:121
#, c-format
msgid "  -x, --expanded           turn on expanded table output\n"
msgstr "  -x, --expanded           开启扩展表格输出\n"

#: help.c:122
#, c-format
msgid ""
"  -z, --field-separator-zero\n"
"                           set field separator for unaligned output to zero "
"byte\n"
msgstr ""
"  -z, --field-separator-zero\n"
"                           将非对齐输出的字段分隔符设为空字节\n"

#: help.c:124
#, c-format
msgid ""
"  -0, --record-separator-zero\n"
"                           set record separator for unaligned output to zero "
"byte\n"
msgstr ""
"  -0, --record-separator-zero\n"
"                           将非对齐输出的记录分隔符设为空字节\n"

#: help.c:127
#, c-format
msgid ""
"\n"
"Connection options:\n"
msgstr ""
"\n"
"连接选项:\n"

#: help.c:130
#, c-format
msgid ""
"  -h, --host=HOSTNAME      database server host or socket directory "
"(default: \"%s\")\n"
msgstr ""
"  -h, --host=HOSTNAME      数据库服务器主机或套接字目录（默认: \"%s\"）\n"

#: help.c:131
msgid "local socket"
msgstr "本地套接字"

#: help.c:134
#, c-format
msgid "  -p, --port=PORT          database server port (default: \"%s\")\n"
msgstr "  -p, --port=PORT          数据库服务器端口（默认: \"%s\"）\n"

#: help.c:137
#, c-format
msgid "  -U, --username=USERNAME  database user name (default: \"%s\")\n"
msgstr "  -U, --username=USERNAME  数据库用户名（默认: \"%s\"）\n"

#: help.c:138
#, c-format
msgid "  -w, --no-password        never prompt for password\n"
msgstr "  -w, --no-password        永远不提示输入密码\n"

#: help.c:139
#, c-format
msgid ""
"  -W, --password           force password prompt (should happen "
"automatically)\n"
msgstr "  -W, --password           强制提示输入密码（应当自动提示）\n"

#: help.c:141
#, c-format
msgid ""
"\n"
"For more information, type \"\\?\" (for internal commands) or \"\\help\" "
"(for SQL\n"
"commands) from within psql, or consult the psql section in the PostgreSQL\n"
"documentation.\n"
"\n"
msgstr ""
"\n"
"更多信息，在 psql 中输入 \"\\?\"（内部命令）或 \"\\help\"（SQL 命令），\n"
"或参阅 PostgreSQL 文档中的 psql 章节。\n"
"\n"

#: help.c:144
#, c-format
msgid "Report bugs to <%s>.\n"
msgstr "请向 <%s> 报告缺陷。\n"

#: help.c:145
#, c-format
msgid "%s home page: <%s>\n"
msgstr "%s 主页: <%s>\n"

#: help.c:171
#, c-format
msgid "General\n"
msgstr "一般\n"

#: help.c:172
#, c-format
msgid ""
"  \\copyright             show PostgreSQL usage and distribution terms\n"
msgstr "  \\copyright             显示 PostgreSQL 的使用和发行许可条款\n"

#: help.c:173
#, c-format
msgid ""
"  \\crosstabview [COLUMNS] execute query and display results in crosstab\n"
msgstr "  \\crosstabview [COLUMNS] 执行查询并且以交叉表显示结果\n"

#: help.c:174
#, c-format
msgid ""
"  \\errverbose            show most recent error message at maximum "
"verbosity\n"
msgstr "  \\errverbose            以最高详细级别显示最近的错误消息\n"

#: help.c:175
#, c-format
msgid ""
"  \\g [(OPTIONS)] [FILE]  execute query (and send results to file or |"
"pipe);\n"
"                         \\g with no arguments is equivalent to a semicolon\n"
msgstr ""
"  \\g [(OPTIONS)] [FILE]  执行查询（并将结果发送到文件或 |pipe）；\n"
"                         不带参数的 \\g 等同于分号\n"

#: help.c:177
#, c-format
msgid ""
"  \\gdesc                 describe result of query, without executing it\n"
msgstr "  \\gdesc                 描述查询结果，而不执行查询\n"

#: help.c:178
#, c-format
msgid ""
"  \\gexec                 execute query, then execute each value in its "
"result\n"
msgstr "  \\gexec                 执行查询，再执行结果中的每个值\n"

#: help.c:179
#, c-format
msgid ""
"  \\gset [PREFIX]         execute query and store results in psql variables\n"
msgstr "  \\gset [PREFIX]         执行查询并将结果存入 psql 变量\n"

#: help.c:180
#, c-format
msgid "  \\gx [(OPTIONS)] [FILE] as \\g, but forces expanded output mode\n"
msgstr "  \\gx [(OPTIONS)] [FILE] 就像 \\g，但强制扩展输出模式\n"

#: help.c:181
#, c-format
msgid "  \\q                     quit psql\n"
msgstr "  \\q                     退出 psql\n"

#: help.c:182
#, c-format
msgid ""
"  \\restrict RESTRICT_KEY\n"
"                         enter restricted mode with provided key\n"
msgstr ""
"  \\restrict RESTRICT_KEY\n"
"                         使用给定密钥进入限制模式\n"

#: help.c:184
#, c-format
msgid ""
"  \\unrestrict RESTRICT_KEY\n"
"                         exit restricted mode if key matches\n"
msgstr ""
"  \\unrestrict RESTRICT_KEY\n"
"                         密钥匹配时退出限制模式\n"

#: help.c:186
#, c-format
msgid "  \\watch [SEC]           execute query every SEC seconds\n"
msgstr "  \\watch [SEC]           每隔 SEC 秒执行一次查询\n"

#: help.c:189
#, c-format
msgid "Help\n"
msgstr "帮助\n"

#: help.c:191
#, c-format
msgid "  \\? [commands]          show help on backslash commands\n"
msgstr "  \\? [commands]          显示反斜杠命令的帮助\n"

#: help.c:192
#, c-format
msgid "  \\? options             show help on psql command-line options\n"
msgstr "  \\? options             显示 psql 命令行选项的帮助\n"

#: help.c:193
#, c-format
msgid "  \\? variables           show help on special variables\n"
msgstr "  \\? variables           显示特殊变量的帮助\n"

#: help.c:194
#, c-format
msgid ""
"  \\h [NAME]              help on syntax of SQL commands, * for all "
"commands\n"
msgstr "  \\h [NAME]              查看 SQL 命令的语法帮助，* 表示所有命令\n"

#: help.c:197
#, c-format
msgid "Query Buffer\n"
msgstr "查询缓冲区\n"

#: help.c:198
#, c-format
msgid ""
"  \\e [FILE] [LINE]       edit the query buffer (or file) with external "
"editor\n"
msgstr "  \\e [FILE] [LINE]       使用外部编辑器编辑查询缓冲区（或文件）\n"

#: help.c:199
#, c-format
msgid ""
"  \\ef [FUNCNAME [LINE]]  edit function definition with external editor\n"
msgstr "  \\ef [FUNCNAME [LINE]]  使用外部编辑器编辑函数定义\n"

#: help.c:200
#, c-format
msgid "  \\ev [VIEWNAME [LINE]]  edit view definition with external editor\n"
msgstr "  \\ev [VIEWNAME [LINE]]  使用外部编辑器编辑视图定义\n"

#: help.c:201
#, c-format
msgid "  \\p                     show the contents of the query buffer\n"
msgstr "  \\p                     显示查询缓冲区的内容\n"

#: help.c:202
#, c-format
msgid "  \\r                     reset (clear) the query buffer\n"
msgstr "  \\r                     重置（清空）查询缓冲区\n"

#: help.c:204
#, c-format
msgid "  \\s [FILE]              display history or save it to file\n"
msgstr "  \\s [FILE]              显示历史记录或将历史记录保存在文件中\n"

#: help.c:206
#, c-format
msgid "  \\w FILE                write query buffer to file\n"
msgstr "  \\w FILE                将查询缓冲区写入文件\n"

#: help.c:209
#, c-format
msgid "Input/Output\n"
msgstr "输入/输出\n"

#: help.c:210
#, c-format
msgid ""
"  \\copy ...              perform SQL COPY with data stream to the client "
"host\n"
msgstr "  \\copy ...              执行 SQL COPY，将数据流传至客户端主机\n"

#: help.c:211
#, c-format
msgid ""
"  \\echo [-n] [STRING]    write string to standard output (-n for no "
"newline)\n"
msgstr "  \\echo [-n] [STRING]    将字符串写入标准输出（-n 表示无换行）\n"

#: help.c:212
#, c-format
msgid "  \\i FILE                execute commands from file\n"
msgstr "  \\i FILE                从文件中执行命令\n"

#: help.c:213
#, c-format
msgid ""
"  \\ir FILE               as \\i, but relative to location of current "
"script\n"
msgstr "  \\ir FILE               与 \\i 类似，但是相对于当前脚本的位置\n"

#: help.c:214
#, c-format
msgid "  \\o [FILE]              send all query results to file or |pipe\n"
msgstr "  \\o [FILE]              将全部查询结果写入文件或 |pipe\n"

#: help.c:215
#, c-format
msgid ""
"  \\qecho [-n] [STRING]   write string to \\o output stream (-n for no "
"newline)\n"
msgstr "  \\qecho [-n] [STRING]   将字符串写入 \\o 输出流（-n 表示无换行）\n"

#: help.c:216
#, c-format
msgid ""
"  \\warn [-n] [STRING]    write string to standard error (-n for no "
"newline)\n"
msgstr "  \\warn [-n] [STRING]    将字符串写入标准错误（-n 表示无换行）\n"

#: help.c:219
#, c-format
msgid "Conditional\n"
msgstr "条件\n"

#: help.c:220
#, c-format
msgid "  \\if EXPR               begin conditional block\n"
msgstr "  \\if EXPR               开始条件块\n"

#: help.c:221
#, c-format
msgid ""
"  \\elif EXPR             alternative within current conditional block\n"
msgstr "  \\elif EXPR             当前条件块内的备选分支\n"

#: help.c:222
#, c-format
msgid ""
"  \\else                  final alternative within current conditional "
"block\n"
msgstr "  \\else                  当前条件块内的最后一个备选分支\n"

#: help.c:223
#, c-format
msgid "  \\endif                 end conditional block\n"
msgstr "  \\endif                 结束条件块\n"

#: help.c:226
#, c-format
msgid "Informational\n"
msgstr "信息查询\n"

#: help.c:227
#, c-format
msgid "  (options: S = show system objects, + = additional detail)\n"
msgstr "  （选项: S = 显示系统对象, + = 额外详情）\n"

#: help.c:228
#, c-format
msgid "  \\d[S+]                 list tables, views, and sequences\n"
msgstr "  \\d[S+]                 列出表、视图和序列\n"

#: help.c:229
#, c-format
msgid "  \\d[S+]  NAME           describe table, view, sequence, or index\n"
msgstr "  \\d[S+]  NAME           描述表、视图、序列或索引\n"

#: help.c:230
#, c-format
msgid "  \\da[S]  [PATTERN]      list aggregates\n"
msgstr "  \\da[S]  [PATTERN]      列出聚合函数\n"

#: help.c:231
#, c-format
msgid "  \\dA[+]  [PATTERN]      list access methods\n"
msgstr "  \\dA[+]  [PATTERN]      列出访问方法\n"

#: help.c:232
#, c-format
msgid "  \\dAc[+] [AMPTRN [TYPEPTRN]]  list operator classes\n"
msgstr "  \\dAc[+] [AMPTRN [TYPEPTRN]]  列出操作符类\n"

#: help.c:233
#, c-format
msgid "  \\dAf[+] [AMPTRN [TYPEPTRN]]  list operator families\n"
msgstr "  \\dAf[+] [AMPTRN [TYPEPTRN]]  列出操作符族\n"

#: help.c:234
#, c-format
msgid "  \\dAo[+] [AMPTRN [OPFPTRN]]   list operators of operator families\n"
msgstr "  \\dAo[+] [AMPTRN [OPFPTRN]]   列出操作符族中的操作符\n"

#: help.c:235
#, c-format
msgid ""
"  \\dAp[+] [AMPTRN [OPFPTRN]]   list support functions of operator families\n"
msgstr "  \\dAp[+] [AMPTRN [OPFPTRN]]   列出操作符族中的支持函数\n"

#: help.c:236
#, c-format
msgid "  \\db[+]  [PATTERN]      list tablespaces\n"
msgstr "  \\db[+]  [PATTERN]      列出表空间\n"

#: help.c:237
#, c-format
msgid "  \\dc[S+] [PATTERN]      list conversions\n"
msgstr "  \\dc[S+] [PATTERN]      列出编码转换\n"

#: help.c:238
#, c-format
msgid "  \\dC[+]  [PATTERN]      list casts\n"
msgstr "  \\dC[+]  [PATTERN]      列出类型转换\n"

#: help.c:239
#, c-format
msgid ""
"  \\dd[S]  [PATTERN]      show object descriptions not displayed elsewhere\n"
msgstr "  \\dd[S]  [PATTERN]      显示未在其他位置显示的对象描述\n"

#: help.c:240
#, c-format
msgid "  \\dD[S+] [PATTERN]      list domains\n"
msgstr "  \\dD[S+] [PATTERN]      列出域\n"

#: help.c:241
#, c-format
msgid "  \\ddp    [PATTERN]      list default privileges\n"
msgstr "  \\ddp    [PATTERN]      列出默认权限\n"

#: help.c:242
#, c-format
msgid "  \\dE[S+] [PATTERN]      list foreign tables\n"
msgstr "  \\dE[S+] [PATTERN]      列出外部表\n"

#: help.c:243
#, c-format
msgid "  \\des[+] [PATTERN]      list foreign servers\n"
msgstr "  \\des[+] [PATTERN]      列出外部服务器\n"

#: help.c:244
#, c-format
msgid "  \\det[+] [PATTERN]      list foreign tables\n"
msgstr "  \\det[+] [PATTERN]      列出外部表\n"

#: help.c:245
#, c-format
msgid "  \\deu[+] [PATTERN]      list user mappings\n"
msgstr "  \\deu[+] [PATTERN]      列出用户映射\n"

#: help.c:246
#, c-format
msgid "  \\dew[+] [PATTERN]      list foreign-data wrappers\n"
msgstr "  \\dew[+] [PATTERN]      列出外部数据包装器\n"

#: help.c:247
#, c-format
msgid ""
"  \\df[anptw][S+] [FUNCPTRN [TYPEPTRN ...]]\n"
"                         list [only agg/normal/procedure/trigger/window] "
"functions\n"
msgstr ""
"  \\df[anptw][S+] [FUNCPTRN [TYPEPTRN ...]]\n"
"                         列出函数 [仅聚合/普通/过程/触发器/窗口]\n"

#: help.c:249
#, c-format
msgid "  \\dF[+]  [PATTERN]      list text search configurations\n"
msgstr "  \\dF[+]  [PATTERN]      列出文本搜索配置\n"

#: help.c:250
#, c-format
msgid "  \\dFd[+] [PATTERN]      list text search dictionaries\n"
msgstr "  \\dFd[+] [PATTERN]      列出文本搜索字典\n"

#: help.c:251
#, c-format
msgid "  \\dFp[+] [PATTERN]      list text search parsers\n"
msgstr "  \\dFp[+] [PATTERN]      列出文本搜索解析器\n"

#: help.c:252
#, c-format
msgid "  \\dFt[+] [PATTERN]      list text search templates\n"
msgstr "  \\dFt[+] [PATTERN]      列出文本搜索模板\n"

#: help.c:253
#, c-format
msgid "  \\dg[S+] [PATTERN]      list roles\n"
msgstr "  \\dg[S+] [PATTERN]      列出角色\n"

#: help.c:254
#, c-format
msgid "  \\di[S+] [PATTERN]      list indexes\n"
msgstr "  \\di[S+] [PATTERN]      列出索引\n"

#: help.c:255
#, c-format
msgid "  \\dl                    list large objects, same as \\lo_list\n"
msgstr "  \\dl                    列出大对象，与 \\lo_list 相同\n"

#: help.c:256
#, c-format
msgid "  \\dL[S+] [PATTERN]      list procedural languages\n"
msgstr "  \\dL[S+] [PATTERN]      列出过程语言\n"

#: help.c:257
#, c-format
msgid "  \\dm[S+] [PATTERN]      list materialized views\n"
msgstr "  \\dm[S+] [PATTERN]      列出物化视图\n"

#: help.c:258
#, c-format
msgid "  \\dn[S+] [PATTERN]      list schemas\n"
msgstr "  \\dn[S+] [PATTERN]      列出模式\n"

#: help.c:259
#, c-format
msgid ""
"  \\do[S+] [OPPTRN [TYPEPTRN [TYPEPTRN]]]\n"
"                         list operators\n"
msgstr ""
"  \\do[S+] [OPPTRN [TYPEPTRN [TYPEPTRN]]]\n"
"                         列出操作符\n"

#: help.c:261
#, c-format
msgid "  \\dO[S+] [PATTERN]      list collations\n"
msgstr "  \\dO[S+] [PATTERN]      列出排序规则\n"

#: help.c:262
#, c-format
msgid ""
"  \\dp     [PATTERN]      list table, view, and sequence access privileges\n"
msgstr "  \\dp     [PATTERN]      列出表、视图和序列的访问权限\n"

#: help.c:263
#, c-format
msgid ""
"  \\dP[itn+] [PATTERN]    list [only index/table] partitioned relations "
"[n=nested]\n"
msgstr "  \\dP[itn+] [PATTERN]    列出 [仅索引/表] 分区关系 [n=嵌套]\n"

#: help.c:264
#, c-format
msgid "  \\drds [ROLEPTRN [DBPTRN]] list per-database role settings\n"
msgstr "  \\drds [ROLEPTRN [DBPTRN]] 列出按数据库设置的角色配置\n"

#: help.c:265
#, c-format
msgid "  \\dRp[+] [PATTERN]      list replication publications\n"
msgstr "  \\dRp[+] [PATTERN]      列出复制发布\n"

#: help.c:266
#, c-format
msgid "  \\dRs[+] [PATTERN]      list replication subscriptions\n"
msgstr "  \\dRs[+] [PATTERN]      列出复制订阅\n"

#: help.c:267
#, c-format
msgid "  \\ds[S+] [PATTERN]      list sequences\n"
msgstr "  \\ds[S+] [PATTERN]      列出序列\n"

#: help.c:268
#, c-format
msgid "  \\dt[S+] [PATTERN]      list tables\n"
msgstr "  \\dt[S+] [PATTERN]      列出表\n"

#: help.c:269
#, c-format
msgid "  \\dT[S+] [PATTERN]      list data types\n"
msgstr "  \\dT[S+] [PATTERN]      列出数据类型\n"

#: help.c:270
#, c-format
msgid "  \\du[S+] [PATTERN]      list roles\n"
msgstr "  \\du[S+] [PATTERN]      列出角色\n"

#: help.c:271
#, c-format
msgid "  \\dv[S+] [PATTERN]      list views\n"
msgstr "  \\dv[S+] [PATTERN]      列出视图\n"

#: help.c:272
#, c-format
msgid "  \\dx[+]  [PATTERN]      list extensions\n"
msgstr "  \\dx[+]  [PATTERN]      列出扩展\n"

#: help.c:273
#, c-format
msgid "  \\dX     [PATTERN]      list extended statistics\n"
msgstr "  \\dX     [PATTERN]      列出扩展统计信息\n"

#: help.c:274
#, c-format
msgid "  \\dy[+]  [PATTERN]      list event triggers\n"
msgstr "  \\dy[+]  [PATTERN]      列出事件触发器\n"

#: help.c:275
#, c-format
msgid "  \\l[+]   [PATTERN]      list databases\n"
msgstr "  \\l[+]   [PATTERN]      列出数据库\n"

#: help.c:276
#, c-format
msgid "  \\sf[+]  FUNCNAME       show a function's definition\n"
msgstr "  \\sf[+]  FUNCNAME       显示函数定义\n"

#: help.c:277
#, c-format
msgid "  \\sv[+]  VIEWNAME       show a view's definition\n"
msgstr "  \\sv[+]  VIEWNAME       显示视图定义\n"

#: help.c:278
#, c-format
msgid "  \\z      [PATTERN]      same as \\dp\n"
msgstr "  \\z      [PATTERN]      与 \\dp 相同\n"

#: help.c:281
#, c-format
msgid "Formatting\n"
msgstr "格式化\n"

#: help.c:282
#, c-format
msgid ""
"  \\a                     toggle between unaligned and aligned output mode\n"
msgstr "  \\a                     在非对齐模式和对齐模式之间切换\n"

#: help.c:283
#, c-format
msgid "  \\C [STRING]            set table title, or unset if none\n"
msgstr "  \\C [STRING]            设置表格标题，不带参数时清除标题\n"

#: help.c:284
#, c-format
msgid ""
"  \\f [STRING]            show or set field separator for unaligned query "
"output\n"
msgstr "  \\f [STRING]            显示或设置非对齐模式查询输出的字段分隔符\n"

#: help.c:285
#, c-format
msgid "  \\H                     toggle HTML output mode (currently %s)\n"
msgstr "  \\H                     切换 HTML 输出模式（当前为 %s）\n"

#: help.c:287
#, c-format
msgid ""
"  \\pset [NAME [VALUE]]   set table output option\n"
"                         (border|columns|csv_fieldsep|expanded|fieldsep|\n"
"                         fieldsep_zero|footer|format|linestyle|null|\n"
"                         numericlocale|pager|pager_min_lines|recordsep|\n"
"                         recordsep_zero|tableattr|title|tuples_only|\n"
"                         unicode_border_linestyle|unicode_column_linestyle|\n"
"                         unicode_header_linestyle)\n"
msgstr ""
"  \\pset [NAME [VALUE]]   设置表格输出选项\n"
"                         (border|columns|csv_fieldsep|expanded|fieldsep|\n"
"                         fieldsep_zero|footer|format|linestyle|null|\n"
"                         numericlocale|pager|pager_min_lines|recordsep|\n"
"                         recordsep_zero|tableattr|title|tuples_only|\n"
"                         unicode_border_linestyle|unicode_column_linestyle|\n"
"                         unicode_header_linestyle)\n"

#: help.c:294
#, c-format
msgid "  \\t [on|off]            show only rows (currently %s)\n"
msgstr "  \\t [on|off]            只显示行（当前为 %s）\n"

#: help.c:296
#, c-format
msgid ""
"  \\T [STRING]            set HTML <table> tag attributes, or unset if none\n"
msgstr ""
"  \\T [STRING]            设置 HTML <table> 标签属性，不带参数时清除设置\n"

#: help.c:297
#, c-format
msgid "  \\x [on|off|auto]       toggle expanded output (currently %s)\n"
msgstr "  \\x [on|off|auto]       切换扩展输出模式（当前为 %s）\n"

#: help.c:301
#, c-format
msgid "Connection\n"
msgstr "连接\n"

#: help.c:303
#, c-format
msgid ""
"  \\c[onnect] {[DBNAME|- USER|- HOST|- PORT|-] | conninfo}\n"
"                         connect to new database (currently \"%s\")\n"
msgstr ""
"  \\c[onnect] {[DBNAME|- USER|- HOST|- PORT|-] | conninfo}\n"
"                         连接到新数据库（当前为 \"%s\"）\n"

#: help.c:307
#, c-format
msgid ""
"  \\c[onnect] {[DBNAME|- USER|- HOST|- PORT|-] | conninfo}\n"
"                         connect to new database (currently no connection)\n"
msgstr ""
"  \\c[onnect] {[DBNAME|- USER|- HOST|- PORT|-] | conninfo}\n"
"                         连接到新数据库（当前无连接）\n"

#: help.c:309
#, c-format
msgid ""
"  \\conninfo              display information about current connection\n"
msgstr "  \\conninfo              显示当前连接的相关信息\n"

#: help.c:310
#, c-format
msgid "  \\encoding [ENCODING]   show or set client encoding\n"
msgstr "  \\encoding [ENCODING]   显示或设置客户端编码\n"

#: help.c:311
#, c-format
msgid "  \\password [USERNAME]   securely change the password for a user\n"
msgstr "  \\password [USERNAME]   安全地为用户更改密码\n"

#: help.c:314
#, c-format
msgid "Operating System\n"
msgstr "操作系统\n"

#: help.c:315
#, c-format
msgid "  \\cd [DIR]              change the current working directory\n"
msgstr "  \\cd [DIR]              更改目前的工作目录\n"

#: help.c:316
#, c-format
msgid "  \\setenv NAME [VALUE]   set or unset environment variable\n"
msgstr "  \\setenv NAME [VALUE]   设置或取消设置环境变量\n"

#: help.c:317
#, c-format
msgid "  \\timing [on|off]       toggle timing of commands (currently %s)\n"
msgstr "  \\timing [on|off]       切换命令计时（当前为 %s）\n"

#: help.c:319
#, c-format
msgid ""
"  \\! [COMMAND]           execute command in shell or start interactive "
"shell\n"
msgstr "  \\! [COMMAND]           在 shell 中执行命令或启动交互式 shell\n"

#: help.c:322
#, c-format
msgid "Variables\n"
msgstr "变量\n"

#: help.c:323
#, c-format
msgid "  \\prompt [TEXT] NAME    prompt user to set internal variable\n"
msgstr "  \\prompt [TEXT] NAME    提示用户设置内部变量\n"

#: help.c:324
#, c-format
msgid ""
"  \\set [NAME [VALUE]]    set internal variable, or list all if no "
"parameters\n"
msgstr "  \\set [NAME [VALUE]]    设置内部变量，若无参数则列出全部变量\n"

#: help.c:325
#, c-format
msgid "  \\unset NAME            unset (delete) internal variable\n"
msgstr "  \\unset NAME            取消设置（删除）内部变量\n"

#: help.c:328
#, c-format
msgid "Large Objects\n"
msgstr "大对象\n"

#: help.c:329
#, c-format
msgid ""
"  \\lo_export LOBOID FILE\n"
"  \\lo_import FILE [COMMENT]\n"
"  \\lo_list\n"
"  \\lo_unlink LOBOID      large object operations\n"
msgstr ""
"  \\lo_export LOBOID FILE\n"
"  \\lo_import FILE [COMMENT]\n"
"  \\lo_list\n"
"  \\lo_unlink LOBOID      大对象操作\n"

#: help.c:356
#, c-format
msgid ""
"List of specially treated variables\n"
"\n"
msgstr ""
"特殊处理变量列表\n"
"\n"

#: help.c:358
#, c-format
msgid "psql variables:\n"
msgstr "psql 变量:\n"

#: help.c:360
#, c-format
msgid ""
"  psql --set=NAME=VALUE\n"
"  or \\set NAME VALUE inside psql\n"
"\n"
msgstr ""
"  psql --set=NAME=VALUE\n"
"  或在 psql 中执行 \\set NAME VALUE\n"
"\n"

#: help.c:362
#, c-format
msgid ""
"  AUTOCOMMIT\n"
"    if set, successful SQL commands are automatically committed\n"
msgstr ""
"  AUTOCOMMIT\n"
"    设置后，成功的 SQL 命令会自动提交\n"

#: help.c:364
#, c-format
msgid ""
"  COMP_KEYWORD_CASE\n"
"    determines the case used to complete SQL key words\n"
"    [lower, upper, preserve-lower, preserve-upper]\n"
msgstr ""
"  COMP_KEYWORD_CASE\n"
"    决定 SQL 关键字补全所用的大小写\n"
"    [lower, upper, preserve-lower, preserve-upper]\n"

#: help.c:367
#, c-format
msgid ""
"  DBNAME\n"
"    the currently connected database name\n"
msgstr ""
"  DBNAME\n"
"    当前已连接的数据库名\n"

#: help.c:369
#, c-format
msgid ""
"  ECHO\n"
"    controls what input is written to standard output\n"
"    [all, errors, none, queries]\n"
msgstr ""
"  ECHO\n"
"    控制将哪些输入写入标准输出\n"
"    [all, errors, none, queries]\n"

#: help.c:372
#, c-format
msgid ""
"  ECHO_HIDDEN\n"
"    if set, display internal queries executed by backslash commands;\n"
"    if set to \"noexec\", just show them without execution\n"
msgstr ""
"  ECHO_HIDDEN\n"
"    设置后显示反斜杠命令执行的内部查询；\n"
"    设为 \"noexec\" 时只显示而不执行\n"

#: help.c:375
#, c-format
msgid ""
"  ENCODING\n"
"    current client character set encoding\n"
msgstr ""
"  ENCODING\n"
"    当前的客户端字符集编码\n"

#: help.c:377
#, c-format
msgid ""
"  ERROR\n"
"    true if last query failed, else false\n"
msgstr ""
"  ERROR\n"
"    上次查询失败时为 true，否则为 false\n"

#: help.c:379
#, c-format
msgid ""
"  FETCH_COUNT\n"
"    the number of result rows to fetch and display at a time (0 = "
"unlimited)\n"
msgstr ""
"  FETCH_COUNT\n"
"    每次获取并显示的结果行数（0 = 无限制）\n"

#: help.c:381
#, c-format
msgid ""
"  HIDE_TABLEAM\n"
"    if set, table access methods are not displayed\n"
msgstr ""
"  HIDE_TABLEAM\n"
"    如果设置，则不显示表访问方法\n"

#: help.c:383
#, c-format
msgid ""
"  HIDE_TOAST_COMPRESSION\n"
"    if set, compression methods are not displayed\n"
msgstr ""
"  HIDE_TOAST_COMPRESSION\n"
"    如果设置，则不显示压缩方法\n"

#: help.c:385
#, c-format
msgid ""
"  HISTCONTROL\n"
"    controls command history [ignorespace, ignoredups, ignoreboth]\n"
msgstr ""
"  HISTCONTROL\n"
"    控制命令历史记录 [ignorespace, ignoredups, ignoreboth]\n"

#: help.c:387
#, c-format
msgid ""
"  HISTFILE\n"
"    file name used to store the command history\n"
msgstr ""
"  HISTFILE\n"
"    用来存储命令历史记录的文件名\n"

#: help.c:389
#, c-format
msgid ""
"  HISTSIZE\n"
"    maximum number of commands to store in the command history\n"
msgstr ""
"  HISTSIZE\n"
"    保存在命令历史记录中的最大命令数\n"

#: help.c:391
#, c-format
msgid ""
"  HOST\n"
"    the currently connected database server host\n"
msgstr ""
"  HOST\n"
"    当前已连接的数据库服务器主机\n"

#: help.c:393
#, c-format
msgid ""
"  IGNOREEOF\n"
"    number of EOFs needed to terminate an interactive session\n"
msgstr ""
"  IGNOREEOF\n"
"    终止交互式会话所需的 EOF 数\n"

#: help.c:395
#, c-format
msgid ""
"  LASTOID\n"
"    value of the last affected OID\n"
msgstr ""
"  LASTOID\n"
"    最后一个受影响的 OID 的值\n"

#: help.c:397
#, c-format
msgid ""
"  LAST_ERROR_MESSAGE\n"
"  LAST_ERROR_SQLSTATE\n"
"    message and SQLSTATE of last error, or empty string and \"00000\" if "
"none\n"
msgstr ""
"  LAST_ERROR_MESSAGE\n"
"  LAST_ERROR_SQLSTATE\n"
"    最近错误的消息和 SQLSTATE，无错误时分别为空字符串和 \"00000\"\n"

#: help.c:400
#, c-format
msgid ""
"  ON_ERROR_ROLLBACK\n"
"    if set, an error doesn't stop a transaction (uses implicit savepoints)\n"
msgstr ""
"  ON_ERROR_ROLLBACK\n"
"    设置后，错误不会停止事务（使用隐式保存点）\n"

#: help.c:402
#, c-format
msgid ""
"  ON_ERROR_STOP\n"
"    stop batch execution after error\n"
msgstr ""
"  ON_ERROR_STOP\n"
"    发生错误后停止批量执行\n"

#: help.c:404
#, c-format
msgid ""
"  PORT\n"
"    server port of the current connection\n"
msgstr ""
"  PORT\n"
"    当前连接的服务器端口\n"

#: help.c:406
#, c-format
msgid ""
"  PROMPT1\n"
"    specifies the standard psql prompt\n"
msgstr ""
"  PROMPT1\n"
"    指定标准的 psql 提示符\n"

#: help.c:408
#, c-format
msgid ""
"  PROMPT2\n"
"    specifies the prompt used when a statement continues from a previous "
"line\n"
msgstr ""
"  PROMPT2\n"
"    指定在语句跨行时使用的提示符\n"

#: help.c:410
#, c-format
msgid ""
"  PROMPT3\n"
"    specifies the prompt used during COPY ... FROM STDIN\n"
msgstr ""
"  PROMPT3\n"
"    指定 COPY ... FROM STDIN 期间使用的提示符\n"

#: help.c:412
#, c-format
msgid ""
"  QUIET\n"
"    run quietly (same as -q option)\n"
msgstr ""
"  QUIET\n"
"    静默运行（和 -q 选项相同）\n"

#: help.c:414
#, c-format
msgid ""
"  ROW_COUNT\n"
"    number of rows returned or affected by last query, or 0\n"
msgstr ""
"  ROW_COUNT\n"
"    上一个查询返回或影响的行数，或 0\n"

#: help.c:416
#, c-format
msgid ""
"  SERVER_VERSION_NAME\n"
"  SERVER_VERSION_NUM\n"
"    server's version (in short string or numeric format)\n"
msgstr ""
"  SERVER_VERSION_NAME\n"
"  SERVER_VERSION_NUM\n"
"    服务器版本（短字符串或数值格式）\n"

#: help.c:419
#, c-format
msgid ""
"  SHOW_CONTEXT\n"
"    controls display of message context fields [never, errors, always]\n"
msgstr ""
"  SHOW_CONTEXT\n"
"    控制消息上下文字段的显示 [never, errors, always]\n"

#: help.c:421
#, c-format
msgid ""
"  SINGLELINE\n"
"    if set, end of line terminates SQL commands (same as -S option)\n"
msgstr ""
"  SINGLELINE\n"
"    设置后，行末终止 SQL 命令（与 -S 选项相同）\n"

#: help.c:423
#, c-format
msgid ""
"  SINGLESTEP\n"
"    single-step mode (same as -s option)\n"
msgstr ""
"  SINGLESTEP\n"
"    单步模式（与 -s 选项相同）\n"

#: help.c:425
#, c-format
msgid ""
"  SQLSTATE\n"
"    SQLSTATE of last query, or \"00000\" if no error\n"
msgstr ""
"  SQLSTATE\n"
"    最近查询的 SQLSTATE，无错误时为 \"00000\"\n"

#: help.c:427
#, c-format
msgid ""
"  USER\n"
"    the currently connected database user\n"
msgstr ""
"  USER\n"
"    当前已连接的数据库用户\n"

#: help.c:429
#, c-format
msgid ""
"  VERBOSITY\n"
"    controls verbosity of error reports [default, verbose, terse, sqlstate]\n"
msgstr ""
"  VERBOSITY\n"
"    控制错误报告的详细程度 [default, verbose, terse, sqlstate]\n"

#: help.c:431
#, c-format
msgid ""
"  VERSION\n"
"  VERSION_NAME\n"
"  VERSION_NUM\n"
"    psql's version (in verbose string, short string, or numeric format)\n"
msgstr ""
"  VERSION\n"
"  VERSION_NAME\n"
"  VERSION_NUM\n"
"    psql 版本（详细字符串、短字符串或数值格式）\n"

#: help.c:436
#, c-format
msgid ""
"\n"
"Display settings:\n"
msgstr ""
"\n"
"显示设置:\n"

#: help.c:438
#, c-format
msgid ""
"  psql --pset=NAME[=VALUE]\n"
"  or \\pset NAME [VALUE] inside psql\n"
"\n"
msgstr ""
"  psql --pset=NAME[=VALUE]\n"
"  或在 psql 中执行 \\pset NAME [VALUE]\n"
"\n"

#: help.c:440
#, c-format
msgid ""
"  border\n"
"    border style (number)\n"
msgstr ""
"  border\n"
"    边框样式（数字）\n"

#: help.c:442
#, c-format
msgid ""
"  columns\n"
"    target width for the wrapped format\n"
msgstr ""
"  columns\n"
"    wrapped 格式的目标宽度\n"

#: help.c:444
#, c-format
msgid ""
"  csv_fieldsep\n"
"    field separator for CSV output format (default \"%c\")\n"
msgstr ""
"  csv_fieldsep\n"
"    CSV 输出格式的字段分隔符（默认为 \"%c\"）\n"

#: help.c:447
#, c-format
msgid ""
"  expanded (or x)\n"
"    expanded output [on, off, auto]\n"
msgstr ""
"  expanded（或 x）\n"
"    扩展输出 [on, off, auto]\n"

#: help.c:449
#, c-format
msgid ""
"  fieldsep\n"
"    field separator for unaligned output (default \"%s\")\n"
msgstr ""
"  fieldsep\n"
"    非对齐输出的字段分隔符（默认为 \"%s\"）\n"

#: help.c:452
#, c-format
msgid ""
"  fieldsep_zero\n"
"    set field separator for unaligned output to a zero byte\n"
msgstr ""
"  fieldsep_zero\n"
"    将非对齐输出的字段分隔符设为空字节\n"

#: help.c:454
#, c-format
msgid ""
"  footer\n"
"    enable or disable display of the table footer [on, off]\n"
msgstr ""
"  footer\n"
"    启用或禁用表格页脚的显示 [on, off]\n"

#: help.c:456
#, c-format
msgid ""
"  format\n"
"    set output format [unaligned, aligned, wrapped, html, asciidoc, ...]\n"
msgstr ""
"  format\n"
"    设置输出格式 [unaligned, aligned, wrapped, html, asciidoc, ...]\n"

#: help.c:458
#, c-format
msgid ""
"  linestyle\n"
"    set the border line drawing style [ascii, old-ascii, unicode]\n"
msgstr ""
"  linestyle\n"
"    设置边框线型 [ascii, old-ascii, unicode]\n"

#: help.c:460
#, c-format
msgid ""
"  null\n"
"    set the string to be printed in place of a null value\n"
msgstr ""
"  null\n"
"    设置用于替代 NULL 值的打印字符串\n"

#: help.c:462
#, c-format
msgid ""
"  numericlocale\n"
"    enable display of a locale-specific character to separate groups of "
"digits\n"
msgstr ""
"  numericlocale\n"
"    启用数字分组分隔符显示，分隔符由区域设置决定\n"

#: help.c:464
#, c-format
msgid ""
"  pager\n"
"    control when an external pager is used [yes, no, always]\n"
msgstr ""
"  pager\n"
"    控制何时使用外部分页器 [yes, no, always]\n"

#: help.c:466
#, c-format
msgid ""
"  recordsep\n"
"    record (line) separator for unaligned output\n"
msgstr ""
"  recordsep\n"
"    用于非对齐输出中的记录（行）分隔符\n"

#: help.c:468
#, c-format
msgid ""
"  recordsep_zero\n"
"    set record separator for unaligned output to a zero byte\n"
msgstr ""
"  recordsep_zero\n"
"    将非对齐输出的记录分隔符设为空字节\n"

#: help.c:470
#, c-format
msgid ""
"  tableattr (or T)\n"
"    specify attributes for table tag in html format, or proportional\n"
"    column widths for left-aligned data types in latex-longtable format\n"
msgstr ""
"  tableattr（或者 T）\n"
"    指定 html 格式中表格标签的属性\n"
"    或者 latex-longtable 格式中左对齐数据类型的比例列宽\n"

#: help.c:473
#, c-format
msgid ""
"  title\n"
"    set the table title for subsequently printed tables\n"
msgstr ""
"  title\n"
"    为后续打印的表格设置标题\n"

#: help.c:475
#, c-format
msgid ""
"  tuples_only\n"
"    if set, only actual table data is shown\n"
msgstr ""
"  tuples_only\n"
"    设置后，只显示实际的表格数据\n"

#: help.c:477
#, c-format
msgid ""
"  unicode_border_linestyle\n"
"  unicode_column_linestyle\n"
"  unicode_header_linestyle\n"
"    set the style of Unicode line drawing [single, double]\n"
msgstr ""
"  unicode_border_linestyle\n"
"  unicode_column_linestyle\n"
"  unicode_header_linestyle\n"
"    设置 Unicode 线型 [single, double]\n"

#: help.c:482
#, c-format
msgid ""
"\n"
"Environment variables:\n"
msgstr ""
"\n"
"环境变量:\n"

#: help.c:486
#, c-format
msgid ""
"  NAME=VALUE [NAME=VALUE] psql ...\n"
"  or \\setenv NAME [VALUE] inside psql\n"
"\n"
msgstr ""
"  NAME=VALUE [NAME=VALUE] psql ...\n"
"  或在 psql 中执行 \\setenv NAME [VALUE]\n"
"\n"

#: help.c:488
#, c-format
msgid ""
"  set NAME=VALUE\n"
"  psql ...\n"
"  or \\setenv NAME [VALUE] inside psql\n"
"\n"
msgstr ""
"  set NAME=VALUE\n"
"  psql ...\n"
"  或在 psql 中执行 \\setenv NAME [VALUE]\n"
"\n"

#: help.c:491
#, c-format
msgid ""
"  COLUMNS\n"
"    number of columns for wrapped format\n"
msgstr ""
"  COLUMNS\n"
"    wrapped 格式的显示列数\n"

#: help.c:493
#, c-format
msgid ""
"  PGAPPNAME\n"
"    same as the application_name connection parameter\n"
