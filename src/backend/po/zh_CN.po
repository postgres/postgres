msgid "window \"%s\" does not exist"
msgstr "窗口 \"%s\" 不存在"

#: parser/parse_agg.c:1169
#, c-format
msgid "too many grouping sets present (maximum 4096)"
msgstr "分组集过多（最多 4096 个）"

#: parser/parse_agg.c:1332
#, c-format
msgid ""
"aggregate functions are not allowed in a recursive query's recursive term"
msgstr "递归查询的递归项中不允许使用聚合函数"

#: parser/parse_agg.c:1553
#, c-format
msgid ""
"column \"%s.%s\" must appear in the GROUP BY clause or be used in an "
"aggregate function"
msgstr "列 \"%s.%s\" 必须出现在 GROUP BY 子句中或者在聚合函数中使用"

#: parser/parse_agg.c:1556
#, c-format
msgid ""
"Direct arguments of an ordered-set aggregate must use only grouped columns."
msgstr "有序集聚合函数的直接参数只能使用分组列。"

#: parser/parse_agg.c:1561
#, c-format
msgid "subquery uses ungrouped column \"%s.%s\" from outer query"
msgstr "子查询使用外层查询中的非分组列 \"%s.%s\""

#: parser/parse_agg.c:1758
#, c-format
msgid ""
"arguments to GROUPING must be grouping expressions of the associated query "
"level"
msgstr "GROUPING 的参数必须是相关查询层次的分组表达式"

#: parser/parse_clause.c:191
#, c-format
msgid "relation \"%s\" cannot be the target of a modifying statement"
msgstr "关系 \"%s\" 不能作为修改语句的目标"

#: parser/parse_clause.c:569 parser/parse_clause.c:597 parser/parse_func.c:2740
#, c-format
msgid "set-returning functions must appear at top level of FROM"
msgstr "返回集合的函数必须出现在 FROM 的顶层"

#: parser/parse_clause.c:609
#, c-format
msgid "multiple column definition lists are not allowed for the same function"
msgstr "同一函数不允许有多个列定义列表"

#: parser/parse_clause.c:642
#, c-format
msgid ""
"ROWS FROM() with multiple functions cannot have a column definition list"
msgstr "包含多个函数的 ROWS FROM() 不能带有列定义列表"

#: parser/parse_clause.c:643
#, c-format
msgid ""
"Put a separate column definition list for each function inside ROWS FROM()."
msgstr "在 ROWS FROM() 内为每个函数分别指定列定义列表。"

#: parser/parse_clause.c:649
#, c-format
msgid "UNNEST() with multiple arguments cannot have a column definition list"
msgstr "带有多个参数的 UNNEST() 不能带有列定义列表"

#: parser/parse_clause.c:650
#, c-format
msgid ""
"Use separate UNNEST() calls inside ROWS FROM(), and attach a column "
"definition list to each one."
msgstr "在 ROWS FROM() 内分别调用 UNNEST()，并为每个调用指定列定义列表。"

#: parser/parse_clause.c:657
#, c-format
msgid "WITH ORDINALITY cannot be used with a column definition list"
msgstr "WITH ORDINALITY 不能与列定义列表一起使用"

#: parser/parse_clause.c:658
#, c-format
msgid "Put the column definition list inside ROWS FROM()."
msgstr "将列定义列表放在 ROWS FROM() 内。"

#: parser/parse_clause.c:762 parser/parse_jsontable.c:293
#, c-format
msgid "only one FOR ORDINALITY column is allowed"
msgstr "只允许一个 FOR ORDINALITY 列"

#: parser/parse_clause.c:823
#, c-format
msgid "column name \"%s\" is not unique"
msgstr "列名 \"%s\" 不唯一"

#: parser/parse_clause.c:865
#, c-format
msgid "namespace name \"%s\" is not unique"
msgstr "命名空间名称 \"%s\" 不唯一"

#: parser/parse_clause.c:875
#, c-format
msgid "only one default namespace is allowed"
msgstr "只允许一个默认命名空间"

#: parser/parse_clause.c:935
#, c-format
msgid "tablesample method %s does not exist"
msgstr "表采样方法 %s 不存在"

#: parser/parse_clause.c:957
#, c-format
msgid "tablesample method %s requires %d argument, not %d"
msgid_plural "tablesample method %s requires %d arguments, not %d"
msgstr[0] "表采样方法 %s 需要 %d 个参数，而不是 %d 个"

#: parser/parse_clause.c:991
#, c-format
msgid "tablesample method %s does not support REPEATABLE"
msgstr "表采样方法 %s 不支持 REPEATABLE"

#: parser/parse_clause.c:1144
#, c-format
msgid "TABLESAMPLE clause can only be applied to tables and materialized views"
msgstr "TABLESAMPLE 子句只能用于表和物化视图"

#: parser/parse_clause.c:1331
#, c-format
msgid "column name \"%s\" appears more than once in USING clause"
msgstr "在 USING 子句中列名 \"%s\" 出现多次"

#: parser/parse_clause.c:1346
#, c-format
msgid "common column name \"%s\" appears more than once in left table"
msgstr "共同的列名 \"%s\" 在左边的表中出现多次"

#: parser/parse_clause.c:1355
#, c-format
msgid "column \"%s\" specified in USING clause does not exist in left table"
msgstr "USING 子句中指定的列 \"%s\" 在左边的表中不存在"

#: parser/parse_clause.c:1370
#, c-format
msgid "common column name \"%s\" appears more than once in right table"
msgstr "共同的列名 \"%s\" 在右边的表中出现多次"

#: parser/parse_clause.c:1379
#, c-format
msgid "column \"%s\" specified in USING clause does not exist in right table"
msgstr "USING 子句中指定的列 \"%s\" 在右边的表中不存在"

#: parser/parse_clause.c:1909
#, c-format
msgid "row count cannot be null in FETCH FIRST ... WITH TIES clause"
msgstr "FETCH FIRST ... WITH TIES 子句中的行数不能为 NULL"

#. translator: %s is name of a SQL construct, eg LIMIT
