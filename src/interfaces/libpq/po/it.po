msgid "could not parse OpenID discovery document"
msgstr "non è stato possibile analizzare il documento di discovery OpenID"

#: ../libpq-oauth/oauth-curl.c:2260
#, c-format
msgid "issuer identifier (%s) does not match oauth_issuer (%s)"
msgstr "l'identificatore dell'issuer (%s) non combacia con oauth_issuer (%s)"

#: ../libpq-oauth/oauth-curl.c:2287
#, c-format
msgid "issuer \"%s\" does not provide a device authorization endpoint"
msgstr "l'issuer \"%s\" non fornisce un endpoint di autorizzazione del device"

#: ../libpq-oauth/oauth-curl.c:2313
#, c-format
msgid "device authorization endpoint \"%s\" must use HTTPS"
msgstr "l'endpoint di autorizzazione del device \"%s\" deve usare HTTPS"

#: ../libpq-oauth/oauth-curl.c:2322
#, c-format
msgid "token endpoint \"%s\" must use HTTPS"
msgstr "l'endpoint del token \"%s\" deve usare HTTPS"

#: ../libpq-oauth/oauth-curl.c:2462
msgid "could not parse device authorization"
msgstr "non è stato possibile analizzare l'autorizzazione del device"

#: ../libpq-oauth/oauth-curl.c:2549
msgid "could not parse access token response"
msgstr "non è stato possibile analizzare la risposta dell'access token"

#: ../libpq-oauth/oauth-curl.c:2626
#, c-format
msgid "slow_down interval overflow"
msgstr "overflow dell'intervallo slow_down"

#. translator: The first %s is a URL for the user to visit in a
#. browser, and the second %s is a code to be copy-pasted there.
#.
#: ../libpq-oauth/oauth-curl.c:2662
#, c-format
msgid "Visit %s and enter the code: %s\n"
msgstr "Visita %s e inserisci il codice: %s\n"

#: ../libpq-oauth/oauth-curl.c:2667
#, c-format
msgid "device prompt failed"
msgstr "richiesta al device fallita"

#: ../libpq-oauth/oauth-curl.c:2720
msgid "curl_global_init previously failed during OAuth setup"
msgstr "curl_global_init era già fallito durante la configurazione di OAuth"

#: ../libpq-oauth/oauth-curl.c:2738
msgid "curl_global_init failed during OAuth setup"
msgstr "curl_global_init è fallito durante la configurazione di OAuth"

#: ../libpq-oauth/oauth-curl.c:2760
msgid ""
"libcurl is no longer thread-safe\n"
"\tCurl initialization was reported thread-safe when libpq\n"
"\twas compiled, but the currently installed version of\n"
"\tlibcurl reports that it is not. Recompile libpq against\n"
"\tthe installed version of libcurl."
msgstr ""
"libcurl non è più thread-safe\n"
"\tL'inizializzazione di Curl era stata segnalata come thread-safe al\n"
"\tmomento della compilazione di libpq, ma la versione di libcurl\n"
"\tattualmente installata segnala che non lo è. Ricompilare libpq con\n"
"\tla versione di libcurl installata."

#: ../libpq-oauth/oauth-curl.c:2900
msgid "could not fetch OpenID discovery document"
msgstr "non è stato possibile recuperare il documento di discovery OpenID"

#  translator: %s represents an SQL statement name
#: ../libpq-oauth/oauth-curl.c:2914
msgid "cannot run OAuth device authorization"
msgstr "non è possibile eseguire l'autorizzazione del device OAuth"

#: ../libpq-oauth/oauth-curl.c:2918
msgid "could not obtain device authorization"
msgstr "non è stato possibile ottenere l'autorizzazione del device"

#: ../libpq-oauth/oauth-curl.c:2929 ../libpq-oauth/oauth-curl.c:2997
msgid "could not obtain access token"
msgstr "non è stato possibile ottenere l'access token"

#: fe-auth-oauth.c:140
#, c-format
msgid "internal error: no OAuth token was set for the connection"
msgstr "errore interno: nessun token OAuth impostato per la connessione"

#: fe-auth-oauth.c:403
#, c-format
msgid "OAuth discovery URI \"%s\" must use HTTPS"
msgstr "l'URI di discovery OAuth \"%s\" deve usare HTTPS"

#: fe-auth-oauth.c:420
#, c-format
msgid "OAuth discovery URI \"%s\" must not contain query or fragment components"
msgstr "l'URI di discovery OAuth \"%s\" non deve contenere componenti query o fragment"

#: fe-auth-oauth.c:435
#, c-format
msgid "OAuth discovery URI \"%s\" is not a .well-known URI"
msgstr "l'URI di discovery OAuth \"%s\" non è un URI .well-known"

#: fe-auth-oauth.c:461
#, c-format
msgid "OAuth discovery URI \"%s\" uses an unsupported .well-known suffix"
msgstr "l'URI di discovery OAuth \"%s\" usa un suffisso .well-known non supportato"

#: fe-auth-oauth.c:486
#, c-format
msgid "OAuth discovery URI \"%s\" uses an invalid format"
msgstr "l'URI di discovery OAuth \"%s\" usa un formato non valido"

#: fe-auth-oauth.c:535
#, c-format
msgid "server's error message contained an embedded NULL, and was discarded"
msgstr "il messaggio di errore del server conteneva un NULL incorporato ed è stato scartato"

#: fe-auth-oauth.c:546
#, c-format
msgid "server's error response is not valid UTF-8"
msgstr "la risposta di errore del server non è UTF-8 valido"

#: fe-auth-oauth.c:586
#, c-format
msgid "failed to parse server's error response: %s"
msgstr "analisi della risposta di errore del server fallita: %s"

#: fe-auth-oauth.c:617
#, c-format
msgid "server's discovery document at %s (issuer \"%s\") is incompatible with oauth_issuer (%s)"
msgstr "il documento di discovery del server presso %s (issuer \"%s\") non è compatibile con oauth_issuer (%s)"

#: fe-auth-oauth.c:638
#, c-format
msgid "server's discovery document has moved to %s (previous location was %s)"
msgstr "il documento di discovery del server si è spostato a %s (la posizione precedente era %s)"

#: fe-auth-oauth.c:659
#, c-format
msgid "server sent error response without a status"
msgstr "il server ha inviato una risposta di errore senza uno stato"

#: fe-auth-oauth.c:670
#, c-format
msgid "server rejected OAuth bearer token: %s"
msgstr "il server ha rifiutato il token bearer OAuth: %s"

#: fe-auth-oauth.c:717
msgid "user-defined OAuth flow failed"
msgstr "il flusso OAuth definito dall'utente è fallito"

#: fe-auth-oauth.c:747
#, c-format
msgid "user-defined OAuth flow provided neither a token nor an async callback"
msgstr "il flusso OAuth definito dall'utente non ha fornito né un token né una callback asincrona"

#: fe-auth-oauth.c:769
#, c-format
msgid "user-defined OAuth flow did not provide a token"
msgstr "il flusso OAuth definito dall'utente non ha fornito un token"

#: fe-auth-oauth.c:788
#, c-format
msgid "user-defined OAuth flow did not provide a socket for polling"
msgstr "il flusso OAuth definito dall'utente non ha fornito un socket per il polling"

#: fe-auth-oauth.c:932
msgid "could not find entry point for libpq-oauth"
msgstr "non è stato possibile trovare l'entry point per libpq-oauth"

#: fe-auth-oauth.c:1097
#, c-format
msgid "no OAuth flows are available (try installing the libpq-oauth package)"
msgstr "nessun flusso OAuth disponibile (provare a installare il pacchetto libpq-oauth)"

#: fe-auth-oauth.c:1141
#, c-format
msgid "server requires OAuth authentication, but oauth_issuer and oauth_client_id are not both set"
msgstr "il server richiede l'autenticazione OAuth, ma non sono impostati entrambi oauth_issuer e oauth_client_id"

#: fe-auth-oauth.c:1301
#, c-format
msgid "server sent unexpected additional OAuth data"
msgstr "il server ha inviato dati OAuth aggiuntivi inattesi"

#: fe-auth-oauth.c:1341
#, c-format
msgid "server requires OAuth authentication, but no discovery metadata was provided"
msgstr "il server richiede l'autenticazione OAuth, ma non sono stati forniti metadati di discovery"

#: fe-auth-oauth.c:1379
#, c-format
msgid "internal error: OAuth flow did not set a token"
msgstr "errore interno: il flusso OAuth non ha impostato un token"

#: fe-auth-oauth.c:1397
#, c-format
msgid "server sent additional OAuth data after error"
msgstr "il server ha inviato dati OAuth aggiuntivi dopo l'errore"

#: fe-auth-oauth.c:1401
#, c-format
msgid "invalid OAuth exchange state"
msgstr "stato di scambio OAuth non valido"

#: fe-auth-oauth.c:1414
#, c-format
msgid "retrying connection with new bearer token"
msgstr "nuovo tentativo di connessione con un nuovo token bearer"

