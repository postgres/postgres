msgstr "参数之后有多余字符"

#: pgc.l:1042 pgc.l:1045 pgc.l:1048
#, c-format
msgid "trailing junk after numeric literal"
msgstr "数值字面量之后有多余字符"

#: pgc.l:1177
#, c-format
