#: pg_archivecleanup.c:66
#, c-format
msgid "archive location \"%s\" does not exist"
msgstr "归档位置 \"%s\" 不存在"

#: pg_archivecleanup.c:151
#, c-format
msgid "could not remove file \"%s\": %m"
msgstr "无法删除文件 \"%s\": %m"

#: pg_archivecleanup.c:157
#, c-format
msgid "could not read archive location \"%s\": %m"
msgstr "无法读取归档位置 \"%s\": %m"

#: pg_archivecleanup.c:160
#, c-format
msgid "could not close archive location \"%s\": %m"
msgstr "无法关闭归档位置 \"%s\": %m"

#: pg_archivecleanup.c:164
#, c-format
msgid "could not open archive location \"%s\": %m"
msgstr "无法打开归档位置 \"%s\": %m"

#: pg_archivecleanup.c:237
#, c-format
msgid "invalid file name argument"
msgstr "文件名参数无效"

#: pg_archivecleanup.c:238 pg_archivecleanup.c:313 pg_archivecleanup.c:333
#: pg_archivecleanup.c:345 pg_archivecleanup.c:352
#, c-format
msgid "Try \"%s --help\" for more information."
msgstr "运行 \"%s --help\" 获取更多信息。"

#: pg_archivecleanup.c:251
#, c-format
msgid ""
"%s removes older WAL files from PostgreSQL archives.\n"
"\n"
msgstr ""
"%s 从 PostgreSQL 归档中删除旧的 WAL 文件。\n"
"\n"

#: pg_archivecleanup.c:252
#, c-format
msgid "Usage:\n"
msgstr "用法:\n"

#: pg_archivecleanup.c:253
#, c-format
msgid "  %s [OPTION]... ARCHIVELOCATION OLDESTKEPTWALFILE\n"
msgstr "  %s [选项]... 归档位置 最早保留的 WAL 文件\n"

#: pg_archivecleanup.c:254
#, c-format
msgid ""
"\n"
"Options:\n"
msgstr ""
"\n"
"选项:\n"

#: pg_archivecleanup.c:255
#, c-format
msgid "  -d             generate debug output (verbose mode)\n"
msgstr "  -d             生成调试输出（详细模式）\n"

#: pg_archivecleanup.c:256
#, c-format
msgid ""
"  -n             dry run, show the names of the files that would be removed\n"
msgstr "  -n             空跑，显示将被删除的文件名\n"

#: pg_archivecleanup.c:257
#, c-format
msgid "  -V, --version  output version information, then exit\n"
msgstr "  -V, --version  输出版本信息，然后退出\n"

#: pg_archivecleanup.c:258
#, c-format
msgid "  -x EXT         clean up files if they have this extension\n"
msgstr "  -x EXT         如果文件具有此扩展名，则清除文件\n"

#: pg_archivecleanup.c:259
#, c-format
msgid "  -?, --help     show this help, then exit\n"
msgstr "  -?, --help     显示此帮助，然后退出\n"

#: pg_archivecleanup.c:260
#, c-format
msgid ""
"\n"
"For use as archive_cleanup_command in postgresql.conf:\n"
"  archive_cleanup_command = 'pg_archivecleanup [OPTION]... ARCHIVELOCATION "
"%%r'\n"
"e.g.\n"
"  archive_cleanup_command = 'pg_archivecleanup /mnt/server/archiverdir %%r'\n"
msgstr ""
"\n"
"在 postgresql.conf 中用作 archive_cleanup_command:\n"
"  archive_cleanup_command = 'pg_archivecleanup [选项]... 归档位置 %%r'\n"
"例如:\n"
"  archive_cleanup_command = 'pg_archivecleanup /mnt/server/archiverdir %%r'\n"

#: pg_archivecleanup.c:265
#, c-format
msgid ""
"\n"
"Or for use as a standalone archive cleaner:\n"
"e.g.\n"
"  pg_archivecleanup /mnt/server/archiverdir "
"000000010000000000000010.00000020.backup\n"
msgstr ""
"\n"
"或者，将其用作独立归档清理程序:\n"
"例如:\n"
"  pg_archivecleanup /mnt/server/archiverdir "
"000000010000000000000010.00000020.backup\n"

#: pg_archivecleanup.c:269
#, c-format
msgid ""
"\n"
"Report bugs to <%s>.\n"
msgstr ""
"\n"
"请向 <%s> 报告缺陷。\n"

#: pg_archivecleanup.c:270
#, c-format
msgid "%s home page: <%s>\n"
msgstr "%s 主页: <%s>\n"

#: pg_archivecleanup.c:332
#, c-format
msgid "must specify archive location"
msgstr "必须指定归档位置"

#: pg_archivecleanup.c:344
#, c-format
msgid "must specify oldest kept WAL file"
msgstr "必须指定最早保留的 WAL 文件"

#: pg_archivecleanup.c:351
#, c-format
msgid "too many command-line arguments"
msgstr "命令行参数过多"

#, c-format
#~ msgid "Try \"%s --help\" for more information.\n"
#~ msgstr "请用 \"%s --help\" 获取更多的信息.\n"

#, c-format
#~ msgid "fatal: "
#~ msgstr "致命的: "
