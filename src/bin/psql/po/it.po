"  oppure \\set NOME VALORE dentro psql\n"
"\n"

#: help.c:388
msgid ""
"  AUTOCOMMIT\n"
"    if set, successful SQL commands are automatically committed\n"
msgstr ""
"  AUTOCOMMIT\n"
"    se impostata, i comandi SQL riusciti vengono confermati automaticamente\n"

#: help.c:390
msgid ""
"  COMP_KEYWORD_CASE\n"
"    determines the case used to complete SQL key words\n"
"    [lower, upper, preserve-lower, preserve-upper]\n"
msgstr ""
"  COMP_KEYWORD_CASE\n"
"    determina il maiuscolo/minuscolo usato per completare le parole chiave SQL\n"
"    [lower, upper, preserve-lower, preserve-upper]\n"

#: help.c:393
msgid ""
"  DBNAME\n"
"    the currently connected database name\n"
msgstr ""
"  DBNAME\n"
"    il nome del database attualmente connesso\n"

#: help.c:395
msgid ""
"  ECHO\n"
"    controls what input is written to standard output\n"
"    [all, errors, none, queries]\n"
msgstr ""
"  ECHO\n"
"    controlla quale input viene scritto sullo standard output\n"
"    [all, errors, none, queries]\n"

#: help.c:398
msgid ""
"  ECHO_HIDDEN\n"
"    if set, display internal queries executed by backslash commands;\n"
"    if set to \"noexec\", just show them without execution\n"
msgstr ""
"  ECHO_HIDDEN\n"
"    se impostata, mostra le query interne eseguite dai comandi con backslash;\n"
"    se impostata a \"noexec\", le mostra solamente senza eseguirle\n"

#: help.c:401
msgid ""
"  ENCODING\n"
"    current client character set encoding\n"
msgstr ""
"  ENCODING\n"
"    la codifica dei caratteri del client corrente\n"

#: help.c:403
msgid ""
"  ERROR\n"
"    \"true\" if last query failed, else \"false\"\n"
msgstr ""
"  ERROR\n"
"    \"true\" se l'ultima query è fallita, altrimenti \"false\"\n"

#: help.c:405
msgid ""
"  FETCH_COUNT\n"
"    the number of result rows to fetch and display at a time (0 = unlimited)\n"
msgstr ""
"  FETCH_COUNT\n"
"    il numero di righe di risultato da recuperare e mostrare per volta (0 = illimitato)\n"

#: help.c:407
msgid ""
"  HIDE_TABLEAM\n"
"    if set, table access methods are not displayed\n"
msgstr ""
"  HIDE_TABLEAM\n"
"    se impostata, i metodi di accesso delle tabelle non vengono mostrati\n"

#: help.c:409
msgid ""
"  HIDE_TOAST_COMPRESSION\n"
"    if set, compression methods are not displayed\n"
msgstr ""
"  HIDE_TOAST_COMPRESSION\n"
"    se impostata, i metodi di compressione non vengono mostrati\n"

#: help.c:411
msgid ""
"  HISTCONTROL\n"
"    controls command history [ignorespace, ignoredups, ignoreboth]\n"
msgstr ""
"  HISTCONTROL\n"
"    controlla la cronologia dei comandi [ignorespace, ignoredups, ignoreboth]\n"

#: help.c:413
msgid ""
"  HISTFILE\n"
"    file name used to store the command history\n"
msgstr ""
"  HISTFILE\n"
"    nome del file usato per memorizzare la cronologia dei comandi\n"

#: help.c:415
msgid ""
"  HISTSIZE\n"
"    maximum number of commands to store in the command history\n"
msgstr ""
"  HISTSIZE\n"
"    numero massimo di comandi da memorizzare nella cronologia dei comandi\n"

#: help.c:417
msgid ""
"  HOST\n"
"    the currently connected database server host\n"
msgstr ""
"  HOST\n"
"    l'host del server database attualmente connesso\n"

#: help.c:419
msgid ""
"  IGNOREEOF\n"
"    number of EOFs needed to terminate an interactive session\n"
msgstr ""
"  IGNOREEOF\n"
"    numero di EOF necessari per terminare una sessione interattiva\n"

#: help.c:421
msgid ""
"  LASTOID\n"
"    value of the last affected OID\n"
msgstr ""
"  LASTOID\n"
"    valore dell'ultimo OID interessato\n"

#: help.c:423
msgid ""
"  LAST_ERROR_MESSAGE\n"
"  LAST_ERROR_SQLSTATE\n"
"    message and SQLSTATE of last error, or empty string and \"00000\" if none\n"
msgstr ""
"  LAST_ERROR_MESSAGE\n"
"  LAST_ERROR_SQLSTATE\n"
"    messaggio e SQLSTATE dell'ultimo errore, oppure stringa vuota e \"00000\" se nessuno\n"

#: help.c:426
msgid ""
"  ON_ERROR_ROLLBACK\n"
"    if set, an error doesn't stop a transaction (uses implicit savepoints)\n"
msgstr ""
"  ON_ERROR_ROLLBACK\n"
"    se impostata, un errore non interrompe una transazione (usa savepoint impliciti)\n"

#: help.c:428
msgid ""
"  ON_ERROR_STOP\n"
"    stop batch execution after error\n"
msgstr ""
"  ON_ERROR_STOP\n"
"    interrompe l'esecuzione batch dopo un errore\n"

#: help.c:430
msgid ""
"  PORT\n"
"    server port of the current connection\n"
msgstr ""
"  PORT\n"
"    porta del server della connessione corrente\n"

#: help.c:432
msgid ""
"  PROMPT1\n"
"    specifies the standard psql prompt\n"
msgstr ""
"  PROMPT1\n"
"    specifica il prompt standard di psql\n"

#: help.c:434
msgid ""
"  PROMPT2\n"
"    specifies the prompt used when a statement continues from a previous line\n"
msgstr ""
"  PROMPT2\n"
"    specifica il prompt usato quando un'istruzione continua da una riga precedente\n"

#: help.c:436
msgid ""
"  PROMPT3\n"
"    specifies the prompt used during COPY ... FROM STDIN\n"
msgstr ""
"  PROMPT3\n"
"    specifica il prompt usato durante COPY ... FROM STDIN\n"

#: help.c:438
msgid ""
"  QUIET\n"
"    run quietly (same as -q option)\n"
msgstr ""
"  QUIET\n"
"    esecuzione silenziosa (come l'opzione -q)\n"

#: help.c:440
msgid ""
"  ROW_COUNT\n"
"    number of rows returned or affected by last query, or 0\n"
msgstr ""
"  ROW_COUNT\n"
"    numero di righe restituite o interessate dall'ultima query, oppure 0\n"

#: help.c:442
msgid ""
"  SERVER_VERSION_NAME\n"
"  SERVER_VERSION_NUM\n"
"    server's version (in short string or numeric format)\n"
msgstr ""
"  SERVER_VERSION_NAME\n"
"  SERVER_VERSION_NUM\n"
"    versione del server (in formato stringa breve o numerico)\n"

#: help.c:445
msgid ""
"  SHELL_ERROR\n"
"    \"true\" if the last shell command failed, \"false\" if it succeeded\n"
msgstr ""
"  SHELL_ERROR\n"
"    \"true\" se l'ultimo comando shell è fallito, \"false\" se è riuscito\n"

#: help.c:447
msgid ""
"  SHELL_EXIT_CODE\n"
"    exit status of the last shell command\n"
msgstr ""
"  SHELL_EXIT_CODE\n"
"    stato di uscita dell'ultimo comando shell\n"

#: help.c:449
msgid ""
"  SHOW_ALL_RESULTS\n"
"    show all results of a combined query (\\;) instead of only the last\n"
msgstr ""
"  SHOW_ALL_RESULTS\n"
"    mostra tutti i risultati di una query combinata (\\;) invece che solo l'ultimo\n"

#: help.c:451
msgid ""
"  SHOW_CONTEXT\n"
"    controls display of message context fields [never, errors, always]\n"
msgstr ""
"  SHOW_CONTEXT\n"
"    controlla la visualizzazione dei campi di contesto dei messaggi [never, errors, always]\n"

#: help.c:453
msgid ""
"  SINGLELINE\n"
"    if set, end of line terminates SQL commands (same as -S option)\n"
msgstr ""
"  SINGLELINE\n"
"    se impostata, la fine riga termina i comandi SQL (come l'opzione -S)\n"

#: help.c:455
msgid ""
"  SINGLESTEP\n"
"    single-step mode (same as -s option)\n"
msgstr ""
"  SINGLESTEP\n"
"    modalità passo singolo (come l'opzione -s)\n"

#: help.c:457
msgid ""
"  SQLSTATE\n"
"    SQLSTATE of last query, or \"00000\" if no error\n"
msgstr ""
"  SQLSTATE\n"
"    SQLSTATE dell'ultima query, oppure \"00000\" se nessun errore\n"

#: help.c:459
msgid ""
"  USER\n"
"    the currently connected database user\n"
msgstr ""
"  USER\n"
"    l'utente database attualmente connesso\n"

#: help.c:461
msgid ""
"  VERBOSITY\n"
"    controls verbosity of error reports [default, verbose, terse, sqlstate]\n"
msgstr ""
"  VERBOSITY\n"
"    controlla la verbosità dei rapporti di errore [default, verbose, terse, sqlstate]\n"

#: help.c:463
msgid ""
"  VERSION\n"
"  VERSION_NAME\n"
"  VERSION_NUM\n"
"    psql's version (in verbose string, short string, or numeric format)\n"
msgstr ""
"  VERSION\n"
"  VERSION_NAME\n"
"  VERSION_NUM\n"
"    versione di psql (in formato stringa dettagliata, breve o numerico)\n"

#: help.c:467
#, c-format
msgid ""
"  WATCH_INTERVAL\n"
"    number of seconds \\watch waits between executions (default %s)\n"
msgstr ""
"  WATCH_INTERVAL\n"
"    numero di secondi che \\watch attende tra le esecuzioni (predefinito %s)\n"

#: help.c:471
msgid ""
"\n"
"Display settings:\n"
msgstr ""
"\n"
"Impostazioni di visualizzazione:\n"

#: help.c:473
msgid ""
"  psql --pset=NAME[=VALUE]\n"
"  or \\pset NAME [VALUE] inside psql\n"
"\n"
msgstr ""
"  psql --pset=NOME[=VALORE]\n"
"  oppure \\pset NOME [VALORE] dentro psql\n"
"\n"

#: help.c:475
msgid ""
"  border\n"
"    border style (number)\n"
msgstr ""
"  border\n"
"    stile del bordo (numero)\n"

#: help.c:477
msgid ""
"  columns\n"
"    target width for the wrapped format\n"
msgstr ""
"  columns\n"
"    larghezza di destinazione per il formato wrapped\n"

#: help.c:479
#, c-format
msgid ""
"  csv_fieldsep\n"
"    field separator for CSV output format (default \"%c\")\n"
msgstr ""
"  csv_fieldsep\n"
"    separatore di campo per il formato di output CSV (predefinito \"%c\")\n"

#: help.c:482
msgid ""
"  display_false\n"
"    set the string to be printed in place of a boolean 'false'\n"
msgstr ""
"  display_false\n"
"    imposta la stringa da stampare al posto di un booleano 'false'\n"

#: help.c:484
msgid ""
"  display_true\n"
"    set the string to be printed in place of a boolean 'true'\n"
msgstr ""
"  display_true\n"
"    imposta la stringa da stampare al posto di un booleano 'true'\n"

#: help.c:486
msgid ""
"  expanded (or x)\n"
"    expanded output [on, off, auto]\n"
msgstr ""
"  expanded (o x)\n"
"    output espanso [on, off, auto]\n"

#: help.c:488
#, c-format
msgid ""
"  fieldsep\n"
"    field separator for unaligned output (default \"%s\")\n"
msgstr ""
"  fieldsep\n"
"    separatore di campo per l'output non allineato (predefinito \"%s\")\n"

#: help.c:491
msgid ""
"  fieldsep_zero\n"
"    set field separator for unaligned output to a zero byte\n"
msgstr ""
"  fieldsep_zero\n"
"    imposta il separatore di campo per l'output non allineato a un byte zero\n"

#: help.c:493
msgid ""
"  footer\n"
"    enable or disable display of the table footer [on, off]\n"
msgstr ""
"  footer\n"
"    abilita o disabilita la visualizzazione del piè di pagina della tabella [on, off]\n"

#: help.c:495
msgid ""
"  format\n"
"    set output format [unaligned, aligned, wrapped, html, asciidoc, ...]\n"
msgstr ""
"  format\n"
"    imposta il formato di output [unaligned, aligned, wrapped, html, asciidoc, ...]\n"

#: help.c:497
msgid ""
"  linestyle\n"
"    set the border line drawing style [ascii, old-ascii, unicode]\n"
msgstr ""
"  linestyle\n"
"    imposta lo stile di disegno della linea del bordo [ascii, old-ascii, unicode]\n"

#: help.c:499
msgid ""
"  null\n"
"    set the string to be printed in place of a null value\n"
msgstr ""
"  null\n"
"    imposta la stringa da stampare al posto di un valore null\n"

#: help.c:501
msgid ""
"  numericlocale\n"
"    enable display of a locale-specific character to separate groups of digits\n"
msgstr ""
"  numericlocale\n"
"    abilita la visualizzazione di un carattere specifico del locale per separare i gruppi di cifre\n"

#: help.c:503
msgid ""
"  pager\n"
"    control when an external pager is used [yes, no, always]\n"
msgstr ""
"  pager\n"
"    controlla quando viene usato un pager esterno [yes, no, always]\n"

#: help.c:505
msgid ""
"  recordsep\n"
"    record (line) separator for unaligned output\n"
msgstr ""
"  recordsep\n"
"    separatore di record (riga) per l'output non allineato\n"

#: help.c:507
msgid ""
"  recordsep_zero\n"
"    set record separator for unaligned output to a zero byte\n"
msgstr ""
"  recordsep_zero\n"
"    imposta il separatore di record per l'output non allineato a un byte zero\n"

#: help.c:509
msgid ""
"  tableattr (or T)\n"
"    specify attributes for table tag in html format, or proportional\n"
"    column widths for left-aligned data types in latex-longtable format\n"
msgstr ""
"  tableattr (o T)\n"
"    specifica gli attributi per il tag table in formato html, oppure larghezze\n"
"    proporzionali delle colonne per i tipi allineati a sinistra in formato latex-longtable\n"

#: help.c:512
msgid ""
"  title\n"
"    set the table title for subsequently printed tables\n"
msgstr ""
"  title\n"
"    imposta il titolo della tabella per le tabelle stampate successivamente\n"

#: help.c:514
msgid ""
"  tuples_only\n"
"    if set, only actual table data is shown\n"
msgstr ""
"  tuples_only\n"
"    se impostata, vengono mostrati solo i dati effettivi della tabella\n"

#: help.c:516
msgid ""
"  unicode_border_linestyle\n"
"  unicode_column_linestyle\n"
"  unicode_header_linestyle\n"
"    set the style of Unicode line drawing [single, double]\n"
msgstr ""
"  unicode_border_linestyle\n"
"  unicode_column_linestyle\n"
"  unicode_header_linestyle\n"
"    imposta lo stile di disegno delle linee Unicode [single, double]\n"

#: help.c:520
msgid ""
"  xheader_width\n"
"    set the maximum width of the header for expanded output\n"
"    [full, column, page, integer value]\n"
msgstr ""
"  xheader_width\n"
"    imposta la larghezza massima dell'intestazione per l'output espanso\n"
"    [full, column, page, valore intero]\n"

#: help.c:524
msgid ""
"\n"
"Environment variables:\n"
msgstr ""
"\n"
"Variabili d'ambiente:\n"

#: help.c:528
msgid ""
"  NAME=VALUE [NAME=VALUE] psql ...\n"
"  or \\setenv NAME [VALUE] inside psql\n"
"\n"
msgstr ""
"  NOME=VALORE [NOME=VALORE] psql ...\n"
"  oppure \\setenv NOME [VALORE] dentro psql\n"
"\n"

#: help.c:530
msgid ""
"  set NAME=VALUE\n"
"  psql ...\n"
"  or \\setenv NAME [VALUE] inside psql\n"
"\n"
msgstr ""
"  set NOME=VALORE\n"
"  psql ...\n"
"  oppure \\setenv NOME [VALORE] dentro psql\n"
"\n"

#: help.c:533
msgid ""
"  COLUMNS\n"
"    number of columns for wrapped format\n"
msgstr ""
"  COLUMNS\n"
"    numero di colonne per il formato wrapped\n"

#: help.c:535
msgid ""
"  PGAPPNAME\n"
"    same as the application_name connection parameter\n"
msgstr ""
"  PGAPPNAME\n"
"    equivale al parametro di connessione application_name\n"

#: help.c:537
msgid ""
"  PGDATABASE\n"
"    same as the dbname connection parameter\n"
msgstr ""
"  PGDATABASE\n"
"    equivale al parametro di connessione dbname\n"

#: help.c:539
msgid ""
"  PGHOST\n"
"    same as the host connection parameter\n"
msgstr ""
"  PGHOST\n"
"    equivale al parametro di connessione host\n"

#: help.c:541
msgid ""
"  PGPASSFILE\n"
"    password file name\n"
msgstr ""
"  PGPASSFILE\n"
"    nome del file delle password\n"

#: help.c:543
msgid ""
"  PGPASSWORD\n"
"    connection password (not recommended)\n"
msgstr ""
"  PGPASSWORD\n"
"    password di connessione (sconsigliato)\n"

#: help.c:545
msgid ""
"  PGPORT\n"
"    same as the port connection parameter\n"
msgstr ""
"  PGPORT\n"
"    equivale al parametro di connessione port\n"

#: help.c:547
msgid ""
"  PGUSER\n"
"    same as the user connection parameter\n"
msgstr ""
"  PGUSER\n"
"    equivale al parametro di connessione user\n"

#: help.c:549
msgid ""
"  PSQL_EDITOR, EDITOR, VISUAL\n"
"    editor used by the \\e, \\ef, and \\ev commands\n"
msgstr ""
"  PSQL_EDITOR, EDITOR, VISUAL\n"
"    editor usato dai comandi \\e, \\ef e \\ev\n"

#: help.c:551
msgid ""
"  PSQL_EDITOR_LINENUMBER_ARG\n"
"    how to specify a line number when invoking the editor\n"
msgstr ""
"  PSQL_EDITOR_LINENUMBER_ARG\n"
"    come specificare un numero di riga quando si invoca l'editor\n"

#: help.c:553
msgid ""
"  PSQL_HISTORY\n"
"    alternative location for the command history file\n"
msgstr ""
"  PSQL_HISTORY\n"
"    posizione alternativa per il file della cronologia dei comandi\n"

#: help.c:555
msgid ""
"  PSQL_PAGER, PAGER\n"
"    name of external pager program\n"
msgstr ""
"  PSQL_PAGER, PAGER\n"
"    nome del programma pager esterno\n"

#: help.c:558
msgid ""
"  PSQL_WATCH_PAGER\n"
"    name of external pager program used for \\watch\n"
msgstr ""
"  PSQL_WATCH_PAGER\n"
"    nome del programma pager esterno usato per \\watch\n"

#: help.c:561
msgid ""
"  PSQLRC\n"
"    alternative location for the user's .psqlrc file\n"
msgstr ""
"  PSQLRC\n"
"    posizione alternativa per il file .psqlrc dell'utente\n"

#: help.c:563
msgid ""
"  SHELL\n"
"    shell used by the \\! command\n"
msgstr ""
"  SHELL\n"
"    shell usata dal comando \\!\n"

#: help.c:565
msgid ""
"  TMPDIR\n"
"    directory for temporary files\n"
msgstr ""
"  TMPDIR\n"
"    directory per i file temporanei\n"

#: help.c:625
msgid "Available help:\n"
msgstr "Aiuto disponibile:\n"

