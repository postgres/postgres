"\n"
"Opções:\n"

#: pg_walsummary.c:270
#, c-format
msgid "  -i, --individual          list block numbers individually, not as ranges\n"
msgstr "  -i, --individual          listar números de bloco individualmente, não como intervalos\n"

#: pg_walsummary.c:271
#, c-format
