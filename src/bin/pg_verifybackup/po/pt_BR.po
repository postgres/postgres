msgstr "\"%s\" está presente no manifesto, mas não no disco"

#: pg_verifybackup.c:1147
#, c-format
msgid "could not initialize checksum of file \"%s\""
msgstr "não foi possível inicializar o checksum do arquivo \"%s\""

#: pg_verifybackup.c:1195
#, c-format
msgid "file \"%s\" should contain %<PRIu64> bytes, but read %<PRIu64>"
msgstr "o arquivo \"%s\" deveria conter %<PRIu64> bytes, mas leu-se %<PRIu64>"

#: pg_verifybackup.c:1213
#, c-format
msgid "file \"%s\" has checksum of length %d, but expected %d"
msgstr "o arquivo \"%s\" tem um checksum de comprimento %d, mas o esperado é %d"

#: pg_verifybackup.c:1217
#, c-format
msgid "checksum mismatch for file \"%s\""
msgstr "incompatibilidade de checksum para o arquivo \"%s\""

#: pg_verifybackup.c:1243
#, c-format
msgid "WAL parsing failed for timeline %u"
msgstr "Falha na análise do WAL para a linha do tempo %u"

#: pg_verifybackup.c:1377
#, c-format
msgid "%*s/%s kB (%d%%) verified"
msgstr "%*s/%s kB (%d%%) verificado"

#: pg_verifybackup.c:1394
#, c-format
msgid ""
"%s verifies a backup against the backup manifest.\n"
"\n"
msgstr ""
"%s verifica um backup em relação ao manifesto de backup.\n"
"\n"

#: pg_verifybackup.c:1395
#, c-format
msgid ""
"Usage:\n"
"  %s [OPTION]... BACKUPDIR\n"
"\n"
msgstr ""
"Uso:  \n"
"  %s [OPÇÃO]... DIRETÓRIO_DE_BACKUP\n"
"\n"

#: pg_verifybackup.c:1396
#, c-format
msgid "Options:\n"
msgstr "Opções:\n"

#: pg_verifybackup.c:1397
#, c-format
msgid "  -e, --exit-on-error         exit immediately on error\n"
msgstr "  -e, --exit-on-error         sair imediatamente em caso de erro\n"

#: pg_verifybackup.c:1398
#, c-format
msgid "  -F, --format=p|t            backup format (plain, tar)\n"
msgstr "  -F, --format=p|t            formato de backup (plain, tar)\n"

#: pg_verifybackup.c:1399
#, c-format
msgid "  -i, --ignore=RELATIVE_PATH  ignore indicated path\n"
msgstr "  -i, --ignore=CAMINHO_RELATIVO  ignorar o caminho indicado\n"

#: pg_verifybackup.c:1400
#, c-format
msgid "  -m, --manifest-path=PATH    use specified path for manifest\n"
msgstr "  -m, --manifest-path=CAMINHO    usar o caminho especificado para o manifesto\n"

#: pg_verifybackup.c:1401
#, c-format
msgid "  -n, --no-parse-wal          do not try to parse WAL files\n"
msgstr "  -n, --no-parse-wal          não tentar analisar os arquivos WAL\n"

#: pg_verifybackup.c:1402
#, c-format
msgid "  -P, --progress              show progress information\n"
msgstr "  -P, --progress              exibir informações de progresso\n"

#: pg_verifybackup.c:1403
#, c-format
msgid "  -q, --quiet                 do not print any output, except for errors\n"
msgstr "  -q, --quiet                 não imprimir nenhuma saída, exceto para erros\n"

#: pg_verifybackup.c:1404
#, c-format
msgid "  -s, --skip-checksums        skip checksum verification\n"
msgstr "  -s, --skip-checksums        pular a verificação de checksums\n"

#: pg_verifybackup.c:1405
#, c-format
msgid "  -w, --wal-path=PATH         use specified path for WAL files\n"
msgstr ""

#: pg_verifybackup.c:1406
#, c-format
msgid "      --wal-directory=PATH    (same as --wal-path, deprecated)\n"
msgstr ""

#: pg_verifybackup.c:1407
#, c-format
msgid "  -V, --version               output version information, then exit\n"
msgstr "  -V, --versão               exibir informações da versão e sair\n"

#: pg_verifybackup.c:1408
#, c-format
msgid "  -?, --help                  show this help, then exit\n"
msgstr "  -?, --ajuda                  exibir esta ajuda e sair\n"

#: pg_verifybackup.c:1409
#, c-format
msgid ""
"\n"
"Report bugs to <%s>.\n"
msgstr ""
"\n"
"Relate erros a <%s>.\n"

#: pg_verifybackup.c:1410
#, c-format
msgid "%s home page: <%s>\n"
msgstr "Página web do %s: <%s>\n"
