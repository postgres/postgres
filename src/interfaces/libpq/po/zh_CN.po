#, c-format
msgid "invalid LDAP URL \"%s\": must have exactly one attribute\n"
msgstr "LDAP URL \"%s\" 无效: 必须有且仅有一个属性\n"

#: fe-connect.c:4767 fe-connect.c:4829
#, c-format
msgid "invalid LDAP URL \"%s\": must have search scope (base/one/sub)\n"
msgstr "LDAP URL \"%s\" 无效: 必须指定搜索范围（base/one/sub）\n"

#: fe-connect.c:4779
#, c-format
msgid "invalid LDAP URL \"%s\": no filter\n"
msgstr "LDAP URL \"%s\" 无效: 没有过滤器\n"

#: fe-connect.c:4801
#, c-format
msgid "invalid LDAP URL \"%s\": invalid port number\n"
msgstr "LDAP URL \"%s\" 无效: 端口号无效\n"

#: fe-connect.c:4839
msgid "could not create LDAP structure\n"
msgstr "无法创建 LDAP 结构\n"

#: fe-connect.c:4915
#, c-format
msgid "lookup on LDAP server failed: %s\n"
msgstr "LDAP 服务器上的查找失败: %s\n"

#: fe-connect.c:4926
msgid "more than one entry found on LDAP lookup\n"
msgstr "LDAP 查找找到多个条目\n"

#: fe-connect.c:4927 fe-connect.c:4939
msgid "no entry found on LDAP lookup\n"
msgstr "LDAP 查找未找到条目\n"

#: fe-connect.c:4950 fe-connect.c:4963
msgid "attribute has no values on LDAP lookup\n"
msgstr "LDAP 查找所得属性没有值\n"

#: fe-connect.c:4977
#, c-format
msgid "connection info string size exceeds the maximum allowed (%d)\n"
msgstr "连接信息字符串的大小超过允许的最大值（%d）\n"

#: fe-connect.c:5029 fe-connect.c:5048 fe-connect.c:5580
#, c-format
msgid "missing \"=\" after \"%s\" in connection info string\n"
msgstr "连接信息字符串中的 \"%s\" 后缺少 \"=\"\n"

#: fe-connect.c:5121 fe-connect.c:5765 fe-connect.c:6541
#, c-format
msgid "invalid connection option \"%s\"\n"
msgstr "连接选项 \"%s\" 无效\n"

#: fe-connect.c:5137 fe-connect.c:5629
msgid "unterminated quoted string in connection info string\n"
msgstr "连接信息字符串中有未终止的引号字符串\n"

#: fe-connect.c:5218
#, c-format
msgid "definition of service \"%s\" not found\n"
msgstr "找不到服务 \"%s\" 的定义\n"

#: fe-connect.c:5244
#, c-format
msgid "service file \"%s\" not found\n"
msgstr "找不到服务文件 \"%s\"\n"

#: fe-connect.c:5258
#, c-format
msgid "line %d too long in service file \"%s\"\n"
msgstr "服务文件 \"%2$s\" 的第 %1$d 行过长\n"

