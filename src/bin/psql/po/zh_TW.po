msgstr "  \\dx[x+]  [PATTERN]     列出擴充模組\n"

# help.c:218
#: help.c:271
msgid "  \\dX[x]   [PATTERN]     list extended statistics\n"
msgstr "  \\dX[x]   [PATTERN]     列出延伸統計資訊\n"

# help.c:222
#: help.c:272
msgid "  \\dy[x+]  [PATTERN]     list event triggers\n"
msgstr "  \\dy[x+]  [PATTERN]     列出事件觸發器\n"

# help.c:228
#: help.c:273
