#: createdb.c:307
#, c-format
msgid ""
"\n"
"By default, a database with the same name as the current user is created.\n"
msgstr ""
"\n"
"默认情况下，会创建与当前用户同名的数据库。\n"

#: createuser.c:193
msgid "Enter name of role to add: "
msgstr "输入要添加的角色名: "

#: createuser.c:208
msgid "Enter password for new role: "
msgstr "输入新角色的密码: "

#: createuser.c:209
msgid "Enter it again: "
msgstr "再输入一遍: "

#: createuser.c:212
#, c-format
msgid "Passwords didn't match.\n"
msgstr "两次输入的密码不一致。\n"

#: createuser.c:220
msgid "Shall the new role be a superuser?"
msgstr "新角色是否应为超级用户？"

#: createuser.c:235
msgid "Shall the new role be allowed to create databases?"
msgstr "是否允许新角色创建数据库？"

#: createuser.c:243
msgid "Shall the new role be allowed to create more new roles?"
msgstr "是否允许新角色创建其他角色？"

#: createuser.c:280
#, c-format
msgid "password encryption failed: %s"
msgstr "密码加密失败: %s"

#: createuser.c:333
#, c-format
msgid "creation of new role failed: %s"
msgstr "创建新角色失败: %s"

#: createuser.c:347
#, c-format
msgid ""
"%s creates a new PostgreSQL role.\n"
"\n"
msgstr ""
"%s 创建新的 PostgreSQL 角色。\n"
"\n"

#: createuser.c:349 dropuser.c:172
#, c-format
msgid "  %s [OPTION]... [ROLENAME]\n"
msgstr "  %s [选项]... [角色名]\n"

#: createuser.c:351
#, c-format
msgid ""
"  -c, --connection-limit=N  connection limit for role (default: no limit)\n"
msgstr "  -c, --connection-limit=N  角色的连接数限制（默认: 无限制）\n"

#: createuser.c:352
#, c-format
msgid "  -d, --createdb            role can create new databases\n"
msgstr "  -d, --createdb            此角色可以创建新数据库\n"

#: createuser.c:353
#, c-format
msgid "  -D, --no-createdb         role cannot create databases (default)\n"
msgstr "  -D, --no-createdb         此角色不能创建数据库（默认）\n"

#: createuser.c:355
#, c-format
msgid "  -g, --role=ROLE           new role will be a member of this role\n"
msgstr "  -g, --role=ROLE           新角色将成为此角色的成员\n"

#: createuser.c:356
#, c-format
msgid ""
"  -i, --inherit             role inherits privileges of roles it is a\n"
"                            member of (default)\n"
msgstr ""
"  -i, --inherit             角色继承其所属角色的权限\n"
"                            （默认）\n"

#: createuser.c:358
#, c-format
msgid "  -I, --no-inherit          role does not inherit privileges\n"
msgstr "  -I, --no-inherit          角色不继承权限\n"

#: createuser.c:359
#, c-format
msgid "  -l, --login               role can login (default)\n"
msgstr "  -l, --login               角色可以登录（默认）\n"

#: createuser.c:360
#, c-format
msgid "  -L, --no-login            role cannot login\n"
msgstr "  -L, --no-login            角色不能登录\n"

#: createuser.c:361
#, c-format
msgid "  -P, --pwprompt            assign a password to new role\n"
msgstr "  -P, --pwprompt            给新角色指定密码\n"

#: createuser.c:362
#, c-format
msgid "  -r, --createrole          role can create new roles\n"
msgstr "  -r, --createrole          此角色可以创建新角色\n"

#: createuser.c:363
#, c-format
msgid "  -R, --no-createrole       role cannot create roles (default)\n"
msgstr "  -R, --no-createrole       此角色不能创建角色（默认）\n"

#: createuser.c:364
#, c-format
msgid "  -s, --superuser           role will be superuser\n"
msgstr "  -s, --superuser           角色将是超级用户\n"

#: createuser.c:365
#, c-format
msgid "  -S, --no-superuser        role will not be superuser (default)\n"
msgstr "  -S, --no-superuser        角色将不是超级用户（默认）\n"

#: createuser.c:367
#, c-format
msgid ""
"  --interactive             prompt for missing role name and attributes "
"rather\n"
"                            than using defaults\n"
msgstr ""
"  --interactive             提示输入缺少的角色名和属性，\n"
"                            而不使用默认值\n"

#: createuser.c:369
#, c-format
msgid "  --replication             role can initiate replication\n"
msgstr "  --replication             角色可以发起复制\n"

#: createuser.c:370
#, c-format
msgid "  --no-replication          role cannot initiate replication\n"
msgstr "  --no-replication          角色不能发起复制\n"

#: createuser.c:375
#, c-format
msgid ""
"  -U, --username=USERNAME   user name to connect as (not the one to create)\n"
msgstr "  -U, --username=USERNAME   连接所用的用户名（不是要创建的角色）\n"

