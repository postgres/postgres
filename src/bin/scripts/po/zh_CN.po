#: createdb.c:301
#, c-format
msgid "  %s [OPTION]... [DBNAME] [DESCRIPTION]\n"
msgstr "  %s [选项]... [数据库名] [描述]\n"

#: createdb.c:303
#, c-format
msgid "  -D, --tablespace=TABLESPACE  default tablespace for the database\n"
msgstr "  -D, --tablespace=TABLESPACE  数据库默认表空间\n"

