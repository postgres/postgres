#, c-format
msgid ""
"\n"
"General options:\n"
msgstr ""
"\n"
"一般選項:\n"

#: pg_dump.c:1082
#, c-format
msgid "  -f, --file=FILENAME          output file or directory name\n"
msgstr "  -f, --file=FILENAME          輸出檔案或目錄的名稱\n"

