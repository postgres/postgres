msgstr "la sintassi LIMIT #,# passata al server non è più supportata"

#: preproc.y:8308 preproc.y:8316
#, c-format
msgid "CREATE TABLE AS cannot specify INTO"
msgstr "CREATE TABLE AS non può specificare INTO"

#: preproc.y:8361
#, c-format
