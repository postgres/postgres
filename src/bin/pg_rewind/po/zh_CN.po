msgid "clusters are not compatible with this version of pg_rewind"
msgstr "集簇与此版本的 pg_rewind 不兼容"

#: pg_rewind.c:702
#, c-format
msgid ""
"target server needs to use either data checksums or \"wal_log_hints = on\""
msgstr "目标服务器需要启用数据校验和或设置 \"wal_log_hints = on\""

#: pg_rewind.c:713
#, c-format
msgid "target server must be shut down cleanly"
msgstr "目标服务器必须已正常关闭"

#: pg_rewind.c:723
#, c-format
msgid "source data directory must be shut down cleanly"
msgstr "源数据目录对应的服务器必须已正常关闭"

#: pg_rewind.c:775
#, c-format
msgid "%*s/%s kB (%d%%) copied"
msgstr "已复制 %*s/%s kB（%d%%）"

#: pg_rewind.c:838
#, c-format
msgid "invalid control file"
msgstr "无效的控制文件"

#: pg_rewind.c:920
#, c-format
msgid ""
"could not find common ancestor of the source and target cluster's timelines"
msgstr "无法找到源集簇和目标集簇时间线的共同祖先"

#: pg_rewind.c:961
#, c-format
msgid "backup label buffer too small"
msgstr "备份标签缓冲区过小"

#: pg_rewind.c:984
#, c-format
msgid "unexpected control file CRC"
msgstr "意外的控制文件 CRC"

#: pg_rewind.c:996
#, c-format
msgid "unexpected control file size %d, expected %d"
msgstr "控制文件大小异常: %d，预期为 %d"

#: pg_rewind.c:1005
#, c-format
msgid ""
"WAL segment size must be a power of two between 1 MB and 1 GB, but the "
"control file specifies %d byte"
msgid_plural ""
"WAL segment size must be a power of two between 1 MB and 1 GB, but the "
"control file specifies %d bytes"
msgstr[0] ""
"WAL 段大小必须是 1 MB 到 1 GB 之间的二的幂，但控制文件指定了 %d 字节"

#: pg_rewind.c:1044 pg_rewind.c:1102
#, c-format
msgid ""
"The program \"%s\" is needed by %s but was not found in the\n"
"same directory as \"%s\".\n"
"Check your installation."
msgstr ""
"%2$s 需要程序 \"%1$s\"，\n"
"但在与 \"%3$s\" 相同的目录中找不到该程序。\n"
"请检查安装。"

#: pg_rewind.c:1049 pg_rewind.c:1107
#, c-format
msgid ""
"The program \"%s\" was found by \"%s\"\n"
"but was not the same version as %s.\n"
"Check your installation."
msgstr ""
"程序 \"%s\" 已由 \"%s\" 找到，\n"
"但与 %s 版本不一致。\n"
"请检查安装。"

#: pg_rewind.c:1070
#, c-format
msgid "restore_command is not set in the target cluster"
msgstr "目标集簇未设置 restore_command"

#: pg_rewind.c:1113
#, c-format
msgid "executing \"%s\" for target server to complete crash recovery"
msgstr "正在对目标服务器执行 \"%s\" 以完成崩溃恢复"

