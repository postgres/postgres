msgstr "неможливо дублювати нульовий покажчик (внутрішня помилка)\n"

#: ../../common/fe_memutils.c:209
#, c-format
msgid "invalid memory allocation request size %zu + %zu\n"
msgstr "неправильний розмір запиту на виділення пам'яті %zu + %zu\n"

#: ../../common/fe_memutils.c:228
#, c-format
msgid "invalid memory allocation request size %zu * %zu\n"
msgstr "неправильний розмір запиту на виділення пам'яті %zu * %zu\n"

#: ../../common/file_utils.c:69 ../../common/file_utils.c:370
#: ../../common/file_utils.c:428 ../../common/file_utils.c:502
#: pg_walsummary.c:108
#, c-format
msgid "could not open file \"%s\": %m"
msgstr "не можливо відкрити файл \"%s\": %m"

#: ../../common/file_utils.c:75
#, c-format
msgid "could not synchronize file system for file \"%s\": %m"
msgstr "не вдалося синхронізувати файлову систему для файлу \"%s\": %m"

#: ../../common/file_utils.c:123 ../../common/file_utils.c:588
#, c-format
msgid "could not stat file \"%s\": %m"
msgstr "не вдалося отримати інформацію від файлу \"%s\": %m"

#: ../../common/file_utils.c:133 ../../common/file_utils.c:243
#: ../../fe_utils/option_utils.c:99
#, c-format
msgid "this build does not support sync method \"%s\""
msgstr "ця збірка не підтримує метод синхронізації \"%s\""

#: ../../common/file_utils.c:156 ../../common/file_utils.c:304
#, c-format
msgid "could not open directory \"%s\": %m"
msgstr "не вдалося відкрити каталог \"%s\": %m"

#: ../../common/file_utils.c:174 ../../common/file_utils.c:338
#, c-format
msgid "could not read directory \"%s\": %m"
msgstr "не вдалося прочитати каталог \"%s\": %m"

#: ../../common/file_utils.c:440 ../../common/file_utils.c:510
#, c-format
msgid "could not fsync file \"%s\": %m"
msgstr "не вдалося fsync файл \"%s\": %m"

#: ../../common/file_utils.c:520
#, c-format
msgid "could not rename file \"%s\" to \"%s\": %m"
msgstr "не вдалося перейменувати файл \"%s\" на \"%s\": %m"

#: ../../fe_utils/option_utils.c:69
#, c-format
msgid "invalid value \"%s\" for option %s"
msgstr "неприпустиме значення \"%s\" для параметра %s"

#: ../../fe_utils/option_utils.c:76
#, c-format
msgid "%s must be in range %d..%d"
msgstr "%s має бути в діапазоні %d..%d"

#: ../../fe_utils/option_utils.c:106
#, c-format
msgid "unrecognized sync method: %s"
msgstr "нерозпізнаний метод синхронізації: %s"

#: ../../fe_utils/option_utils.c:139
#, c-format
msgid "options %s and %s cannot be used together"
msgstr "параметри %s і %s не можна використовувати разом"

#: pg_walsummary.c:86 pg_walsummary.c:94
#, c-format
msgid "Try \"%s --help\" for more information."
msgstr "Спробуйте \"%s --help\" для додаткової інформації."

#: pg_walsummary.c:93
#, c-format
msgid "no input files specified"
msgstr "не вказано вхідні файли"

#: pg_walsummary.c:251
#, c-format
msgid "could not read file \"%s\": %m"
msgstr "не вдалося прочитати файл \"%s\": %m"

#: pg_walsummary.c:266
#, c-format
msgid "%s prints the contents of a WAL summary file.\n\n"
msgstr "%s друкує вміст файлу зведення WAL.\n\n"

#: pg_walsummary.c:267
#, c-format
msgid "Usage:\n"
msgstr "Використання:\n"

#: pg_walsummary.c:268
#, c-format
msgid "  %s [OPTION]... FILE...\n"
msgstr "  %s [OPTION]... FILE...\n"

#: pg_walsummary.c:269
#, c-format
msgid "\n"
"Options:\n"
msgstr "\n"
"Параметри:\n"

#: pg_walsummary.c:270
#, c-format
msgid "  -i, --individual          list block numbers individually, not as ranges\n"
msgstr "  -i, --individual          вивести номера блоків індивідуально, не як діапазони\n"

#: pg_walsummary.c:271
#, c-format
msgid "  -q, --quiet               don't print anything, just parse the files\n"
msgstr "  -q, --quiet не друкувати нічого, просто розібрати файли\n"

#: pg_walsummary.c:272
#, c-format
msgid "  -V, --version             output version information, then exit\n"
msgstr "  -V, --version             вивести інформацію про версію і вийти\n"

#: pg_walsummary.c:273
#, c-format
msgid "  -?, --help                show this help, then exit\n"
msgstr "  -?, --help                показати цю довідку, потім вийти\n"

#: pg_walsummary.c:275
#, c-format
msgid "\n"
"Report bugs to <%s>.\n"
msgstr "\n"
"Повідомляти про помилки на <%s>.\n"

#: pg_walsummary.c:276
#, c-format
msgid "%s home page: <%s>\n"
msgstr "Домашня сторінка %s: <%s>\n"

