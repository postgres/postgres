msgstr ""
"  --set-char-signedness=OPTION  установить для нового кластера знаковость "
"char\n"
"                                по умолчанию: \"signed\" или \"unsigned\"\n"

#: option.c:334
#, c-format
msgid "  --swap                        move data directories to new cluster\n"
msgstr ""
