msgstr "Unix 域套接字路径 \"%s\" 过长（最多 %d 字节）\n"

#: fe-connect.c:2449
#, c-format
msgid "could not translate Unix-domain socket path \"%s\" to address: %s\n"
msgstr "无法将 Unix 域套接字路径 \"%s\" 解析为地址: %s\n"

