#: pg_walsummary.c:268
#, c-format
msgid "  %s [OPTION]... FILE...\n"
msgstr " %s [OPZIONE]... FILE...\n"

#: pg_walsummary.c:269
#, c-format
msgid ""
"\n"
"Options:\n"
msgstr ""
"\n"
"Opzioni:\n"

#: pg_walsummary.c:270
#, c-format
msgid "  -i, --individual          list block numbers individually, not as ranges\n"
msgstr " -i, --individual          elenca i numeri dei blocchi singolarmente, non come intervalli\n"

#: pg_walsummary.c:271
#, c-format
msgid "  -q, --quiet               don't print anything, just parse the files\n"
msgstr " -q, --quiet               non stampare nulla, analizza solo i file\n"

#: pg_walsummary.c:272
#, c-format
msgid "  -V, --version             output version information, then exit\n"
msgstr "  -V, --version             mostra informazioni sulla versione ed esci\n"

#: pg_walsummary.c:273
#, c-format
msgid "  -?, --help                show this help, then exit\n"
msgstr "  -?, --help                mostra questo aiuto ed esci\n"

