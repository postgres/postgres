#: option.c:306
#, c-format
msgid ""
"pg_upgrade upgrades a PostgreSQL cluster to a different major version.\n"
"\n"
msgstr ""
"pg_upgrade 将 PostgreSQL 集簇升级到其他主版本。\n"
"\n"

#: option.c:307
#, c-format
msgid "Usage:\n"
msgstr "用法:\n"

#: option.c:308
#, c-format
msgid ""
"  pg_upgrade [OPTION]...\n"
"\n"
msgstr ""
"  pg_upgrade [选项]...\n"
"\n"

#: option.c:309
#, c-format
msgid "Options:\n"
msgstr "选项:\n"

#: option.c:310
#, c-format
msgid "  -b, --old-bindir=BINDIR       old cluster executable directory\n"
msgstr "  -b, --old-bindir=BINDIR       旧集簇的可执行文件目录\n"

#: option.c:311
#, c-format
msgid ""
"  -B, --new-bindir=BINDIR       new cluster executable directory (default\n"
"                                same directory as pg_upgrade)\n"
msgstr ""
"  -B, --new-bindir=BINDIR       新集簇的可执行文件目录（默认与\n"
"                                pg_upgrade 所在目录相同）\n"

#: option.c:313
#, c-format
msgid ""
"  -c, --check                   check clusters only, don't change any data\n"
msgstr "  -c, --check                   仅检查集簇，不更改任何数据\n"

#: option.c:314
#, c-format
msgid "  -d, --old-datadir=DATADIR     old cluster data directory\n"
msgstr "  -d, --old-datadir=DATADIR     旧集簇数据目录\n"

#: option.c:315
#, c-format
msgid "  -D, --new-datadir=DATADIR     new cluster data directory\n"
msgstr "  -D, --new-datadir=DATADIR     新集簇数据目录\n"

#: option.c:316
#, c-format
msgid ""
"  -j, --jobs=NUM                number of simultaneous processes or threads "
"to use\n"
msgstr "  -j, --jobs=NUM                要同时使用的进程或线程数\n"

#: option.c:317
#, c-format
msgid ""
"  -k, --link                    link instead of copying files to new "
"cluster\n"
msgstr "  -k, --link                    使用硬链接代替将文件复制到新集簇\n"

#: option.c:318
#, c-format
msgid ""
"  -N, --no-sync                 do not wait for changes to be written safely "
"to disk\n"
msgstr "  -N, --no-sync                 不等待变更安全写入磁盘\n"

#: option.c:319
#, c-format
msgid ""
"  -o, --old-options=OPTIONS     old cluster options to pass to the server\n"
msgstr "  -o, --old-options=OPTIONS     要传递到服务器的旧集簇选项\n"

#: option.c:320
#, c-format
msgid ""
"  -O, --new-options=OPTIONS     new cluster options to pass to the server\n"
msgstr "  -O, --new-options=OPTIONS     要传递到服务器的新集簇选项\n"

#: option.c:321
#, c-format
msgid "  -p, --old-port=PORT           old cluster port number (default %d)\n"
msgstr "  -p, --old-port=PORT           旧集簇端口号（默认值为 %d）\n"

#: option.c:322
#, c-format
msgid "  -P, --new-port=PORT           new cluster port number (default %d)\n"
msgstr "  -P, --new-port=PORT           新集簇端口号（默认值为 %d）\n"

#: option.c:323
#, c-format
msgid ""
"  -r, --retain                  retain SQL and log files after success\n"
msgstr "  -r, --retain                  成功后保留 SQL 和日志文件\n"

#: option.c:324
#, c-format
msgid ""
"  -s, --socketdir=DIR           socket directory to use (default current "
"dir.)\n"
msgstr "  -s, --socketdir=DIR           使用的套接字目录（默认为当前目录）\n"

#: option.c:325
#, c-format
msgid "  -U, --username=NAME           cluster superuser (default \"%s\")\n"
msgstr "  -U, --username=NAME           集簇超级用户（默认值为 \"%s\"）\n"

#: option.c:326
#, c-format
msgid "  -v, --verbose                 enable verbose internal logging\n"
msgstr "  -v, --verbose                 启用详细的内部日志\n"

#: option.c:327
#, c-format
msgid ""
"  -V, --version                 display version information, then exit\n"
msgstr "  -V, --version                 显示版本信息，然后退出\n"

#: option.c:328
#, c-format
msgid ""
"  --clone                       clone instead of copying files to new "
"cluster\n"
msgstr "  --clone                       克隆而不是将文件复制到新集簇\n"

#: option.c:329
#, c-format
msgid "  --copy                        copy files to new cluster (default)\n"
msgstr "  --copy                        将文件复制到新集簇（默认）\n"

#: option.c:330
#, c-format
msgid ""
"  --copy-file-range             copy files to new cluster with "
"copy_file_range\n"
msgstr ""
"  --copy-file-range             使用 copy_file_range 将文件复制到新集簇\n"

#: option.c:331
#, c-format
msgid ""
"  --no-statistics               do not import statistics from old cluster\n"
msgstr "  --no-statistics               不从旧集簇导入统计信息\n"

#: option.c:332
#, c-format
msgid ""
"  --set-char-signedness=OPTION  set new cluster char signedness to "
"\"signed\" or\n"
"                                \"unsigned\"\n"
msgstr ""
"  --set-char-signedness=OPTION  将新集簇的 char 符号属性设为 \"signed\" 或\n"
"                                \"unsigned\"\n"

#: option.c:334
#, c-format
msgid "  --swap                        move data directories to new cluster\n"
msgstr "  --swap                        将数据目录移动到新集簇\n"

#: option.c:335
#, c-format
msgid "  --sync-method=METHOD          set method for syncing files to disk\n"
msgstr "  --sync-method=METHOD          设置将文件同步到磁盘的方法\n"

#: option.c:336
#, c-format
msgid "  -?, --help                    show this help, then exit\n"
msgstr "  -?, --help                    显示此帮助，然后退出\n"

#: option.c:337
#, c-format
msgid ""
"\n"
"Before running pg_upgrade you must:\n"
"  create a new database cluster (using the new version of initdb)\n"
"  shutdown the postmaster servicing the old cluster\n"
"  shutdown the postmaster servicing the new cluster\n"
msgstr ""
"\n"
"运行 pg_upgrade 前，必须:\n"
"  创建新数据库集簇（使用新版本的 initdb）\n"
"  关闭为旧集簇提供服务的 postmaster\n"
"  关闭为新集簇提供服务的 postmaster\n"

#: option.c:342
#, c-format
msgid ""
"\n"
"When you run pg_upgrade, you must provide the following information:\n"
"  the data directory for the old cluster  (-d DATADIR)\n"
"  the data directory for the new cluster  (-D DATADIR)\n"
"  the \"bin\" directory for the old version (-b BINDIR)\n"
"  the \"bin\" directory for the new version (-B BINDIR)\n"
msgstr ""
"\n"
"运行 pg_upgrade 时，必须提供以下信息:\n"
"  旧集簇的数据目录（-d DATADIR）\n"
"  新集簇的数据目录（-D DATADIR）\n"
"  旧版本的 \"bin\" 目录（-b BINDIR）\n"
"  新版本的 \"bin\" 目录（-B BINDIR）\n"

#: option.c:348
#, c-format
msgid ""
"\n"
"For example:\n"
"  pg_upgrade -d oldCluster/data -D newCluster/data -b oldCluster/bin -B "
"newCluster/bin\n"
"or\n"
msgstr ""
"\n"
"例如:\n"
"  pg_upgrade -d oldCluster/data -D newCluster/data -b oldCluster/bin -B "
"newCluster/bin\n"
"或\n"

#: option.c:353
#, c-format
msgid ""
"  $ export PGDATAOLD=oldCluster/data\n"
"  $ export PGDATANEW=newCluster/data\n"
"  $ export PGBINOLD=oldCluster/bin\n"
"  $ export PGBINNEW=newCluster/bin\n"
"  $ pg_upgrade\n"
msgstr ""
"  $ export PGDATAOLD=oldCluster/data\n"
"  $ export PGDATANEW=newCluster/data\n"
"  $ export PGBINOLD=oldCluster/bin\n"
"  $ export PGBINNEW=newCluster/bin\n"
"  $ pg_upgrade\n"

#: option.c:359
#, c-format
msgid ""
"  C:\\> set PGDATAOLD=oldCluster/data\n"
"  C:\\> set PGDATANEW=newCluster/data\n"
"  C:\\> set PGBINOLD=oldCluster/bin\n"
"  C:\\> set PGBINNEW=newCluster/bin\n"
"  C:\\> pg_upgrade\n"
msgstr ""
"  C:\\> set PGDATAOLD=oldCluster/data\n"
"  C:\\> set PGDATANEW=newCluster/data\n"
"  C:\\> set PGBINOLD=oldCluster/bin\n"
"  C:\\> set PGBINNEW=newCluster/bin\n"
"  C:\\> pg_upgrade\n"

