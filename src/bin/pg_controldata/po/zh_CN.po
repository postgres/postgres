#, c-format
msgid "too many command-line arguments (first is \"%s\")"
msgstr "命令行参数过多（第一个多余参数是 \"%s\"）"

#: pg_controldata.c:163
#, c-format
msgid "no data directory specified"
msgstr "未指定数据目录"

#: pg_controldata.c:172
#, c-format
msgid ""
"control file version (%u) does not match the version understood by this "
"program (%u)"
msgstr "控制文件版本（%u）与此程序支持的版本（%u）不匹配"

#: pg_controldata.c:174
#, c-format
msgid ""
"Either the control file has been created with a different version of "
"PostgreSQL, or it is corrupt.  The results below are untrustworthy."
msgstr ""
"控制文件可能由不同版本的 PostgreSQL 创建，也可能已损坏。以下结果不可信。"

#: pg_controldata.c:179
#, c-format
msgid "calculated CRC checksum does not match value stored in control file"
msgstr "计算得到的 CRC 校验和与控制文件中存储的值不匹配"

#: pg_controldata.c:180
#, c-format
msgid ""
"Either the control file is corrupt, or it has a different layout than this "
"program is expecting.  The results below are untrustworthy."
msgstr "控制文件可能已损坏，也可能采用了此程序预期之外的布局。以下结果不可信。"

#: pg_controldata.c:189
#, c-format
msgid "invalid WAL segment size in control file (%d byte)"
msgid_plural "invalid WAL segment size in control file (%d bytes)"
msgstr[0] "控制文件中的 WAL 段大小无效（%d 字节）"

#: pg_controldata.c:193
#, c-format
msgid "The WAL segment size must be a power of two between 1 MB and 1 GB."
msgstr "WAL 段大小必须是 1 MB 到 1 GB 之间的二的幂。"

#: pg_controldata.c:194
#, c-format
msgid "The file is corrupt and the results below are untrustworthy."
msgstr "文件已损坏，以下结果不可信。"

