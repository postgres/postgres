"\n"
msgstr ""
"%s 是用於初始化、啟動、停止或控制 PostgreSQL 伺服器的工具。\n"
"\n"

#: pg_ctl.c:1976
#, c-format
msgid "Usage:\n"
msgstr "用法:\n"

#: pg_ctl.c:1977
#, c-format
msgid "  %s init[db]   [-D DATADIR] [-s] [-o OPTIONS]\n"
msgstr "  %s init[db]   [-D 資料目錄] [-s] [-o 選項]\n"

#: pg_ctl.c:1978
#, c-format
msgid ""
"  %s start      [-D DATADIR] [-l FILENAME] [-W] [-t SECS] [-s]\n"
"                    [-o OPTIONS] [-p PATH] [-c]\n"
msgstr "  %s start      [-D 資料目錄] [-l 檔名] [-W] [-t 秒數] [-s]\n                    [-o 選項] [-p 路徑] [-c]\n"

#: pg_ctl.c:1980
#, c-format
msgid "  %s stop       [-D DATADIR] [-m SHUTDOWN-MODE] [-W] [-t SECS] [-s]\n"
msgstr "  %s stop       [-D 資料目錄] [-m 停止模式] [-W] [-t 秒數] [-s]\n"

#: pg_ctl.c:1981
#, c-format
msgid ""
"  %s restart    [-D DATADIR] [-m SHUTDOWN-MODE] [-W] [-t SECS] [-s]\n"
"                    [-o OPTIONS] [-c]\n"
msgstr "  %s restart    [-D 資料目錄] [-m 停止模式] [-W] [-t 秒數] [-s]\n                    [-o 選項] [-c]\n"

#: pg_ctl.c:1983
#, c-format
msgid "  %s reload     [-D DATADIR] [-s]\n"
msgstr "  %s reload     [-D 資料目錄] [-s]\n"

#: pg_ctl.c:1984
#, c-format
msgid "  %s status     [-D DATADIR]\n"
msgstr "  %s status     [-D 資料目錄]\n"

#: pg_ctl.c:1985
#, c-format
msgid "  %s promote    [-D DATADIR] [-W] [-t SECS] [-s]\n"
msgstr "  %s promote    [-D 資料目錄] [-W] [-t 秒數] [-s]\n"

#: pg_ctl.c:1986
#, c-format
msgid "  %s logrotate  [-D DATADIR] [-s]\n"
msgstr "  %s logrotate  [-D 資料目錄] [-s]\n"

#: pg_ctl.c:1987
#, c-format
msgid "  %s kill       SIGNALNAME PID\n"
msgstr "  %s kill       訊號名稱 行程編號\n"

#: pg_ctl.c:1989
#, c-format
msgid ""
"  %s register   [-D DATADIR] [-N SERVICENAME] [-U USERNAME] [-P PASSWORD]\n"
"                    [-S START-TYPE] [-e SOURCE] [-W] [-t SECS] [-s] [-o OPTIONS]\n"
msgstr "  %s register   [-D 資料目錄] [-N 服務名稱] [-U 使用者名稱] [-P 密碼]\n                    [-S 啟動方式] [-e 事件來源] [-W] [-t 秒數] [-s] [-o 選項]\n"

#: pg_ctl.c:1991
#, c-format
msgid "  %s unregister [-N SERVICENAME]\n"
msgstr "  %s unregister [-N 服務名稱]\n"

#: pg_ctl.c:1994
#, c-format
msgid ""
"\n"
"Common options:\n"
msgstr "\n通用選項:\n"

#: pg_ctl.c:1995
#, c-format
msgid "  -D, --pgdata=DATADIR   location of the database storage area\n"
msgstr "  -D, --pgdata=DATADIR   資料庫儲存區域的位置\n"

#: pg_ctl.c:1997
#, c-format
msgid "  -e SOURCE              event source for logging when running as a service\n"
msgstr "  -e SOURCE              以服務形式執行時用於記錄日誌的事件來源\n"

#: pg_ctl.c:1999
#, c-format
msgid "  -s, --silent           only print errors, no informational messages\n"
msgstr "  -s, --silent           僅顯示錯誤訊息，不顯示資訊性訊息\n"

#: pg_ctl.c:2000
#, c-format
msgid "  -t, --timeout=SECS     seconds to wait when using -w option\n"
msgstr "  -t, --timeout=SECS     使用 -w 選項時等待的秒數\n"

#: pg_ctl.c:2001
#, c-format
msgid "  -V, --version          output version information, then exit\n"
msgstr "  -V, --version          顯示版本，然後結束\n"

#: pg_ctl.c:2002
#, c-format
msgid "  -w, --wait             wait until operation completes (default)\n"
msgstr "  -w, --wait             等待操作完成(預設值)\n"

#: pg_ctl.c:2003
#, c-format
msgid "  -W, --no-wait          do not wait until operation completes\n"
msgstr "  -W, --no-wait          不等待操作完成\n"

#: pg_ctl.c:2004
#, c-format
msgid "  -?, --help             show this help, then exit\n"
msgstr "  -?, --help             顯示說明，然後結束\n"

#: pg_ctl.c:2005
#, c-format
msgid "If the -D option is omitted, the environment variable PGDATA is used.\n"
msgstr "若省略 -D 選項，將使用環境變數 PGDATA。\n"

#: pg_ctl.c:2007
#, c-format
msgid ""
"\n"
"Options for start or restart:\n"
msgstr ""
"\n"
"啟動或重新啟動的選項:\n"

#: pg_ctl.c:2009
#, c-format
msgid "  -c, --core-files       allow postgres to produce core files\n"
msgstr "  -c, --core-files       允許 postgres 產生核心傾印檔案\n"

#: pg_ctl.c:2011
#, c-format
msgid "  -c, --core-files       not applicable on this platform\n"
msgstr "  -c, --core-files       不適用此平台\n"

#: pg_ctl.c:2013
#, c-format
msgid "  -l, --log=FILENAME     write (or append) server log to FILENAME\n"
msgstr "  -l, --log=FILENAME     將伺服器日誌寫入(或附加到)檔案 FILENAME\n"

#: pg_ctl.c:2014
#, c-format
msgid ""
"  -o, --options=OPTIONS  command line options to pass to postgres\n"
"                         (PostgreSQL server executable) or initdb\n"
msgstr "  -o, --options=OPTIONS  傳遞給 postgres(PostgreSQL 伺服器執行檔)\n                         或 initdb 的命令列選項\n"

#: pg_ctl.c:2016
#, c-format
msgid "  -p PATH-TO-POSTGRES    normally not necessary\n"
msgstr "  -p PATH-TO-POSTGRES    通常不需要\n"

#: pg_ctl.c:2017
#, c-format
msgid ""
"\n"
"Options for stop or restart:\n"
msgstr ""
"\n"
"停止或重新啟動的選項:\n"

#: pg_ctl.c:2018
#, c-format
msgid "  -m, --mode=MODE        MODE can be \"smart\", \"fast\", or \"immediate\"\n"
msgstr "  -m, --mode=MODE        MODE 可以是 \"smart\", \"fast\" 或 \"immediate\"\n"

#: pg_ctl.c:2020
#, c-format
msgid ""
"\n"
"Shutdown modes are:\n"
msgstr "\n停止模式:\n"

#: pg_ctl.c:2021
#, c-format
msgid "  smart       quit after all clients have disconnected\n"
msgstr "  smart       在所有客戶端中斷連線後結束\n"

#: pg_ctl.c:2022
#, c-format
msgid "  fast        quit directly, with proper shutdown (default)\n"
msgstr "  fast        直接結束，正常停止(預設)\n"

#: pg_ctl.c:2023
#, c-format
msgid "  immediate   quit without complete shutdown; will lead to recovery on restart\n"
msgstr "  immediate   立即結束，不進行完整的停止；重新啟動時將進行復原\n"

#: pg_ctl.c:2025
#, c-format
msgid ""
"\n"
"Allowed signal names for kill:\n"
msgstr "\n允許用於 kill 命令的訊號名稱:\n"

#: pg_ctl.c:2029
#, c-format
msgid ""
"\n"
"Options for register and unregister:\n"
msgstr ""
"\n"
"註冊和取消註冊服務的選項:\n"

#: pg_ctl.c:2030
#, c-format
msgid "  -N SERVICENAME  service name with which to register PostgreSQL server\n"
msgstr "  -N SERVICENAME  註冊 PostgreSQL 伺服器的服務名稱\n"

#: pg_ctl.c:2031
#, c-format
msgid "  -P PASSWORD     password of account to register PostgreSQL server\n"
msgstr "  -P PASSWORD     註冊 PostgreSQL 伺服器的帳號密碼\n"

#: pg_ctl.c:2032
#, c-format
msgid "  -U USERNAME     user name of account to register PostgreSQL server\n"
msgstr "  -U USERNAME     註冊 PostgreSQL 伺服器的帳號名稱\n"

#: pg_ctl.c:2033
#, c-format
msgid "  -S START-TYPE   service start type to register PostgreSQL server\n"
msgstr "  -S START-TYPE   註冊 PostgreSQL 伺服器的服務啟動方式\n"

#: pg_ctl.c:2035
#, c-format
msgid ""
"\n"
"Start types are:\n"
msgstr ""
"\n"
"啟動方式:\n"

#: pg_ctl.c:2036
#, c-format
msgid "  auto       start service automatically during system startup (default)\n"
msgstr "  auto       系統啟動時自動啟動服務(預設)\n"

#: pg_ctl.c:2037
#, c-format
msgid "  demand     start service on demand\n"
msgstr "  demand     依需要啟動服務\n"

#: pg_ctl.c:2040
#, c-format
msgid ""
"\n"
"Report bugs to <%s>.\n"
msgstr ""
"\n"
"回報錯誤至 <%s>。\n"

#: pg_ctl.c:2041
#, c-format
msgid "%s home page: <%s>\n"
msgstr "%s 首頁: <%s>\n"

#: pg_ctl.c:2066
#, c-format
msgid "%s: unrecognized shutdown mode \"%s\"\n"
msgstr "%s: 無法識別的關停模式 \"%s\"\n"

#: pg_ctl.c:2095
#, c-format
msgid "%s: unrecognized signal name \"%s\"\n"
msgstr "%s: 無法識別的訊號名稱 \"%s\"\n"

#: pg_ctl.c:2112
#, c-format
msgid "%s: unrecognized start type \"%s\"\n"
msgstr "%s: 無法識別的啟動方式 \"%s\"\n"

#: pg_ctl.c:2168
#, c-format
msgid "%s: could not determine the data directory using command \"%s\"\n"
msgstr "%s: 無法使用命令 \"%s\" 確定資料目錄\n"

#: pg_ctl.c:2191
#, c-format
msgid "%s: control file appears to be corrupt\n"
msgstr "%s: 控制檔似乎已損毀\n"

#: pg_ctl.c:2259
#, c-format
msgid ""
"%s: cannot be run as root\n"
"Please log in (using, e.g., \"su\") as the (unprivileged) user that will\n"
"own the server process.\n"
msgstr "%s: 不能以 root 身分執行\n請以將會擁有伺服器行程的(非特權)使用者登入\n(例如用 \"su\" 命令)。\n"

# commands/tablespace.c:386 commands/tablespace.c:483
#: pg_ctl.c:2331
#, c-format
msgid "%s: -S option not supported on this platform\n"
msgstr "%s: 此平台不支援 -S 選項\n"

#: pg_ctl.c:2387
#, c-format
msgid "%s: missing arguments for kill mode\n"
msgstr "%s: 缺少 kill 模式所需的參數\n"

#: pg_ctl.c:2405
#, c-format
msgid "%s: unrecognized operation mode \"%s\"\n"
msgstr "%s: 無法識別的操作模式 \"%s\"\n"

#: pg_ctl.c:2414
#, c-format
msgid "%s: too many command-line arguments (first is \"%s\")\n"
msgstr "%s: 命令列參數過多(第一個多餘參數是 \"%s\")\n"

#: pg_ctl.c:2421
#, c-format
msgid "%s: no operation specified\n"
msgstr "%s: 未指定操作\n"

#: pg_ctl.c:2442
#, c-format
msgid "%s: no database directory specified and environment variable PGDATA unset\n"
msgstr "%s: 未指定資料庫目錄，且未設定環境變數 PGDATA\n"

