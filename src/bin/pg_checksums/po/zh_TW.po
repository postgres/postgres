#: pg_checksums.c:70
#, c-format
msgid ""
"%s enables, disables, or verifies data checksums in a PostgreSQL database cluster.\n"
"\n"
msgstr ""
"%s 可以啟動、關閉或驗證 PostgreSQL 資料庫叢集中的資料檢查碼。\n"
"\n"

#: pg_checksums.c:71
#, c-format
msgid "Usage:\n"
msgstr "用法:\n"

#: pg_checksums.c:72
#, c-format
msgid "  %s [OPTION]... [DATADIR]\n"
msgstr "  %s [選項]... [資料目錄]\n"

#: pg_checksums.c:73
#, c-format
msgid ""
"\n"
"Options:\n"
msgstr ""
"\n"
"選項:\n"

#: pg_checksums.c:74
#, c-format
msgid " [-D, --pgdata=]DATADIR    data directory\n"
msgstr " [-D, --pgdata=]DATADIR    資料目錄\n"

#: pg_checksums.c:75
#, c-format
msgid "  -c, --check              check data checksums (default)\n"
msgstr "  -c, --check              檢查資料檢查碼(預設)\n"

#: pg_checksums.c:76
#, c-format
msgid "  -d, --disable            disable data checksums\n"
msgstr "  -d, --disable            關閉資料檢查碼\n"

#: pg_checksums.c:77
#, c-format
msgid "  -e, --enable             enable data checksums\n"
msgstr "  -e, --enable             啟動資料檢查碼\n"

#: pg_checksums.c:78
#, c-format
msgid "  -f, --filenode=FILENODE  check only relation with specified filenode\n"
msgstr "  -f, --filenode=FILENODE  只檢查指定 filenode 的關聯\n"

#: pg_checksums.c:79
#, c-format
msgid "  -N, --no-sync            do not wait for changes to be written safely to disk\n"
msgstr "  -N, --no-sync            不等待變更安全寫入磁碟\n"

#: pg_checksums.c:80
#, c-format
msgid "  -P, --progress           show progress information\n"
msgstr "  -P, --progress           顯示進度資訊\n"

#: pg_checksums.c:81
#, c-format
msgid "      --sync-method=METHOD set method for syncing files to disk\n"
msgstr "      --sync-method=METHOD 設定將檔案同步到磁碟的方法\n"

#: pg_checksums.c:82
#, c-format
msgid "  -v, --verbose            output verbose messages\n"
msgstr "  -v, --verbose            顯示詳細訊息\n"

#: pg_checksums.c:83
#, c-format
msgid "  -V, --version            output version information, then exit\n"
msgstr "  -V, --version            顯示版本，然後結束\n"

#: pg_checksums.c:84
#, c-format
msgid "  -?, --help               show this help, then exit\n"
msgstr "  -?, --help               顯示說明，然後結束\n"

#: pg_checksums.c:85
#, c-format
msgid ""
"\n"
"If no data directory (DATADIR) is specified, the environment variable PGDATA\n"
"is used.\n"
"\n"
msgstr ""
"\n"
"若未指定資料目錄(DATADIR)就用環境變數 PGDATA。\n"
"\n"

#: pg_checksums.c:87
#, c-format
msgid "Report bugs to <%s>.\n"
msgstr "回報錯誤至 <%s>。\n"

#: pg_checksums.c:88
#, c-format
msgid "%s home page: <%s>\n"
msgstr "%s 首頁: <%s>\n"

#: pg_checksums.c:145
#, c-format
msgid "%<PRId64>/%<PRId64> MB (%d%%) computed"
msgstr "已計算 %<PRId64>/%<PRId64> MB (%d%%)"

# utils/init/miscinit.c:539
