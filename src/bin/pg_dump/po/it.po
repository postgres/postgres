#, c-format
msgid "  -t, --table=PATTERN          dump only the specified table(s)\n"
msgstr "  -t, --table=PATTERN           esporta solo le tabelle specificate\n"

#: pg_dump.c:1328
#, c-format
msgid "  -T, --exclude-table=PATTERN  do NOT dump the specified table(s)\n"
msgstr "  -T, --exclude-table=PATTERN   NON esportare le tabelle specificate\n"

