#: help.c:554
msgid ""
"  PSQL_HISTORY\n"
"    alternative location for the command history file\n"
msgstr ""
"  PSQL_HISTORY\n"
"    命令歷史檔案的替代位置\n"

#: help.c:556
msgid ""
"  PSQL_PAGER, PAGER\n"
