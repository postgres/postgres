# help.c:219
#: help.c:235
msgid "  \\dd[Sx]  [PATTERN]     show object descriptions not displayed elsewhere\n"
msgstr "  \\dd[Sx]  [PATTERN]     顯示未在其他位置顯示的物件描述\n"

# help.c:220
