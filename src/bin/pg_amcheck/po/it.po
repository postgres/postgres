"\n"

#: pg_amcheck.c:1186
#, c-format
msgid "Usage:\n"
msgstr "Uso:\n"

#: pg_amcheck.c:1187
#, c-format
msgid "  %s [OPTION]... [DBNAME]\n"
msgstr "  %s [OPZIONE]... [NOMEDB]\n"

#: pg_amcheck.c:1188
#, c-format
msgid ""
"\n"
"Target options:\n"
msgstr ""
"\n"
"Opzioni di destinazione:\n"

#: pg_amcheck.c:1189
#, c-format
msgid "  -a, --all                       check all databases\n"
msgstr "  -a, --all                       controlla tutti i database\n"

#: pg_amcheck.c:1190
#, c-format
msgid "  -d, --database=PATTERN          check matching database(s)\n"
msgstr "  -d, --database=PATTERN          controlla i database corrispondenti\n"

#: pg_amcheck.c:1191
#, c-format
msgid "  -D, --exclude-database=PATTERN  do NOT check matching database(s)\n"
msgstr "  -D, --exclude-database=PATTERN  NON controllare i database corrispondenti\n"

#: pg_amcheck.c:1192
#, c-format
msgid "  -i, --index=PATTERN             check matching index(es)\n"
msgstr "  -i, --index=PATTERN             controlla gli indici corrispondenti\n"

#: pg_amcheck.c:1193
#, c-format
msgid "  -I, --exclude-index=PATTERN     do NOT check matching index(es)\n"
msgstr "  -I, --exclude-index=PATTERN     NON controllare gli indici corrispondenti\n"

#: pg_amcheck.c:1194
#, c-format
msgid "  -r, --relation=PATTERN          check matching relation(s)\n"
msgstr "  -r, --relation=PATTERN          controlla le relazioni corrispondenti\n"

#: pg_amcheck.c:1195
#, c-format
msgid "  -R, --exclude-relation=PATTERN  do NOT check matching relation(s)\n"
msgstr ""
"  -R, --exclude-relation=PATTERN  NON controllare le relazioni corrispondenti\n"

#: pg_amcheck.c:1196
#, c-format
msgid "  -s, --schema=PATTERN            check matching schema(s)\n"
msgstr "  -s, --schema=PATTERN            controlla gli schemi corrispondenti\n"

#: pg_amcheck.c:1197
#, c-format
msgid "  -S, --exclude-schema=PATTERN    do NOT check matching schema(s)\n"
msgstr "  -S, --exclude-schema=PATTERN    NON controllare gli schemi corrispondenti\n"

#: pg_amcheck.c:1198
#, c-format
msgid "  -t, --table=PATTERN             check matching table(s)\n"
msgstr "  -t, --table=PATTERN             controlla le tabelle corrispondenti\n"

#: pg_amcheck.c:1199
#, c-format
msgid "  -T, --exclude-table=PATTERN     do NOT check matching table(s)\n"
msgstr "  -T, --exclude-table=PATTERN     NON controllare le tabelle corrispondenti\n"

#: pg_amcheck.c:1200
#, c-format
msgid ""
"      --no-dependent-indexes      do NOT expand list of relations to include "
"indexes\n"
msgstr ""
"      --no-dependent-indexes      NON espandere la lista delle relazioni includendo "
"gli indici\n"

#: pg_amcheck.c:1201
#, c-format
msgid ""
"      --no-dependent-toast        do NOT expand list of relations to include TOAST "
"tables\n"
msgstr ""
"      --no-dependent-toast        NON espandere la lista delle relazioni includendo "
"le tabelle TOAST\n"

#: pg_amcheck.c:1202
#, c-format
msgid "      --no-strict-names           do NOT require patterns to match objects\n"
msgstr ""
"      --no-strict-names           NON richiedere che i pattern corrispondano a "
"oggetti\n"

#: pg_amcheck.c:1203
#, c-format
msgid ""
"\n"
"Table checking options:\n"
msgstr ""
"\n"
"Opzioni per il controllo delle tabelle:\n"

#: pg_amcheck.c:1204
#, c-format
msgid "      --exclude-toast-pointers    do NOT follow relation TOAST pointers\n"
msgstr ""
"      --exclude-toast-pointers    NON seguire i puntatori TOAST della relazione\n"

#: pg_amcheck.c:1205
#, c-format
msgid "      --on-error-stop             stop checking at end of first corrupt page\n"
msgstr ""
"      --on-error-stop             ferma il controllo alla fine della prima pagina "
"corrotta\n"

#: pg_amcheck.c:1206
#, c-format
msgid ""
"      --skip=OPTION               do NOT check \"all-frozen\" or \"all-visible\" "
"blocks\n"
msgstr ""
"      --skip=OPZIONE               NON controllare i blocchi \"all-frozen\" oppure "
"\"all-visible\"\n"

#: pg_amcheck.c:1207
#, c-format
msgid ""
"      --startblock=BLOCK          begin checking table(s) at the given block "
"number\n"
msgstr ""
"      --startblock=BLOCCO          inizia il controllo delle tabelle dal numero di "
"blocco indicato\n"

#: pg_amcheck.c:1208
#, c-format
msgid ""
"      --endblock=BLOCK            check table(s) only up to the given block number\n"
msgstr ""
"      --endblock=BLOCCO            controlla le tabelle solo fino al numero di "
"blocco indicato\n"

#: pg_amcheck.c:1209
#, c-format
msgid ""
"\n"
"B-tree index checking options:\n"
msgstr ""
"\n"
"Opzioni per il controllo degli indici B-tree:\n"

#: pg_amcheck.c:1210
#, c-format
msgid "      --checkunique               check unique constraint if index is unique\n"
msgstr ""
"      --checkunique               controlla il vincolo di unicità se l'indice è "
"unico\n"

#: pg_amcheck.c:1211
#, c-format
msgid ""
"      --heapallindexed            check that all heap tuples are found within "
"indexes\n"
msgstr ""
"      --heapallindexed             controlla che tutte le tuple heap siano presenti "
"negli indici\n"

#: pg_amcheck.c:1212
#, c-format
msgid "      --parent-check              check index parent/child relationships\n"
msgstr ""
"      --parent-check               controlla le relazioni padre/figlio dell'indice\n"

#: pg_amcheck.c:1213
#, c-format
msgid "      --rootdescend               search from root page to refind tuples\n"
msgstr ""
"      --rootdescend                cerca dalla pagina radice per ritrovare le "
"tuple\n"

