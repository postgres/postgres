msgstr "параметр %s вимагає використання параметру %s"

#: pg_waldump.c:1237
#, c-format
msgid "too many command-line arguments (first is \"%s\")"
msgstr "забагато аргументів у командному рядку (перший \"%s\")"

#: pg_waldump.c:1274
#, c-format
msgid "unnecessary command-line arguments specified with tar archive (first is \"%s\")"
msgstr "зайві аргументи командного рядка вказані разом з архівом tar (перший \"%s\")"

#: pg_waldump.c:1310
#, c-format
msgid "start WAL location %X/%08X is not inside file \"%s\""
msgstr "початкове розташування WAL %X/%08X не всередині файлу \"%s\""

#: pg_waldump.c:1337
#, c-format
msgid "ENDSEG %s is before STARTSEG %s"
msgstr "ENDSEG %s перед STARTSEG %s"

#: pg_waldump.c:1351
#, c-format
msgid "end WAL location %X/%08X is not inside file \"%s\""
msgstr "кінцеве розташування WAL %X/%08X не всередині файлу \"%s\""

#: pg_waldump.c:1364
#, c-format
msgid "no start WAL location given"
msgstr "не задано початкове розташування WAL"

#: pg_waldump.c:1371
#, c-format
msgid "--follow is not supported when reading from a tar archive"
msgstr "--follow не підтримується при читанні з архіву tar"

#: pg_waldump.c:1409
#, c-format
msgid "out of memory while allocating a WAL reading processor"
msgstr "недостатньо пам'яті під час виділення обробника читання WAL"

#: pg_waldump.c:1425
#, c-format
msgid "could not find a valid record after %X/%08X: %s"
msgstr "не вдалося знайти припустимий запис після %X/%08X: %s"

#: pg_waldump.c:1428
#, c-format
msgid "could not find a valid record after %X/%08X"
msgstr "не вдалося знайти припустимий запис після %X/%08X"

#: pg_waldump.c:1439
#, c-format
msgid "first record is after %X/%08X, at %X/%08X, skipping over %u byte"
msgid_plural "first record is after %X/%08X, at %X/%08X, skipping over %u bytes"
msgstr[0] "перший запис після %X/%08X, за адресою %X/%08X, пропускаючи %u байт"
msgstr[1] "перший запис після %X/%08X, за адресою %X/%08X, пропускаючи %u байти"
msgstr[2] "перший запис після %X/%08X, за адресою %X/%08X, пропускаючи %u байтів"
msgstr[3] "перший запис після %X/%08X, за адресою %X/%08X, пропускаючи %u байта"

#: pg_waldump.c:1527
#, c-format
msgid "error in WAL record at %X/%08X: %s"
msgstr "помилка у записі WAL у %X/%08X: %s"

#: pg_waldump.c:1545
#, c-format
msgid "Try \"%s --help\" for more information."
msgstr "Спробуйте \"%s --help\" для додаткової інформації."

#: xlogreader.c:621
#, c-format
msgid "invalid record offset at %X/%08X: expected at least %u, got %u"
msgstr "неприпустиме зміщення запису в %X/%08X: очікувалось хоча б %u, отримано %u"

#: xlogreader.c:630
#, c-format
