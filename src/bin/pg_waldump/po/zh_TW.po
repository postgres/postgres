#: pg_waldump.c:208
#, c-format
msgid "could not read file \"%s\": %m"
msgstr "無法讀取檔案 \"%s\": %m"

#: pg_waldump.c:211
#, c-format
msgid "could not read file \"%s\": read %d of %zu"
msgstr "無法讀取檔案 \"%1$s\": 應讀取 %3$zu，實際讀取 %2$d"

#: pg_waldump.c:272
#, c-format
msgid "could not locate WAL file \"%s\""
msgstr "找不到 WAL 檔 \"%s\""

#: pg_waldump.c:274
#, c-format
msgid "could not find any WAL file"
msgstr "找不到任何 WAL 檔"

#: pg_waldump.c:315
#, c-format
msgid "could not find file \"%s\": %m"
msgstr "找不到檔案 \"%s\": %m"

#: pg_waldump.c:364
#, c-format
msgid "could not read from file %s, offset %u: %m"
msgstr "無法從檔案 %s 的位移 %u 處讀取: %m"

#: pg_waldump.c:368
#, c-format
msgid "could not read from file %s, offset %u: read %d of %zu"
msgstr "無法讀取檔案 %1$s 的位移 %2$u 處的資料: 應讀取 %4$zu，實際讀取 %3$d"

#: pg_waldump.c:721
#, c-format
msgid ""
"%s decodes and displays PostgreSQL write-ahead logs for debugging.\n"
"\n"
msgstr "%s 解碼並顯示 PostgreSQL 的預寫式日誌以進行除錯。\n\n"

#: pg_waldump.c:723
#, c-format
msgid "Usage:\n"
msgstr "用法:\n"

#: pg_waldump.c:724
#, c-format
msgid "  %s [OPTION]... [STARTSEG [ENDSEG]]\n"
msgstr "  %s [選項]... [起始片段 [結束片段]]\n"

#: pg_waldump.c:725
#, c-format
msgid ""
"\n"
"Options:\n"
msgstr ""
"\n"
"選項:\n"

#: pg_waldump.c:726
#, c-format
msgid "  -b, --bkp-details      output detailed information about backup blocks\n"
msgstr "  -b, --bkp-details      輸出關於備份區塊的詳細資訊\n"

#: pg_waldump.c:727
#, c-format
msgid "  -e, --end=RECPTR       stop reading at WAL location RECPTR\n"
msgstr "  -e, --end=RECPTR       在 WAL 位置 RECPTR 停止讀取\n"

#: pg_waldump.c:728
#, c-format
msgid "  -f, --follow           keep retrying after reaching end of WAL\n"
msgstr "  -f, --follow           到達 WAL 結尾後繼續嘗試\n"

#: pg_waldump.c:729
#, c-format
msgid "  -n, --limit=N          number of records to display\n"
msgstr "  -n, --limit=N          要顯示的記錄數量\n"

#: pg_waldump.c:730
#, c-format
msgid ""
"  -p, --path=PATH        directory in which to find log segment files or a\n"
"                         directory with a ./pg_wal that contains such files\n"
"                         (default: current directory, ./pg_wal, $PGDATA/pg_wal)\n"
msgstr "  -p, --path=PATH        用於查詢日誌片段檔案的目錄，或者\n                         包含 ./pg_wal 子目錄且該子目錄含有這些檔案的目錄\n                         （預設: 目前目錄, ./pg_wal, $PGDATA/pg_wal）\n"

#: pg_waldump.c:733
#, c-format
msgid "  -q, --quiet            do not print any output, except for errors\n"
msgstr "  -q, --quiet            不顯示任何輸出，除了錯誤訊息\n"

#: pg_waldump.c:734
#, c-format
msgid ""
"  -r, --rmgr=RMGR        only show records generated by resource manager RMGR;\n"
"                         use --rmgr=list to list valid resource manager names\n"
msgstr "  -r, --rmgr=RMGR        只顯示由資源管理員 RMGR 產生的記錄；\n                         用 --rmgr=list 列出有效的資源管理員名稱\n"

#: pg_waldump.c:736
#, c-format
msgid "  -s, --start=RECPTR     start reading at WAL location RECPTR\n"
msgstr "  -s, --start=RECPTR     從 WAL 位置 RECPTR 開始讀取\n"

#: pg_waldump.c:737
#, c-format
msgid ""
"  -t, --timeline=TLI     timeline from which to read log records\n"
"                         (default: 1 or the value used in STARTSEG)\n"
msgstr "  -t, --timeline=TLI     要讀取日誌記錄的時間軸\n                         （預設: 1 或 STARTSEG 中使用的值）\n"

#: pg_waldump.c:739
#, c-format
msgid "  -V, --version          output version information, then exit\n"
msgstr "  -V, --version          顯示版本，然後結束\n"

#: pg_waldump.c:740
#, c-format
msgid "  -x, --xid=XID          only show records with transaction ID XID\n"
msgstr "  -x, --xid=XID          只顯示有交易 ID XID 的記錄\n"

#: pg_waldump.c:741
#, c-format
msgid ""
"  -z, --stats[=record]   show statistics instead of records\n"
"                         (optionally, show per-record statistics)\n"
msgstr "  -z, --stats[=record]   顯示統計資料而不是記錄\n                         (可選擇顯示各記錄類型的統計資料)\n"

#: pg_waldump.c:743
#, c-format
msgid "  -?, --help             show this help, then exit\n"
msgstr "  -?, --help             顯示說明，然後結束\n"

#: pg_waldump.c:744
#, c-format
msgid ""
"\n"
"Report bugs to <%s>.\n"
msgstr "\n回報錯誤至 <%s>。\n"

#: pg_waldump.c:745
#, c-format
msgid "%s home page: <%s>\n"
msgstr "%s 首頁: <%s>\n"

#: pg_waldump.c:822
#, c-format
msgid "no arguments specified"
msgstr "未指定任何參數"

#: pg_waldump.c:837
#, c-format
msgid "could not parse end WAL location \"%s\""
msgstr "無法解析 WAL 結束位置 \"%s\""

#: pg_waldump.c:849
#, c-format
msgid "could not parse limit \"%s\""
msgstr "無法解析限制值 \"%s\""

#: pg_waldump.c:880
#, c-format
msgid "resource manager \"%s\" does not exist"
msgstr "資源管理員 \"%s\" 不存在"

#: pg_waldump.c:889
#, c-format
msgid "could not parse start WAL location \"%s\""
msgstr "無法解析 WAL 起始位置 \"%s\""

#: pg_waldump.c:899
#, c-format
msgid "could not parse timeline \"%s\""
msgstr "無法解析時間軸 \"%s\""

#: pg_waldump.c:906
#, c-format
msgid "could not parse \"%s\" as a transaction ID"
msgstr "無法將 \"%s\" 解析為交易 ID"

#: pg_waldump.c:921
#, c-format
msgid "unrecognized argument to --stats: %s"
msgstr "無法識別 --stats 的參數: %s"

#: pg_waldump.c:934
#, c-format
msgid "too many command-line arguments (first is \"%s\")"
msgstr "命令列參數過多(第一個多餘參數是 \"%s\")"

