#: pg_isready.c:229 reindexdb.c:900 vacuumdb.c:353
#, c-format
msgid ""
"\n"
"Options:\n"
msgstr ""
"\n"
"选项:\n"

#: clusterdb.c:277
#, c-format
msgid "  -a, --all                 cluster all databases\n"
msgstr "  -a, --all                 对所有数据库进行聚簇\n"

#: clusterdb.c:278
#, c-format
msgid "  -d, --dbname=DBNAME       database to cluster\n"
msgstr "  -d, --dbname=DBNAME       要进行聚簇的数据库\n"

#: clusterdb.c:279 createuser.c:425 dropdb.c:174 dropuser.c:174
#, c-format
msgid ""
"  -e, --echo                show the commands being sent to the server\n"
msgstr "  -e, --echo                显示发送到服务器的命令\n"

#: clusterdb.c:280
#, c-format
msgid "  -q, --quiet               don't write any messages\n"
msgstr "  -q, --quiet               不输出任何消息\n"

#: clusterdb.c:281
#, c-format
msgid "  -t, --table=TABLE         cluster specific table(s) only\n"
msgstr "  -t, --table=TABLE         仅对指定的表进行聚簇\n"

#: clusterdb.c:282
#, c-format
msgid "  -v, --verbose             write a lot of output\n"
msgstr "  -v, --verbose             输出详细信息\n"

