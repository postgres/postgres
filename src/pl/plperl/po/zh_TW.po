#, c-format
msgid "Perl hash contains nonexistent column \"%s\""
msgstr "Perl 雜湊包含不存在的欄位 \"%s\""

# commands/tablecmds.c:5425
#: plperl.c:1109 plperl.c:1839
#, c-format
msgid "cannot set system attribute \"%s\""
msgstr "不能設定系統屬性 \"%s\""

# executor/execQual.c:2085 utils/adt/arrayfuncs.c:507
#: plperl.c:1210 plperl.c:1225 plperl.c:1242
#, c-format
msgid "multidimensional arrays must have array expressions with matching dimensions"
msgstr "多維陣列中的陣列運算式必須具有相符的維度"

# executor/execQual.c:257 executor/execQual.c:285 executor/execQual.c:2065
# utils/adt/array_userfuncs.c:362 utils/adt/arrayfuncs.c:216
# utils/adt/arrayfuncs.c:472 utils/adt/arrayfuncs.c:1153
# utils/adt/arrayfuncs.c:2421
#: plperl.c:1215
#, c-format
msgid "number of array dimensions exceeds the maximum allowed (%d)"
msgstr "陣列維度數超過允許的最大值(%d)"

# access/nbtree/nbtinsert.c:404 access/nbtree/nbtsort.c:499
#: plperl.c:1278
#, c-format
msgid "array size exceeds the maximum allowed (%zu)"
msgstr "陣列大小超過允許的最大值 (%zu)"

# commands/tablecmds.c:3079 commands/tablecmds.c:3172
# commands/tablecmds.c:3222 commands/tablecmds.c:3318
# commands/tablecmds.c:3379 commands/tablecmds.c:4573
#: plperl.c:1304
#, c-format
msgid "cannot convert Perl array to non-array type %s"
msgstr "不能將 Perl 陣列轉換為非陣列型別 %s"

# utils/adt/numeric.c:1761
#: plperl.c:1405
#, c-format
msgid "cannot convert Perl hash to non-composite type %s"
msgstr "不能將 Perl 雜湊轉換為非複合型別 %s"

#: plperl.c:1427 plperl.c:3347
#, c-format
msgid "function returning record called in context that cannot accept type record"
msgstr "在不能接受 record 型別的上下文中呼叫傳回 record 的函式"

# utils/cache/lsyscache.c:1720
#: plperl.c:1488
#, c-format
msgid "lookup failed for type %s"
msgstr "尋找型別 %s 失敗"

#: plperl.c:1809
#, c-format
msgid "$_TD->{new} does not exist"
msgstr "$_TD->{new} 不存在"

#: plperl.c:1813
#, c-format
msgid "$_TD->{new} is not a hash reference"
msgstr "$_TD->{new} 不是雜湊參考"

# commands/tablecmds.c:4580
#: plperl.c:1846
#, c-format
msgid "cannot set generated column \"%s\""
msgstr "不能設定產生欄位 \"%s\""

#: plperl.c:2057 plperl.c:2896
#, c-format
msgid "PL/Perl functions cannot return type %s"
msgstr "PL/Perl 函式不能傳回型別 %s"

#: plperl.c:2070 plperl.c:2935
#, c-format
msgid "PL/Perl functions cannot accept type %s"
msgstr "PL/Perl 函式不能接受型別 %s"

#: plperl.c:2187
#, c-format
msgid "didn't get a CODE reference from compiling function \"%s\""
msgstr "未從編譯函式 \"%s\" 取得 CODE 參考"

#: plperl.c:2278
#, c-format
msgid "didn't get a return item from function"
msgstr "未從函式取得傳回項目"

#: plperl.c:2322 plperl.c:2389
#, c-format
msgid "couldn't fetch $_TD"
msgstr "無法擷取 $_TD"

#: plperl.c:2346 plperl.c:2409
#, c-format
msgid "didn't get a return item from trigger function"
msgstr "未從觸發器函式取得傳回項目"

#: plperl.c:2466
#, c-format
msgid "set-valued function called in context that cannot accept a set"
msgstr "在不能接受集合的情境中呼叫傳回集合的函式"

#: plperl.c:2471
#, c-format
msgid "materialize mode required, but it is not allowed in this context"
msgstr "需要物化模式，但此上下文不允許該模式"

#: plperl.c:2516
#, c-format
msgid "set-returning PL/Perl function must return reference to array or use return_next"
msgstr "傳回集合的 PL/Perl 函式必須傳回陣列的參考或用 return_next"

#: plperl.c:2636
#, c-format
msgid "ignoring modified row in DELETE trigger"
msgstr "正在忽略 DELETE 觸發器中已修改的列"

#: plperl.c:2644
#, c-format
msgid "result of PL/Perl trigger function must be undef, \"SKIP\", or \"MODIFY\""
msgstr "PL/Perl 觸發器函式的結果必須是 undef, \"SKIP\" 或 \"MODIFY\""

#: plperl.c:2891
#, c-format
msgid "trigger functions can only be called as triggers"
msgstr "觸發器函式只能當做觸發器呼叫"

#: plperl.c:3252
#, c-format
msgid "query result has too many rows to fit in a Perl array"
msgstr "查詢結果的列數過多，無法放入 Perl 陣列中"

#: plperl.c:3324
#, c-format
msgid "cannot use return_next in a non-SETOF function"
msgstr "在非 SETOF 函式中不能使用 return_next"

#: plperl.c:3398
#, c-format
msgid "SETOF-composite-returning PL/Perl function must call return_next with reference to hash"
msgstr "傳回 SETOF 複合型別的 PL/Perl 函式必須以雜湊參考為參數呼叫 return_next"

#: plperl.c:4180
#, c-format
msgid "PL/Perl function \"%s\""
msgstr "PL/Perl 函式 \"%s\""

#: plperl.c:4192
#, c-format
msgid "compilation of PL/Perl function \"%s\""
msgstr "編譯 PL/Perl 函式 \"%s\""

#: plperl.c:4201
#, c-format
msgid "PL/Perl anonymous code block"
msgstr "PL/Perl 匿名程式碼區塊"

