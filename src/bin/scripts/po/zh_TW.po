"\n"
"Options:\n"
msgstr ""
"\n"
"選項:\n"

#: clusterdb.c:268
#, c-format
msgid "  -a, --all                 cluster all databases\n"
msgstr "  -a, --all                 對所有資料庫進行叢集化\n"

