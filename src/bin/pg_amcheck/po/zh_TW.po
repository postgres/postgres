msgstr "並行作業數必須至少為 1"

#: pg_amcheck.c:402
#, c-format
msgid "invalid argument for option %s"
msgstr "選項 %s 的參數無效"

#: pg_amcheck.c:411
#, c-format
msgid "invalid start block"
msgstr "起始區塊無效"

#: pg_amcheck.c:416
#, c-format
msgid "start block out of bounds"
msgstr "起始區塊超出範圍"

#: pg_amcheck.c:426
#, c-format
msgid "invalid end block"
msgstr "結束區塊無效"

#: pg_amcheck.c:431
#, c-format
msgid "end block out of bounds"
msgstr "結束區塊超出範圍"

# postmaster/postmaster.c:512 postmaster/postmaster.c:525
#: pg_amcheck.c:456 pg_amcheck.c:482
#, c-format
msgid "Try \"%s --help\" for more information.\n"
msgstr "用 \"%s --help\" 取得更多資訊。\n"

#: pg_amcheck.c:464
#, c-format
msgid "end block precedes start block"
msgstr "結束區塊早於起始區塊"

#: pg_amcheck.c:480
#, c-format
msgid "too many command-line arguments (first is \"%s\")"
msgstr "命令列參數過多(第一個多餘參數是 \"%s\")"

#: pg_amcheck.c:501
#, c-format
msgid "cannot specify a database name with --all"
msgstr "使用 --all 時不能指定資料庫名稱"

#: pg_amcheck.c:510
#, c-format
msgid "cannot specify both a database name and database patterns"
msgstr "不能同時指定資料庫名稱和資料庫名稱表達式"

#: pg_amcheck.c:540
#, c-format
msgid "no databases to check"
msgstr "沒有要檢查的資料庫"

#: pg_amcheck.c:596
#, c-format
msgid "database \"%s\": %s"
msgstr "資料庫 \"%s\": %s"

#: pg_amcheck.c:607
#, c-format
msgid "skipping database \"%s\": amcheck is not installed"
msgstr "正在跳過資料庫 \"%s\": 未安裝 amcheck"

#: pg_amcheck.c:615
#, c-format
msgid "in database \"%s\": using amcheck version \"%s\" in schema \"%s\""
msgstr "在資料庫 \"%1$s\" 中: 使用 schema \"%3$s\" 中的 amcheck 版本 \"%2$s\""

#: pg_amcheck.c:637
#, c-format
msgid "no heap tables to check matching \"%s\""
msgstr "沒有符合 \"%s\" 的堆積資料表需要檢查"

#: pg_amcheck.c:640
#, c-format
msgid "no btree indexes to check matching \"%s\""
msgstr "沒有符合 \"%s\" 的 btree 索引需要檢查"

#: pg_amcheck.c:643
#, c-format
msgid "no relations to check in schemas matching \"%s\""
msgstr "符合 \"%s\" 的 schema 中沒有關聯需要檢查"

#: pg_amcheck.c:646
#, c-format
msgid "no relations to check matching \"%s\""
msgstr "沒有符合 \"%s\" 的關聯需要檢查"

#: pg_amcheck.c:674
#, c-format
msgid "no relations to check"
msgstr "沒有關聯需要檢查"

#: pg_amcheck.c:758
#, c-format
msgid "checking heap table \"%s.%s.%s\""
msgstr "正在檢查堆積資料表 \"%s.%s.%s\""

#: pg_amcheck.c:774
#, c-format
msgid "checking btree index \"%s.%s.%s\""
msgstr "正在檢查 btree 索引 \"%s.%s.%s\""

#: pg_amcheck.c:921
#, c-format
msgid "error sending command to database \"%s\": %s"
msgstr "傳送命令至資料庫 \"%s\" 發生錯誤: %s"

#: pg_amcheck.c:924
#, c-format
msgid "command was: %s"
msgstr "命令為：%s"

#: pg_amcheck.c:1043
#, c-format
msgid "heap table \"%s.%s.%s\", block %s, offset %s, attribute %s:\n"
msgstr "堆積資料表 \"%s.%s.%s\", 區塊 %s, 位移編號 %s, 屬性 %s:\n"

#: pg_amcheck.c:1050
#, c-format
msgid "heap table \"%s.%s.%s\", block %s, offset %s:\n"
msgstr "堆積資料表 \"%s.%s.%s\", 區塊 %s, 位移編號 %s:\n"

#: pg_amcheck.c:1056
#, c-format
msgid "heap table \"%s.%s.%s\", block %s:\n"
msgstr "堆積資料表 \"%s.%s.%s\", 區塊 %s:\n"

#: pg_amcheck.c:1061 pg_amcheck.c:1072
#, c-format
msgid "heap table \"%s.%s.%s\":\n"
msgstr "堆積資料表 \"%s.%s.%s\":\n"

#: pg_amcheck.c:1076 pg_amcheck.c:1145
#, c-format
msgid "query was: %s\n"
msgstr "查詢是: %s\n"

#: pg_amcheck.c:1127
#, c-format
msgid "btree index \"%s.%s.%s\": btree checking function returned unexpected number of rows: %d"
msgstr "btree 索引 \"%s.%s.%s\": btree 檢查函式傳回非預期數量的資料列: %d"

#: pg_amcheck.c:1131
#, c-format
msgid "Are %s's and amcheck's versions compatible?"
msgstr "%s 和 amcheck 的版本是否相容？"

#: pg_amcheck.c:1141
#, c-format
msgid "btree index \"%s.%s.%s\":\n"
msgstr "btree 索引 \"%s.%s.%s\":\n"

#: pg_amcheck.c:1166
#, c-format
msgid ""
"%s checks objects in a PostgreSQL database for corruption.\n"
"\n"
msgstr "%s 檢查 PostgreSQL 資料庫中的物件是否損壞。\n\n"

#: pg_amcheck.c:1167
#, c-format
msgid "Usage:\n"
msgstr "用法:\n"

#: pg_amcheck.c:1168
#, c-format
msgid "  %s [OPTION]... [DBNAME]\n"
msgstr "  %s [選項]... [資料庫名稱]\n"

#: pg_amcheck.c:1169
#, c-format
msgid ""
"\n"
"Target options:\n"
msgstr "\n目標選項:\n"

#: pg_amcheck.c:1170
#, c-format
msgid "  -a, --all                       check all databases\n"
msgstr "  -a, --all                       檢查所有資料庫\n"

#: pg_amcheck.c:1171
#, c-format
msgid "  -d, --database=PATTERN          check matching database(s)\n"
msgstr "  -d, --database=PATTERN          檢查符合的資料庫\n"

#: pg_amcheck.c:1172
#, c-format
msgid "  -D, --exclude-database=PATTERN  do NOT check matching database(s)\n"
msgstr "  -D, --exclude-database=PATTERN  不檢查符合的資料庫\n"

#: pg_amcheck.c:1173
#, c-format
msgid "  -i, --index=PATTERN             check matching index(es)\n"
msgstr "  -i, --index=PATTERN             檢查符合的索引\n"

#: pg_amcheck.c:1174
#, c-format
msgid "  -I, --exclude-index=PATTERN     do NOT check matching index(es)\n"
msgstr "  -I, --exclude-index=PATTERN     不檢查符合的索引\n"

#: pg_amcheck.c:1175
#, c-format
msgid "  -r, --relation=PATTERN          check matching relation(s)\n"
msgstr "  -r, --relation=PATTERN          檢查符合的關聯\n"

#: pg_amcheck.c:1176
#, c-format
msgid "  -R, --exclude-relation=PATTERN  do NOT check matching relation(s)\n"
msgstr "  -R, --exclude-relation=PATTERN  不檢查符合的關聯\n"

#: pg_amcheck.c:1177
#, c-format
msgid "  -s, --schema=PATTERN            check matching schema(s)\n"
msgstr "  -s, --schema=PATTERN            檢查符合的 schema\n"

#: pg_amcheck.c:1178
#, c-format
msgid "  -S, --exclude-schema=PATTERN    do NOT check matching schema(s)\n"
msgstr "  -S, --exclude-schema=PATTERN    不檢查符合的 schema\n"

#: pg_amcheck.c:1179
#, c-format
msgid "  -t, --table=PATTERN             check matching table(s)\n"
msgstr "  -t, --table=PATTERN             檢查符合的資料表\n"

#: pg_amcheck.c:1180
#, c-format
msgid "  -T, --exclude-table=PATTERN     do NOT check matching table(s)\n"
msgstr "  -T, --exclude-table=PATTERN     不檢查符合的資料表\n"

#: pg_amcheck.c:1181
#, c-format
msgid "      --no-dependent-indexes      do NOT expand list of relations to include indexes\n"
msgstr "      --no-dependent-indexes      不展開關聯清單以包含索引\n"

#: pg_amcheck.c:1182
#, c-format
msgid "      --no-dependent-toast        do NOT expand list of relations to include TOAST tables\n"
msgstr "      --no-dependent-toast        不展開關聯清單以包含 TOAST 資料表\n"

#: pg_amcheck.c:1183
#, c-format
msgid "      --no-strict-names           do NOT require patterns to match objects\n"
msgstr "      --no-strict-names           不要求表達式必須符合物件\n"

#: pg_amcheck.c:1184
#, c-format
msgid ""
"\n"
"Table checking options:\n"
msgstr "\n資料表檢查選項:\n"

#: pg_amcheck.c:1185
#, c-format
msgid "      --exclude-toast-pointers    do NOT follow relation TOAST pointers\n"
msgstr "      --exclude-toast-pointers    不要追蹤關聯 TOAST 指標\n"

#: pg_amcheck.c:1186
#, c-format
msgid "      --on-error-stop             stop checking at end of first corrupt page\n"
msgstr "      --on-error-stop             在第一個損壞資料頁的結尾停止檢查\n"

#: pg_amcheck.c:1187
#, c-format
msgid "      --skip=OPTION               do NOT check \"all-frozen\" or \"all-visible\" blocks\n"
msgstr "      --skip=OPTION               不檢查 \"all-frozen\" 或 \"all-visible\" 區塊\n"

#: pg_amcheck.c:1188
#, c-format
msgid "      --startblock=BLOCK          begin checking table(s) at the given block number\n"
msgstr "      --startblock=BLOCK          從指定的區塊編號開始檢查資料表\n"

#: pg_amcheck.c:1189
#, c-format
msgid "      --endblock=BLOCK            check table(s) only up to the given block number\n"
msgstr "      --endblock=BLOCK            只檢查資料表直到指定的區塊編號為止\n"

#: pg_amcheck.c:1190
#, c-format
msgid ""
"\n"
"B-tree index checking options:\n"
msgstr "\nB-tree 索引檢查選項:\n"

#: pg_amcheck.c:1191
#, c-format
msgid "      --heapallindexed            check that all heap tuples are found within indexes\n"
msgstr "      --heapallindexed            檢查所有堆元組是否都在索引內找到\n"

#: pg_amcheck.c:1192
#, c-format
msgid "      --parent-check              check index parent/child relationships\n"
msgstr "      --parent-check              檢查索引的父子關聯\n"

#: pg_amcheck.c:1193
#, c-format
msgid "      --rootdescend               search from root page to refind tuples\n"
msgstr "      --rootdescend               從根資料頁搜索以重新尋找元組\n"

#: pg_amcheck.c:1194
#, c-format
msgid ""
"\n"
"Connection options:\n"
msgstr ""
"\n"
"連線選項:\n"

#: pg_amcheck.c:1195
#, c-format
msgid "  -h, --host=HOSTNAME             database server host or socket directory\n"
msgstr "  -h, --host=HOSTNAME             資料庫伺服器主機或 socket 目錄\n"

#: pg_amcheck.c:1196
#, c-format
msgid "  -p, --port=PORT                 database server port\n"
msgstr "  -p, --port=PORT                 資料庫伺服器連接埠\n"

#: pg_amcheck.c:1197
#, c-format
msgid "  -U, --username=USERNAME         user name to connect as\n"
msgstr "  -U, --username=USERNAME         用來連線的使用者名稱\n"

#: pg_amcheck.c:1198
#, c-format
msgid "  -w, --no-password               never prompt for password\n"
msgstr "  -w, --no-password               不詢問密碼\n"

#: pg_amcheck.c:1199
#, c-format
msgid "  -W, --password                  force password prompt\n"
msgstr "  -W, --password                  要求詢問密碼\n"

#: pg_amcheck.c:1200
#, c-format
msgid "      --maintenance-db=DBNAME     alternate maintenance database\n"
msgstr "      --maintenance-db=DBNAME     替代的維護資料庫\n"

#: pg_amcheck.c:1201
#, c-format
msgid ""
"\n"
"Other options:\n"
msgstr ""
"\n"
"其他選項:\n"

#: pg_amcheck.c:1202
#, c-format
msgid "  -e, --echo                      show the commands being sent to the server\n"
msgstr "  -e, --echo                      顯示被送到伺服器的命令\n"

#: pg_amcheck.c:1203
#, c-format
msgid "  -j, --jobs=NUM                  use this many concurrent connections to the server\n"
msgstr "  -j, --jobs=NUM                  用指定數量的並行連線連至伺服器\n"

#: pg_amcheck.c:1204
#, c-format
msgid "  -P, --progress                  show progress information\n"
msgstr "  -P, --progress                  顯示進度資訊\n"

#: pg_amcheck.c:1205
#, c-format
msgid "  -v, --verbose                   write a lot of output\n"
msgstr "  -v, --verbose                   產生詳細輸出\n"

#: pg_amcheck.c:1206
#, c-format
msgid "  -V, --version                   output version information, then exit\n"
msgstr "  -V, --version                   顯示版本，然後結束\n"

#: pg_amcheck.c:1207
#, c-format
msgid "      --install-missing           install missing extensions\n"
msgstr "      --install-missing           安裝缺少的擴充模組\n"

#: pg_amcheck.c:1208
#, c-format
msgid "  -?, --help                      show this help, then exit\n"
msgstr "  -?, --help                      顯示說明，然後結束\n"

#: pg_amcheck.c:1210
#, c-format
msgid ""
"\n"
"Report bugs to <%s>.\n"
msgstr "\n回報錯誤至 <%s>。\n"

#: pg_amcheck.c:1211
#, c-format
msgid "%s home page: <%s>\n"
msgstr "%s 首頁: <%s>\n"

#: pg_amcheck.c:1269
#, c-format
msgid "%*s/%s relations (%d%%), %*s/%s pages (%d%%) %*s"
msgstr "%*s/%s 關聯 (%d%%), %*s/%s 資料頁 (%d%%) %*s"

#: pg_amcheck.c:1280
#, c-format
msgid "%*s/%s relations (%d%%), %*s/%s pages (%d%%) (%s%-*.*s)"
msgstr "%*s/%s 關聯 (%d%%), %*s/%s 資料頁 (%d%%) (%s%-*.*s)"

#: pg_amcheck.c:1295
#, c-format
msgid "%*s/%s relations (%d%%), %*s/%s pages (%d%%)"
msgstr "%*s/%s 關聯 (%d%%), %*s/%s 資料頁 (%d%%)"

