msgstr "错误校验和:      %<PRId64>\n"

#: pg_checksums.c:628 pg_checksums.c:660
#, c-format
msgid "Data checksum version: %u\n"
msgstr "数据校验和版本:  %u\n"

#: pg_checksums.c:635
#, c-format
msgid "Files written:  %<PRId64>\n"
msgstr "已写入文件:      %<PRId64>\n"

#: pg_checksums.c:636
#, c-format
msgid "Blocks written: %<PRId64>\n"
msgstr "已写入块:        %<PRId64>\n"

#: pg_checksums.c:652
#, c-format
msgid "syncing data directory"
msgstr "正在同步数据目录"

#: pg_checksums.c:656
#, c-format
msgid "updating control file"
msgstr "正在更新控制文件"

#: pg_checksums.c:662
#, c-format
msgid "Checksums enabled in cluster\n"
msgstr "已在集簇中启用校验和\n"

#: pg_checksums.c:664
#, c-format
