#, c-format
msgid "PL/Python procedure \"%s\""
msgstr "PL/Python 程序 \"%s\""

#: plpy_main.c:371
#, c-format
msgid "PL/Python function \"%s\""
msgstr "PL/Python 函式 \"%s\""

#: plpy_main.c:379
#, c-format
msgid "PL/Python anonymous code block"
msgstr "PL/Python 匿名程式碼區塊"

#: plpy_plpymodule.c:159
#, c-format
msgid "could not create the spiexceptions module"
msgstr "無法建立 spiexceptions 模組"

#: plpy_plpymodule.c:171
#, c-format
msgid "could not add the spiexceptions module"
msgstr "無法新增 spiexceptions 模組"

#: plpy_plpymodule.c:201
#, c-format
msgid "could not add exception %s"
msgstr "無法新增例外 %s"

# access/transam/xlog.c:4111
#: plpy_plpymodule.c:228
#, c-format
msgid "could not generate SPI exceptions"
msgstr "無法產生 SPI 例外"

#: plpy_plpymodule.c:396
#, c-format
msgid "could not unpack arguments in plpy.elog"
msgstr "無法解包 plpy.elog 中的參數"

#: plpy_plpymodule.c:405
msgid "could not parse error message in plpy.elog"
msgstr "無法解析 plpy.elog 中的錯誤訊息"

#: plpy_plpymodule.c:422
#, c-format
