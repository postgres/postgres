msgstr "  \\lo_import FILE [COMMENT]\n"
"                         читати великий об'єкт з файлу\n"

#: help.c:283
msgid "  \\lo_list[x+]           list large objects\n"
msgstr "  \\lo_list[x+]           список великих об'єктів\n"

#: help.c:284
