"\n"

#: pg_dump.c:1267 pg_dumpall.c:700 pg_restore.c:536
#, c-format
msgid "Usage:\n"
msgstr "用法:\n"

#: pg_dump.c:1268
#, c-format
msgid "  %s [OPTION]... [DBNAME]\n"
msgstr "  %s [选项]... [数据库名]\n"

#: pg_dump.c:1270 pg_dumpall.c:703 pg_restore.c:539
#, c-format
msgid ""
"\n"
"General options:\n"
msgstr ""
"\n"
"一般选项:\n"

#: pg_dump.c:1271
#, c-format
msgid "  -f, --file=FILENAME          output file or directory name\n"
msgstr "  -f, --file=FILENAME          输出文件或目录名\n"

#: pg_dump.c:1272
#, c-format
msgid ""
"  -F, --format=c|d|t|p         output file format (custom, directory, tar,\n"
"                               plain text (default))\n"
msgstr ""
"  -F, --format=c|d|t|p         输出格式（自定义、目录、tar、纯文本（默"
"认））\n"

#: pg_dump.c:1274
#, c-format
msgid "  -j, --jobs=NUM               use this many parallel jobs to dump\n"
msgstr "  -j, --jobs=NUM               使用指定数量的并行任务进行转储\n"

#: pg_dump.c:1275 pg_dumpall.c:705
#, c-format
msgid "  -v, --verbose                verbose mode\n"
msgstr "  -v, --verbose                详细模式\n"

#: pg_dump.c:1276 pg_dumpall.c:706
#, c-format
msgid "  -V, --version                output version information, then exit\n"
msgstr "  -V, --version                输出版本信息，然后退出\n"

#: pg_dump.c:1277
#, c-format
msgid ""
"  -Z, --compress=METHOD[:DETAIL]\n"
"                               compress as specified\n"
msgstr ""
"  -Z, --compress=METHOD[:DETAIL]\n"
"                               按指定方式压缩\n"

#: pg_dump.c:1279 pg_dumpall.c:707
#, c-format
msgid ""
"  --lock-wait-timeout=TIMEOUT  fail after waiting TIMEOUT for a table lock\n"
msgstr "  --lock-wait-timeout=TIMEOUT  在等待表锁超时后操作失败\n"

#: pg_dump.c:1280 pg_dumpall.c:739
#, c-format
msgid ""
"  --no-sync                    do not wait for changes to be written safely "
"to disk\n"
msgstr "  --no-sync                    不等待变更安全写入磁盘\n"

#: pg_dump.c:1281
#, c-format
msgid "  --sync-method=METHOD         set method for syncing files to disk\n"
msgstr "  --sync-method=METHOD         设置将文件同步到磁盘的方法\n"

#: pg_dump.c:1282 pg_dumpall.c:708
#, c-format
msgid "  -?, --help                   show this help, then exit\n"
msgstr "  -?, --help                   显示此帮助，然后退出\n"

#: pg_dump.c:1284 pg_dumpall.c:709
#, c-format
msgid ""
"\n"
"Options controlling the output content:\n"
msgstr ""
"\n"
"控制输出内容的选项:\n"

#: pg_dump.c:1285 pg_dumpall.c:710
#, c-format
msgid ""
"  -a, --data-only              dump only the data, not the schema or "
"statistics\n"
msgstr "  -a, --data-only              仅转储数据，不转储模式定义或统计信息\n"

#: pg_dump.c:1286
#, c-format
msgid "  -b, --large-objects          include large objects in dump\n"
msgstr "  -b, --large-objects          在转储中包含大对象\n"

#: pg_dump.c:1287
#, c-format
msgid "  --blobs                      (same as --large-objects, deprecated)\n"
msgstr "  --blobs                      （与 --large-objects 相同，已弃用）\n"

#: pg_dump.c:1288
#, c-format
msgid "  -B, --no-large-objects       exclude large objects in dump\n"
msgstr "  -B, --no-large-objects       从转储中排除大对象\n"

#: pg_dump.c:1289
#, c-format
msgid ""
"  --no-blobs                   (same as --no-large-objects, deprecated)\n"
msgstr ""
"  --no-blobs                   （与 --no-large-objects 相同，已弃用）\n"

#: pg_dump.c:1290 pg_restore.c:550
#, c-format
msgid ""
"  -c, --clean                  clean (drop) database objects before "
"recreating\n"
msgstr ""
"  -c, --clean                  在重新创建之前，先清除（删除）数据库对象\n"

#: pg_dump.c:1291
#, c-format
msgid ""
"  -C, --create                 include commands to create database in dump\n"
msgstr "  -C, --create                 在转储中包含创建数据库的命令\n"

#: pg_dump.c:1292
#, c-format
msgid "  -e, --extension=PATTERN      dump the specified extension(s) only\n"
msgstr "  -e, --extension=PATTERN      仅转储指定的扩展\n"

#: pg_dump.c:1293 pg_dumpall.c:712
#, c-format
msgid "  -E, --encoding=ENCODING      dump the data in encoding ENCODING\n"
msgstr "  -E, --encoding=ENCODING      使用 ENCODING 编码转储数据\n"

#: pg_dump.c:1294
#, c-format
msgid "  -n, --schema=PATTERN         dump the specified schema(s) only\n"
msgstr "  -n, --schema=PATTERN         仅转储指定的模式\n"

#: pg_dump.c:1295
#, c-format
msgid "  -N, --exclude-schema=PATTERN do NOT dump the specified schema(s)\n"
msgstr "  -N, --exclude-schema=PATTERN 不转储指定的模式\n"

#: pg_dump.c:1296
#, c-format
msgid ""
"  -O, --no-owner               skip restoration of object ownership in\n"
"                               plain-text format\n"
msgstr ""
"  -O, --no-owner               使用纯文本格式时，跳过对象所有权的恢复\n"

#: pg_dump.c:1298 pg_dumpall.c:716
#, c-format
msgid ""
"  -s, --schema-only            dump only the schema, no data or statistics\n"
msgstr "  -s, --schema-only            仅转储模式定义，不转储数据或统计信息\n"

#: pg_dump.c:1299
#, c-format
msgid ""
"  -S, --superuser=NAME         superuser user name to use in plain-text "
"format\n"
msgstr "  -S, --superuser=NAME         纯文本格式中使用的超级用户名\n"

#: pg_dump.c:1300
#, c-format
msgid "  -t, --table=PATTERN          dump only the specified table(s)\n"
msgstr "  -t, --table=PATTERN          仅转储指定的表\n"

#: pg_dump.c:1301
#, c-format
msgid "  -T, --exclude-table=PATTERN  do NOT dump the specified table(s)\n"
msgstr "  -T, --exclude-table=PATTERN  不转储指定的表\n"

#: pg_dump.c:1302 pg_dumpall.c:719
#, c-format
msgid "  -x, --no-privileges          do not dump privileges (grant/revoke)\n"
msgstr "  -x, --no-privileges          不转储权限（grant/revoke）\n"

#: pg_dump.c:1303 pg_dumpall.c:720
#, c-format
msgid "  --binary-upgrade             for use by upgrade utilities only\n"
msgstr "  --binary-upgrade             只能由升级工具使用\n"

#: pg_dump.c:1304 pg_dumpall.c:721
#, c-format
msgid ""
"  --column-inserts             dump data as INSERT commands with column "
"names\n"
msgstr "  --column-inserts             以带有列名的 INSERT 命令形式转储数据\n"

#: pg_dump.c:1305 pg_dumpall.c:722
#, c-format
msgid ""
"  --disable-dollar-quoting     disable dollar quoting, use SQL standard "
"quoting\n"
msgstr "  --disable-dollar-quoting     禁用美元引号，使用 SQL 标准引号\n"

#: pg_dump.c:1306 pg_dumpall.c:723 pg_restore.c:567
#, c-format
msgid ""
"  --disable-triggers           disable triggers during data-only restore\n"
msgstr "  --disable-triggers           在只恢复数据的过程中禁用触发器\n"

#: pg_dump.c:1307
#, c-format
msgid ""
"  --enable-row-security        enable row security (dump only content user "
"has\n"
"                               access to)\n"
msgstr ""
"  --enable-row-security        启用行安全性（仅转储用户有权访问的内容）\n"

#: pg_dump.c:1309
#, c-format
msgid "  --exclude-extension=PATTERN  do NOT dump the specified extension(s)\n"
msgstr "  --exclude-extension=PATTERN  不转储指定的扩展\n"

#: pg_dump.c:1310
#, c-format
msgid ""
"  --exclude-table-and-children=PATTERN\n"
"                               do NOT dump the specified table(s), "
"including\n"
"                               child and partition tables\n"
msgstr ""
"  --exclude-table-and-children=PATTERN\n"
"                               不转储指定的表，包括其子表和分区表\n"

#: pg_dump.c:1313
#, c-format
msgid ""
"  --exclude-table-data=PATTERN do NOT dump data for the specified table(s)\n"
msgstr "  --exclude-table-data=PATTERN 不转储指定的表中的数据\n"

#: pg_dump.c:1314
#, c-format
msgid ""
"  --exclude-table-data-and-children=PATTERN\n"
"                               do NOT dump data for the specified table(s),\n"
"                               including child and partition tables\n"
msgstr ""
"  --exclude-table-data-and-children=PATTERN\n"
"                               不转储指定表的数据，\n"
"                               包括其子表和分区表的数据\n"

#: pg_dump.c:1317 pg_dumpall.c:725
#, c-format
msgid ""
"  --extra-float-digits=NUM     override default setting for "
"extra_float_digits\n"
msgstr "  --extra-float-digits=NUM     覆盖 extra_float_digits 的默认设置\n"

#: pg_dump.c:1318
#, c-format
msgid ""
"  --filter=FILENAME            include or exclude objects and data from "
"dump\n"
"                               based on expressions in FILENAME\n"
msgstr ""
"  --filter=FILENAME            根据 FILENAME 中的表达式，在转储中\n"
"                               包含或排除对象及数据\n"

#: pg_dump.c:1320 pg_dumpall.c:727 pg_restore.c:571
#, c-format
msgid "  --if-exists                  use IF EXISTS when dropping objects\n"
msgstr "  --if-exists                  当删除对象时使用 IF EXISTS\n"

#: pg_dump.c:1321
#, c-format
msgid ""
"  --include-foreign-data=PATTERN\n"
"                               include data of foreign tables on foreign\n"
"                               servers matching PATTERN\n"
msgstr ""
"  --include-foreign-data=PATTERN\n"
"                               包含名称与 PATTERN 匹配的外部服务器\n"
"                               上外部表的数据\n"

#: pg_dump.c:1324 pg_dumpall.c:728
#, c-format
msgid ""
"  --inserts                    dump data as INSERT commands, rather than "
"COPY\n"
msgstr ""
"  --inserts                    以 INSERT 命令，而不是 COPY 命令的形式转储数"
"据\n"

#: pg_dump.c:1325 pg_dumpall.c:729
#, c-format
msgid "  --load-via-partition-root    load partitions via the root table\n"
msgstr "  --load-via-partition-root    通过根表加载分区\n"

#: pg_dump.c:1326 pg_dumpall.c:730
#, c-format
msgid "  --no-comments                do not dump comment commands\n"
msgstr "  --no-comments                不转储注释命令\n"

#: pg_dump.c:1327 pg_dumpall.c:731
#, c-format
msgid "  --no-data                    do not dump data\n"
msgstr "  --no-data                    不转储数据\n"

#: pg_dump.c:1328 pg_dumpall.c:732
#, c-format
msgid "  --no-policies                do not dump row security policies\n"
msgstr "  --no-policies                不转储行安全策略\n"

#: pg_dump.c:1329 pg_dumpall.c:733
#, c-format
msgid "  --no-publications            do not dump publications\n"
msgstr "  --no-publications            不转储发布\n"

#: pg_dump.c:1330 pg_dumpall.c:735
#, c-format
msgid "  --no-schema                  do not dump schema\n"
msgstr "  --no-schema                  不转储模式定义\n"

#: pg_dump.c:1331 pg_dumpall.c:736
#, c-format
msgid "  --no-security-labels         do not dump security label assignments\n"
msgstr "  --no-security-labels         不转储安全标签的分配\n"

#: pg_dump.c:1332 pg_dumpall.c:737
#, c-format
msgid "  --no-statistics              do not dump statistics\n"
msgstr "  --no-statistics              不转储统计信息\n"

#: pg_dump.c:1333 pg_dumpall.c:738
#, c-format
msgid "  --no-subscriptions           do not dump subscriptions\n"
msgstr "  --no-subscriptions           不转储订阅\n"

#: pg_dump.c:1334 pg_dumpall.c:740
#, c-format
msgid "  --no-table-access-method     do not dump table access methods\n"
msgstr "  --no-table-access-method     不转储表访问方法\n"

#: pg_dump.c:1335 pg_dumpall.c:741
#, c-format
msgid "  --no-tablespaces             do not dump tablespace assignments\n"
msgstr "  --no-tablespaces             不转储表空间分配信息\n"

#: pg_dump.c:1336 pg_dumpall.c:742
#, c-format
msgid "  --no-toast-compression       do not dump TOAST compression methods\n"
msgstr "  --no-toast-compression       不转储 TOAST 压缩方法\n"

#: pg_dump.c:1337 pg_dumpall.c:743
#, c-format
msgid "  --no-unlogged-table-data     do not dump unlogged table data\n"
msgstr "  --no-unlogged-table-data     不转储不记录 WAL 的表的数据\n"

#: pg_dump.c:1338 pg_dumpall.c:744
#, c-format
msgid ""
"  --on-conflict-do-nothing     add ON CONFLICT DO NOTHING to INSERT "
"commands\n"
msgstr ""
"  --on-conflict-do-nothing     将 ON CONFLICT DO NOTHING 添加到 INSERT 命令\n"

#: pg_dump.c:1339 pg_dumpall.c:745
#, c-format
msgid ""
"  --quote-all-identifiers      quote all identifiers, even if not key words\n"
msgstr "  --quote-all-identifiers      为所有标识符加引号，即使不是关键字\n"

#: pg_dump.c:1340 pg_dumpall.c:746 pg_restore.c:584
#, c-format
msgid ""
"  --restrict-key=RESTRICT_KEY  use provided string as psql \\restrict key\n"
msgstr ""
"  --restrict-key=RESTRICT_KEY  使用指定字符串作为 psql \\restrict 密钥\n"

#: pg_dump.c:1341 pg_dumpall.c:747
#, c-format
msgid ""
"  --rows-per-insert=NROWS      number of rows per INSERT; implies --inserts\n"
msgstr ""
"  --rows-per-insert=NROWS      每条 INSERT 的行数；隐含启用 --inserts\n"

#: pg_dump.c:1342
#, c-format
msgid ""
"  --section=SECTION            dump named section (pre-data, data, or post-"
"data)\n"
msgstr ""
"  --section=SECTION            转储指定的节（pre-data, data 或 post-data）\n"

#: pg_dump.c:1343 pg_dumpall.c:748
#, c-format
msgid "  --sequence-data              include sequence data in dump\n"
msgstr "  --sequence-data              在转储中包含序列数据\n"

#: pg_dump.c:1344
#, c-format
msgid ""
"  --serializable-deferrable    wait until the dump can run without "
"anomalies\n"
msgstr "  --serializable-deferrable    等待转储能够在无并发异常的情况下运行\n"

#: pg_dump.c:1345
#, c-format
msgid "  --snapshot=SNAPSHOT          use given snapshot for the dump\n"
msgstr "  --snapshot=SNAPSHOT          为转储使用给定的快照\n"

#: pg_dump.c:1346 pg_dumpall.c:749
#, c-format
msgid "  --statistics                 dump the statistics\n"
msgstr "  --statistics                 转储统计信息\n"

#: pg_dump.c:1347 pg_dumpall.c:750
#, c-format
msgid ""
"  --statistics-only            dump only the statistics, not schema or data\n"
msgstr "  --statistics-only            仅转储统计信息，不转储模式定义或数据\n"

#: pg_dump.c:1348 pg_restore.c:588
#, c-format
msgid ""
"  --strict-names               require table and/or schema include patterns "
"to\n"
"                               match at least one entity each\n"
msgstr ""
"  --strict-names               需要用于包含表或模式的每个匹配表达式\n"
"                               都至少匹配一个对象\n"

#: pg_dump.c:1350
#, c-format
msgid ""
