#, c-format
msgid "could not verify server signature: %s"
msgstr "non è stato possibile verificare la firma del server: %s"

#: fe-auth-scram.c:283
#, c-format
msgid "incorrect server signature"
msgstr "firma del server non corretta"

#: fe-auth-scram.c:292
#, c-format
msgid "invalid SCRAM exchange state"
msgstr "stato di scambio SCRAM non valido"

#: fe-auth-scram.c:316
#, c-format
