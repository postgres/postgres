#: plpy_exec.c:77
#, c-format
msgid "unsupported set function return mode"
msgstr "不支援傳回集合的函式的傳回模式"

#: plpy_exec.c:78
#, c-format
msgid "PL/Python set-returning functions only support returning one value per call."
msgstr "PL/Python 傳回集合的函式僅支援每次呼叫傳回一個值。"

#: plpy_exec.c:142
#, c-format
msgid "returned object cannot be iterated"
msgstr "不能迭代傳回的物件"

#: plpy_exec.c:143
#, c-format
msgid "PL/Python set-returning functions must return an iterable object."
msgstr "PL/Python 傳回集合的函式必須傳回可迭代的物件。"

#: plpy_exec.c:157
#, c-format
msgid "error fetching next item from iterator"
msgstr "從迭代器取得下一個項目時發生錯誤"

#: plpy_exec.c:200
#, c-format
msgid "PL/Python procedure did not return None"
msgstr "PL/Python 程序未傳回 None"

#: plpy_exec.c:204
#, c-format
msgid "PL/Python function with return type \"void\" did not return None"
msgstr "PL/Python 函式的傳回型別為 \"void\" 但未傳回 None"

#: plpy_exec.c:235
#, c-format
msgid "function returning record called in context that cannot accept type record"
msgstr "在不能接受 record 型別的上下文中呼叫傳回 record 的函式"

#: plpy_exec.c:460 plpy_exec.c:484
#, c-format
msgid "unexpected return value from trigger procedure"
msgstr "觸發器函式傳回非預期的值"

#: plpy_exec.c:461
#, c-format
msgid "Expected None or a string."
msgstr "預期 None 或字串。"

#: plpy_exec.c:474
#, c-format
msgid "PL/Python trigger function returned \"MODIFY\" in a DELETE trigger -- ignored"
msgstr "PL/Python 觸發器函式在 DELETE 觸發器中傳回 \"MODIFY\" -- 已忽略"

#: plpy_exec.c:485
#, c-format
msgid "Expected None, \"OK\", \"SKIP\", or \"MODIFY\"."
msgstr "預期 None, \"OK\", \"SKIP\" 或 \"MODIFY\"。"

#: plpy_exec.c:577
#, c-format
msgid "PyList_SetItem() failed, while setting up arguments"
msgstr "設定參數時 PyList_SetItem() 失敗"

#: plpy_exec.c:581
#, c-format
msgid "PyDict_SetItemString() failed, while setting up arguments"
msgstr "設定參數時 PyDict_SetItemString() 失敗"

#: plpy_exec.c:791
#, c-format
msgid "while creating return value"
msgstr "在建立傳回值時"

#: plpy_exec.c:1042
#, c-format
msgid "TD[\"new\"] deleted, cannot modify row"
msgstr "TD[\"new\"] 已刪除，不能修改資料列"

#: plpy_exec.c:1047
#, c-format
msgid "TD[\"new\"] is not a dictionary"
msgstr "TD[\"new\"] 不是字典"

#: plpy_exec.c:1072
#, c-format
msgid "TD[\"new\"] dictionary key at ordinal position %d is not a string"
msgstr "位於順序位置 %d 的 TD[\"new\"] 字典鍵不是字串"

#: plpy_exec.c:1079
#, c-format
msgid "key \"%s\" found in TD[\"new\"] does not exist as a column in the triggering row"
msgstr "TD[\"new\"] 中的鍵 \"%s\" 不在觸發資料列的欄位中"

# commands/tablecmds.c:5425
#: plpy_exec.c:1084
#, c-format
msgid "cannot set system attribute \"%s\""
msgstr "不能設定系統屬性 \"%s\""

# commands/tablecmds.c:4580
#: plpy_exec.c:1089
#, c-format
msgid "cannot set generated column \"%s\""
msgstr "不能設定產生欄位 \"%s\""

#: plpy_exec.c:1147
#, c-format
msgid "while modifying trigger row"
msgstr "在修改觸發資料列時"

#: plpy_exec.c:1199
#, c-format
msgid "forcibly aborting a subtransaction that has not been exited"
msgstr "正在強制中止尚未結束的子交易"

