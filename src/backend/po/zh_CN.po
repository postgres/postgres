#, c-format
msgid "%s \"%s\" is ambiguous"
msgstr "%s \"%s\" 存在歧义"

#. translator: %s is name of a SQL construct, eg ORDER BY
#: parser/parse_clause.c:2127
#, c-format
msgid "non-integer constant in %s"
msgstr "%s 中存在非整数常量"

#. translator: %s is name of a SQL construct, eg ORDER BY
#: parser/parse_clause.c:2149
#, c-format
msgid "%s position %d is not in select list"
msgstr "%s 的列序号 %d 不在选择列表中"

#: parser/parse_clause.c:2588
#, c-format
msgid "CUBE is limited to 12 elements"
msgstr "CUBE 最多允许 12 个元素"

#: parser/parse_clause.c:2794
#, c-format
msgid "window \"%s\" is already defined"
msgstr "窗口 \"%s\" 已定义"

