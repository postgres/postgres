#: main/main.c:391
#, c-format
msgid ""
"Usage:\n"
"  %s [OPTION]...\n"
"\n"
msgstr ""
"Utilizzo:\n"
"  %s [OPZIONE]...\n"
"\n"

#: main/main.c:392
#, c-format
msgid "Options:\n"
msgstr "Opzioni:\n"

#: main/main.c:393
#, c-format
msgid "  -B NBUFFERS        number of shared buffers\n"
msgstr "  -B NBUFFER          numero di buffer condivisi\n"

#: main/main.c:394
#, c-format
msgid "  -c NAME=VALUE      set run-time parameter\n"
msgstr "  -c NOME=VALORE      imposta un parametro a runtime\n"

#: main/main.c:395
#, c-format
msgid "  -C NAME            print value of run-time parameter, then exit\n"
msgstr "  -C NOME             stampa il valore del parametro a runtime, poi esce\n"

#: main/main.c:396
#, c-format
msgid "  -d 1-5             debugging level\n"
msgstr "  -d 1-5              livello di debug\n"

#: main/main.c:397
#, c-format
msgid "  -D DATADIR         database directory\n"
msgstr "  -D DATADIR          directory del database\n"

#: main/main.c:398
#, c-format
msgid "  -e                 use European date input format (DMY)\n"
msgstr "  -e                  usa il formato europeo di input data (DMY)\n"

#: main/main.c:399
#, c-format
msgid "  -F                 turn fsync off\n"
msgstr "  -F                  disattiva fsync\n"

#: main/main.c:400
#, c-format
msgid "  -h HOSTNAME        host name or IP address to listen on\n"
msgstr "  -h HOSTNAME         nome host o indirizzo IP su cui restare in ascolto\n"

#: main/main.c:401
#, c-format
msgid "  -i                 enable TCP/IP connections (deprecated)\n"
msgstr "  -i                  abilita le connessioni TCP/IP (deprecato)\n"

#: main/main.c:402
#, c-format
msgid "  -k DIRECTORY       Unix-domain socket location\n"
msgstr "  -k DIRECTORY        posizione del socket di dominio Unix\n"

#: main/main.c:404
#, c-format
msgid "  -l                 enable SSL connections\n"
msgstr "  -l                  abilita le connessioni SSL\n"

#: main/main.c:406
#, c-format
msgid "  -N MAX-CONNECT     maximum number of allowed connections\n"
msgstr "  -N MAX-CONNECT      numero massimo di connessioni consentite\n"

#: main/main.c:407
#, c-format
msgid "  -p PORT            port number to listen on\n"
msgstr "  -p PORTA            numero di porta su cui restare in ascolto\n"

#: main/main.c:408
#, c-format
msgid "  -s                 show statistics after each query\n"
msgstr "  -s                  mostra le statistiche dopo ogni query\n"

#: main/main.c:409
#, c-format
msgid "  -S WORK-MEM        set amount of memory for sorts (in kB)\n"
msgstr "  -S WORK-MEM         imposta la quantità di memoria per gli ordinamenti (in kB)\n"

#: main/main.c:410
#, c-format
msgid "  -V, --version      output version information, then exit\n"
msgstr "  -V, --version       mostra informazioni sulla versione, poi esce\n"

#: main/main.c:411
#, c-format
msgid "  --NAME=VALUE       set run-time parameter\n"
msgstr "  --NOME=VALORE       imposta un parametro a runtime\n"

#: main/main.c:412
#, c-format
msgid "  --describe-config  describe configuration parameters, then exit\n"
msgstr "  --describe-config   descrive i parametri di configurazione, poi esce\n"

#: main/main.c:413
#, c-format
msgid "  -?, --help         show this help, then exit\n"
msgstr "  -?, --help          mostra questo aiuto, poi esce\n"

#: main/main.c:415
#, c-format
msgid ""
"\n"
"Developer options:\n"
msgstr ""
"\n"
"Opzioni per sviluppatori:\n"

#: main/main.c:416
#, c-format
msgid "  -f s|i|o|b|t|n|m|h forbid use of some plan types\n"
msgstr "  -f s|i|o|b|t|n|m|h  vieta l'uso di alcuni tipi di piano\n"

#: main/main.c:417
#, c-format
msgid "  -O                 allow system table structure changes\n"
msgstr "  -O                  consente modifiche alla struttura delle tabelle di sistema\n"

#: main/main.c:418
#, c-format
msgid "  -P                 disable system indexes\n"
msgstr "  -P                  disabilita gli indici di sistema\n"

#: main/main.c:419
#, c-format
msgid "  -t pa|pl|ex        show timings after each query\n"
msgstr "  -t pa|pl|ex         mostra le tempistiche dopo ogni query\n"

#: main/main.c:420
#, c-format
msgid "  -T                 send SIGABRT to all backend processes if one dies\n"
msgstr "  -T                  invia SIGABRT a tutti i processi backend se uno muore\n"

#: main/main.c:421
#, c-format
msgid "  -W NUM             wait NUM seconds to allow attach from a debugger\n"
msgstr "  -W NUM              attende NUM secondi per consentire il collegamento di un debugger\n"

#: main/main.c:423
#, c-format
msgid ""
"\n"
"Options for single-user mode:\n"
msgstr ""
"\n"
"Opzioni per la modalità a utente singolo:\n"

#: main/main.c:424
#, c-format
msgid "  --single           selects single-user mode (must be first argument)\n"
msgstr "  --single            seleziona la modalità a utente singolo (deve essere il primo argomento)\n"

#: main/main.c:425
#, c-format
msgid "  DBNAME             database name (defaults to user name)\n"
msgstr "  NOMEDB              nome del database (predefinito al nome utente)\n"

#: main/main.c:426
#, c-format
msgid "  -d 0-5             override debugging level\n"
msgstr "  -d 0-5              sovrascrive il livello di debug\n"

#: main/main.c:427
#, c-format
msgid "  -E                 echo statement before execution\n"
msgstr "  -E                  visualizza l'istruzione prima dell'esecuzione\n"

#: main/main.c:428
#, c-format
msgid "  -j                 do not use newline as interactive query delimiter\n"
msgstr "  -j                  non usa l'a-capo come delimitatore di query interattiva\n"

#: main/main.c:429 main/main.c:435
#, c-format
msgid "  -r FILENAME        send stdout and stderr to given file\n"
msgstr "  -r NOMEFILE         invia stdout e stderr al file specificato\n"

#: main/main.c:431
#, c-format
msgid ""
"\n"
"Options for bootstrapping mode:\n"
msgstr ""
"\n"
"Opzioni per la modalità di bootstrap:\n"

#: main/main.c:432
#, c-format
msgid "  --boot             selects bootstrapping mode (must be first argument)\n"
msgstr "  --boot              seleziona la modalità di bootstrap (deve essere il primo argomento)\n"

#: main/main.c:433
#, c-format
msgid "  --check            selects check mode (must be first argument)\n"
msgstr "  --check             seleziona la modalità di verifica (deve essere il primo argomento)\n"

#: main/main.c:434
#, c-format
msgid "  DBNAME             database name (mandatory argument in bootstrapping mode)\n"
msgstr "  NOMEDB              nome del database (argomento obbligatorio in modalità bootstrap)\n"

#: main/main.c:437
#, c-format
msgid ""
"\n"
"Please read the documentation for the complete list of run-time\n"
"configuration settings and how to set them on the command line or in\n"
"the configuration file.\n"
"\n"
"Report bugs to <%s>.\n"
msgstr ""
"\n"
"Leggi la documentazione per l'elenco completo delle impostazioni di\n"
"configurazione a runtime e come impostarle sulla riga di comando o nel\n"
"file di configurazione.\n"
"\n"
"Segnala i bug a <%s>.\n"

#: main/main.c:441
#, c-format
msgid "%s home page: <%s>\n"
msgstr "Pagina iniziale di %s: <%s>\n"

#: main/main.c:452
#, c-format
msgid ""
"\"root\" execution of the PostgreSQL server is not permitted.\n"
"The server must be started under an unprivileged user ID to prevent\n"
"possible system security compromise.  See the documentation for\n"
"more information on how to properly start the server.\n"
msgstr ""
"L'esecuzione del server PostgreSQL come \"root\" non è consentita.\n"
"Il server deve essere avviato con un ID utente non privilegiato per prevenire\n"
"possibili compromissioni della sicurezza del sistema. Consulta la documentazione\n"
"per maggiori informazioni su come avviare correttamente il server.\n"

#: main/main.c:469
#, c-format
msgid "%s: real and effective user IDs must match\n"
msgstr "%s: gli ID utente reale ed effettivo devono corrispondere\n"

#: main/main.c:476
#, c-format
msgid ""
"Execution of PostgreSQL by a user with administrative permissions is not\n"
"permitted.\n"
"The server must be started under an unprivileged user ID to prevent\n"
"possible system security compromises.  See the documentation for\n"
"more information on how to properly start the server.\n"
msgstr ""
"L'esecuzione di PostgreSQL da parte di un utente con permessi amministrativi non\n"
"è consentita.\n"
"Il server deve essere avviato con un ID utente non privilegiato per prevenire\n"
"possibili compromissioni della sicurezza del sistema. Consulta la documentazione\n"
"per maggiori informazioni su come avviare correttamente il server.\n"

