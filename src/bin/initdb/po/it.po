msgstr "lettura della password dal file \"%s\" non riuscita: %m"

#: initdb.c:1724
#, c-format
msgid "password file \"%s\" is empty"
msgstr "il file della password \"%s\" è vuoto"

#: initdb.c:2136
#, c-format
