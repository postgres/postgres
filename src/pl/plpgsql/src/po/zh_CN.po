#: pl_comp.c:438 pl_handler.c:496
#, c-format
msgid "PL/pgSQL functions cannot accept type %s"
msgstr "PL/pgSQL 函数不能接受类型为 %s 的参数"

#: pl_comp.c:530
#, c-format
msgid "could not determine actual return type for polymorphic function \"%s\""
msgstr "无法确定多态函数 \"%s\" 的实际返回类型"

#: pl_comp.c:560
#, c-format
msgid "trigger functions can only be called as triggers"
msgstr "触发器函数只能以触发器的形式调用"

#: pl_comp.c:564 pl_handler.c:480
#, c-format
msgid "PL/pgSQL functions cannot return type %s"
msgstr "PL/pgSQL 函数不能返回类型 %s"

#: pl_comp.c:604
#, c-format
msgid "trigger functions cannot have declared arguments"
msgstr "触发器函数不能声明参数"

#: pl_comp.c:605
#, c-format
msgid ""
"The arguments of the trigger can be accessed through TG_NARGS and TG_ARGV "
"instead."
msgstr "触发器的参数可以通过 TG_NARGS 和 TG_ARGV 进行访问。"

#: pl_comp.c:738
#, c-format
msgid "event trigger functions cannot have declared arguments"
msgstr "事件触发器函数不能声明参数"

#: pl_comp.c:1002
#, c-format
msgid "compilation of PL/pgSQL function \"%s\" near line %d"
msgstr "编译 PL/pgSQL 函数 \"%s\" 时（第 %d 行附近）"

#: pl_comp.c:1025
#, c-format
msgid "parameter name \"%s\" used more than once"
msgstr "多次使用参数名 \"%s\""

#: pl_comp.c:1139
#, c-format
msgid "column reference \"%s\" is ambiguous"
msgstr "列引用 \"%s\" 存在歧义"

#: pl_comp.c:1141
#, c-format
msgid "It could refer to either a PL/pgSQL variable or a table column."
msgstr "它既可能引用 PL/pgSQL 变量，也可能引用表中的列。"

#: pl_comp.c:1324 pl_exec.c:5238 pl_exec.c:5411 pl_exec.c:5498 pl_exec.c:5589
#: pl_exec.c:6621
#, c-format
msgid "record \"%s\" has no field \"%s\""
msgstr "记录 \"%s\" 没有字段 \"%s\""

#: pl_comp.c:1818
#, c-format
msgid "relation \"%s\" does not exist"
msgstr "关系 \"%s\" 不存在"

#: pl_comp.c:1825 pl_comp.c:1867
#, c-format
msgid "relation \"%s\" does not have a composite type"
msgstr "关系 \"%s\" 没有复合类型"

#: pl_comp.c:1933
#, c-format
msgid "variable \"%s\" has pseudo-type %s"
msgstr "变量 \"%s\" 具有伪类型 %s"

#: pl_comp.c:2122
#, c-format
msgid "type \"%s\" is only a shell"
msgstr "类型 \"%s\" 只是 shell 类型"

#: pl_comp.c:2204 pl_exec.c:6922
#, c-format
msgid "type %s is not composite"
msgstr "类型 %s 不是复合类型"

#: pl_comp.c:2252 pl_comp.c:2305
#, c-format
msgid "unrecognized exception condition \"%s\""
msgstr "无法识别的异常条件 \"%s\""

#: pl_comp.c:2500
#, c-format
msgid "cannot pass more than %d argument to a function"
msgid_plural "cannot pass more than %d arguments to a function"
msgstr[0] "不能向函数传递超过 %d 个参数"

#: pl_comp.c:2548
#, c-format
msgid ""
"could not determine actual argument type for polymorphic function \"%s\""
msgstr "无法确定多态函数 \"%s\" 的实际参数类型"

#: pl_exec.c:512 pl_exec.c:951 pl_exec.c:1186
msgid "during initialization of execution state"
msgstr "在执行状态的初始化期间"

#: pl_exec.c:518
msgid "while storing call arguments into local variables"
msgstr "将调用参数存入局部变量时"

#: pl_exec.c:606 pl_exec.c:1024
msgid "during function entry"
msgstr "在进入函数期间"

#: pl_exec.c:629
#, c-format
msgid "control reached end of function without RETURN"
msgstr "控制流程到达函数末尾，但未执行 RETURN"

#: pl_exec.c:635
msgid "while casting return value to function's return type"
msgstr "将返回值转换为函数的返回类型时"

#: pl_exec.c:647 pl_exec.c:3663
#, c-format
msgid "set-valued function called in context that cannot accept a set"
msgstr "在不能接受集合的上下文中调用返回集合的函数"

#: pl_exec.c:652 pl_exec.c:3669
#, c-format
msgid "materialize mode required, but it is not allowed in this context"
msgstr "需要物化模式，但此上下文不允许使用该模式"

#: pl_exec.c:779 pl_exec.c:1050 pl_exec.c:1208
msgid "during function exit"
msgstr "在函数退出期间"

#: pl_exec.c:834 pl_exec.c:898 pl_exec.c:3462
msgid "returned record type does not match expected record type"
msgstr "所返回的记录类型与预期的记录类型不匹配"

#: pl_exec.c:1047 pl_exec.c:1205
#, c-format
msgid "control reached end of trigger procedure without RETURN"
msgstr "控制流程到达触发器函数末尾，但未执行 RETURN"

#: pl_exec.c:1055
#, c-format
msgid "trigger procedure cannot return a set"
msgstr "触发器函数不能返回集合"

#: pl_exec.c:1094 pl_exec.c:1122
msgid ""
"returned row structure does not match the structure of the triggering table"
msgstr "返回的行结构与触发器所在表的结构不匹配"

#. translator: last %s is a phrase such as "during statement block
#. local variable initialization"
#.
#: pl_exec.c:1263
#, c-format
msgid "PL/pgSQL function %s line %d %s"
msgstr "PL/pgSQL 函数 %s 第 %d 行 %s"

#. translator: last %s is a phrase such as "while storing call
#. arguments into local variables"
#.
#: pl_exec.c:1274
#, c-format
msgid "PL/pgSQL function %s %s"
msgstr "PL/pgSQL 函数 %s %s"

#. translator: last %s is a plpgsql statement type name
#: pl_exec.c:1282
#, c-format
msgid "PL/pgSQL function %s line %d at %s"
msgstr "PL/pgSQL 函数 %s 第 %d 行的 %s 处"

#: pl_exec.c:1288
#, c-format
msgid "PL/pgSQL function %s"
msgstr "PL/pgSQL 函数 %s"

#: pl_exec.c:1659
msgid "during statement block local variable initialization"
msgstr "在初始化语句块的局部变量期间"

#: pl_exec.c:1764
msgid "during statement block entry"
msgstr "在进入语句块期间"

#: pl_exec.c:1796
msgid "during statement block exit"
msgstr "在退出语句块期间"

#: pl_exec.c:1834
msgid "during exception cleanup"
msgstr "在清理异常期间"

#: pl_exec.c:2370
#, c-format
msgid ""
"procedure parameter \"%s\" is an output parameter but corresponding argument "
"is not writable"
msgstr "过程参数 \"%s\" 是输出参数，但对应的实参不可写"

#: pl_exec.c:2375
#, c-format
msgid ""
"procedure parameter %d is an output parameter but corresponding argument is "
"not writable"
msgstr "过程参数 %d 是输出参数，但对应的实参不可写"

#: pl_exec.c:2411
#, c-format
msgid "GET STACKED DIAGNOSTICS cannot be used outside an exception handler"
msgstr "GET STACKED DIAGNOSTICS 不能用于异常处理器之外"

#: pl_exec.c:2611
#, c-format
msgid "case not found"
msgstr "未找到匹配的 CASE 分支"

#: pl_exec.c:2612
#, c-format
msgid "CASE statement is missing ELSE part."
msgstr "CASE 语句缺少 ELSE 分支。"

#: pl_exec.c:2705
#, c-format
msgid "lower bound of FOR loop cannot be null"
msgstr "FOR 循环的下界不能为 NULL"

#: pl_exec.c:2721
#, c-format
msgid "upper bound of FOR loop cannot be null"
msgstr "FOR 循环的上界不能为 NULL"

#: pl_exec.c:2739
#, c-format
msgid "BY value of FOR loop cannot be null"
msgstr "FOR 循环的 BY 值不能为 NULL"

#: pl_exec.c:2745
#, c-format
msgid "BY value of FOR loop must be greater than zero"
msgstr "FOR 循环的 BY 值必须大于零"

#: pl_exec.c:2879 pl_exec.c:4671
#, c-format
msgid "cursor \"%s\" already in use"
msgstr "游标 \"%s\" 已在使用"

#: pl_exec.c:2902 pl_exec.c:4741
#, c-format
msgid "arguments given for cursor without arguments"
msgstr "向不带参数的游标传递了参数"

#: pl_exec.c:2921 pl_exec.c:4760
#, c-format
msgid "arguments required for cursor"
msgstr "游标需要参数"

#: pl_exec.c:3012
#, c-format
msgid "FOREACH expression must not be null"
msgstr "FOREACH 表达式不能为 NULL"

#: pl_exec.c:3027
#, c-format
msgid "FOREACH expression must yield an array, not type %s"
msgstr "FOREACH 表达式的结果必须是数组，而不是类型 %s"

#: pl_exec.c:3044
#, c-format
msgid "slice dimension (%d) is out of the valid range 0..%d"
msgstr "切片维数（%d）超出有效范围 0..%d"

#: pl_exec.c:3071
#, c-format
msgid "FOREACH ... SLICE loop variable must be of an array type"
msgstr "FOREACH ... SLICE 循环变量必须属于数组类型"

#: pl_exec.c:3075
#, c-format
msgid "FOREACH loop variable must not be of an array type"
msgstr "FOREACH 循环变量不能为数组类型"

#: pl_exec.c:3237 pl_exec.c:3280 pl_exec.c:3455
#, c-format
msgid ""
"cannot return non-composite value from function returning composite type"
msgstr "返回复合类型的函数不能返回非复合类型的值"

#: pl_exec.c:3319 pl_gram.y:3374
#, c-format
msgid "cannot use RETURN NEXT in a non-SETOF function"
msgstr "不能在非 SETOF 函数中使用 RETURN NEXT"

#: pl_exec.c:3360 pl_exec.c:3492
#, c-format
msgid "wrong result type supplied in RETURN NEXT"
msgstr "在 RETURN NEXT 中提供的结果类型错误"

#: pl_exec.c:3398 pl_exec.c:3419
#, c-format
msgid "wrong record type supplied in RETURN NEXT"
msgstr "在 RETURN NEXT 中提供的记录类型错误"

#: pl_exec.c:3511
#, c-format
msgid "RETURN NEXT must have a parameter"
msgstr "RETURN NEXT 必须有参数"

#: pl_exec.c:3539 pl_gram.y:3438
#, c-format
msgid "cannot use RETURN QUERY in a non-SETOF function"
msgstr "不能在非 SETOF 函数中使用 RETURN QUERY"

#: pl_exec.c:3557
msgid "structure of query does not match function result type"
msgstr "查询结果的结构与函数的返回类型不匹配"

#: pl_exec.c:3612 pl_exec.c:4448 pl_exec.c:8754
#, c-format
msgid "query string argument of EXECUTE is null"
msgstr "EXECUTE 的查询字符串参数为 NULL"

#: pl_exec.c:3697 pl_exec.c:3835
#, c-format
msgid "RAISE option already specified: %s"
msgstr "已指定 RAISE 选项: %s"

#: pl_exec.c:3731
#, c-format
msgid "RAISE without parameters cannot be used outside an exception handler"
msgstr "不带参数的 RAISE 不能用于异常处理器之外"

#: pl_exec.c:3825
#, c-format
msgid "RAISE statement option cannot be null"
msgstr "RAISE 语句选项不能为 NULL"

#: pl_exec.c:3895
#, c-format
msgid "%s"
msgstr "%s"

#: pl_exec.c:3950
#, c-format
msgid "assertion failed"
msgstr "断言失败"

#: pl_exec.c:4321 pl_exec.c:4510
#, c-format
msgid "cannot COPY to/from client in PL/pgSQL"
msgstr "不能在 PL/pgSQL 中从客户端或向客户端使用 COPY 命令"

#: pl_exec.c:4327
#, c-format
msgid "unsupported transaction command in PL/pgSQL"
msgstr "PL/pgSQL 中不支持的事务命令"

#: pl_exec.c:4350 pl_exec.c:4539
#, c-format
msgid "INTO used with a command that cannot return data"
msgstr "INTO 不能用于不返回数据的命令"

#: pl_exec.c:4373 pl_exec.c:4562
#, c-format
msgid "query returned no rows"
msgstr "查询未返回任何行"

#: pl_exec.c:4395 pl_exec.c:4581 pl_exec.c:5733
#, c-format
msgid "query returned more than one row"
msgstr "查询返回超过一行"

#: pl_exec.c:4397
#, c-format
msgid "Make sure the query returns a single row, or use LIMIT 1."
msgstr "确保查询返回一行，或使用 LIMIT 1。"

#: pl_exec.c:4413
#, c-format
msgid "query has no destination for result data"
msgstr "查询结果数据没有接收目标"

#: pl_exec.c:4414
#, c-format
msgid "If you want to discard the results of a SELECT, use PERFORM instead."
msgstr "如果要丢弃 SELECT 语句的结果，改用 PERFORM。"

#: pl_exec.c:4502
#, c-format
msgid "EXECUTE of SELECT ... INTO is not implemented"
msgstr "尚未实现通过 EXECUTE 执行 SELECT ... INTO"

#: pl_exec.c:4503
#, c-format
msgid ""
"You might want to use EXECUTE ... INTO or EXECUTE CREATE TABLE ... AS "
"instead."
msgstr "可以考虑改用 EXECUTE ... INTO 或 EXECUTE CREATE TABLE ... AS。"

#: pl_exec.c:4516
#, c-format
msgid "EXECUTE of transaction commands is not implemented"
msgstr "尚未实现通过 EXECUTE 执行事务命令"

#: pl_exec.c:4826 pl_exec.c:4914
#, c-format
msgid "cursor variable \"%s\" is null"
msgstr "游标变量 \"%s\" 为 NULL"

#: pl_exec.c:4837 pl_exec.c:4925
#, c-format
msgid "cursor \"%s\" does not exist"
msgstr "游标 \"%s\" 不存在"

#: pl_exec.c:4850
#, c-format
msgid "relative or absolute cursor position is null"
msgstr "游标的相对或绝对位置为 NULL"

#: pl_exec.c:5088 pl_exec.c:5183
#, c-format
msgid "null value cannot be assigned to variable \"%s\" declared NOT NULL"
msgstr "不能向声明为 NOT NULL 的变量 \"%s\" 赋 NULL 值"

#: pl_exec.c:5164
#, c-format
msgid "cannot assign non-composite value to a row variable"
msgstr "不能向行变量赋非复合类型的值"

#: pl_exec.c:5196
#, c-format
msgid "cannot assign non-composite value to a record variable"
msgstr "不能向 record 变量赋非复合类型的值"

#: pl_exec.c:5247
#, c-format
msgid "cannot assign to system column \"%s\""
msgstr "不能向系统列 \"%s\" 赋值"

#: pl_exec.c:5696
#, c-format
msgid "query did not return data"
msgstr "查询未返回数据"

#: pl_exec.c:5697 pl_exec.c:5709 pl_exec.c:5734 pl_exec.c:5814 pl_exec.c:5819
#, c-format
msgid "query: %s"
msgstr "查询: %s"

#: pl_exec.c:5705
#, c-format
msgid "query returned %d column"
msgid_plural "query returned %d columns"
msgstr[0] "查询返回 %d 列"

#: pl_exec.c:5813
#, c-format
msgid "query is SELECT INTO, but it should be plain SELECT"
msgstr "查询是 SELECT INTO，但应为普通 SELECT"

#: pl_exec.c:5818
#, c-format
msgid "query is not a SELECT"
msgstr "查询不是 SELECT"

#: pl_exec.c:6635 pl_exec.c:6675 pl_exec.c:6715
#, c-format
msgid ""
"type of parameter %d (%s) does not match that when preparing the plan (%s)"
msgstr "参数 %d 的类型（%s）与准备计划时的类型（%s）不匹配"

#: pl_exec.c:7126 pl_exec.c:7160 pl_exec.c:7234 pl_exec.c:7260
#, c-format
msgid "number of source and target fields in assignment does not match"
msgstr "赋值时源字段与目标字段的数量不匹配"

#. translator: %s represents a name of an extra check
#: pl_exec.c:7128 pl_exec.c:7162 pl_exec.c:7236 pl_exec.c:7262
#, c-format
msgid "%s check of %s is active."
msgstr "%2$s 中的 %1$s 检查已启用。"

#: pl_exec.c:7132 pl_exec.c:7166 pl_exec.c:7240 pl_exec.c:7266
#, c-format
msgid "Make sure the query returns the exact list of columns."
msgstr "确保查询返回准确的列列表。"

#: pl_exec.c:7653
#, c-format
msgid "record \"%s\" is not assigned yet"
msgstr "记录 \"%s\" 尚未赋值"

#: pl_exec.c:7654
#, c-format
msgid "The tuple structure of a not-yet-assigned record is indeterminate."
msgstr "尚未赋值的记录，其元组结构尚不确定。"

#: pl_exec.c:7893
#, c-format
msgid "cannot cast type %s to %s"
msgstr "不能把类型 %s 转换为 %s"

#: pl_exec.c:8352 pl_gram.y:3497
#, c-format
msgid "variable \"%s\" is declared CONSTANT"
msgstr "变量 \"%s\" 已声明为 CONSTANT"

#: pl_funcs.c:237
msgid "statement block"
msgstr "语句块"

#: pl_funcs.c:239
msgid "assignment"
msgstr "赋值"

#: pl_funcs.c:249
msgid "FOR with integer loop variable"
msgstr "带有整数循环变量的 FOR 语句"

#: pl_funcs.c:251
msgid "FOR over SELECT rows"
msgstr "遍历 SELECT 结果行的 FOR 循环"

#: pl_funcs.c:253
msgid "FOR over cursor"
msgstr "遍历游标的 FOR 循环"

#: pl_funcs.c:255
msgid "FOREACH over array"
msgstr "遍历数组的 FOREACH 循环"

#: pl_funcs.c:269
msgid "SQL statement"
msgstr "SQL 语句"

#: pl_funcs.c:273
msgid "FOR over EXECUTE statement"
msgstr "遍历 EXECUTE 语句结果的 FOR 循环"

#: pl_gram.y:487
#, c-format
msgid "block label must be placed before DECLARE, not after"
msgstr "代码块标签必须放在 DECLARE 的前面，而不是后面"

#: pl_gram.y:507
#, c-format
msgid "collations are not supported by type %s"
msgstr "类型 %s 不支持排序规则"

#: pl_gram.y:526
#, c-format
msgid "variable \"%s\" must have a default value, since it's declared NOT NULL"
msgstr "变量 \"%s\" 必须有默认值，因为它已声明为 NOT NULL"

#: pl_gram.y:674 pl_gram.y:689 pl_gram.y:715
#, c-format
msgid "variable \"%s\" does not exist"
msgstr "变量 \"%s\" 不存在"

#: pl_gram.y:733 pl_gram.y:761
msgid "duplicate declaration"
msgstr "重复声明"

#: pl_gram.y:744 pl_gram.y:772
#, c-format
msgid "variable \"%s\" shadows a previously defined variable"
msgstr "变量 \"%s\" 遮蔽先前定义的变量"

#: pl_gram.y:1044
#, c-format
msgid "diagnostics item %s is not allowed in GET STACKED DIAGNOSTICS"
msgstr "GET STACKED DIAGNOSTICS 中不允许使用诊断项 %s"

#: pl_gram.y:1062
#, c-format
msgid "diagnostics item %s is not allowed in GET CURRENT DIAGNOSTICS"
msgstr "GET CURRENT DIAGNOSTICS 中不允许使用诊断项 %s"

#: pl_gram.y:1157
msgid "unrecognized GET DIAGNOSTICS item"
msgstr "无法识别的 GET DIAGNOSTICS 项"

#: pl_gram.y:1173 pl_gram.y:3613
#, c-format
msgid "\"%s\" is not a scalar variable"
msgstr "\"%s\" 不是标量变量"

#: pl_gram.y:1403 pl_gram.y:1596
#, c-format
msgid ""
"loop variable of loop over rows must be a record variable or list of scalar "
"variables"
msgstr "遍历结果行的循环变量必须是 record 变量或标量变量列表"

#: pl_gram.y:1438
#, c-format
msgid "cursor FOR loop must have only one target variable"
msgstr "游标 FOR 循环只能有一个目标变量"

#: pl_gram.y:1445
#, c-format
msgid "cursor FOR loop must use a bound cursor variable"
msgstr "游标 FOR 循环必须使用已绑定的游标变量"

#: pl_gram.y:1535
#, c-format
msgid "integer FOR loop must have only one target variable"
msgstr "整数 FOR 循环只能有一个目标变量"

#: pl_gram.y:1569
#, c-format
msgid "cannot specify REVERSE in query FOR loop"
msgstr "不能在查询 FOR 循环中指定 REVERSE"

#: pl_gram.y:1699
#, c-format
msgid "loop variable of FOREACH must be a known variable or list of variables"
msgstr "FOREACH 的循环变量必须是已知变量或变量列表"

#: pl_gram.y:1741
#, c-format
msgid ""
"there is no label \"%s\" attached to any block or loop enclosing this "
"statement"
msgstr "包围此语句的块或循环均没有标签 \"%s\""

#: pl_gram.y:1749
#, c-format
msgid "block label \"%s\" cannot be used in CONTINUE"
msgstr "块标签 \"%s\" 不能用于 CONTINUE"

#: pl_gram.y:1764
#, c-format
msgid "EXIT cannot be used outside a loop, unless it has a label"
msgstr "EXIT 不能用于循环外，除非指定标签"

#: pl_gram.y:1765
#, c-format
msgid "CONTINUE cannot be used outside a loop"
msgstr "CONTINUE 不能用于循环外"

#: pl_gram.y:1789 pl_gram.y:1827 pl_gram.y:1875 pl_gram.y:3060 pl_gram.y:3148
#: pl_gram.y:3259 pl_gram.y:4008
msgid "unexpected end of function definition"
msgstr "函数定义意外结束"

#: pl_gram.y:1895 pl_gram.y:1919 pl_gram.y:1935 pl_gram.y:1941 pl_gram.y:2066
#: pl_gram.y:2074 pl_gram.y:2088 pl_gram.y:2183 pl_gram.y:2407 pl_gram.y:2497
#: pl_gram.y:2655 pl_gram.y:3855 pl_gram.y:3916 pl_gram.y:3989
msgid "syntax error"
msgstr "语法错误"

#: pl_gram.y:1923 pl_gram.y:1925 pl_gram.y:2411 pl_gram.y:2413
msgid "invalid SQLSTATE code"
msgstr "无效的 SQLSTATE 代码"

#: pl_gram.y:2131
msgid "syntax error, expected \"FOR\""
msgstr "语法错误，预期为 \"FOR\""

#: pl_gram.y:2192
#, c-format
msgid "FETCH statement cannot return multiple rows"
msgstr "FETCH 语句不能返回多行"

#: pl_gram.y:2289
#, c-format
msgid "cursor variable must be a simple variable"
msgstr "游标变量必须是简单变量"

#: pl_gram.y:2295
#, c-format
