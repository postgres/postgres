#: descriptor.c:63
#, c-format
msgid "variable \"%s\" must have a numeric type"
msgstr "变量 \"%s\" 必须是数值类型"

#: descriptor.c:119 descriptor.c:149
#, c-format
msgid "descriptor %s bound to connection %s does not exist"
msgstr "绑定到连接 %2$s 的描述符 %1$s 不存在"

#: descriptor.c:121 descriptor.c:151
#, c-format
msgid "descriptor %s bound to the default connection does not exist"
msgstr "绑定到默认连接的描述符 %s 不存在"

#: descriptor.c:166 descriptor.c:218
#, c-format
msgid "descriptor header item \"%d\" does not exist"
msgstr "描述符头部项 \"%d\" 不存在"

#: descriptor.c:188
#, c-format
msgid "nullable is always 1"
msgstr "nullable 始终为 1"

#: descriptor.c:191
#, c-format
msgid "key_member is always 0"
msgstr "key_member 始终为 0"

#: descriptor.c:285
#, c-format
msgid "descriptor item \"%s\" is not implemented"
msgstr "尚未实现描述符项 \"%s\""

#: descriptor.c:295
#, c-format
msgid "descriptor item \"%s\" cannot be set"
msgstr "不能设置描述符项 \"%s\""

#: ecpg.c:37
#, c-format
msgid ""
"%s is the PostgreSQL embedded SQL preprocessor for C programs.\n"
"\n"
msgstr ""
"%s 是用于 C 程序的 PostgreSQL 嵌入式 SQL 预处理器。\n"
"\n"

#: ecpg.c:39
#, c-format
msgid ""
"Usage:\n"
"  %s [OPTION]... FILE...\n"
"\n"
msgstr ""
"用法:\n"
"  %s [选项]... 文件名...\n"
"\n"

#: ecpg.c:42
#, c-format
msgid "Options:\n"
msgstr "选项:\n"

#: ecpg.c:43
#, c-format
msgid ""
"  -c             automatically generate C code from embedded SQL code;\n"
"                 this affects EXEC SQL TYPE\n"
msgstr ""
"  -c             自动从嵌入式 SQL 代码生成 C 代码；\n"
"                 此选项会影响 EXEC SQL TYPE\n"

#: ecpg.c:45
#, c-format
msgid ""
"  -C MODE        set compatibility mode; MODE can be one of\n"
"                 \"INFORMIX\", \"INFORMIX_SE\", \"ORACLE\"\n"
msgstr ""
"  -C MODE        设置兼容模式；MODE 可以为\n"
"                 \"INFORMIX\", \"INFORMIX_SE\", \"ORACLE\"\n"

#: ecpg.c:48
#, c-format
msgid "  -d             generate parser debug output\n"
msgstr "  -d             输出解析器调试信息\n"

#: ecpg.c:50
#, c-format
msgid "  -D SYMBOL      define SYMBOL\n"
msgstr "  -D SYMBOL      定义 SYMBOL\n"

#: ecpg.c:51
#, c-format
msgid ""
"  -h             parse a header file, this option includes option \"-c\"\n"
msgstr "  -h             解析头文件，此选项隐含 \"-c\" 选项\n"

#: ecpg.c:52
#, c-format
msgid "  -i             parse system include files as well\n"
msgstr "  -i             同时解析系统包含文件\n"

#: ecpg.c:53
#, c-format
msgid "  -I DIRECTORY   search DIRECTORY for include files\n"
msgstr "  -I DIRECTORY   在 DIRECTORY 中搜索包含文件\n"

#: ecpg.c:54
#, c-format
msgid "  -o OUTFILE     write result to OUTFILE\n"
msgstr "  -o OUTFILE     将结果写入 OUTFILE\n"

#: ecpg.c:55
#, c-format
msgid ""
"  -r OPTION      specify run-time behavior; OPTION can be:\n"
"                 \"no_indicator\", \"prepare\", \"questionmarks\"\n"
msgstr ""
"  -r OPTION      指定运行时行为；OPTION 可以为:\n"
"                 \"no_indicator\", \"prepare\", \"questionmarks\"\n"

#: ecpg.c:57
#, c-format
msgid "  --regression   run in regression testing mode\n"
msgstr "  --regression   在回归测试模式下运行\n"

#: ecpg.c:58
#, c-format
msgid "  -t             turn on autocommit of transactions\n"
msgstr "  -t             开启事务的自动提交功能\n"

#: ecpg.c:59
#, c-format
msgid "  -V, --version  output version information, then exit\n"
msgstr "  -V, --version  输出版本信息，然后退出\n"

#: ecpg.c:60
#, c-format
msgid "  -?, --help     show this help, then exit\n"
msgstr "  -?, --help     显示此帮助，然后退出\n"

#: ecpg.c:61
#, c-format
msgid ""
"\n"
"If no output file is specified, the name is formed by adding .c to the\n"
"input file name, after stripping off .pgc if present.\n"
msgstr ""
"\n"
"如果未指定输出文件，则将输入文件名的 .pgc 后缀（如有）去掉，\n"
"再添加 .c 后缀，作为输出文件名。\n"

#: ecpg.c:63
#, c-format
msgid ""
"\n"
"Report bugs to <%s>.\n"
msgstr ""
"\n"
"请向 <%s> 报告缺陷。\n"

#: ecpg.c:64
#, c-format
msgid "%s home page: <%s>\n"
msgstr "%s 主页: <%s>\n"

#: ecpg.c:152
#, c-format
msgid "%s: could not locate my own executable path\n"
msgstr "%s: 无法找到自身的可执行文件路径\n"

#: ecpg.c:195 ecpg.c:246 ecpg.c:260 ecpg.c:286
#, c-format
msgid "Try \"%s --help\" for more information.\n"
msgstr "运行 \"%s --help\" 获取更多信息。\n"

#: ecpg.c:203
#, c-format
msgid "%s: parser debug support (-d) not available\n"
msgstr "%s: 不支持解析器调试（-d）\n"

#: ecpg.c:230 ecpg.c:345 ecpg.c:356
#, c-format
msgid "%s: could not open file \"%s\": %m\n"
msgstr "%s: 无法打开文件 \"%s\": %m\n"

#: ecpg.c:274
#, c-format
msgid "%s, the PostgreSQL embedded C preprocessor, version %s\n"
msgstr "%s，PostgreSQL 嵌入式 C 语言预处理器，版本 %s\n"

#: ecpg.c:276
#, c-format
msgid "EXEC SQL INCLUDE ... search starts here:\n"
msgstr "EXEC SQL INCLUDE ... 从这里开始搜索:\n"

#: ecpg.c:279
#, c-format
msgid "end of search list\n"
msgstr "搜索列表结束\n"

#: ecpg.c:285
#, c-format
msgid "%s: no input files specified\n"
msgstr "%s: 未指定输入文件\n"

#: ecpg.c:491
#, c-format
msgid "cursor \"%s\" has been declared but not opened"
msgstr "游标 \"%s\" 已声明，但尚未打开"

#: ecpg.c:504 util.c:75
#, c-format
msgid "could not remove output file \"%s\"\n"
msgstr "无法删除输出文件 \"%s\"\n"

#: pgc.l:542
#, c-format
msgid "unterminated /* comment"
msgstr "未终止的 /* 注释"

