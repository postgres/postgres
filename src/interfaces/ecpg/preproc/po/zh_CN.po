msgstr "无效的位串字面量"

#: pgc.l:649
#, c-format
msgid "invalid hexadecimal string literal"
msgstr "无效的十六进制字符串字面量"

#: pgc.l:667
#, c-format
msgid "unhandled previous state in xqs\n"
msgstr "xqs 中未处理的先前状态\n"

#: pgc.l:700 pgc.l:820
#, c-format
msgid "unterminated quoted string"
msgstr "未终止的引号字符串"

#: pgc.l:753
#, c-format
msgid "unterminated dollar-quoted string"
msgstr "未终止的美元引号字符串"

#: pgc.l:772 pgc.l:793
#, c-format
msgid "zero-length delimited identifier"
msgstr "长度为零的定界标识符"

#: pgc.l:809
#, c-format
