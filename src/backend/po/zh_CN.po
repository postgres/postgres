#: main/main.c:386
#, c-format
msgid ""
"%s is the PostgreSQL server.\n"
"\n"
msgstr ""
"%s 是 PostgreSQL 服务器。\n"
"\n"

#: main/main.c:387
#, c-format
msgid ""
"Usage:\n"
"  %s [OPTION]...\n"
"\n"
msgstr ""
"用法:\n"
"  %s [选项]...\n"
"\n"

#: main/main.c:388
#, c-format
msgid "Options:\n"
msgstr "选项:\n"

#: main/main.c:389
#, c-format
msgid "  -B NBUFFERS        number of shared buffers\n"
msgstr "  -B NBUFFERS        共享缓冲区的数量\n"

#: main/main.c:390
#, c-format
msgid "  -c NAME=VALUE      set run-time parameter\n"
msgstr "  -c NAME=VALUE      设置运行时参数\n"

#: main/main.c:391
#, c-format
msgid "  -C NAME            print value of run-time parameter, then exit\n"
msgstr "  -C NAME            打印运行时参数的值，然后退出\n"

#: main/main.c:392
#, c-format
msgid "  -d 1-5             debugging level\n"
msgstr "  -d 1-5             调试级别\n"

#: main/main.c:393
#, c-format
msgid "  -D DATADIR         database directory\n"
msgstr "  -D DATADIR         数据库目录\n"

#: main/main.c:394
#, c-format
msgid "  -e                 use European date input format (DMY)\n"
msgstr "  -e                 使用欧洲日期输入格式（DMY）\n"

#: main/main.c:395
#, c-format
msgid "  -F                 turn fsync off\n"
msgstr "  -F                 关闭 fsync\n"

#: main/main.c:396
#, c-format
msgid "  -h HOSTNAME        host name or IP address to listen on\n"
msgstr "  -h HOSTNAME        监听的主机名或者 IP 地址\n"

#: main/main.c:397
#, c-format
msgid "  -i                 enable TCP/IP connections (deprecated)\n"
msgstr "  -i                 启用 TCP/IP 连接（已弃用）\n"

#: main/main.c:398
#, c-format
msgid "  -k DIRECTORY       Unix-domain socket location\n"
msgstr "  -k DIRECTORY       Unix 域套接字的目录位置\n"

#: main/main.c:400
#, c-format
msgid "  -l                 enable SSL connections\n"
msgstr "  -l                 启用 SSL 连接\n"

#: main/main.c:402
#, c-format
msgid "  -N MAX-CONNECT     maximum number of allowed connections\n"
msgstr "  -N MAX-CONNECT     允许建立的最大连接数目\n"

#: main/main.c:403
#, c-format
msgid "  -p PORT            port number to listen on\n"
msgstr "  -p PORT            监听的端口号\n"

#: main/main.c:404
#, c-format
msgid "  -s                 show statistics after each query\n"
msgstr "  -s                 每个查询后显示统计信息\n"

#: main/main.c:405
#, c-format
msgid "  -S WORK-MEM        set amount of memory for sorts (in kB)\n"
msgstr "  -S WORK-MEM        设置排序内存大小（单位为 kB）\n"

#: main/main.c:406
#, c-format
msgid "  -V, --version      output version information, then exit\n"
msgstr "  -V, --version      输出版本信息，然后退出\n"

#: main/main.c:407
#, c-format
msgid "  --NAME=VALUE       set run-time parameter\n"
msgstr "  --NAME=VALUE       设置运行时参数\n"

#: main/main.c:408
#, c-format
msgid "  --describe-config  describe configuration parameters, then exit\n"
msgstr "  --describe-config  描述配置参数，然后退出\n"

#: main/main.c:409
#, c-format
msgid "  -?, --help         show this help, then exit\n"
msgstr "  -?, --help         显示此帮助，然后退出\n"

#: main/main.c:411
#, c-format
msgid ""
"\n"
"Developer options:\n"
msgstr ""
"\n"
"开发人员选项:\n"

#: main/main.c:412
#, c-format
msgid "  -f s|i|o|b|t|n|m|h forbid use of some plan types\n"
msgstr "  -f s|i|o|b|t|n|m|h 禁止使用某些计划类型\n"

#: main/main.c:413
#, c-format
msgid "  -O                 allow system table structure changes\n"
msgstr "  -O                 允许更改系统表结构\n"

#: main/main.c:414
#, c-format
msgid "  -P                 disable system indexes\n"
msgstr "  -P                 禁用系统索引\n"

#: main/main.c:415
#, c-format
msgid "  -t pa|pl|ex        show timings after each query\n"
msgstr "  -t pa|pl|ex        每个查询后显示计时\n"

#: main/main.c:416
#, c-format
msgid ""
"  -T                 send SIGABRT to all backend processes if one dies\n"
msgstr ""
"  -T                 如果一个后端进程崩溃，向所有后端进程发送 SIGABRT\n"

#: main/main.c:417
#, c-format
msgid "  -W NUM             wait NUM seconds to allow attach from a debugger\n"
msgstr "  -W NUM             等待 NUM 秒，以便调试器附加\n"

#: main/main.c:419
#, c-format
msgid ""
"\n"
"Options for single-user mode:\n"
msgstr ""
"\n"
"单用户模式的选项:\n"

#: main/main.c:420
#, c-format
msgid ""
"  --single           selects single-user mode (must be first argument)\n"
msgstr "  --single           选择单用户模式（必须是第一个参数）\n"

#: main/main.c:421
#, c-format
msgid "  DBNAME             database name (defaults to user name)\n"
msgstr "  DBNAME             数据库名称（默认为用户名）\n"

#: main/main.c:422
#, c-format
msgid "  -d 0-5             override debugging level\n"
msgstr "  -d 0-5             覆盖调试级别\n"

#: main/main.c:423
#, c-format
msgid "  -E                 echo statement before execution\n"
msgstr "  -E                 执行前回显语句\n"

#: main/main.c:424
#, c-format
msgid ""
"  -j                 do not use newline as interactive query delimiter\n"
msgstr "  -j                 不使用换行符作为交互查询的分隔符\n"

#: main/main.c:425 main/main.c:431
#, c-format
msgid "  -r FILENAME        send stdout and stderr to given file\n"
msgstr "  -r FILENAME        把标准输出和标准错误发送到指定的文件中\n"

#: main/main.c:427
#, c-format
msgid ""
"\n"
"Options for bootstrapping mode:\n"
msgstr ""
"\n"
"引导模式的选项:\n"

#: main/main.c:428
#, c-format
msgid ""
"  --boot             selects bootstrapping mode (must be first argument)\n"
msgstr "  --boot             选择引导模式（必须是第一个参数）\n"

#: main/main.c:429
#, c-format
msgid "  --check            selects check mode (must be first argument)\n"
msgstr "  --check            选择检查模式（必须是第一个参数）\n"

#: main/main.c:430
#, c-format
msgid ""
"  DBNAME             database name (mandatory argument in bootstrapping "
"mode)\n"
msgstr "  DBNAME             数据库名称（在引导模式中是必选参数）\n"

#: main/main.c:433
#, c-format
msgid ""
"\n"
"Please read the documentation for the complete list of run-time\n"
"configuration settings and how to set them on the command line or in\n"
"the configuration file.\n"
"\n"
"Report bugs to <%s>.\n"
msgstr ""
"\n"
"关于运行时配置设置的完整列表，\n"
"以及如何在命令行或配置文件中\n"
"设置这些参数，请阅读文档。\n"
"\n"
"请向 <%s> 报告缺陷。\n"

#: main/main.c:437
#, c-format
msgid "%s home page: <%s>\n"
msgstr "%s 主页: <%s>\n"

#: main/main.c:448
#, c-format
msgid ""
"\"root\" execution of the PostgreSQL server is not permitted.\n"
"The server must be started under an unprivileged user ID to prevent\n"
"possible system security compromise.  See the documentation for\n"
"more information on how to properly start the server.\n"
msgstr ""
"不允许 \"root\" 执行 PostgreSQL 服务器。\n"
"服务器必须以非特权用户身份启动，以避免\n"
"可能的系统安全风险。有关如何正确启动服务器的\n"
"更多信息，参阅文档。\n"

#: main/main.c:465
#, c-format
msgid "%s: real and effective user IDs must match\n"
msgstr "%s: 真实和有效用户 ID 必须相互匹配\n"

#: main/main.c:472
#, c-format
msgid ""
"Execution of PostgreSQL by a user with administrative permissions is not\n"
"permitted.\n"
"The server must be started under an unprivileged user ID to prevent\n"
"possible system security compromises.  See the documentation for\n"
"more information on how to properly start the server.\n"
msgstr ""
"不允许具有管理员权限的用户\n"
"运行 PostgreSQL。\n"
"服务器必须以非特权用户身份启动，以避免\n"
"可能的系统安全风险。有关如何正确启动服务器的\n"
"更多信息，参阅文档。\n"

