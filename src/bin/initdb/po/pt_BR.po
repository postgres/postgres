"\n"

#: initdb.c:2522
#, c-format
msgid "Usage:\n"
msgstr "Uso:\n"

#: initdb.c:2523
#, c-format
msgid "  %s [OPTION]... [DATADIR]\n"
msgstr "  %s [OPÇÃO]... [DIRDADOS]\n"

#: initdb.c:2524
#, c-format
msgid ""
"\n"
"Options:\n"
msgstr ""
"\n"
"Opções:\n"

#: initdb.c:2525
#, c-format
msgid "  -A, --auth=METHOD         default authentication method for local connections\n"
msgstr "  -A, --auth=MÉTODO            método de autenticação padrão para conexões locais\n"

#: initdb.c:2526
#, c-format
msgid "      --auth-host=METHOD    default authentication method for local TCP/IP connections\n"
msgstr "      --auth-host=MÉTODO       método de autenticação padrão para conexões TCP/IP locais\n"

#: initdb.c:2527
#, c-format
msgid "      --auth-local=METHOD   default authentication method for local-socket connections\n"
msgstr "      --auth-local=MÉTODO      método de autenticação padrão para conexões de soquete locais\n"

#: initdb.c:2528
#, c-format
msgid " [-D, --pgdata=]DATADIR     location for this database cluster\n"
msgstr " [-D, --pgdata=]DIRDADOS       local do agrupamento de banco de dados\n"

#: initdb.c:2529
#, c-format
msgid "  -E, --encoding=ENCODING   set default encoding for new databases\n"
msgstr "  -E, --encoding=CODIFICAÇÃO   ajusta a codificação padrão para novos bancos de dados\n"

#: initdb.c:2530
#, c-format
msgid "  -g, --allow-group-access  allow group read/execute on data directory\n"
msgstr "  -g, --allow-group-access     permite leitura/execução do grupo no diretório de dados\n"

#: initdb.c:2531
#, c-format
msgid "      --icu-locale=LOCALE   set ICU locale ID for new databases\n"
msgstr "      --icu-locale=LOCALE      ajusta ID de configuração regional ICU para novos bancos de dados\n"

#: initdb.c:2532
#, c-format
msgid "      --icu-rules=RULES     set additional ICU collation rules for new databases\n"
msgstr "      --icu-rules=RULES defina regras de ordenação adicional da ICU para novos bancos de dados\n"

#: initdb.c:2533
#, c-format
msgid "  -k, --data-checksums      use data page checksums\n"
msgstr "  -k, --data-checksums         verificações de páginas de dados\n"

#: initdb.c:2534
#, c-format
msgid "      --locale=LOCALE       set default locale for new databases\n"
msgstr "     --locale=LOCALE           ajusta configuração regional padrão para novos bancos de dados\n"

#: initdb.c:2535
#, c-format
msgid ""
"      --lc-collate=, --lc-ctype=, --lc-messages=LOCALE\n"
"      --lc-monetary=, --lc-numeric=, --lc-time=LOCALE\n"
"                            set default locale in the respective category for\n"
"                            new databases (default taken from environment)\n"
msgstr ""
"      --lc-collate, --lc-ctype, --lc-messages=LOCALE\n"
"      --lc-monetary, --lc-numeric, --lc-time=LOCALE\n"
"                               ajusta configuração regional padrão na respectiva categoria\n"
"                               para novos bancos de dados (o ambiente é assumido como padrão)\n"

#: initdb.c:2539
#, c-format
msgid "      --no-locale           equivalent to --locale=C\n"
msgstr "      --no-locale              equivalente a --locale=C\n"

#: initdb.c:2540
#, c-format
msgid ""
"      --builtin-locale=LOCALE\n"
"                            set builtin locale name for new databases\n"
msgstr ""
"      --builtin-locale=LOCALE\n"
"                            define o nome da localidade interna para novos bancos de dados\n"

#: initdb.c:2542
#, c-format
msgid ""
"      --locale-provider={builtin|libc|icu}\n"
"                            set default locale provider for new databases\n"
msgstr ""
"      --locale-provider={builtin|libc|icu}\n"
"                            define o provedor de localidade padrão para novos bancos de dados\n"

#: initdb.c:2544
#, c-format
msgid "      --no-data-checksums   do not use data page checksums\n"
msgstr "      --no-data-checksums   não usar somatórios de verificação das páginas de dados\n"

#: initdb.c:2545
#, c-format
msgid "      --pwfile=FILE         read password for the new superuser from file\n"
msgstr "      --pwfile=ARQUIVO         lê senha do novo super-usuário a partir do arquivo\n"

#: initdb.c:2546
#, c-format
msgid ""
"  -T, --text-search-config=CFG\n"
"                            default text search configuration\n"
msgstr ""
"  -T, --text-search-config=CFG\n"
"                               configuração de busca textual padrão\n"

#: initdb.c:2548
