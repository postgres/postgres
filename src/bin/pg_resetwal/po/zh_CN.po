#: pg_resetwal.c:1221
#, c-format
msgid ""
"%s resets the PostgreSQL write-ahead log.\n"
"\n"
msgstr ""
"%s 重置 PostgreSQL 的预写日志。\n"
"\n"

#: pg_resetwal.c:1222
#, c-format
msgid ""
"Usage:\n"
"  %s [OPTION]... DATADIR\n"
"\n"
msgstr ""
"用法:\n"
"  %s [选项]... 数据目录\n"
"\n"

#: pg_resetwal.c:1223
#, c-format
msgid "Options:\n"
msgstr "选项:\n"

#: pg_resetwal.c:1224
#, c-format
msgid ""
"  -c, --commit-timestamp-ids=XID,XID\n"
"                                   set oldest and newest transactions "
"bearing\n"
"                                   commit timestamp (zero means no change)\n"
msgstr ""
"  -c, --commit-timestamp-ids=XID,XID\n"
"                                   设置带有提交时间戳的最早和最新事务 ID\n"
"                                   （零表示不更改）\n"

#: pg_resetwal.c:1227
#, c-format
msgid " [-D, --pgdata=]DATADIR            data directory\n"
msgstr " [-D, --pgdata=]DATADIR            数据目录\n"

#: pg_resetwal.c:1228
#, c-format
msgid "  -e, --epoch=XIDEPOCH             set next transaction ID epoch\n"
msgstr "  -e, --epoch=XIDEPOCH             设置下一个事务 ID 的纪元\n"

#: pg_resetwal.c:1229
#, c-format
msgid "  -f, --force                      force update to be done\n"
msgstr "  -f, --force                      强制执行更新\n"

#: pg_resetwal.c:1230
#, c-format
msgid ""
"  -l, --next-wal-file=WALFILE      set minimum starting location for new "
"WAL\n"
msgstr "  -l, --next-wal-file=WALFILE      设置新的 WAL 最小起始位置\n"

#: pg_resetwal.c:1231
#, c-format
msgid ""
"  -m, --multixact-ids=MXID,MXID    set next and oldest multitransaction ID\n"
msgstr "  -m, --multixact-ids=MXID,MXID    设置下一个和最早的多事务 ID\n"

#: pg_resetwal.c:1232
#, c-format
msgid ""
"  -n, --dry-run                    no update, just show what would be done\n"
msgstr "  -n, --dry-run                    不更新，只显示将要执行的操作\n"

#: pg_resetwal.c:1233
#, c-format
msgid "  -o, --next-oid=OID               set next OID\n"
msgstr "  -o, --next-oid=OID               设置下一个 OID\n"

#: pg_resetwal.c:1234
#, c-format
msgid "  -O, --multixact-offset=OFFSET    set next multitransaction offset\n"
msgstr "  -O, --multixact-offset=OFFSET    设置下一个多事务偏移量\n"

#: pg_resetwal.c:1235
#, c-format
msgid "  -u, --oldest-transaction-id=XID  set oldest transaction ID\n"
msgstr "  -u, --oldest-transaction-id=XID  设置最早的事务 ID\n"

#: pg_resetwal.c:1236
#, c-format
msgid ""
"  -V, --version                    output version information, then exit\n"
msgstr "  -V, --version                    输出版本信息，然后退出\n"

#: pg_resetwal.c:1237
#, c-format
msgid "  -x, --next-transaction-id=XID    set next transaction ID\n"
msgstr "  -x, --next-transaction-id=XID    设置下一个事务 ID\n"

#: pg_resetwal.c:1238
#, c-format
msgid "      --wal-segsize=SIZE           size of WAL segments, in megabytes\n"
msgstr "      --wal-segsize=SIZE           WAL 段的大小（兆字节）\n"

#: pg_resetwal.c:1239
#, c-format
msgid "  -?, --help                       show this help, then exit\n"
msgstr "  -?, --help                       显示此帮助，然后退出\n"

#: pg_resetwal.c:1240
#, c-format
msgid ""
"\n"
"Report bugs to <%s>.\n"
msgstr ""
"\n"
"请向 <%s> 报告缺陷。\n"

#: pg_resetwal.c:1241
#, c-format
msgid "%s home page: <%s>\n"
msgstr "%s 主页: <%s>\n"
