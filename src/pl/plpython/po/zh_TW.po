#, c-format
msgid "number of array dimensions exceeds the maximum allowed (%d)"
msgstr "陣列維度數超過允許的最大值(%d)"

# utils/adt/rowtypes.c:125 utils/adt/rowtypes.c:152 utils/adt/rowtypes.c:176
# utils/adt/rowtypes.c:184 utils/adt/rowtypes.c:234 utils/adt/rowtypes.c:242
#: plpy_typeio.c:1337
#, c-format
msgid "malformed record literal: \"%s\""
msgstr "格式錯誤的記錄字面值: \"%s\""

# utils/adt/rowtypes.c:126
#: plpy_typeio.c:1338
#, c-format
msgid "Missing left parenthesis."
msgstr "缺少左圓括號。"

#: plpy_typeio.c:1339 plpy_typeio.c:1543
#, c-format
msgid "To return a composite type in an array, return the composite type as a Python tuple, e.g., \"[('foo',)]\"."
msgstr "若要在陣列中傳回複合型別，請將複合型別傳回為 Python 的 tuple，例如: \"[('foo',)]\"。"

#: plpy_typeio.c:1386
#, c-format
msgid "key \"%s\" not found in mapping"
msgstr "對照表中找不到鍵 \"%s\""

#: plpy_typeio.c:1387
#, c-format
msgid "To return null in a column, add the value None to the mapping with the key named after the column."
msgstr "若要在欄位傳回 NULL，以欄位名稱為鍵、None 為值加入對照表。"

#: plpy_typeio.c:1440
#, c-format
msgid "length of returned sequence did not match number of columns in row"
msgstr "傳回的序列長度與資料列中的欄位數不一致"

#: plpy_typeio.c:1541
#, c-format
msgid "attribute \"%s\" does not exist in Python object"
msgstr "Python 物件中不存在屬性 \"%s\""

#: plpy_typeio.c:1544
#, c-format
msgid "To return null in a column, let the returned object have an attribute named after column with value None."
msgstr "若要在欄位傳回 NULL，以欄位名稱為傳回物件的屬性名稱並以 None 為值。"

#: plpy_util.c:29
#, c-format
msgid "could not convert Python Unicode object to bytes"
msgstr "無法將 Python 的 Unicode 物件轉換為位元組"

#: plpy_util.c:35
#, c-format
msgid "could not extract bytes from encoded string"
msgstr "無法從編碼字串中擷取位元組"

