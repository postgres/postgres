msgstr "不能复制窗口 \"%s\"，因为它带有窗口帧子句"

#: parser/parse_clause.c:2905
#, c-format
msgid "Omit the parentheses in this OVER clause."
msgstr "省略此 OVER 子句中的括号。"

#: parser/parse_clause.c:2925
#, c-format
msgid ""
"RANGE with offset PRECEDING/FOLLOWING requires exactly one ORDER BY column"
msgstr "带有 PRECEDING/FOLLOWING 偏移量的 RANGE 需要且仅需要一个 ORDER BY 列"

#: parser/parse_clause.c:2948
#, c-format
msgid "GROUPS mode requires an ORDER BY clause"
msgstr "GROUPS 模式需要 ORDER BY 子句"

#: parser/parse_clause.c:3018
#, c-format
msgid ""
"in an aggregate with DISTINCT, ORDER BY expressions must appear in argument "
"list"
msgstr ""
"在带有 DISTINCT 子句的聚合函数中，ORDER BY 子句后面的表达式必须在参数列表中出"
"现"

#: parser/parse_clause.c:3019
#, c-format
msgid "for SELECT DISTINCT, ORDER BY expressions must appear in select list"
msgstr "使用 SELECT DISTINCT 时，ORDER BY 表达式必须出现在选择列表中"

#: parser/parse_clause.c:3051
#, c-format
msgid "an aggregate with DISTINCT must have at least one argument"
msgstr "带有 DISTINCT 关键字的聚合函数必须至少有一个参数"

#: parser/parse_clause.c:3052
#, c-format
msgid "SELECT DISTINCT must have at least one column"
msgstr "SELECT DISTINCT 必须至少有一列"

#: parser/parse_clause.c:3118 parser/parse_clause.c:3150
#, c-format
msgid "SELECT DISTINCT ON expressions must match initial ORDER BY expressions"
msgstr "SELECT DISTINCT ON 表达式必须与 ORDER BY 开头的表达式匹配"

#: parser/parse_clause.c:3228 parser/parse_clause.c:3234
#, c-format
msgid "%s is not allowed in ON CONFLICT clause"
msgstr "ON CONFLICT 子句中不允许使用 %s"

#: parser/parse_clause.c:3240
#, c-format
msgid "operator class options are not allowed in ON CONFLICT clause"
msgstr "ON CONFLICT 子句中不允许使用操作符类选项"

#: parser/parse_clause.c:3319
#, c-format
