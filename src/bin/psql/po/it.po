#: help.c:60
msgid ""
"psql is the PostgreSQL interactive terminal.\n"
"\n"
msgstr ""
"psql è il terminale interattivo di PostgreSQL.\n"
"\n"

#: help.c:61 help.c:385 help.c:472 help.c:525
msgid "Usage:\n"
msgstr "Utilizzo:\n"

#: help.c:62
msgid ""
"  psql [OPTION]... [DBNAME [USERNAME]]\n"
"\n"
msgstr ""
"  psql [OPZIONE]... [NOMEDB [UTENTE]]\n"
"\n"

#: help.c:64
msgid "General options:\n"
msgstr "Opzioni generali:\n"

#: help.c:65
msgid "  -c, --command=COMMAND    run only single command (SQL or internal) and exit\n"
msgstr "  -c, --command=COMANDO    esegue solo un singolo comando (SQL o interno) ed esce\n"

#: help.c:66
msgid "  -d, --dbname=DBNAME      database name to connect to\n"
msgstr "  -d, --dbname=NOMEDB      nome del database a cui connettersi\n"

#: help.c:67
msgid "  -f, --file=FILENAME      execute commands from file, then exit\n"
msgstr "  -f, --file=NOMEFILE      esegue i comandi dal file, poi esce\n"

#: help.c:68
msgid "  -l, --list               list available databases, then exit\n"
msgstr "  -l, --list               elenca i database disponibili, poi esce\n"

#: help.c:69
msgid ""
"  -v, --set=, --variable=NAME=VALUE\n"
"                           set psql variable NAME to VALUE\n"
"                           (e.g., -v ON_ERROR_STOP=1)\n"
msgstr ""
"  -v, --set=, --variable=NOME=VALORE\n"
"                           imposta la variabile psql NOME a VALORE\n"
"                           (per es. -v ON_ERROR_STOP=1)\n"

#: help.c:72
msgid "  -V, --version            output version information, then exit\n"
msgstr "  -V, --version            mostra informazioni sulla versione, poi esce\n"

#: help.c:73
msgid "  -X, --no-psqlrc          do not read startup file (~/.psqlrc)\n"
msgstr "  -X, --no-psqlrc          non legge il file di avvio (~/.psqlrc)\n"

#: help.c:74
msgid ""
"  -1 (\"one\"), --single-transaction\n"
"                           execute as a single transaction (if non-interactive)\n"
msgstr ""
"  -1 (\"uno\"), --single-transaction\n"
"                           esegue come singola transazione (se non interattivo)\n"

#: help.c:76
msgid "  -?, --help[=options]     show this help, then exit\n"
msgstr "  -?, --help[=options]     mostra questo aiuto, poi esce\n"

#: help.c:77
msgid "      --help=commands      list backslash commands, then exit\n"
msgstr "      --help=commands      elenca i comandi con backslash, poi esce\n"

#: help.c:78
msgid "      --help=variables     list special variables, then exit\n"
msgstr "      --help=variables     elenca le variabili speciali, poi esce\n"

#: help.c:80
msgid ""
"\n"
"Input and output options:\n"
msgstr ""
"\n"
"Opzioni di input e output:\n"

#: help.c:81
msgid "  -a, --echo-all           echo all input from script\n"
msgstr "  -a, --echo-all           visualizza tutto l'input dallo script\n"

#: help.c:82
msgid "  -b, --echo-errors        echo failed commands\n"
msgstr "  -b, --echo-errors        visualizza i comandi falliti\n"

#: help.c:83
msgid "  -e, --echo-queries       echo commands sent to server\n"
msgstr "  -e, --echo-queries       visualizza i comandi inviati al server\n"

#: help.c:84
msgid "  -E, --echo-hidden        display queries that internal commands generate\n"
msgstr "  -E, --echo-hidden        mostra le query generate dai comandi interni\n"

#: help.c:85
msgid "  -L, --log-file=FILENAME  send session log to file\n"
msgstr "  -L, --log-file=NOMEFILE  invia il log della sessione al file\n"

#: help.c:86
msgid "  -n, --no-readline        disable enhanced command line editing (readline)\n"
msgstr "  -n, --no-readline        disabilita la modifica avanzata della riga di comando (readline)\n"

#: help.c:87
msgid "  -o, --output=FILENAME    send query results to file (or |pipe)\n"
msgstr "  -o, --output=NOMEFILE    invia i risultati delle query al file (o |pipe)\n"

#: help.c:88
msgid "  -q, --quiet              run quietly (no messages, only query output)\n"
msgstr "  -q, --quiet              esecuzione silenziosa (nessun messaggio, solo output delle query)\n"

#: help.c:89
msgid "  -s, --single-step        single-step mode (confirm each query)\n"
msgstr "  -s, --single-step        modalità passo singolo (conferma ogni query)\n"

#: help.c:90
msgid "  -S, --single-line        single-line mode (end of line terminates SQL command)\n"
msgstr "  -S, --single-line        modalità riga singola (la fine riga termina il comando SQL)\n"

#: help.c:92
msgid ""
"\n"
"Output format options:\n"
msgstr ""
"\n"
"Opzioni di formato di output:\n"

#: help.c:93
msgid "  -A, --no-align           unaligned table output mode\n"
msgstr "  -A, --no-align           modalità di output tabella non allineata\n"

#: help.c:94
msgid "      --csv                CSV (Comma-Separated Values) table output mode\n"
msgstr "      --csv                modalità di output tabella CSV (valori separati da virgola)\n"

#: help.c:95
#, c-format
msgid ""
"  -F, --field-separator=STRING\n"
"                           field separator for unaligned output (default: \"%s\")\n"
msgstr ""
"  -F, --field-separator=STRINGA\n"
"                           separatore di campo per l'output non allineato (predefinito: \"%s\")\n"

#: help.c:98
msgid "  -H, --html               HTML table output mode\n"
msgstr "  -H, --html               modalità di output tabella HTML\n"

#: help.c:99
msgid "  -P, --pset=VAR[=ARG]     set printing option VAR to ARG (see \\pset command)\n"
msgstr "  -P, --pset=VAR[=ARG]     imposta l'opzione di stampa VAR ad ARG (vedi il comando \\pset)\n"

#: help.c:100
msgid ""
"  -R, --record-separator=STRING\n"
"                           record separator for unaligned output (default: newline)\n"
msgstr ""
"  -R, --record-separator=STRINGA\n"
"                           separatore di record per l'output non allineato (predefinito: a-capo)\n"

#: help.c:102
msgid "  -t, --tuples-only        print rows only\n"
msgstr "  -t, --tuples-only        stampa solo le righe\n"

#: help.c:103
msgid "  -T, --table-attr=TEXT    set HTML table tag attributes (e.g., width, border)\n"
msgstr "  -T, --table-attr=TESTO   imposta gli attributi del tag tabella HTML (per es. width, border)\n"

#: help.c:104
msgid "  -x, --expanded           turn on expanded table output\n"
msgstr "  -x, --expanded           attiva l'output tabella espanso\n"

#: help.c:105
msgid ""
"  -z, --field-separator-zero\n"
"                           set field separator for unaligned output to zero byte\n"
msgstr ""
"  -z, --field-separator-zero\n"
"                           imposta il separatore di campo per l'output non allineato a byte zero\n"

#: help.c:107
msgid ""
"  -0, --record-separator-zero\n"
"                           set record separator for unaligned output to zero byte\n"
msgstr ""
"  -0, --record-separator-zero\n"
"                           imposta il separatore di record per l'output non allineato a byte zero\n"

#: help.c:110
msgid ""
"\n"
"Connection options:\n"
msgstr ""
"\n"
"Opzioni di connessione:\n"

#: help.c:111
msgid "  -h, --host=HOSTNAME      database server host or socket directory\n"
msgstr "  -h, --host=HOSTNAME      host del server database o directory del socket\n"

#: help.c:112
msgid "  -p, --port=PORT          database server port\n"
msgstr "  -p, --port=PORTA         porta del server database\n"

#: help.c:113
msgid "  -U, --username=USERNAME  database user name\n"
msgstr "  -U, --username=UTENTE    nome utente del database\n"

#: help.c:114
msgid "  -w, --no-password        never prompt for password\n"
msgstr "  -w, --no-password        non richiede mai la password\n"

#: help.c:115
msgid "  -W, --password           force password prompt (should happen automatically)\n"
msgstr "  -W, --password           forza la richiesta della password (dovrebbe avvenire automaticamente)\n"

#: help.c:117
msgid ""
"\n"
"For more information, type \"\\?\" (for internal commands) or \"\\help\" (for SQL\n"
"commands) from within psql, or consult the psql section in the PostgreSQL\n"
"documentation.\n"
"\n"
msgstr ""
"\n"
"Per maggiori informazioni, digita \"\\?\" (per i comandi interni) o \"\\help\" (per i\n"
"comandi SQL) dentro psql, oppure consulta la sezione psql della\n"
"documentazione di PostgreSQL.\n"
"\n"

#: help.c:120
#, c-format
msgid "Report bugs to <%s>.\n"
msgstr "Segnala i bug a <%s>.\n"

#: help.c:121
#, c-format
msgid "%s home page: <%s>\n"
msgstr "Pagina iniziale di %s: <%s>\n"

#: help.c:163
msgid "General\n"
msgstr "Generale\n"

#: help.c:164
msgid "  \\copyright             show PostgreSQL usage and distribution terms\n"
msgstr "  \\copyright             mostra i termini di utilizzo e distribuzione di PostgreSQL\n"

#: help.c:165
msgid "  \\crosstabview [COLUMNS] execute query and display result in crosstab\n"
msgstr "  \\crosstabview [COLONNE] esegue la query e mostra il risultato in crosstab\n"

#: help.c:166
msgid "  \\errverbose            show most recent error message at maximum verbosity\n"
msgstr "  \\errverbose            mostra il messaggio di errore più recente alla massima verbosità\n"

#: help.c:167
msgid ""
"  \\g [(OPTIONS)] [FILE]  execute query (and send result to file or |pipe);\n"
"                         \\g with no arguments is equivalent to a semicolon\n"
msgstr ""
"  \\g [(OPZIONI)] [FILE]  esegue la query (e invia il risultato al file o |pipe);\n"
"                         \\g senza argomenti equivale a un punto e virgola\n"

#: help.c:169
msgid "  \\gdesc                 describe result of query, without executing it\n"
msgstr "  \\gdesc                 descrive il risultato della query, senza eseguirla\n"

#: help.c:170
msgid "  \\gexec                 execute query, then execute each value in its result\n"
