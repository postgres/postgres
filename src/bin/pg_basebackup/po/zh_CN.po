msgstr "无法创建 zstd 压缩上下文"

#: bbstreamer_zstd.c:91
#, c-format
msgid "could not set zstd compression level to %d: %s"
msgstr "无法把 zstd 压缩级别设为 %d: %s"

#: bbstreamer_zstd.c:105
#, c-format
msgid "could not set compression worker count to %d: %s"
msgstr "无法把压缩工作线程数设为 %d: %s"

#: bbstreamer_zstd.c:115
#, c-format
msgid "could not enable long-distance mode: %s"
msgstr "无法启用长距离模式: %s"

#: bbstreamer_zstd.c:272
#, c-format
msgid "could not create zstd decompression context"
msgstr "无法创建 zstd 解压缩上下文"

#: pg_basebackup.c:238
#, c-format
msgid "removing data directory \"%s\""
msgstr "正在删除数据目录 \"%s\""

#: pg_basebackup.c:240
#, c-format
msgid "failed to remove data directory"
msgstr "删除数据目录失败"

#: pg_basebackup.c:244
#, c-format
msgid "removing contents of data directory \"%s\""
msgstr "正在删除数据目录 \"%s\" 的内容"

#: pg_basebackup.c:246
#, c-format
msgid "failed to remove contents of data directory"
msgstr "删除数据目录内容失败"

#: pg_basebackup.c:251
#, c-format
msgid "removing WAL directory \"%s\""
msgstr "正在删除 WAL 目录 \"%s\""

#: pg_basebackup.c:253
#, c-format
msgid "failed to remove WAL directory"
msgstr "删除 WAL 目录失败"

#: pg_basebackup.c:257
#, c-format
msgid "removing contents of WAL directory \"%s\""
msgstr "正在删除 WAL 目录 \"%s\" 的内容"

#: pg_basebackup.c:259
#, c-format
msgid "failed to remove contents of WAL directory"
msgstr "删除 WAL 目录内容失败"

#: pg_basebackup.c:265
#, c-format
msgid "data directory \"%s\" not removed at user's request"
msgstr "根据用户要求，未删除数据目录 \"%s\""

#: pg_basebackup.c:268
#, c-format
msgid "WAL directory \"%s\" not removed at user's request"
msgstr "根据用户要求，未删除 WAL 目录 \"%s\""

#: pg_basebackup.c:272
#, c-format
msgid "changes to tablespace directories will not be undone"
msgstr "对表空间目录的变更将不会撤销"

#: pg_basebackup.c:324
#, c-format
msgid "directory name too long"
msgstr "目录名过长"

#: pg_basebackup.c:331
#, c-format
msgid "multiple \"=\" signs in tablespace mapping"
msgstr "表空间映射中出现多个 \"=\" 号"

#: pg_basebackup.c:340
#, c-format
msgid "invalid tablespace mapping format \"%s\", must be \"OLDDIR=NEWDIR\""
msgstr "表空间映射格式 \"%s\" 无效，必须为 \"OLDDIR=NEWDIR\""

#: pg_basebackup.c:359
#, c-format
msgid "old directory is not an absolute path in tablespace mapping: %s"
msgstr "表空间映射中的旧目录不是绝对路径: %s"

#: pg_basebackup.c:363
#, c-format
msgid "new directory is not an absolute path in tablespace mapping: %s"
msgstr "表空间映射中的新目录不是绝对路径: %s"

#: pg_basebackup.c:385
#, c-format
msgid ""
"%s takes a base backup of a running PostgreSQL server.\n"
"\n"
msgstr ""
"%s 对运行中的 PostgreSQL 服务器进行基础备份。\n"
"\n"

#: pg_basebackup.c:387 pg_receivewal.c:79 pg_recvlogical.c:76
#, c-format
msgid "Usage:\n"
msgstr "用法:\n"

#: pg_basebackup.c:388 pg_receivewal.c:80 pg_recvlogical.c:77
#, c-format
msgid "  %s [OPTION]...\n"
msgstr "  %s [选项]...\n"

#: pg_basebackup.c:389
#, c-format
msgid ""
"\n"
"Options controlling the output:\n"
msgstr ""
"\n"
"控制输出的选项:\n"

#: pg_basebackup.c:390
#, c-format
msgid "  -D, --pgdata=DIRECTORY receive base backup into directory\n"
msgstr "  -D, --pgdata=DIRECTORY 接收基础备份到指定目录\n"

#: pg_basebackup.c:391
#, c-format
msgid "  -F, --format=p|t       output format (plain (default), tar)\n"
msgstr "  -F, --format=p|t       输出格式（plain（默认）或 tar）\n"

#: pg_basebackup.c:392
#, c-format
msgid ""
"  -r, --max-rate=RATE    maximum transfer rate to transfer data directory\n"
"                         (in kB/s, or use suffix \"k\" or \"M\")\n"
msgstr ""
"  -r, --max-rate=RATE    传输数据目录的最大速率\n"
"                         （单位为 kB/s，或使用后缀 \"k\" 或 \"M\"）\n"

#: pg_basebackup.c:394
#, c-format
msgid ""
"  -R, --write-recovery-conf\n"
"                         write configuration for replication\n"
msgstr ""
"  -R, --write-recovery-conf\n"
"                         为复制写入配置文件\n"

#: pg_basebackup.c:396
#, c-format
msgid ""
"  -t, --target=TARGET[:DETAIL]\n"
"                         backup target (if other than client)\n"
msgstr ""
"  -t, --target=TARGET[:DETAIL]\n"
"                         备份目标（目标不是客户端时指定）\n"

#: pg_basebackup.c:398
#, c-format
msgid ""
"  -T, --tablespace-mapping=OLDDIR=NEWDIR\n"
"                         relocate tablespace in OLDDIR to NEWDIR\n"
msgstr ""
"  -T, --tablespace-mapping=OLDDIR=NEWDIR\n"
"                         将 OLDDIR 中的表空间重定位到 NEWDIR\n"

#: pg_basebackup.c:400
#, c-format
msgid "      --waldir=WALDIR    location for the write-ahead log directory\n"
msgstr "      --waldir=WALDIR    预写日志目录的位置\n"

#: pg_basebackup.c:401
#, c-format
msgid ""
"  -X, --wal-method=none|fetch|stream\n"
"                         include required WAL files with specified method\n"
msgstr ""
"  -X, --wal-method=none|fetch|stream\n"
"                         按指定方法包含所需的 WAL 文件\n"

#: pg_basebackup.c:403
#, c-format
msgid "  -z, --gzip             compress tar output\n"
msgstr "  -z, --gzip             压缩 tar 输出\n"

#: pg_basebackup.c:404
#, c-format
msgid ""
"  -Z, --compress=[{client|server}-]METHOD[:DETAIL]\n"
"                         compress on client or server as specified\n"
msgstr ""
"  -Z, --compress=[{client|server}-]METHOD[:DETAIL]\n"
"                         按指定方式在客户端或服务器端压缩\n"

#: pg_basebackup.c:406
#, c-format
msgid "  -Z, --compress=none    do not compress tar output\n"
msgstr "  -Z, --compress=none    不压缩 tar 输出\n"

#: pg_basebackup.c:407
#, c-format
msgid ""
"\n"
"General options:\n"
msgstr ""
"\n"
"一般选项:\n"

#: pg_basebackup.c:408
#, c-format
msgid ""
"  -c, --checkpoint=fast|spread\n"
"                         set fast or spread checkpointing\n"
msgstr ""
"  -c, --checkpoint=fast|spread\n"
"                         设置 fast 或 spread 的检查点方式\n"

#: pg_basebackup.c:410
#, c-format
msgid "  -C, --create-slot      create replication slot\n"
msgstr "  -C, --create-slot      创建复制槽\n"

#: pg_basebackup.c:411
#, c-format
msgid "  -l, --label=LABEL      set backup label\n"
msgstr "  -l, --label=LABEL      设置备份标签\n"

#: pg_basebackup.c:412
#, c-format
msgid "  -n, --no-clean         do not clean up after errors\n"
msgstr "  -n, --no-clean         出错后不清理\n"

#: pg_basebackup.c:413
#, c-format
msgid ""
"  -N, --no-sync          do not wait for changes to be written safely to "
"disk\n"
msgstr "  -N, --no-sync          不等待变更安全写入磁盘\n"

#: pg_basebackup.c:414
#, c-format
msgid "  -P, --progress         show progress information\n"
msgstr "  -P, --progress         显示进度信息\n"

#: pg_basebackup.c:415 pg_receivewal.c:89
#, c-format
msgid "  -S, --slot=SLOTNAME    replication slot to use\n"
msgstr "  -S, --slot=SLOTNAME    要使用的复制槽\n"

#: pg_basebackup.c:416 pg_receivewal.c:91 pg_recvlogical.c:98
#, c-format
msgid "  -v, --verbose          output verbose messages\n"
msgstr "  -v, --verbose          输出详细的消息\n"

#: pg_basebackup.c:417 pg_receivewal.c:92 pg_recvlogical.c:99
#, c-format
msgid "  -V, --version          output version information, then exit\n"
msgstr "  -V, --version          输出版本信息，然后退出\n"

#: pg_basebackup.c:418
#, c-format
msgid ""
"      --manifest-checksums=SHA{224,256,384,512}|CRC32C|NONE\n"
"                         use algorithm for manifest checksums\n"
msgstr ""
"      --manifest-checksums=SHA{224,256,384,512}|CRC32C|NONE\n"
"                         使用指定算法计算清单校验和\n"

#: pg_basebackup.c:420
#, c-format
msgid ""
"      --manifest-force-encode\n"
"                         hex encode all file names in manifest\n"
msgstr ""
"      --manifest-force-encode\n"
"                         十六进制编码清单中的所有文件名\n"

#: pg_basebackup.c:422
#, c-format
msgid "      --no-estimate-size do not estimate backup size in server side\n"
msgstr "      --no-estimate-size 不在服务器端估算备份大小\n"

#: pg_basebackup.c:423
#, c-format
msgid "      --no-manifest      suppress generation of backup manifest\n"
msgstr "      --no-manifest      不生成备份清单\n"

#: pg_basebackup.c:424
#, c-format
msgid ""
"      --no-slot          prevent creation of temporary replication slot\n"
msgstr "      --no-slot          防止创建临时复制槽\n"

#: pg_basebackup.c:425
#, c-format
msgid ""
"      --no-verify-checksums\n"
"                         do not verify checksums\n"
msgstr ""
"      --no-verify-checksums\n"
"                         不验证校验和\n"

#: pg_basebackup.c:427 pg_receivewal.c:95 pg_recvlogical.c:100
#, c-format
msgid "  -?, --help             show this help, then exit\n"
msgstr "  -?, --help             显示此帮助，然后退出\n"

#: pg_basebackup.c:428 pg_receivewal.c:96 pg_recvlogical.c:101
#, c-format
msgid ""
"\n"
"Connection options:\n"
msgstr ""
"\n"
"连接选项:\n"

#: pg_basebackup.c:429 pg_receivewal.c:97
#, c-format
msgid "  -d, --dbname=CONNSTR   connection string\n"
msgstr "  -d, --dbname=CONNSTR   连接字符串\n"

#: pg_basebackup.c:430 pg_receivewal.c:98 pg_recvlogical.c:103
#, c-format
msgid "  -h, --host=HOSTNAME    database server host or socket directory\n"
msgstr "  -h, --host=HOSTNAME    数据库服务器主机或套接字目录\n"

#: pg_basebackup.c:431 pg_receivewal.c:99 pg_recvlogical.c:104
#, c-format
msgid "  -p, --port=PORT        database server port number\n"
msgstr "  -p, --port=PORT        数据库服务器端口号\n"

#: pg_basebackup.c:432
#, c-format
msgid ""
"  -s, --status-interval=INTERVAL\n"
"                         time between status packets sent to server (in "
"seconds)\n"
msgstr ""
"  -s, --status-interval=INTERVAL\n"
"                         发往服务器的状态包的时间间隔（以秒计）\n"

#: pg_basebackup.c:434 pg_receivewal.c:100 pg_recvlogical.c:105
#, c-format
msgid "  -U, --username=NAME    connect as specified database user\n"
msgstr "  -U, --username=NAME    以指定的数据库用户连接\n"

#: pg_basebackup.c:435 pg_receivewal.c:101 pg_recvlogical.c:106
#, c-format
msgid "  -w, --no-password      never prompt for password\n"
msgstr "  -w, --no-password      永远不提示输入密码\n"

#: pg_basebackup.c:436 pg_receivewal.c:102 pg_recvlogical.c:107
#, c-format
msgid ""
