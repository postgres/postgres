msgid "INSTEAD NOTHING rules on SELECT are not implemented"
msgstr "在 SELECT 上的 INSTEAD NOTHING 规则未实现"

#: rewrite/rewriteDefine.c:325
#, c-format
msgid "Use views instead."
msgstr "改用视图。"

#: rewrite/rewriteDefine.c:333
#, c-format
msgid "multiple actions for rules on SELECT are not implemented"
msgstr "在 SELECT 上的多动作规则未实现"

#: rewrite/rewriteDefine.c:343
#, c-format
msgid "rules on SELECT must have action INSTEAD SELECT"
msgstr "在 SELECT 上的规则必须有 INSTEAD SELECT 动作"

#: rewrite/rewriteDefine.c:351
#, c-format
msgid "rules on SELECT must not contain data-modifying statements in WITH"
msgstr "SELECT 上的规则不得在 WITH 子句中包含修改数据的语句"

#: rewrite/rewriteDefine.c:359
