msgstr "私钥文件 \"%s\" 不是常规文件"

#: fe-secure-openssl.c:1448
#, c-format
msgid ""
"private key file \"%s\" has group or world access; file must have "
"permissions u=rw (0600) or less if owned by the current user, or permissions "
"u=rw,g=r (0640) or less if owned by root"
msgstr ""
"私钥文件 \"%s\" 允许组或其他用户访问；如果属于当前用户，权限必须为 u=rw "
"(0600) 或更严格；如果属于 root，权限必须为 u=rw,g=r (0640) 或更严格"

#: fe-secure-openssl.c:1472
#, c-format
msgid "could not load private key file \"%s\": %s"
msgstr "无法加载私钥文件 \"%s\": %s"

#: fe-secure-openssl.c:1488
#, c-format
msgid "certificate does not match private key file \"%s\": %s"
msgstr "证书与私钥文件 \"%s\" 不匹配: %s"

#: fe-secure-openssl.c:1557
#, c-format
msgid "SSL error: certificate verify failed: %s"
msgstr "SSL 错误: 证书验证失败: %s"

#: fe-secure-openssl.c:1602
#, c-format
