msgstr "shell 命令参数包含换行符或回车符: \"%s\"\n"

#: ../../fe_utils/string_utils.c:758
#, c-format
msgid "database name contains a newline or carriage return: \"%s\"\n"
msgstr "数据库名包含换行符或回车符: \"%s\"\n"

#: pg_amcheck.c:404
#, c-format
msgid "invalid argument for option %s"
msgstr "选项 %s 的参数无效"

