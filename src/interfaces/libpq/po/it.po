#, c-format
msgid "provider requires client authentication, and no oauth_client_secret is set"
msgstr "il provider richiede l'autenticazione del client, ma non è impostato nessun oauth_client_secret"

#: ../libpq-oauth/oauth-curl.c:1604
#, c-format
msgid "could not check timer expiration: %m"
msgstr "non è stato possibile controllare la scadenza del timer: %m"

