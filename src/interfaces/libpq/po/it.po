#, c-format
msgid "could not create libcurl handle"
msgstr "non è stato possibile creare l'handle di libcurl"

#: ../libpq-oauth/oauth-curl.c:1886
#, c-format
msgid "response is too large"
msgstr "la risposta è troppo grande"

