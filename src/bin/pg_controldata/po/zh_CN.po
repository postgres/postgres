msgstr "无法读取文件 \"%s\": %m"

#: ../../common/controldata_utils.c:111
#, c-format
msgid "could not read file \"%s\": read %d of %zu"
msgstr "无法读取文件 \"%1$s\": 应读取 %3$zu，实际读取 %2$d"

