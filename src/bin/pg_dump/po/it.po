#, c-format
msgid "  -?, --help                   show this help, then exit\n"
msgstr "  -?, --help                   mostra questo aiuto, poi esci\n"

#: pg_dump.c:1311 pg_dumpall.c:714
#, c-format
msgid ""
"\n"
"Options controlling the output content:\n"
msgstr ""
"\n"
"Opzioni per il controllo del contenuto dell'output:\n"

#: pg_dump.c:1312 pg_dumpall.c:715
#, c-format
msgid "  -a, --data-only              dump only the data, not the schema or statistics\n"
msgstr "  -a, --data-only               esporta solo i dati, non lo schema o le statistiche\n"

#: pg_dump.c:1313
#, c-format
msgid "  -b, --large-objects          include large objects in dump\n"
msgstr "  -b, --large-objects           includi i large object nel dump\n"

#: pg_dump.c:1314
#, c-format
msgid "  --blobs                      (same as --large-objects, deprecated)\n"
msgstr "  --blobs                       (equivalente a --large-objects, deprecato)\n"

#: pg_dump.c:1315
#, c-format
msgid "  -B, --no-large-objects       exclude large objects in dump\n"
msgstr "  -B, --no-large-objects        escludi i large object dal dump\n"

#: pg_dump.c:1316
#, c-format
msgid "  --no-blobs                   (same as --no-large-objects, deprecated)\n"
msgstr "  --no-blobs                    (equivalente a --no-large-objects, deprecato)\n"

#: pg_dump.c:1317 pg_restore.c:550
#, c-format
