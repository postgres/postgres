#: vacuumdb.c:366
#, c-format
msgid "      --missing-stats-only        only analyze relations with missing statistics\n"
msgstr "      --missing-stats-only        僅分析缺少統計資訊的關聯\n"

#: vacuumdb.c:367
#, c-format
msgid "      --no-index-cleanup          don't remove index entries that point to dead tuples\n"
msgstr "      --no-index-cleanup          不刪除指向死元組的索引項目\n"

#: vacuumdb.c:368
#, c-format
msgid "      --no-process-main           skip the main relation\n"
msgstr "      --no-process-main           跳過主關聯\n"

#: vacuumdb.c:369
#, c-format
msgid "      --no-process-toast          skip the TOAST table associated with the table to vacuum\n"
msgstr "      --no-process-toast          跳過與待清理資料表相關聯的 TOAST 資料表\n"

#: vacuumdb.c:370
#, c-format
msgid "      --no-truncate               don't truncate empty pages at the end of the table\n"
msgstr "      --no-truncate               不截斷資料表末尾的空白頁面\n"

#: vacuumdb.c:371
#, c-format
msgid "  -n, --schema=SCHEMA             vacuum tables in the specified schema(s) only\n"
msgstr "  -n, --schema=SCHEMA             僅清理指定 schema 中的資料表\n"

#: vacuumdb.c:372
#, c-format
msgid "  -N, --exclude-schema=SCHEMA     do not vacuum tables in the specified schema(s)\n"
msgstr "  -N, --exclude-schema=SCHEMA     不清理指定 schema 中的資料表\n"

#: vacuumdb.c:373
#, c-format
msgid "  -P, --parallel=PARALLEL_WORKERS use this many background workers for vacuum, if available\n"
msgstr "  -P, --parallel=PARALLEL_WORKERS 可用時使用指定數量的背景工作行程進行清理\n"

#: vacuumdb.c:374
#, c-format
msgid "  -q, --quiet                     don't write any messages\n"
msgstr "  -q, --quiet                     不輸出任何訊息\n"

#: vacuumdb.c:375
#, c-format
msgid "      --skip-locked               skip relations that cannot be immediately locked\n"
msgstr "      --skip-locked               跳過無法立即鎖定的關聯\n"

#: vacuumdb.c:376
#, c-format
msgid "  -t, --table='TABLE[(COLUMNS)]'  vacuum specific table(s) only\n"
msgstr "  -t, --table='TABLE[(COLUMNS)]'  僅清理指定的資料表\n"

#: vacuumdb.c:377
#, c-format
msgid "  -v, --verbose                   write a lot of output\n"
msgstr "  -v, --verbose                   產生詳細輸出\n"

#: vacuumdb.c:378
#, c-format
msgid "  -V, --version                   output version information, then exit\n"
msgstr "  -V, --version                   顯示版本，然後結束\n"

#: vacuumdb.c:379
#, c-format
msgid "  -z, --analyze                   update optimizer statistics\n"
msgstr "  -z, --analyze                   更新最佳化工具統計資料\n"

#: vacuumdb.c:380
#, c-format
msgid "  -Z, --analyze-only              only update optimizer statistics; no vacuum\n"
msgstr "  -Z, --analyze-only              只更新最佳化工具統計資料；不清理\n"

#: vacuumdb.c:381
#, c-format
msgid ""
"      --analyze-in-stages         only update optimizer statistics, in multiple\n"
"                                  stages for faster results; no vacuum\n"
msgstr "      --analyze-in-stages         只更新最佳化工具統計資料，分多個階段\n                                  以更快獲得結果；不執行清理\n"

#: vacuumdb.c:383
#, c-format
msgid "  -?, --help                      show this help, then exit\n"
msgstr "  -?, --help                      顯示說明，然後結束\n"

#: vacuumdb.c:391
#, c-format
msgid ""
"\n"
"Read the description of the SQL command VACUUM for details.\n"
msgstr ""
"\n"
"請參考 SQL 命令 VACUUM 的說明。\n"

#: vacuuming.c:198
msgid "Generating minimal optimizer statistics (1 target)"
msgstr "正在產生最少的最佳化工具統計資料 (統計目標為 1)"

#: vacuuming.c:199
msgid "Generating medium optimizer statistics (10 targets)"
msgstr "正在產生中等數量的最佳化工具統計資料 (統計目標為 10)"

#: vacuuming.c:200
msgid "Generating default (full) optimizer statistics"
msgstr "正在產生預設的完整最佳化工具統計資料"

