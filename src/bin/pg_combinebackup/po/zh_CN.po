msgstr "无法访问目录 \"%s\": %m"

#: pg_combinebackup.c:780
#, c-format
msgid ""
"%s reconstructs full backups from incrementals.\n"
"\n"
msgstr ""
"%s 根据增量备份重建完整备份。\n"
"\n"

#: pg_combinebackup.c:781
#, c-format
msgid "Usage:\n"
msgstr "用法:\n"

#: pg_combinebackup.c:782
#, c-format
msgid "  %s [OPTION]... DIRECTORY...\n"
msgstr "  %s [选项]... 目录...\n"

#: pg_combinebackup.c:783
#, c-format
msgid ""
"\n"
"Options:\n"
msgstr ""
"\n"
"选项:\n"

#: pg_combinebackup.c:784
#, c-format
msgid "  -d, --debug               generate lots of debugging output\n"
msgstr "  -d, --debug               产生大量的调试信息\n"

#: pg_combinebackup.c:785
#, c-format
msgid "  -k, --link                link files instead of copying\n"
msgstr "  -k, --link                链接文件而不是复制文件\n"

#: pg_combinebackup.c:786
#, c-format
msgid "  -n, --dry-run             do not actually do anything\n"
msgstr "  -n, --dry-run             实际不执行任何操作\n"

#: pg_combinebackup.c:787
#, c-format
msgid ""
"  -N, --no-sync             do not wait for changes to be written safely to "
"disk\n"
msgstr "  -N, --no-sync             不等待变更安全写入磁盘\n"

#: pg_combinebackup.c:788
#, c-format
msgid "  -o, --output=DIRECTORY    output directory\n"
msgstr "  -o, --output=DIRECTORY    输出目录\n"

#: pg_combinebackup.c:789
#, c-format
msgid ""
"  -T, --tablespace-mapping=OLDDIR=NEWDIR\n"
"                            relocate tablespace in OLDDIR to NEWDIR\n"
msgstr ""
"  -T, --tablespace-mapping=OLDDIR=NEWDIR\n"
"                            将 OLDDIR 中的表空间重定位到 NEWDIR\n"

#: pg_combinebackup.c:791
#, c-format
msgid "      --clone               clone (reflink) files instead of copying\n"
msgstr "      --clone               克隆（reflink）文件而不是复制文件\n"

#: pg_combinebackup.c:792
#, c-format
msgid "      --copy                copy files (default)\n"
msgstr "      --copy                复制文件（默认）\n"

#: pg_combinebackup.c:793
#, c-format
msgid "      --copy-file-range     copy using copy_file_range() system call\n"
msgstr "      --copy-file-range     使用 copy_file_range() 系统调用复制\n"

#: pg_combinebackup.c:794
#, c-format
msgid ""
"      --manifest-checksums=SHA{224,256,384,512}|CRC32C|NONE\n"
"                            use algorithm for manifest checksums\n"
msgstr ""
"      --manifest-checksums=SHA{224,256,384,512}|CRC32C|NONE\n"
"                            使用指定算法计算清单校验和\n"

#: pg_combinebackup.c:796
#, c-format
msgid "      --no-manifest         suppress generation of backup manifest\n"
msgstr "      --no-manifest         不生成备份清单\n"

#: pg_combinebackup.c:797
#, c-format
msgid "      --sync-method=METHOD  set method for syncing files to disk\n"
msgstr "      --sync-method=METHOD  设置将文件同步到磁盘的方法\n"

#: pg_combinebackup.c:798
#, c-format
msgid "  -V, --version             output version information, then exit\n"
msgstr "  -V, --version             输出版本信息，然后退出\n"

#: pg_combinebackup.c:799
#, c-format
msgid "  -?, --help                show this help, then exit\n"
msgstr "  -?, --help                显示此帮助，然后退出\n"

#: pg_combinebackup.c:801
#, c-format
msgid ""
"\n"
"Report bugs to <%s>.\n"
msgstr ""
"\n"
"请向 <%s> 报告缺陷。\n"

#: pg_combinebackup.c:802
#, c-format
msgid "%s home page: <%s>\n"
msgstr "%s 主页: <%s>\n"

