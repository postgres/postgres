#, c-format
msgid ""
"  --exclude-table-data-and-children=PATTERN\n"
"                               do NOT dump data for the specified table(s),\n"
"                               including child and partition tables\n"
msgstr ""
"  --exclude-table-data-and-children=PATTERN\n"
"                               NON esportare i dati delle tabelle specificate,\n"
