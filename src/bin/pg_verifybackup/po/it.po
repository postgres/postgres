#: pg_verifybackup.c:1390
#, c-format
msgid ""
"%s verifies a backup against the backup manifest.\n"
"\n"
msgstr ""
"%s verifica un backup rispetto al manifest di backup.\n"
"\n"

#: pg_verifybackup.c:1391
#, c-format
msgid ""
"Usage:\n"
"  %s [OPTION]... BACKUPDIR\n"
"\n"
msgstr ""
"Uso:\n"
"  %s [OPZIONE]... DIRBACKUP\n"
"\n"

#: pg_verifybackup.c:1392
#, c-format
msgid "Options:\n"
msgstr "Opzioni:\n"

#: pg_verifybackup.c:1393
#, c-format
msgid "  -e, --exit-on-error         exit immediately on error\n"
msgstr "  -e, --exit-on-error         esci immediatamente in caso di errore\n"

#: pg_verifybackup.c:1394
#, c-format
msgid "  -F, --format=p|t            backup format (plain, tar)\n"
msgstr "  -F, --format=p|t            formato del backup (plain, tar)\n"

#: pg_verifybackup.c:1395
#, c-format
msgid "  -i, --ignore=RELATIVE_PATH  ignore indicated path\n"
msgstr "  -i, --ignore=PERCORSO_RELATIVO  ignora il percorso indicato\n"

#: pg_verifybackup.c:1396
#, c-format
msgid "  -m, --manifest-path=PATH    use specified path for manifest\n"
msgstr "  -m, --manifest-path=PERCORSO usa il percorso specificato per il manifest\n"

#: pg_verifybackup.c:1397
#, c-format
msgid "  -n, --no-parse-wal          do not try to parse WAL files\n"
msgstr "  -n, --no-parse-wal          non provare ad analizzare i file WAL\n"

#: pg_verifybackup.c:1398
#, c-format
msgid "  -P, --progress              show progress information\n"
msgstr "  -P, --progress              mostra le informazioni di avanzamento\n"

#: pg_verifybackup.c:1399
#, c-format
msgid "  -q, --quiet                 do not print any output, except for errors\n"
msgstr "  -q, --quiet                 non stampare alcun output, tranne gli errori\n"

#: pg_verifybackup.c:1400
#, c-format
msgid "  -s, --skip-checksums        skip checksum verification\n"
msgstr "  -s, --skip-checksums        salta la verifica dei checksum\n"

#: pg_verifybackup.c:1401
#, c-format
msgid "  -w, --wal-path=PATH         use specified path for WAL files\n"
msgstr "  -w, --wal-path=PERCORSO     usa il percorso specificato per i file WAL\n"

#: pg_verifybackup.c:1402
#, c-format
msgid "      --wal-directory=PATH    (same as --wal-path, deprecated)\n"
msgstr "      --wal-directory=PERCORSO (equivalente a --wal-path, deprecato)\n"

#: pg_verifybackup.c:1403
#, c-format
msgid "  -V, --version               output version information, then exit\n"
msgstr ""
"  -V, --version                mostra le informazioni sulla versione, poi esci\n"

#: pg_verifybackup.c:1404
#, c-format
msgid "  -?, --help                  show this help, then exit\n"
msgstr "  -?, --help                   mostra questo aiuto, poi esci\n"

