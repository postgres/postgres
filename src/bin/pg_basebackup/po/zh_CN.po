msgstr "无法关闭压缩文件 \"%s\": %m"

#: pg_basebackup.c:1291 pg_recvlogical.c:635
#, c-format
msgid "could not close file \"%s\": %m"
msgstr "无法关闭文件 \"%s\": %m"

#: pg_basebackup.c:1553
#, c-format
