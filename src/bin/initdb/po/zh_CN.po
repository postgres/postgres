#: initdb.c:2393
#, c-format
msgid ""
"The program \"%s\" was found by \"%s\"\n"
"but was not the same version as %s.\n"
"Check your installation."
msgstr ""
"程序 \"%s\" 已由 \"%s\" 找到，\n"
"但与 %s 版本不一致。\n"
"请检查安装。"

