#: option.c:306
#, c-format
msgid ""
"pg_upgrade upgrades a PostgreSQL cluster to a different major version.\n"
"\n"
msgstr ""
"pg_upgrade 將 PostgreSQL 叢集升級到不同的主要版本。\n"
"\n"

#: option.c:307
#, c-format
msgid "Usage:\n"
msgstr "用法:\n"

#: option.c:308
#, c-format
msgid ""
"  pg_upgrade [OPTION]...\n"
"\n"
msgstr "  pg_upgrade [選項]...\n\n"

# postmaster/postmaster.c:1017 tcop/postgres.c:2115
#: option.c:309
#, c-format
msgid "Options:\n"
msgstr "選項:\n"

#: option.c:310
#, c-format
msgid "  -b, --old-bindir=BINDIR       old cluster executable directory\n"
msgstr "  -b, --old-bindir=BINDIR       舊叢集執行檔目錄\n"

#: option.c:311
#, c-format
msgid ""
"  -B, --new-bindir=BINDIR       new cluster executable directory (default\n"
"                                same directory as pg_upgrade)\n"
msgstr "  -B, --new-bindir=BINDIR       新叢集執行檔目錄(預設與 pg_upgrade 相同目錄)\n"

#: option.c:313
#, c-format
msgid "  -c, --check                   check clusters only, don't change any data\n"
msgstr "  -c, --check                   只檢查叢集，不變更任何資料\n"

#: option.c:314
#, c-format
msgid "  -d, --old-datadir=DATADIR     old cluster data directory\n"
msgstr "  -d, --old-datadir=DATADIR     舊叢集資料目錄\n"

#: option.c:315
#, c-format
msgid "  -D, --new-datadir=DATADIR     new cluster data directory\n"
msgstr "  -D, --new-datadir=DATADIR     新叢集資料目錄\n"

#: option.c:316
#, c-format
msgid "  -j, --jobs=NUM                number of simultaneous processes or threads to use\n"
msgstr "  -j, --jobs=NUM                同時使用的行程或執行緒數目\n"

#: option.c:317
#, c-format
msgid "  -k, --link                    link instead of copying files to new cluster\n"
msgstr "  -k, --link                    連結檔案至新叢集，而非複製\n"

#: option.c:318
#, c-format
msgid "  -N, --no-sync                 do not wait for changes to be written safely to disk\n"
msgstr "  -N, --no-sync                 不等待變更安全寫入磁碟\n"

#: option.c:319
#, c-format
msgid "  -o, --old-options=OPTIONS     old cluster options to pass to the server\n"
msgstr "  -o, --old-options=OPTIONS     傳遞給伺服器的舊叢集選項\n"

#: option.c:320
#, c-format
msgid "  -O, --new-options=OPTIONS     new cluster options to pass to the server\n"
msgstr "  -O, --new-options=OPTIONS     傳遞給伺服器的新叢集選項\n"

#: option.c:321
#, c-format
msgid "  -p, --old-port=PORT           old cluster port number (default %d)\n"
msgstr "  -p, --old-port=PORT           舊叢集連接埠(預設 %d)\n"

#: option.c:322
#, c-format
msgid "  -P, --new-port=PORT           new cluster port number (default %d)\n"
msgstr "  -P, --new-port=PORT           新叢集連接埠(預設 %d)\n"

#: option.c:323
#, c-format
msgid "  -r, --retain                  retain SQL and log files after success\n"
msgstr "  -r, --retain                  在成功後保留 SQL 和日誌檔案\n"

#: option.c:324
#, c-format
msgid "  -s, --socketdir=DIR           socket directory to use (default current dir.)\n"
msgstr "  -s, --socketdir=DIR           使用的 socket 目錄(預設為目前目錄)\n"

#: option.c:325
#, c-format
msgid "  -U, --username=NAME           cluster superuser (default \"%s\")\n"
msgstr "  -U, --username=NAME           叢集超級使用者(預設為 \"%s\")\n"

#: option.c:326
#, c-format
msgid "  -v, --verbose                 enable verbose internal logging\n"
msgstr "  -v, --verbose                 啟動詳細的內部記錄\n"

#: option.c:327
#, c-format
msgid "  -V, --version                 display version information, then exit\n"
msgstr "  -V, --version                 顯示版本，然後結束\n"

#: option.c:328
#, c-format
msgid "  --clone                       clone instead of copying files to new cluster\n"
msgstr "  --clone                       clone 檔案至新叢集而非複製\n"

#: option.c:329
#, c-format
msgid "  --copy                        copy files to new cluster (default)\n"
msgstr "  --copy                        複製檔案至新叢集(預設)\n"

#: option.c:330
#, c-format
msgid "  --copy-file-range             copy files to new cluster with copy_file_range\n"
msgstr "  --copy-file-range             使用 copy_file_range 將檔案複製到新叢集\n"

# tcop/postgres.c:2129
#: option.c:331
#, c-format
msgid "  --no-statistics               do not import statistics from old cluster\n"
msgstr "  --no-statistics               不從舊叢集匯入統計資料\n"

#: option.c:332
#, c-format
msgid ""
"  --set-char-signedness=OPTION  set new cluster char signedness to \"signed\" or\n"
"                                \"unsigned\"\n"
msgstr "  --set-char-signedness=OPTION  將新叢集的 char 符號屬性設為 \"signed\" 或\n                                \"unsigned\"\n"

#: option.c:334
#, c-format
msgid "  --swap                        move data directories to new cluster\n"
msgstr "  --swap                        將資料目錄移動到新叢集\n"

#: option.c:335
#, c-format
msgid "  --sync-method=METHOD          set method for syncing files to disk\n"
msgstr "  --sync-method=METHOD          設定將檔案同步到磁碟的方法\n"

#: option.c:336
#, c-format
msgid "  -?, --help                    show this help, then exit\n"
msgstr "  -?, --help                    顯示說明，然後結束\n"

#: option.c:337
#, c-format
msgid ""
"\n"
"Before running pg_upgrade you must:\n"
"  create a new database cluster (using the new version of initdb)\n"
"  shutdown the postmaster servicing the old cluster\n"
"  shutdown the postmaster servicing the new cluster\n"
msgstr "\n在執行 pg_upgrade 之前，您必須:\n  建立新的資料庫叢集(使用新版本的 initdb)\n  關閉舊叢集的 postmaster\n  關閉新叢集的 postmaster\n"

#: option.c:342
#, c-format
msgid ""
"\n"
"When you run pg_upgrade, you must provide the following information:\n"
"  the data directory for the old cluster  (-d DATADIR)\n"
"  the data directory for the new cluster  (-D DATADIR)\n"
"  the \"bin\" directory for the old version (-b BINDIR)\n"
"  the \"bin\" directory for the new version (-B BINDIR)\n"
msgstr "\n當您執行 pg_upgrade 時，必須提供以下資訊:\n  舊叢集的資料目錄                        (-d DATADIR)\n  新叢集的資料目錄                        (-D DATADIR)\n  舊版本的 \"bin\" 目錄                     (-b BINDIR)\n  新版本的 \"bin\" 目錄                     (-B BINDIR)\n"

#: option.c:348
#, c-format
msgid ""
"\n"
"For example:\n"
"  pg_upgrade -d oldCluster/data -D newCluster/data -b oldCluster/bin -B newCluster/bin\n"
"or\n"
msgstr ""
"\n"
"例如:\n"
"  pg_upgrade -d oldCluster/data -D newCluster/data -b oldCluster/bin -B newCluster/bin\n"
"或\n"

#: option.c:353
#, c-format
msgid ""
"  $ export PGDATAOLD=oldCluster/data\n"
"  $ export PGDATANEW=newCluster/data\n"
"  $ export PGBINOLD=oldCluster/bin\n"
"  $ export PGBINNEW=newCluster/bin\n"
"  $ pg_upgrade\n"
msgstr ""
"  $ export PGDATAOLD=oldCluster/data\n"
"  $ export PGDATANEW=newCluster/data\n"
"  $ export PGBINOLD=oldCluster/bin\n"
"  $ export PGBINNEW=newCluster/bin\n"
"  $ pg_upgrade\n"

