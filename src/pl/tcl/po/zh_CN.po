#: pltcl.c:467
msgid "PL/Tcl function to call once when pltcl is first used."
msgstr "首次使用 pltcl 时调用一次的 PL/Tcl 函数。"

#: pltcl.c:474
msgid "PL/TclU function to call once when pltclu is first used."
msgstr "首次使用 pltclu 时调用一次的 PL/TclU 函数。"

#: pltcl.c:638
#, c-format
msgid "function \"%s\" is in the wrong language"
msgstr "函数 \"%s\" 所用语言错误"

#: pltcl.c:649
#, c-format
msgid "function \"%s\" must not be SECURITY DEFINER"
msgstr "函数 \"%s\" 不得为 SECURITY DEFINER"

#. translator: %s is "pltcl.start_proc" or "pltclu.start_proc"
#: pltcl.c:683
#, c-format
msgid "processing %s parameter"
msgstr "正在处理 %s 参数"

#: pltcl.c:837
#, c-format
msgid "set-valued function called in context that cannot accept a set"
msgstr "在不能接受集合的上下文中调用返回集合的函数"

#: pltcl.c:1010
#, c-format
msgid ""
"function returning record called in context that cannot accept type record"
msgstr "在不能接受 record 类型的上下文中调用返回 record 类型的函数"

#: pltcl.c:1029
#, c-format
msgid "could not parse function return value: %s"
msgstr "无法解析函数返回值: %s"

#: pltcl.c:1297
#, c-format
msgid "could not parse trigger return value: %s"
msgstr "无法解析触发器返回值: %s"

#: pltcl.c:1382 pltcl.c:1816
#, c-format
msgid "%s"
msgstr "%s"

#: pltcl.c:1383
#, c-format
msgid ""
"%s\n"
"in PL/Tcl function \"%s\""
msgstr ""
"%s\n"
"在 PL/Tcl 函数 \"%s\" 中"

#: pltcl.c:1548
#, c-format
msgid "trigger functions can only be called as triggers"
msgstr "触发器函数只能以触发器的形式调用"

#: pltcl.c:1552
#, c-format
msgid "PL/Tcl functions cannot return type %s"
msgstr "PL/Tcl 函数不能返回类型 %s"

#: pltcl.c:1590
#, c-format
msgid "PL/Tcl functions cannot accept type %s"
msgstr "PL/Tcl 函数不能接受类型为 %s 的参数"

#: pltcl.c:1706
#, c-format
msgid "could not create internal procedure \"%s\": %s"
msgstr "无法创建内部过程 \"%s\": %s"

#: pltcl.c:3210
#, c-format
msgid "column name/value list must have even number of elements"
msgstr "列名/值列表必须具有偶数个元素"

#: pltcl.c:3228
#, c-format
msgid "column name/value list contains nonexistent column name \"%s\""
msgstr "列名/值列表包含不存在的列名 \"%s\""

#: pltcl.c:3235
#, c-format
msgid "cannot set system attribute \"%s\""
msgstr "不能设置系统属性 \"%s\""

#: pltcl.c:3241
#, c-format
msgid "cannot set generated column \"%s\""
msgstr "不能设置生成列 \"%s\""

#, c-format
#~ msgid "could not split return value from trigger: %s"
#~ msgstr "无法分离来自触发器的返回值：%s"
