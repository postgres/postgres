#: check.c:75
#, c-format
msgid ""
"Performing Consistency Checks on Old Live Server\n"
"------------------------------------------------\n"
msgstr ""
"正在对运行中的旧服务器执行一致性检查\n"
"------------------------------------------------\n"

#: check.c:81
#, c-format
msgid ""
"Performing Consistency Checks\n"
"-----------------------------\n"
msgstr ""
"正在执行一致性检查\n"
"-----------------------------\n"

#: check.c:242
#, c-format
msgid ""
"\n"
"*Clusters are compatible*\n"
msgstr ""
"\n"
"*集簇兼容*\n"

#: check.c:248
#, c-format
msgid ""
"\n"
"If pg_upgrade fails after this point, you must re-initdb the\n"
"new cluster before continuing.\n"
msgstr ""
"\n"
"如果 pg_upgrade 在此之后失败，必须重新对新集簇执行 initdb，\n"
"然后才能继续。\n"

#: check.c:293
#, c-format
msgid ""
"Optimizer statistics are not transferred by pg_upgrade.\n"
"Once you start the new server, consider running:\n"
"    %s/vacuumdb %s--all --analyze-in-stages\n"
"\n"
msgstr ""
"pg_upgrade 不会传输优化器统计信息。\n"
"启动新服务器后，考虑运行:\n"
"    %s/vacuumdb %s--all --analyze-in-stages\n"
"\n"

#: check.c:299
#, c-format
msgid ""
"Running this script will delete the old cluster's data files:\n"
"    %s\n"
msgstr ""
"运行此脚本将删除旧集簇的数据文件:\n"
"    %s\n"

#: check.c:304
#, c-format
msgid ""
"Could not create a script to delete the old cluster's data files\n"
"because user-defined tablespaces or the new cluster's data directory\n"
"exist in the old cluster directory.  The old cluster's contents must\n"
"be deleted manually.\n"
msgstr ""
"无法创建删除旧集簇数据文件的脚本，\n"
"因为用户定义的表空间或新集簇的数据目录\n"
"位于旧集簇目录内。必须手动删除\n"
"旧集簇的内容。\n"

#: check.c:316
#, c-format
msgid "Checking cluster versions"
msgstr "正在检查集簇版本"

#: check.c:333
#, c-format
msgid "This utility can only upgrade from PostgreSQL version 9.0 and later.\n"
msgstr "此工具只能从 PostgreSQL 9.0 及更高版本升级。\n"

#: check.c:337
#, c-format
msgid "This utility can only upgrade to PostgreSQL version %s.\n"
msgstr "此工具只能升级到 PostgreSQL %s。\n"

#: check.c:346
#, c-format
msgid ""
"This utility cannot be used to downgrade to older major PostgreSQL "
"versions.\n"
msgstr "此工具不能用于降级到较旧的 PostgreSQL 主版本。\n"

#: check.c:351
#, c-format
msgid ""
"Old cluster data and binary directories are from different major versions.\n"
msgstr "旧集簇的数据目录与可执行文件目录来自不同的主版本。\n"

#: check.c:354
#, c-format
msgid ""
"New cluster data and binary directories are from different major versions.\n"
msgstr "新集簇的数据目录与可执行文件目录来自不同的主版本。\n"

#: check.c:371
#, c-format
msgid ""
"When checking a pre-PG 9.1 live old server, you must specify the old "
"server's port number.\n"
msgstr "检查运行中的 PG 9.1 之前版本的旧服务器时，必须指定旧服务器的端口号。\n"

#: check.c:375
#, c-format
msgid ""
"When checking a live server, the old and new port numbers must be "
"different.\n"
msgstr "检查运行中的服务器时，新旧端口号必须不同。\n"

#: check.c:390
#, c-format
msgid "encodings for database \"%s\" do not match:  old \"%s\", new \"%s\"\n"
msgstr "数据库 \"%s\" 的编码不匹配: 旧值 \"%s\", 新值 \"%s\"\n"

#: check.c:395
#, c-format
msgid ""
"lc_collate values for database \"%s\" do not match:  old \"%s\", new \"%s\"\n"
msgstr "数据库 \"%s\" 的 lc_collate 值不匹配: 旧值 \"%s\", 新值 \"%s\"\n"

#: check.c:398
#, c-format
msgid ""
"lc_ctype values for database \"%s\" do not match:  old \"%s\", new \"%s\"\n"
msgstr "数据库 \"%s\" 的 lc_ctype 值不匹配: 旧值 \"%s\", 新值 \"%s\"\n"

#: check.c:471
#, c-format
msgid "New cluster database \"%s\" is not empty: found relation \"%s.%s\"\n"
msgstr "新集簇数据库 \"%s\" 不为空: 发现关系 \"%s.%s\"\n"

#: check.c:528
#, c-format
msgid "Checking for new cluster tablespace directories"
msgstr "正在检查新集簇的表空间目录"

#: check.c:539
#, c-format
msgid "new cluster tablespace directory already exists: \"%s\"\n"
msgstr "新集簇的表空间目录已存在: \"%s\"\n"

#: check.c:572
#, c-format
msgid ""
"\n"
"WARNING:  new data directory should not be inside the old data directory, "
"e.g. %s\n"
msgstr ""
"\n"
"警告:  新数据目录不宜位于旧数据目录内，例如 %s\n"

#: check.c:596
#, c-format
msgid ""
"\n"
"WARNING:  user-defined tablespace locations should not be inside the data "
"directory, e.g. %s\n"
msgstr ""
"\n"
"警告:  用户定义的表空间位置不宜位于数据目录内，例如 %s\n"

#: check.c:606
#, c-format
msgid "Creating script to delete old cluster"
msgstr "正在创建删除旧集簇的脚本"

#: check.c:609 check.c:873 check.c:971 check.c:1101 check.c:1179 check.c:1258
#: check.c:1553 file.c:338 function.c:240 option.c:497 version.c:54
#: version.c:204 version.c:407 version.c:542
#, c-format
msgid "could not open file \"%s\": %s\n"
msgstr "无法打开文件 \"%s\": %s\n"

#: check.c:665
#, c-format
msgid "could not add execute permission to file \"%s\": %s\n"
msgstr "无法为文件 \"%s\" 添加执行权限: %s\n"

#: check.c:685
#, c-format
msgid "Checking database user is the install user"
msgstr "正在检查数据库用户是否为安装用户"

#: check.c:701
#, c-format
msgid "database user \"%s\" is not the install user\n"
msgstr "数据库用户 \"%s\" 不是安装用户\n"

#: check.c:712
#, c-format
msgid "could not determine the number of users\n"
msgstr "无法确定用户数量\n"

#: check.c:720
#, c-format
msgid "Only the install user can be defined in the new cluster.\n"
msgstr "新集簇中只能定义安装用户。\n"

#: check.c:740
#, c-format
msgid "Checking database connection settings"
msgstr "正在检查数据库连接设置"

#: check.c:762
#, c-format
msgid ""
"template0 must not allow connections, i.e. its pg_database.datallowconn must "
"be false\n"
msgstr "template0 不得允许连接，即其 pg_database.datallowconn 必须为 false\n"

#: check.c:772
#, c-format
msgid ""
"All non-template0 databases must allow connections, i.e. their "
"pg_database.datallowconn must be true\n"
msgstr ""
"除 template0 外的所有数据库都必须允许连接，即它们的 pg_database.datallowconn "
"必须为 true\n"

#: check.c:797
#, c-format
msgid "Checking for prepared transactions"
msgstr "正在检查预备事务"

#: check.c:806
#, c-format
msgid "The source cluster contains prepared transactions\n"
msgstr "源集簇包含预备事务\n"

#: check.c:808
#, c-format
msgid "The target cluster contains prepared transactions\n"
msgstr "目标集簇包含预备事务\n"

#: check.c:834
#, c-format
msgid "Checking for contrib/isn with bigint-passing mismatch"
msgstr "正在检查 contrib/isn 的 bigint 参数传递方式是否不匹配"

#: check.c:895 check.c:996 check.c:1121 check.c:1201 check.c:1278 check.c:1336
#: check.c:1395 check.c:1429 check.c:1458 check.c:1576 function.c:262
#: version.c:278 version.c:316 version.c:491
#, c-format
msgid "fatal\n"
msgstr "致命错误\n"

#: check.c:896
#, c-format
msgid ""
"Your installation contains \"contrib/isn\" functions which rely on the\n"
"bigint data type.  Your old and new clusters pass bigint values\n"
"differently so this cluster cannot currently be upgraded.  You can\n"
"manually dump databases in the old cluster that use \"contrib/isn\"\n"
"facilities, drop them, perform the upgrade, and then restore them.  A\n"
"list of the problem functions is in the file:\n"
"    %s\n"
"\n"
msgstr ""
"您的安装有依赖 bigint 数据类型的 \"contrib/isn\" 函数。\n"
"新旧集簇传递 bigint 值的方式不同，因此当前不能升级此集簇。\n"
"可以手动转储旧集簇中使用 \"contrib/isn\" 功能的数据库，\n"
"删除这些数据库，执行升级，然后将其恢复。\n"
"有问题的函数列在以下文件中:\n"
"    %s\n"
"\n"

#: check.c:919
#, c-format
msgid "Checking for user-defined postfix operators"
msgstr "正在检查用户定义的后缀操作符"

#: check.c:997
#, c-format
msgid ""
"Your installation contains user-defined postfix operators, which are not\n"
"supported anymore.  Consider dropping the postfix operators and replacing\n"
"them with prefix operators or function calls.\n"
"A list of user-defined postfix operators is in the file:\n"
"    %s\n"
"\n"
msgstr ""
"您的安装包含已不再受支持的\n"
"用户定义后缀操作符。考虑删除这些后缀操作符，并用\n"
"前缀操作符或函数调用替代。\n"
"用户定义的后缀操作符列在以下文件中:\n"
"    %s\n"
"\n"

#: check.c:1021
#, c-format
msgid "Checking for incompatible polymorphic functions"
msgstr "正在检查不兼容的多态函数"

#: check.c:1122
#, c-format
msgid ""
"Your installation contains user-defined objects that refer to internal\n"
"polymorphic functions with arguments of type \"anyarray\" or "
"\"anyelement\".\n"
"These user-defined objects must be dropped before upgrading and restored\n"
"afterwards, changing them to refer to the new corresponding functions with\n"
"arguments of type \"anycompatiblearray\" and \"anycompatible\".\n"
"A list of the problematic objects is in the file:\n"
"    %s\n"
"\n"
msgstr ""
"您的安装包含引用内部多态函数的用户定义对象，\n"
"这些函数的参数类型为 \"anyarray\" 或 \"anyelement\"。\n"
"必须在升级前删除这些用户定义对象，并在升级后恢复，\n"
"同时将其改为引用相应的新函数，\n"
"新函数的参数类型为 \"anycompatiblearray\" 和 \"anycompatible\"。\n"
"有问题的对象列在以下文件中:\n"
"    %s\n"
"\n"

#: check.c:1147
#, c-format
msgid "Checking for tables WITH OIDS"
msgstr "正在检查使用 WITH OIDS 的表"

#: check.c:1202
#, c-format
msgid ""
"Your installation contains tables declared WITH OIDS, which is not\n"
"supported anymore.  Consider removing the oid column using\n"
"    ALTER TABLE ... SET WITHOUT OIDS;\n"
"A list of tables with the problem is in the file:\n"
"    %s\n"
"\n"
msgstr ""
"您的安装包含以 WITH OIDS 声明的表，此方式已\n"
"不再受支持。考虑使用以下命令删除 oid 列:\n"
"    ALTER TABLE ... SET WITHOUT OIDS;\n"
"有问题的表列在以下文件中:\n"
"    %s\n"
"\n"

#: check.c:1227
#, c-format
msgid "Checking for not-null constraint inconsistencies"
msgstr "正在检查非空约束的不一致"

#: check.c:1279
#, c-format
msgid ""
"Your installation contains inconsistent NOT NULL constraints.\n"
"If the parent column(s) are NOT NULL, then the child column must\n"
"also be marked NOT NULL, or the upgrade will fail.\n"
"You can fix this by running\n"
"    ALTER TABLE tablename ALTER column SET NOT NULL;\n"
"on each column listed in the file:\n"
"    %s\n"
"\n"
msgstr ""
"您的安装中存在不一致的 NOT NULL 约束。\n"
"如果父表的列为 NOT NULL，子表的对应列也必须标记为 NOT NULL，\n"
"否则升级将失败。可以运行以下命令来修复:\n"
"    ALTER TABLE tablename ALTER column SET NOT NULL;\n"
"对以下文件中列出的每一列都执行此操作:\n"
"    %s\n"
"\n"

#: check.c:1308
#, c-format
msgid "Checking for system-defined composite types in user tables"
msgstr "正在检查用户表中的系统定义复合类型"

#: check.c:1337
#, c-format
msgid ""
"Your installation contains system-defined composite type(s) in user tables.\n"
"These type OIDs are not stable across PostgreSQL versions,\n"
"so this cluster cannot currently be upgraded.  You can\n"
"drop the problem columns and restart the upgrade.\n"
"A list of the problem columns is in the file:\n"
"    %s\n"
"\n"
msgstr ""
"您的安装在用户表中包含系统定义的复合类型。\n"
"这些类型的 OID 在不同 PostgreSQL 版本间并不稳定，\n"
"因此当前不能升级此集簇。可以删除有问题的列，然后重新开始升级。\n"
"有问题的列的列表位于文件:\n"
"    %s\n"
"\n"

#: check.c:1365
#, c-format
msgid "Checking for reg* data types in user tables"
msgstr "正在检查用户表中的 reg* 数据类型"

#: check.c:1396
#, c-format
msgid ""
"Your installation contains one of the reg* data types in user tables.\n"
"These data types reference system OIDs that are not preserved by\n"
"pg_upgrade, so this cluster cannot currently be upgraded.  You can\n"
"drop the problem columns and restart the upgrade.\n"
"A list of the problem columns is in the file:\n"
"    %s\n"
"\n"
msgstr ""
"您的安装在用户表中包含某种 reg* 数据类型。\n"
"这些数据类型引用 pg_upgrade 不会保留的系统 OID，\n"
"因此当前不能升级此集簇。可以删除有问题的列，然后重新开始升级。\n"
"有问题的列的列表位于文件:\n"
"    %s\n"
"\n"

#: check.c:1420
#, c-format
msgid "Checking for removed \"%s\" data type in user tables"
msgstr "正在检查用户表中已移除的 \"%s\" 数据类型"

#: check.c:1430
#, c-format
msgid ""
"Your installation contains the \"%s\" data type in user tables.\n"
"The \"%s\" type has been removed in PostgreSQL version %s,\n"
"so this cluster cannot currently be upgraded.  You can drop the\n"
"problem columns, or change them to another data type, and restart\n"
"the upgrade.  A list of the problem columns is in the file:\n"
"    %s\n"
"\n"
msgstr ""
"您的安装在用户表中包含 \"%1$s\" 数据类型。\n"
"PostgreSQL %3$s 已移除 \"%2$s\" 类型，因此当前不能升级此集簇。\n"
"可以删除有问题的列，或将其改为其他数据类型，然后重新开始升级。\n"
"有问题的列的列表位于文件:\n"
"    %4$s\n"
"\n"

#: check.c:1452
#, c-format
msgid "Checking for incompatible \"jsonb\" data type"
msgstr "正在检查不兼容的 \"jsonb\" 数据类型"

#: check.c:1459
#, c-format
msgid ""
"Your installation contains the \"jsonb\" data type in user tables.\n"
"The internal format of \"jsonb\" changed during 9.4 beta so this\n"
"cluster cannot currently be upgraded.  You can\n"
"drop the problem columns and restart the upgrade.\n"
"A list of the problem columns is in the file:\n"
"    %s\n"
"\n"
msgstr ""
"您的安装在用户表中包含 \"jsonb\" 数据类型。\n"
"\"jsonb\" 的内部格式在 9.4 beta 期间已发生变化，\n"
"因此当前不能升级此集簇。可以删除有问题的列，然后重新开始升级。\n"
"有问题的列的列表位于文件:\n"
"    %s\n"
"\n"

#: check.c:1481
#, c-format
msgid "Checking for roles starting with \"pg_\""
msgstr "正在检查以 \"pg_\" 开头的角色"

#: check.c:1491
#, c-format
msgid "The source cluster contains roles starting with \"pg_\"\n"
msgstr "源集簇包含以 \"pg_\" 开头的角色\n"

#: check.c:1493
#, c-format
msgid "The target cluster contains roles starting with \"pg_\"\n"
msgstr "目标集簇包含以 \"pg_\" 开头的角色\n"

#: check.c:1514
#, c-format
msgid "Checking for user-defined encoding conversions"
msgstr "正在检查用户定义的编码转换"

#: check.c:1577
#, c-format
msgid ""
"Your installation contains user-defined encoding conversions.\n"
"The conversion function parameters changed in PostgreSQL version 14\n"
"so this cluster cannot currently be upgraded.  You can remove the\n"
"encoding conversions in the old cluster and restart the upgrade.\n"
"A list of user-defined encoding conversions is in the file:\n"
"    %s\n"
"\n"
msgstr ""
"您的安装包含用户定义的编码转换。\n"
"转换函数参数在 PostgreSQL 14 中已发生变化，\n"
"因此当前不能升级此集簇。可以删除\n"
"旧集簇中的编码转换，然后重新开始升级。\n"
"用户定义的编码转换列在以下文件中:\n"
"    %s\n"
"\n"

#: check.c:1604
#, c-format
msgid "failed to get the current locale\n"
msgstr "无法获取当前区域设置\n"

#: check.c:1613
#, c-format
msgid "failed to get system locale name for \"%s\"\n"
msgstr "无法获取 \"%s\" 的系统区域设置名称\n"

#: check.c:1619
#, c-format
msgid "failed to restore old locale \"%s\"\n"
msgstr "恢复原有区域设置 \"%s\" 失败\n"

#: controldata.c:128 controldata.c:196
#, c-format
msgid "could not get control data using %s: %s\n"
msgstr "无法使用 %s 获取控制数据: %s\n"

#: controldata.c:139
#, c-format
msgid "%d: database cluster state problem\n"
msgstr "%d: 数据库集簇状态存在问题\n"

#: controldata.c:157
#, c-format
msgid ""
"The source cluster was shut down while in recovery mode.  To upgrade, use "
"\"rsync\" as documented or shut it down as a primary.\n"
msgstr ""
"源集簇在恢复模式下关闭。若要升级，按文档说明使用 \"rsync\"，或使其作为主库关"
"闭。\n"

#: controldata.c:159
#, c-format
msgid ""
"The target cluster was shut down while in recovery mode.  To upgrade, use "
"\"rsync\" as documented or shut it down as a primary.\n"
msgstr ""
"目标集簇在恢复模式下关闭。若要升级，按文档说明使用 \"rsync\"，或使其作为主库"
"关闭。\n"

#: controldata.c:164
#, c-format
msgid "The source cluster was not shut down cleanly.\n"
msgstr "源集簇未正常关闭。\n"

#: controldata.c:166
#, c-format
msgid "The target cluster was not shut down cleanly.\n"
msgstr "目标集簇未正常关闭。\n"

#: controldata.c:177
#, c-format
msgid "The source cluster lacks cluster state information:\n"
msgstr "源集簇缺少集簇状态信息:\n"

#: controldata.c:179
#, c-format
msgid "The target cluster lacks cluster state information:\n"
msgstr "目标集簇缺少集簇状态信息:\n"

#: controldata.c:209 dump.c:53 pg_upgrade.c:335 pg_upgrade.c:371
#: relfilenode.c:243 server.c:33 util.c:79
#, c-format
msgid "%s"
msgstr "%s"

#: controldata.c:216
#, c-format
msgid "%d: pg_resetwal problem\n"
msgstr "%d: pg_resetwal 存在问题\n"

#: controldata.c:226 controldata.c:236 controldata.c:247 controldata.c:258
#: controldata.c:269 controldata.c:288 controldata.c:299 controldata.c:310
#: controldata.c:321 controldata.c:332 controldata.c:343 controldata.c:354
#: controldata.c:357 controldata.c:361 controldata.c:371 controldata.c:383
#: controldata.c:394 controldata.c:405 controldata.c:416 controldata.c:427
#: controldata.c:438 controldata.c:449 controldata.c:460 controldata.c:471
#: controldata.c:482 controldata.c:493
#, c-format
msgid "%d: controldata retrieval problem\n"
msgstr "%d: 获取控制数据时存在问题\n"

#: controldata.c:571
#, c-format
msgid "The source cluster lacks some required control information:\n"
msgstr "源集簇缺少部分必需的控制信息:\n"

#: controldata.c:574
#, c-format
msgid "The target cluster lacks some required control information:\n"
msgstr "目标集簇缺少部分必需的控制信息:\n"

#: controldata.c:577
#, c-format
msgid "  checkpoint next XID\n"
msgstr "  检查点的下一个 XID\n"

#: controldata.c:580
#, c-format
msgid "  latest checkpoint next OID\n"
msgstr "  最新检查点的下一个 OID\n"

#: controldata.c:583
#, c-format
msgid "  latest checkpoint next MultiXactId\n"
msgstr "  最新检查点的下一个 MultiXactId\n"

#: controldata.c:587
#, c-format
msgid "  latest checkpoint oldest MultiXactId\n"
msgstr "  最新检查点的最早 MultiXactId\n"

#: controldata.c:590
#, c-format
msgid "  latest checkpoint oldestXID\n"
