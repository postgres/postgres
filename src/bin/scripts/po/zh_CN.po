#, c-format
msgid ""
"  -a, --with-admin=ROLE     ROLE will be a member of new role with admin\n"
"                            option\n"
msgstr ""
"  -a, --with-admin=ROLE     ROLE 将成为新角色的成员，并具有\n"
"                            ADMIN 选项\n"

