#, c-format
msgid "postgres single-user mode in target cluster failed"
msgstr "目标集簇中的 postgres 单用户模式执行失败"

#: pg_rewind.c:1134
#, c-format
msgid "Command was: %s"
msgstr "命令为: %s"

