msgstr "  \\dD[Sx+] [PATTERN]     列出可用域\n"

# help.c:218
#: help.c:237
msgid "  \\ddp[x]  [PATTERN]     list default privileges\n"
msgstr "  \\ddp[x]  [PATTERN]     列出預設權限\n"

# help.c:228
#: help.c:238
msgid "  \\dE[Sx+] [PATTERN]     list foreign tables\n"
msgstr "  \\dE[Sx+] [PATTERN]     列出外部資料表\n"

# help.c:228
#: help.c:239
msgid "  \\des[x+] [PATTERN]     list foreign servers\n"
msgstr "  \\des[x+] [PATTERN]     列出外部伺服器\n"

# help.c:228
#: help.c:240
msgid "  \\det[x+] [PATTERN]     list foreign tables\n"
msgstr "  \\det[x+] [PATTERN]     列出外部資料表\n"

# help.c:228
#: help.c:241
msgid "  \\deu[x+] [PATTERN]     list user mappings\n"
msgstr "  \\deu[x+] [PATTERN]     列出使用者映射\n"

# help.c:222
#: help.c:242
msgid "  \\dew[x+] [PATTERN]     list foreign-data wrappers\n"
msgstr "  \\dew[x+] [PATTERN]     列出外部資料封裝程式\n"

# help.c:215
#: help.c:243
msgid ""
"  \\df[anptw][Sx+] [FUNCPTRN [TYPEPTRN ...]]\n"
"                         list [only agg/normal/procedure/trigger/window] functions\n"
msgstr "  \\df[anptw][Sx+] [FUNCPTRN [TYPEPTRN ...]]\n                         列出函式 [僅聚合/一般/程序/觸發器/視窗]\n"

# help.c:221
#: help.c:245
msgid "  \\dF[x+]  [PATTERN]     list text search configurations\n"
msgstr "  \\dF[x+]  [PATTERN]     列出文字搜尋組態\n"

# help.c:228
#: help.c:246
msgid "  \\dFd[x+] [PATTERN]     list text search dictionaries\n"
msgstr "  \\dFd[x+] [PATTERN]     列出文字搜尋字典\n"

# help.c:228
#: help.c:247
msgid "  \\dFp[x+] [PATTERN]     list text search parsers\n"
msgstr "  \\dFp[x+] [PATTERN]     列出文字搜尋解析器\n"

# help.c:228
#: help.c:248
msgid "  \\dFt[x+] [PATTERN]     list text search templates\n"
msgstr "  \\dFt[x+] [PATTERN]     列出文字搜尋範本\n"

# help.c:222
#: help.c:249
msgid "  \\dg[Sx+] [PATTERN]     list roles\n"
msgstr "  \\dg[Sx+] [PATTERN]     列出角色\n"

# help.c:220
#: help.c:250
msgid "  \\di[Sx+] [PATTERN]     list indexes\n"
msgstr "  \\di[Sx+] [PATTERN]     列出索引\n"

# help.c:225
#: help.c:251
msgid "  \\dl[x+]                list large objects, same as \\lo_list\n"
msgstr "  \\dl[x+]                列出大型物件，同 \\lo_list\n"

# help.c:228
#: help.c:252
msgid "  \\dL[Sx+] [PATTERN]     list procedural languages\n"
msgstr "  \\dL[Sx+] [PATTERN]     列出程序語言\n"

# help.c:228
#: help.c:253
msgid "  \\dm[Sx+] [PATTERN]     list materialized views\n"
msgstr "  \\dm[Sx+] [PATTERN]     列出物化檢視表\n"

# help.c:228
#: help.c:254
msgid "  \\dn[Sx+] [PATTERN]     list schemas\n"
msgstr "  \\dn[Sx+] [PATTERN]     列出 schema\n"

# help.c:224
#: help.c:255
msgid ""
"  \\do[Sx+] [OPPTRN [TYPEPTRN [TYPEPTRN]]]\n"
"                         list operators\n"
msgstr "  \\do[Sx+] [OPPTRN [TYPEPTRN [TYPEPTRN]]]\n                         列出運算子\n"

# help.c:220
#: help.c:257
msgid "  \\dO[Sx+] [PATTERN]     list collations\n"
msgstr "  \\dO[Sx+] [PATTERN]     列出定序\n"

# help.c:226
#: help.c:258
msgid "  \\dp[Sx]  [PATTERN]     list table, view, and sequence access privileges\n"
msgstr "  \\dp[Sx]  [PATTERN]     列出資料表、檢視表、序列的存取權限\n"

# help.c:228
#: help.c:259
msgid "  \\dP[itnx+] [PATTERN]   list [only index/table] partitioned relations [n=nested]\n"
msgstr "  \\dP[itnx+] [PATTERN]   列出[僅索引/資料表]的分割關聯[n=巢狀]\n"

#: help.c:260
msgid ""
"  \\drds[x] [ROLEPTRN [DBPTRN]]\n"
"                         list per-database role settings\n"
msgstr "  \\drds[x] [ROLEPTRN [DBPTRN]]\n                         列出各資料庫的角色設定\n"

# help.c:222
#: help.c:262
msgid "  \\drg[Sx] [PATTERN]     list role grants\n"
msgstr "  \\drg[Sx] [PATTERN]     列出角色授權\n"

# help.c:220
