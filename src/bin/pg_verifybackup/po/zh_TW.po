#: pg_verifybackup.c:939
#, c-format
msgid "file \"%s\" has checksum of length %d, but expected %d"
msgstr "檔案 \"%s\" 的檢查碼長度為 %d，但預期為 %d"

#: pg_verifybackup.c:943
#, c-format
msgid "checksum mismatch for file \"%s\""
msgstr "檔案 \"%s\" 的檢查碼不一致"

#: pg_verifybackup.c:969
#, c-format
msgid "WAL parsing failed for timeline %u"
msgstr "WAL 解析失敗, 時間線 %u"

#: pg_verifybackup.c:1072
#, c-format
msgid "%*s/%s kB (%d%%) verified"
msgstr "已驗證 %*s/%s kB (%d%%)"

#: pg_verifybackup.c:1089
#, c-format
msgid ""
"%s verifies a backup against the backup manifest.\n"
"\n"
msgstr ""
"%s 驗證備份和備份清單是否一致。\n"
"\n"

#: pg_verifybackup.c:1090
#, c-format
msgid ""
"Usage:\n"
"  %s [OPTION]... BACKUPDIR\n"
"\n"
msgstr "用法:\n  %s [選項]... 備份目錄\n\n"

# postmaster/postmaster.c:1017 tcop/postgres.c:2115
#: pg_verifybackup.c:1091
#, c-format
msgid "Options:\n"
msgstr "選項:\n"

#: pg_verifybackup.c:1092
#, c-format
msgid "  -e, --exit-on-error         exit immediately on error\n"
msgstr "  -e, --exit-on-error         發生錯誤立即結束\n"

#: pg_verifybackup.c:1093
#, c-format
msgid "  -i, --ignore=RELATIVE_PATH  ignore indicated path\n"
msgstr "  -i, --ignore=RELATIVE_PATH  忽略指定的路徑\n"

#: pg_verifybackup.c:1094
#, c-format
msgid "  -m, --manifest-path=PATH    use specified path for manifest\n"
msgstr "  -m, --manifest-path=PATH    指定清單的路徑\n"

#: pg_verifybackup.c:1095
#, c-format
msgid "  -n, --no-parse-wal          do not try to parse WAL files\n"
msgstr "  -n, --no-parse-wal          不嘗試解析 WAL 檔\n"

#: pg_verifybackup.c:1096
#, c-format
msgid "  -P, --progress              show progress information\n"
msgstr "  -P, --progress              顯示進度資訊\n"

#: pg_verifybackup.c:1097
#, c-format
msgid "  -q, --quiet                 do not print any output, except for errors\n"
msgstr "  -q, --quiet                 不顯示任何輸出，除了錯誤訊息\n"

#: pg_verifybackup.c:1098
#, c-format
msgid "  -s, --skip-checksums        skip checksum verification\n"
msgstr "  -s, --skip-checksums        跳過檢查碼驗證\n"

#: pg_verifybackup.c:1099
#, c-format
msgid "  -w, --wal-directory=PATH    use specified path for WAL files\n"
msgstr "  -w, --wal-directory=PATH    使用指定路徑尋找 WAL 檔\n"

#: pg_verifybackup.c:1100
#, c-format
msgid "  -V, --version               output version information, then exit\n"
msgstr "  -V, --version               顯示版本，然後結束\n"

#: pg_verifybackup.c:1101
#, c-format
msgid "  -?, --help                  show this help, then exit\n"
msgstr "  -?, --help                  顯示說明，然後結束\n"

#: pg_verifybackup.c:1102
#, c-format
msgid ""
"\n"
"Report bugs to <%s>.\n"
msgstr ""
"\n"
"回報錯誤至 <%s>。\n"

#: pg_verifybackup.c:1103
#, c-format
msgid "%s home page: <%s>\n"
msgstr "%s 首頁: <%s>\n"

#~ msgid "parsing failed"
#~ msgstr "解析失敗"

