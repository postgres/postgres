#: pg_resetwal.c:1222
#, c-format
msgid "  %s [OPTION]... DATADIR\n"
msgstr "  %s [OPÇÃO]... DATADIR\n"

#: pg_resetwal.c:1224
#, c-format
msgid ""
"\n"
"Options:\n"
msgstr ""
"\n"
"Opções:\n"

#: pg_resetwal.c:1225
#, c-format
msgid " [-D, --pgdata=]DATADIR  data directory\n"
msgstr " [-D, --pgdata=]DIRDADOS diretório de dados\n"

#: pg_resetwal.c:1226
#, c-format
msgid ""
"  -f, --force            force update to be done even after unclean shutdown or\n"
"                         if pg_control values had to be guessed\n"
msgstr "  -f, --force            forçar a atualização, mesmo após um desligamento incorreto ou se os valores do pg_control tiverem que ser supostos\n"

#: pg_resetwal.c:1228
#, c-format
msgid "  -n, --dry-run          no update, just show what would be done\n"
msgstr "  -n, --dry-run          sem atualização, apenas mostra o que seria feito\n"

#: pg_resetwal.c:1229
#, c-format
msgid "  -V, --version          output version information, then exit\n"
msgstr "  -V, --version          mostra informação sobre a versão e termina\n"

#: pg_resetwal.c:1230
#, c-format
msgid "  -?, --help             show this help, then exit\n"
msgstr "  -?, --help             mostra essa ajuda e termina\n"

#: pg_resetwal.c:1232
#, c-format
msgid ""
"\n"
"Options to override control file values:\n"
msgstr ""
"\n"
"Opções para substituir os valores do arquivo de controle:\n"

#: pg_resetwal.c:1233
#, c-format
msgid ""
"  -c, --commit-timestamp-ids=XID,XID\n"
"                                   set oldest and newest transactions bearing\n"
"                                   commit timestamp (zero means no change)\n"
msgstr ""
"  -c, --commit-timestamp-ids=XID,XID\n"
"                                   define as transações mais antiga e mais nova\n"
"                                   timestamp de efetivação (zero significa nenhuma mudança)\n"

#: pg_resetwal.c:1236
#, c-format
msgid "  -e, --epoch=XIDEPOCH             set next transaction ID epoch\n"
msgstr "  -e, --epoch=ÉPOCA_XID            define próxima época do ID de transação\n"

#: pg_resetwal.c:1237
#, c-format
msgid "  -l, --next-wal-file=WALFILE      set minimum starting location for new WAL\n"
msgstr "  -l, --next-wal-file=ARQUIVOWAL   define local inicial mínimo do WAL para novo log de transação\n"

#: pg_resetwal.c:1238
#, c-format
msgid "  -m, --multixact-ids=MXID,MXID    set next and oldest multitransaction ID\n"
msgstr "  -m, --multixact-ids=MXID,MXID    define próximo e mais velho ID de multitransação\n"

#: pg_resetwal.c:1239
#, c-format
msgid "  -o, --next-oid=OID               set next OID\n"
msgstr "  -o, --next-oid=OID               define próximo OID\n"

#: pg_resetwal.c:1240
#, c-format
msgid "  -O, --multixact-offset=OFFSET    set next multitransaction offset\n"
msgstr "  -O, --multixact-offset=POSIÇÃO   define próxima posição de multitransação\n"

#: pg_resetwal.c:1241
#, c-format
msgid "  -u, --oldest-transaction-id=XID  set oldest transaction ID\n"
msgstr "  -u, --oldest-transaction-id=XID  define ID de transação mais antigo\n"

#: pg_resetwal.c:1242
#, c-format
msgid "  -x, --next-transaction-id=XID    set next transaction ID\n"
msgstr "  -x, --next-transaction-id=XID    define próximo ID de transação\n"

#: pg_resetwal.c:1243
#, c-format
msgid "      --char-signedness=OPTION     set char signedness to \"signed\" or \"unsigned\"\n"
msgstr ""

#: pg_resetwal.c:1244
#, c-format
msgid "      --wal-segsize=SIZE           size of WAL segments, in megabytes\n"
msgstr "      --wal-segsize=TAMANHO        tamanho dos segmentos do WAL, em megabytes\n"

#: pg_resetwal.c:1246
#, c-format
msgid ""
"\n"
"Report bugs to <%s>.\n"
msgstr ""
"\n"
"Relate erros a <%s>.\n"

#: pg_resetwal.c:1247
#, c-format
msgid "%s home page: <%s>\n"
msgstr "página web do %s: <%s>\n"

#, c-format
#~ msgid "  -?, --help                       show this help, then exit\n"
#~ msgstr "  -?, --help                       mostra essa ajuda e termina\n"

#, c-format
#~ msgid "  -V, --version                    output version information, then exit\n"
#~ msgstr "  -V, --version                    mostra informação sobre a versão e termina\n"

#, c-format
#~ msgid "  -f, --force                      force update to be done\n"
#~ msgstr "  -f, --force                      força atualização ser feita\n"

#, c-format
#~ msgid " [-D, --pgdata=]DATADIR            data directory\n"
#~ msgstr " [-D, --pgdata=]DIRDADOS           diretório de dados\n"

