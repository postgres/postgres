msgstr "  -E, --encoding=CODIFICA       esporta i dati nella codifica CODIFICA\n"

#: pg_dump.c:1321
#, c-format
msgid "  -n, --schema=PATTERN         dump the specified schema(s) only\n"
msgstr "  -n, --schema=PATTERN          esporta solo gli schemi specificati\n"

#: pg_dump.c:1322
#, c-format
