#: ../../../src/common/logging.c:259
#, c-format
msgid "fatal: "
msgstr "致命錯誤: "

#: ../../../src/common/logging.c:266
#, c-format
msgid "error: "
msgstr "錯誤: "

#: ../../../src/common/logging.c:273
#, c-format
msgid "warning: "
msgstr "警告: "

#: pg_checksums.c:75
#, c-format
msgid ""
"%s enables, disables, or verifies data checksums in a PostgreSQL database cluster.\n"
"\n"
msgstr "%s 可以啟動、關閉或驗證 PostgreSQL 資料庫叢集中的資料檢查碼。\n\n"

#: pg_checksums.c:76
#, c-format
msgid "Usage:\n"
msgstr "用法:\n"

#: pg_checksums.c:77
#, c-format
msgid "  %s [OPTION]... [DATADIR]\n"
msgstr "  %s [選項]... [資料目錄]\n"

#: pg_checksums.c:78
#, c-format
msgid ""
"\n"
"Options:\n"
msgstr ""
"\n"
"選項:\n"

#: pg_checksums.c:79
#, c-format
msgid " [-D, --pgdata=]DATADIR    data directory\n"
msgstr " [-D, --pgdata=]DATADIR    資料目錄\n"

#: pg_checksums.c:80
#, c-format
msgid "  -c, --check              check data checksums (default)\n"
msgstr "  -c, --check              檢查資料檢查碼(預設)\n"

#: pg_checksums.c:81
#, c-format
msgid "  -d, --disable            disable data checksums\n"
msgstr "  -d, --disable            關閉資料檢查碼\n"

#: pg_checksums.c:82
#, c-format
msgid "  -e, --enable             enable data checksums\n"
msgstr "  -e, --enable             啟動資料檢查碼\n"

#: pg_checksums.c:83
#, c-format
msgid "  -f, --filenode=FILENODE  check only relation with specified filenode\n"
msgstr "  -f, --filenode=FILENODE  只檢查指定 filenode 的關聯\n"

#: pg_checksums.c:84
#, c-format
msgid "  -N, --no-sync            do not wait for changes to be written safely to disk\n"
msgstr "  -N, --no-sync            不等待變更安全寫入磁碟\n"

#: pg_checksums.c:85
#, c-format
msgid "  -P, --progress           show progress information\n"
msgstr "  -P, --progress           顯示進度資訊\n"

#: pg_checksums.c:86
#, c-format
msgid "  -v, --verbose            output verbose messages\n"
msgstr "  -v, --verbose            顯示詳細訊息\n"

#: pg_checksums.c:87
#, c-format
msgid "  -V, --version            output version information, then exit\n"
msgstr "  -V, --version            顯示版本，然後結束\n"

#: pg_checksums.c:88
#, c-format
msgid "  -?, --help               show this help, then exit\n"
msgstr "  -?, --help               顯示說明，然後結束\n"

#: pg_checksums.c:89
#, c-format
msgid ""
"\n"
"If no data directory (DATADIR) is specified, the environment variable PGDATA\n"
"is used.\n"
"\n"
msgstr "\n若未指定資料目錄(DATADIR)就用環境變數 PGDATA。\n\n"

#: pg_checksums.c:91
#, c-format
msgid "Report bugs to <%s>.\n"
msgstr "回報錯誤至 <%s>。\n"

#: pg_checksums.c:92
#, c-format
msgid "%s home page: <%s>\n"
msgstr "%s 首頁: <%s>\n"

#: pg_checksums.c:161
#, c-format
msgid "%*s/%s MB (%d%%) computed"
msgstr "已計算 %*s/%s MB (%d%%)"

# access/transam/slru.c:638 access/transam/xlog.c:1631
# access/transam/xlog.c:2742 access/transam/xlog.c:2832
# access/transam/xlog.c:2930 libpq/hba.c:911 libpq/hba.c:935
# utils/error/elog.c:1118 utils/init/miscinit.c:783 utils/init/miscinit.c:889
# utils/misc/database.c:68
#: pg_checksums.c:207
#, c-format
msgid "could not open file \"%s\": %m"
msgstr "無法開啟檔案 \"%s\": %m"

# utils/init/miscinit.c:539
#: pg_checksums.c:223
#, c-format
msgid "could not read block %u in file \"%s\": %m"
msgstr "無法讀取檔案 \"%2$s\" 的區塊 %1$u: %m"

#: pg_checksums.c:226
#, c-format
msgid "could not read block %u in file \"%s\": read %d of %d"
msgstr "無法讀取檔案 \"%2$s\" 的區塊 %1$u: 應讀取 %4$d，實際讀取 %3$d"

#: pg_checksums.c:250
#, c-format
msgid "checksum verification failed in file \"%s\", block %u: calculated checksum %X but block contains %X"
msgstr "檔案 \"%s\" 中區塊 %u 的檢查碼驗證失敗: 算得檢查碼 %X，但區塊包含 %X"

#: pg_checksums.c:265
#, c-format
msgid "seek failed for block %u in file \"%s\": %m"
msgstr "在檔案 \"%2$s\" 中定位區塊 %1$u 失敗: %m"

# utils/init/miscinit.c:672 utils/init/miscinit.c:682
#: pg_checksums.c:274
#, c-format
msgid "could not write block %u in file \"%s\": %m"
msgstr "無法寫入檔案 \"%2$s\" 的區塊 %1$u: %m"

#: pg_checksums.c:277
#, c-format
msgid "could not write block %u in file \"%s\": wrote %d of %d"
msgstr "無法寫入檔案 \"%2$s\" 中的區塊 %1$u: 應寫入 %4$d，實際寫入 %3$d"

#: pg_checksums.c:290
#, c-format
msgid "checksums verified in file \"%s\""
msgstr "檔案 \"%s\" 中已驗證檢查碼"

#: pg_checksums.c:292
#, c-format
msgid "checksums enabled in file \"%s\""
msgstr "檔案 \"%s\" 中已啟動檢查碼"

# access/transam/slru.c:930 commands/tablespace.c:529
# commands/tablespace.c:694 utils/adt/misc.c:174
#: pg_checksums.c:317
#, c-format
msgid "could not open directory \"%s\": %m"
msgstr "無法開啟目錄 \"%s\": %m"

# access/transam/xlog.c:1936 access/transam/xlog.c:2038
# access/transam/xlog.c:5291
#: pg_checksums.c:344 pg_checksums.c:419
#, c-format
msgid "could not stat file \"%s\": %m"
msgstr "無法取得檔案 \"%s\" 的狀態: %m"

#: pg_checksums.c:371
#, c-format
msgid "invalid segment number %d in file name \"%s\""
msgstr "檔名 \"%2$s\" 中的區段編號 %1$d 無效"

#: pg_checksums.c:500
#, c-format
msgid "invalid filenode specification, must be numeric: %s"
msgstr "filenode 指定無效，必須是數字: %s"

# postmaster/postmaster.c:512 postmaster/postmaster.c:525
#: pg_checksums.c:518 pg_checksums.c:534 pg_checksums.c:544 pg_checksums.c:553
#, c-format
msgid "Try \"%s --help\" for more information.\n"
msgstr "用 \"%s --help\" 取得更多資訊。\n"

#: pg_checksums.c:533
#, c-format
msgid "no data directory specified"
msgstr "未指定資料目錄"

#: pg_checksums.c:542
#, c-format
msgid "too many command-line arguments (first is \"%s\")"
msgstr "命令列參數過多(第一個多餘參數是 \"%s\")"

#: pg_checksums.c:552
#, c-format
msgid "option -f/--filenode can only be used with --check"
msgstr "選項 -f/--filenode 只能與 --check 一起使用"

#: pg_checksums.c:562
#, c-format
msgid "pg_control CRC value is incorrect"
msgstr "pg_control 的 CRC 值不正確"

#: pg_checksums.c:568
#, c-format
msgid "cluster is not compatible with this version of pg_checksums"
msgstr "叢集與這版 pg_checksums 不相容"

#: pg_checksums.c:574
#, c-format
msgid "database cluster is not compatible"
msgstr "資料庫叢集不相容"

#: pg_checksums.c:575
#, c-format
msgid "The database cluster was initialized with block size %u, but pg_checksums was compiled with block size %u.\n"
msgstr "資料庫叢集使用區塊大小 %u 進行初始化，但 pg_checksums 編譯時使用區塊大小 %u。\n"

#: pg_checksums.c:588
#, c-format
msgid "cluster must be shut down"
msgstr "必須關閉叢集"

#: pg_checksums.c:595
#, c-format
msgid "data checksums are not enabled in cluster"
msgstr "叢集未啟動資料檢查碼"

#: pg_checksums.c:602
#, c-format
msgid "data checksums are already disabled in cluster"
msgstr "叢集已關閉資料檢查碼"

#: pg_checksums.c:609
#, c-format
msgid "data checksums are already enabled in cluster"
msgstr "叢集已啟動資料檢查碼"

#: pg_checksums.c:635
#, c-format
msgid "Checksum operation completed\n"
msgstr "檢查碼作業完成\n"

#: pg_checksums.c:636
#, c-format
msgid "Files scanned:  %s\n"
msgstr "已掃描檔案:     %s\n"

#: pg_checksums.c:637
#, c-format
msgid "Blocks scanned: %s\n"
msgstr "已掃描區塊:     %s\n"

#: pg_checksums.c:640
#, c-format
msgid "Bad checksums:  %s\n"
msgstr "錯誤檢查碼:     %s\n"

#: pg_checksums.c:641 pg_checksums.c:668
#, c-format
msgid "Data checksum version: %u\n"
msgstr "資料檢查碼版本:  %u\n"

#: pg_checksums.c:660
#, c-format
msgid "syncing data directory"
msgstr "正在同步資料目錄"

#: pg_checksums.c:664
#, c-format
msgid "updating control file"
msgstr "正在更新控制檔"

#: pg_checksums.c:670
#, c-format
msgid "Checksums enabled in cluster\n"
msgstr "叢集已啟動檢查碼\n"

#: pg_checksums.c:672
#, c-format
msgid "Checksums disabled in cluster\n"
msgstr "叢集已關閉檢查碼\n"

