msgstr "soltanto i protocolli \"tcp\" e \"unix\" ed il tipo database \"postgresql\" sono supportati"

#: preproc.y:8376
#, c-format
msgid "expected \"://\", found \"%s\""
msgstr "atteso \"://\", trovato \"%s\""

#: preproc.y:8381
#, c-format
