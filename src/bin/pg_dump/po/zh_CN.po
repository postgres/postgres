msgstr "恢复过程中忽略的错误数: %d"

#: pg_restore.c:535
#, c-format
msgid ""
"%s restores a PostgreSQL database from an archive created by pg_dump.\n"
"\n"
msgstr ""
"%s 从 pg_dump 创建的归档中恢复 PostgreSQL 数据库。\n"
"\n"

#: pg_restore.c:537
#, c-format
msgid "  %s [OPTION]... [FILE]\n"
msgstr "  %s [选项]... [文件名]\n"

#: pg_restore.c:540
#, c-format
msgid "  -d, --dbname=NAME        connect to database name\n"
msgstr "  -d, --dbname=NAME        连接到指定的数据库\n"

#: pg_restore.c:541
#, c-format
msgid "  -f, --file=FILENAME      output file name (- for stdout)\n"
msgstr "  -f, --file=FILENAME      输出文件名（- 表示标准输出）\n"

#: pg_restore.c:542
#, c-format
msgid "  -F, --format=c|d|t       backup file format (should be automatic)\n"
msgstr "  -F, --format=c|d|t       备份文件格式（应当自动识别）\n"

#: pg_restore.c:543
#, c-format
msgid "  -l, --list               print summarized TOC of the archive\n"
msgstr "  -l, --list               打印归档的目录（TOC）摘要\n"

#: pg_restore.c:544
#, c-format
msgid "  -v, --verbose            verbose mode\n"
msgstr "  -v, --verbose            详细模式\n"

#: pg_restore.c:545
#, c-format
msgid "  -V, --version            output version information, then exit\n"
msgstr "  -V, --version            输出版本信息，然后退出\n"

#: pg_restore.c:546
#, c-format
msgid "  -?, --help               show this help, then exit\n"
msgstr "  -?, --help               显示此帮助，然后退出\n"

#: pg_restore.c:548
#, c-format
msgid ""
"\n"
"Options controlling the restore:\n"
msgstr ""
"\n"
"控制恢复的选项:\n"

#: pg_restore.c:549
#, c-format
msgid "  -a, --data-only              restore only the data, no schema\n"
msgstr "  -a, --data-only              仅恢复数据，不恢复模式定义\n"

#: pg_restore.c:551
#, c-format
msgid "  -C, --create                 create the target database\n"
msgstr "  -C, --create                 创建目标数据库\n"

#: pg_restore.c:552
#, c-format
msgid "  -e, --exit-on-error          exit on error, default is to continue\n"
msgstr "  -e, --exit-on-error          出错时退出，默认继续执行\n"

#: pg_restore.c:553
#, c-format
msgid "  -I, --index=NAME             restore named index\n"
msgstr "  -I, --index=NAME             恢复指定名称的索引\n"

#: pg_restore.c:554
#, c-format
msgid "  -j, --jobs=NUM               use this many parallel jobs to restore\n"
msgstr "  -j, --jobs=NUM               使用指定数量的并行任务进行恢复\n"

#: pg_restore.c:555
#, c-format
msgid ""
"  -L, --use-list=FILENAME      use table of contents from this file for\n"
"                               selecting/ordering output\n"
msgstr ""
"  -L, --use-list=FILENAME      使用此文件中的目录选择输出内容并确定顺序\n"

#: pg_restore.c:557
#, c-format
msgid "  -n, --schema=NAME            restore only objects in this schema\n"
msgstr "  -n, --schema=NAME            仅恢复此模式中的对象\n"

#: pg_restore.c:558
#, c-format
msgid "  -N, --exclude-schema=NAME    do not restore objects in this schema\n"
msgstr "  -N, --exclude-schema=NAME    不恢复此模式中的对象\n"

#: pg_restore.c:560
#, c-format
msgid "  -P, --function=NAME(args)    restore named function\n"
msgstr "  -P, --function=NAME(args)    恢复指定名称的函数\n"

#: pg_restore.c:561
#, c-format
msgid "  -s, --schema-only            restore only the schema, no data\n"
msgstr "  -s, --schema-only            仅恢复模式定义，不恢复数据\n"

#: pg_restore.c:562
#, c-format
msgid ""
"  -S, --superuser=NAME         superuser user name to use for disabling "
"triggers\n"
msgstr "  -S, --superuser=NAME         禁用触发器时使用的超级用户名\n"

#: pg_restore.c:563
#, c-format
msgid ""
"  -t, --table=NAME             restore named relation (table, view, etc.)\n"
msgstr "  -t, --table=NAME             恢复指定名称的关系（表、视图等）\n"

#: pg_restore.c:564
#, c-format
msgid "  -T, --trigger=NAME           restore named trigger\n"
msgstr "  -T, --trigger=NAME           恢复指定名称的触发器\n"

#: pg_restore.c:565
#, c-format
msgid ""
"  -x, --no-privileges          skip restoration of access privileges (grant/"
"revoke)\n"
msgstr "  -x, --no-privileges          跳过访问权限的恢复（grant/revoke）\n"

#: pg_restore.c:566
#, c-format
msgid "  -1, --single-transaction     restore as a single transaction\n"
msgstr "  -1, --single-transaction     作为单个事务恢复\n"

#: pg_restore.c:568
#, c-format
msgid "  --enable-row-security        enable row security\n"
msgstr "  --enable-row-security        启用行安全性\n"

#: pg_restore.c:569
#, c-format
msgid ""
"  --filter=FILENAME            restore or skip objects based on expressions\n"
"                               in FILENAME\n"
msgstr ""
"  --filter=FILENAME            根据 FILENAME 中的表达式恢复或跳过对象\n"

#: pg_restore.c:572
#, c-format
msgid "  --no-comments                do not restore comment commands\n"
msgstr "  --no-comments                不恢复注释命令\n"

#: pg_restore.c:573
#, c-format
msgid "  --no-data                    do not restore data\n"
msgstr "  --no-data                    不恢复数据\n"

#: pg_restore.c:574
#, c-format
msgid ""
"  --no-data-for-failed-tables  do not restore data of tables that could not "
"be\n"
"                               created\n"
msgstr "  --no-data-for-failed-tables  对那些无法创建的表不进行数据恢复\n"

#: pg_restore.c:576
#, c-format
msgid "  --no-policies                do not restore row security policies\n"
msgstr "  --no-policies                不恢复行安全策略\n"

#: pg_restore.c:577
#, c-format
msgid "  --no-publications            do not restore publications\n"
msgstr "  --no-publications            不恢复发布\n"

#: pg_restore.c:578
#, c-format
msgid "  --no-schema                  do not restore schema\n"
msgstr "  --no-schema                  不恢复模式定义\n"

#: pg_restore.c:579
#, c-format
msgid "  --no-security-labels         do not restore security labels\n"
msgstr "  --no-security-labels         不恢复安全标签信息\n"

#: pg_restore.c:580
#, c-format
msgid "  --no-statistics              do not restore statistics\n"
msgstr "  --no-statistics              不恢复统计信息\n"

#: pg_restore.c:581
#, c-format
msgid "  --no-subscriptions           do not restore subscriptions\n"
msgstr "  --no-subscriptions           不恢复订阅\n"

#: pg_restore.c:582
#, c-format
msgid "  --no-table-access-method     do not restore table access methods\n"
msgstr "  --no-table-access-method     不恢复表访问方法\n"

#: pg_restore.c:583
#, c-format
msgid "  --no-tablespaces             do not restore tablespace assignments\n"
msgstr "  --no-tablespaces             不恢复表空间分配信息\n"

#: pg_restore.c:585
#, c-format
msgid ""
"  --section=SECTION            restore named section (pre-data, data, or "
"post-data)\n"
msgstr ""
"  --section=SECTION            恢复指定的节（pre-data, data 或 post-data）\n"

#: pg_restore.c:586
#, c-format
msgid "  --statistics                 restore the statistics\n"
msgstr "  --statistics                 恢复统计信息\n"

#: pg_restore.c:587
#, c-format
msgid ""
"  --statistics-only            restore only the statistics, not schema or "
"data\n"
msgstr "  --statistics-only            仅恢复统计信息，不恢复模式定义或数据\n"

#: pg_restore.c:590
#, c-format
msgid "  --transaction-size=N         commit after every N objects\n"
msgstr "  --transaction-size=N         每处理 N 个对象后提交\n"

#: pg_restore.c:601
#, c-format
msgid "  --role=ROLENAME          do SET ROLE before restore\n"
msgstr "  --role=ROLENAME          在恢复前运行 SET ROLE\n"

#: pg_restore.c:603
#, c-format
msgid ""
"\n"
"The options -I, -n, -N, -P, -t, -T, and --section can be combined and "
"specified\n"
"multiple times to select multiple objects.\n"
msgstr ""
"\n"
"选项 -I, -n, -N, -P, -t, -T 和 --section 可以组合使用，\n"
"也可以多次指定，以选择多个对象。\n"

#: pg_restore.c:606
#, c-format
msgid ""
"\n"
"If no input file name is supplied, then standard input is used.\n"
"\n"
msgstr ""
"\n"
"如果没有提供输入文件名，则使用标准输入。\n"
"\n"

