#: pg_amcheck.c:1220
#, c-format
msgid "      --maintenance-db=DBNAME     alternate maintenance database\n"
msgstr "      --maintenance-db=DBNAME     banco de dados alternativo para manutenção\n"

#: pg_amcheck.c:1221
#, c-format
msgid ""
"\n"
"Other options:\n"
msgstr ""
"\n"
"Outras opções:\n"

